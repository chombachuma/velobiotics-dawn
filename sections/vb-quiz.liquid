{%- comment -%} VB BioMatch — Velobiotics Personalised Wellness Quiz v3 {%- endcomment -%}
<style>
  .vbq{--g:#4d8c44;--g2:#2e5d28;--cream:#fdf9f1;--ink:#1a2e1a;--mute:#5a6b5a;--border:#e8efe6;--tint:#eef7ec;font-family:'Open Sans','Inter',system-ui,sans-serif;color:var(--ink);position:relative;display:block}
  /* Active mode: no position:fixed (Shopify section wrappers break it). We hide sibling sections via JS instead. */
  body.vbq-active{background:#fdf9f1}
  .vbq.is-fs{background:#fdf9f1;min-height:100vh}
  .vbq__shell{max-width:680px;margin:0 auto;padding:32px 20px 80px;position:relative;z-index:1}
  .vbq.is-fs .vbq__shell{padding-top:32px;min-height:calc(100vh - 60px);display:flex;flex-direction:column;justify-content:center}

  /* Step visibility — bulletproof */
  .vbq__step{display:none}
  .vbq__step.is-active{display:block;opacity:1;animation:vbqfade .35s ease-out forwards}
  .vbq__step--full.is-active{display:block;padding:0}
  @keyframes vbqfade{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}

  /* Sticky progress — sticks to the body viewport since body is the scroll container */
  .vbq__progress{position:sticky;top:0;left:0;right:0;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);padding:14px 20px;z-index:200;border-bottom:1px solid var(--border);display:none}
  .vbq__progress.is-on{display:flex;align-items:center;gap:14px}
  .vbq__exit{appearance:none;border:none;background:none;cursor:pointer;color:var(--mute);font-size:22px;line-height:1;padding:6px 10px;border-radius:8px;transition:.2s}
  .vbq__exit:hover{background:var(--tint);color:var(--ink)}
  .vbq__progress-track{flex:1;height:8px;background:#eee;border-radius:99px;overflow:hidden;position:relative}
  .vbq__progress-fill{height:100%;background:linear-gradient(90deg,var(--g),var(--g2));border-radius:99px;transition:width .5s cubic-bezier(.4,0,.2,1);position:relative}
  .vbq__progress-fill::after{content:'';position:absolute;right:0;top:50%;transform:translateY(-50%);width:14px;height:14px;background:#fff;border:3px solid var(--g);border-radius:50%;box-shadow:0 2px 8px rgba(77,140,68,.4)}
  .vbq__progress-label{font-size:13px;color:var(--mute);font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}
  .vbq__progress-label strong{color:var(--g)}

  /* ============ HERO — full-bleed, femina.care-style ============ */
  .vbq__hero{position:relative;width:100%;min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:80px 20px 60px;overflow:hidden;text-align:center;box-sizing:border-box}
  .vbq__hero-bg{position:absolute;inset:0;z-index:0;overflow:hidden}
  .vbq__hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center 25%;filter:saturate(.92) contrast(1.02)}
  /* Layered fade overlays — text legibility on any image */
  .vbq__hero-bg::before{content:'';position:absolute;inset:0;background:
    linear-gradient(180deg,rgba(253,249,241,.35) 0%,rgba(253,249,241,0) 25%,rgba(253,249,241,0) 65%,rgba(253,249,241,.95) 100%),
    linear-gradient(90deg,rgba(253,249,241,1) 0%,rgba(253,249,241,.4) 18%,rgba(253,249,241,0) 30%,rgba(253,249,241,0) 70%,rgba(253,249,241,.4) 82%,rgba(253,249,241,1) 100%);z-index:2;pointer-events:none}
  @media(max-width:768px){
    .vbq__hero-bg::before{background:
      linear-gradient(180deg,rgba(253,249,241,.4) 0%,rgba(253,249,241,.1) 30%,rgba(253,249,241,.5) 75%,rgba(253,249,241,1) 100%);}
  }
  /* Soft center glow behind text */
  .vbq__hero-bg::after{content:'';position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(820px,90%);height:min(560px,80%);background:radial-gradient(ellipse,rgba(253,249,241,.7) 0%,rgba(253,249,241,.3) 50%,transparent 80%);z-index:2;pointer-events:none;filter:blur(20px)}
  .vbq__hero-content{position:relative;z-index:5;max-width:720px;margin:0 auto}
  .vbq__hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid #d8e8d4;color:var(--g2);padding:8px 18px;border-radius:999px;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:28px;box-shadow:0 4px 20px rgba(0,0,0,.08)}
  .vbq__hero-eyebrow::before{content:'';width:6px;height:6px;background:var(--g);border-radius:50%;animation:vbqpulse 2s ease-in-out infinite}
  @keyframes vbqpulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
  .vbq__hero-title{font-family:'Playfair Display',Georgia,serif;font-size:clamp(38px,7.5vw,82px);line-height:1;font-weight:700;margin:0 0 20px;letter-spacing:-.025em;color:var(--ink)}
  .vbq__hero-title .vbq__hl{color:var(--g);font-style:italic;display:block}
  .vbq__hero-sub{font-size:clamp(16px,2vw,20px);line-height:1.5;color:#2a3a2a;margin:0 0 36px;max-width:520px;margin-left:auto;margin-right:auto;font-weight:500}
  .vbq__hero-cta{display:inline-flex;align-items:center;gap:10px;background:var(--g);color:#fff;padding:20px 44px;border-radius:99px;font-size:18px;font-weight:700;text-decoration:none;border:none;cursor:pointer;font-family:inherit;box-shadow:0 12px 40px rgba(77,140,68,.45);transition:all .3s cubic-bezier(.4,0,.2,1)}
  .vbq__hero-cta:hover{background:var(--g2);transform:translateY(-3px) scale(1.02);box-shadow:0 18px 56px rgba(77,140,68,.55);color:#fff}
  .vbq__hero-cta::after{content:'→';display:inline-block;transition:transform .3s}
  .vbq__hero-cta:hover::after{transform:translateX(6px)}
  .vbq__hero-meta{display:flex;justify-content:center;gap:32px;margin-top:32px;flex-wrap:wrap;font-size:13px;color:#2a3a2a;font-weight:600}
  .vbq__hero-meta span{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.7);backdrop-filter:blur(6px);padding:6px 14px;border-radius:99px}

  /* Common typography for quiz steps */
  .vbq__eyebrow{display:inline-block;background:var(--tint);color:var(--g2);padding:6px 14px;border-radius:999px;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:20px}
  .vbq__h{font-family:'Playfair Display',Georgia,serif;font-size:clamp(28px,5.5vw,46px);line-height:1.1;margin:0 0 14px;font-weight:700;letter-spacing:-.01em;color:var(--ink)}
  .vbq__h .vbq__hl{color:var(--g);font-style:italic}
  .vbq__sub{font-size:17px;line-height:1.55;color:var(--mute);margin:0 0 32px;max-width:540px}

  /* Options */
  .vbq__opts{display:grid;gap:12px;margin-bottom:24px}
  .vbq__opts.cols-2{grid-template-columns:repeat(2,1fr)}
  .vbq__opts.cols-3{grid-template-columns:repeat(3,1fr)}
  @media (max-width:640px){.vbq__opts.cols-2,.vbq__opts.cols-3{grid-template-columns:1fr}}
  .vbq__opt{display:flex;align-items:center;gap:14px;padding:18px 20px;background:#fff;border:2px solid var(--border);border-radius:16px;cursor:pointer;font-weight:600;font-size:16px;color:var(--ink);text-align:left;transition:all .25s cubic-bezier(.4,0,.2,1);user-select:none;font-family:inherit;width:100%}
  .vbq__opt:hover{border-color:var(--g);background:var(--tint);transform:translateY(-2px);box-shadow:0 8px 24px rgba(77,140,68,.18)}
  .vbq__opt.is-on{border-color:var(--g);background:var(--tint);box-shadow:0 4px 16px rgba(77,140,68,.2)}
  .vbq__opt-icon{font-size:22px;flex-shrink:0;width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:var(--cream);border-radius:50%}
  .vbq__opt.is-on .vbq__opt-icon{background:var(--g);color:#fff}
  .vbq__opt-text{flex:1}
  .vbq__opt-text small{display:block;font-weight:400;color:var(--mute);font-size:12px;margin-top:2px}
  .vbq__check{width:22px;height:22px;border:2px solid #ccc;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.2s}
  .vbq__opt.is-on .vbq__check{background:var(--g);border-color:var(--g)}
  .vbq__opt.is-on .vbq__check::after{content:'';width:7px;height:12px;border:solid #fff;border-width:0 3px 3px 0;transform:rotate(45deg);margin-top:-2px}
  .vbq__nav{display:flex;gap:12px;align-items:center;margin-top:32px}
  .vbq__btn{appearance:none;border:none;cursor:pointer;font-weight:700;font-size:16px;padding:16px 32px;border-radius:99px;transition:all .25s;font-family:inherit;display:inline-flex;align-items:center;gap:8px}
  .vbq__btn--prime{background:var(--g);color:#fff;flex:1;justify-content:center;box-shadow:0 4px 16px rgba(77,140,68,.25)}
  .vbq__btn--prime:hover:not(:disabled){background:var(--g2);transform:translateY(-2px);box-shadow:0 10px 28px rgba(77,140,68,.35)}
  .vbq__btn--prime:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}
  .vbq__btn--ghost{background:transparent;color:var(--mute);padding:16px 20px}
  .vbq__btn--ghost:hover{color:var(--g);background:var(--tint)}
  .vbq__input{width:100%;padding:18px 22px;border:2px solid var(--border);border-radius:14px;font-size:16px;font-family:inherit;background:#fff;transition:.2s;color:var(--ink);box-sizing:border-box}
  .vbq__input:focus{outline:none;border-color:var(--g);box-shadow:0 0 0 4px rgba(77,140,68,.12)}
  .vbq__field{margin-bottom:18px}
  .vbq__field label{display:block;font-weight:600;font-size:14px;margin-bottom:8px;color:var(--ink)}
  .vbq__legal{font-size:13px;color:var(--mute);line-height:1.55;margin-top:14px}
  .vbq__legal a{color:var(--g);text-decoration:underline}
  .vbq__hint{font-size:13px;color:var(--mute);margin:-14px 0 16px;font-style:italic}

  /* Interstitial */
  .vbq__inter{text-align:center;padding:40px 20px}
  .vbq__inter-emoji{font-size:64px;margin-bottom:20px;display:block;animation:vbqbounce .6s cubic-bezier(.34,1.56,.64,1)}
  @keyframes vbqbounce{0%{transform:scale(0)}60%{transform:scale(1.15)}100%{transform:scale(1)}}
  .vbq__inter-h{font-family:'Playfair Display',Georgia,serif;font-size:clamp(24px,4vw,36px);line-height:1.2;margin:0 0 14px;font-weight:700;color:var(--ink)}
  .vbq__inter-h .vbq__hl{color:var(--g);font-style:italic}
  .vbq__inter-sub{font-size:17px;line-height:1.55;color:var(--mute);margin:0 auto 28px;max-width:480px}
  .vbq__inter-stat{display:inline-block;background:linear-gradient(135deg,var(--tint),#fff);border:1px solid #d8e8d4;border-radius:18px;padding:18px 32px;margin-bottom:24px}
  .vbq__inter-stat strong{font-family:'Playfair Display',Georgia,serif;font-size:36px;color:var(--g);display:block;line-height:1}
  .vbq__inter-stat small{color:var(--mute);font-size:13px;font-weight:600}

  /* Loader */
  .vbq__loader{text-align:center;padding:64px 0}
  .vbq__spinner{width:72px;height:72px;border:5px solid var(--tint);border-top-color:var(--g);border-radius:50%;margin:0 auto 28px;animation:vbqspin 1s linear infinite}
  @keyframes vbqspin{to{transform:rotate(360deg)}}
  .vbq__loader-msg{font-size:18px;font-weight:600;color:var(--g2);margin:0;min-height:28px}

  /* Results */
  .vbq__results-header{text-align:center;margin-bottom:32px}
  .vbq__profile{background:linear-gradient(135deg,var(--tint),#fff);border:1px solid #d8e8d4;border-radius:18px;padding:22px;margin-bottom:28px;font-size:15px;color:var(--ink);line-height:1.6}
  .vbq__profile strong{color:var(--g2);font-weight:700}
  .vbq__rec{background:#fff;border:2px solid var(--border);border-radius:20px;padding:24px;margin-bottom:18px;display:flex;gap:20px;align-items:flex-start;position:relative;overflow:hidden;transition:.3s}
  .vbq__rec:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(77,140,68,.08)}
  .vbq__rec.is-top{border-color:var(--g);box-shadow:0 16px 48px rgba(77,140,68,.18)}
  .vbq__rec-rank{position:absolute;top:0;right:0;background:var(--g);color:#fff;padding:6px 16px;border-bottom-left-radius:14px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .vbq__rec-img{width:120px;height:120px;flex-shrink:0;background:#f6f6f4;border-radius:14px;overflow:hidden;display:flex;align-items:center;justify-content:center}
  .vbq__rec-img img{width:100%;height:100%;object-fit:contain}
  .vbq__rec-body{flex:1;min-width:0}
  .vbq__rec-brand{font-size:11px;font-weight:700;color:var(--g);text-transform:uppercase;letter-spacing:.1em;margin-bottom:4px}
  .vbq__rec-title{font-size:18px;font-weight:700;color:var(--ink);margin:0 0 10px;line-height:1.3}
  .vbq__rec-why{font-size:14px;color:var(--mute);line-height:1.55;margin:0 0 14px}
  .vbq__rec-cta{display:inline-flex;align-items:center;gap:6px;background:var(--g);color:#fff;padding:11px 20px;border-radius:99px;font-weight:700;font-size:14px;text-decoration:none;transition:.2s}
  .vbq__rec-cta:hover{background:var(--g2);transform:translateY(-1px);color:#fff}
  .vbq__rec-cta-secondary{display:inline-block;margin-left:12px;font-size:13px;color:var(--mute);text-decoration:underline}
  @media (max-width:640px){.vbq__rec{flex-direction:column;align-items:stretch}.vbq__rec-img{width:100%;height:180px}}
  .vbq__share{text-align:center;margin-top:36px;padding-top:28px;border-top:1px solid var(--border)}
  .vbq__share p{margin:0 0 14px;color:var(--mute);font-size:14px}
  .vbq__share-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
  .vbq__share-btn{padding:10px 20px;background:var(--tint);border:1px solid #d8e8d4;border-radius:99px;color:var(--g2);text-decoration:none;font-size:13px;font-weight:600;cursor:pointer;transition:.2s}
  .vbq__share-btn:hover{background:var(--g);color:#fff;border-color:var(--g)}
</style>

<div class="vbq" id="vbq" data-omnisend-key="{{ section.settings.omnisend_api_key }}" data-quiz-name="{{ section.settings.quiz_name | default: 'BioMatch' }}">

  {%- comment -%} Sticky progress bar (shown during quiz only) {%- endcomment -%}
  <div class="vbq__progress" id="vbq-progress">
    <button class="vbq__exit" type="button" id="vbq-exit-btn" aria-label="Exit quiz">✕</button>
    <div class="vbq__progress-track"><div class="vbq__progress-fill" id="vbq-fill" style="width:0%"></div></div>
    <div class="vbq__progress-label">Step <strong id="vbq-step">1</strong> / 7</div>
  </div>

  {%- comment -%} ============ STEP 0: HERO (outside .vbq__shell — full-width) ============ {%- endcomment -%}
  <section class="vbq__step vbq__step--full is-active" data-step="start">
    <div class="vbq__hero">
      <div class="vbq__hero-bg">
        <img src="{{ section.settings.hero_image_url | default: 'https://d8j0ntlcm91z4.cloudfront.net/user_3CoTqdc3EEPYJ6jrH5LNdYUmSqc/hf_20260531_111648_3fbd3644-aa6e-4f4d-8cdc-d92377a17835.png' }}" alt="" loading="eager">
      </div>
      <div class="vbq__hero-content">
        <div class="vbq__hero-eyebrow">{{ section.settings.eyebrow | default: 'The Velobiotics BioMatch' }}</div>
        <h1 class="vbq__hero-title">{{ section.settings.hero_title_pre | default: 'Find your' }}<span class="vbq__hl">{{ section.settings.hero_title_highlight | default: 'perfect probiotic.' }}</span></h1>
        <p class="vbq__hero-sub">{{ section.settings.hero_sub | default: '7 quick questions. 60 seconds. A personalised stack — built by doctors, backed by Velobiotics™ MEP science.' }}</p>
        <button type="button" class="vbq__hero-cta" id="vbq-start-btn">{{ section.settings.cta_start | default: 'Start the BioMatch' }}</button>
        <div class="vbq__hero-meta">
          <span>⏱ 60 seconds</span>
          <span>🩺 Doctor-built</span>
          <span>💚 100% free</span>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ============ Quiz steps inside constrained shell ============ {%- endcomment -%}
  <div class="vbq__shell">

    <section class="vbq__step" data-step="q" data-key="who">
      <div class="vbq__eyebrow">Question 1 of 7</div>
      <h2 class="vbq__h">Who is this <span class="vbq__hl">for?</span></h2>
      <p class="vbq__sub">We'll tailor every recommendation to the right person.</p>
      <div class="vbq__opts cols-2">
        <button type="button" class="vbq__opt" data-val="myself"><span class="vbq__opt-icon">👤</span><span class="vbq__opt-text">Myself</span><span class="vbq__check"></span></button>
        <button type="button" class="vbq__opt" data-val="partner"><span class="vbq__opt-icon">💑</span><span class="vbq__opt-text">My Partner</span><span class="vbq__check"></span></button>
        <button type="button" class="vbq__opt" data-val="child"><span class="vbq__opt-icon">👶</span><span class="vbq__opt-text">My Child</span><span class="vbq__check"></span></button>
        <button type="button" class="vbq__opt" data-val="family"><span class="vbq__opt-icon">👨‍👩‍👧</span><span class="vbq__opt-text">Whole Family</span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button type="button" class="vbq__btn vbq__btn--ghost" data-vbq-action="prev">← Back</button><button type="button" class="vbq__btn vbq__btn--prime" data-vbq-action="next" disabled>Continue</button></div>
    </section>

    <section class="vbq__step" data-step="q" data-key="sex">
      <div class="vbq__eyebrow">Question 2 of 7</div>
      <h2 class="vbq__h">Biological <span class="vbq__hl">sex?</span></h2>
      <p class="vbq__sub">Some of our formulas are body-specific — this helps us match the right one. We honour all identities; biology guides the science.</p>
      <div class="vbq__opts cols-2">
        <button type="button" class="vbq__opt" data-val="female"><span class="vbq__opt-icon">♀</span><span class="vbq__opt-text">Female<small>Femina + Her-Biotics</small></span><span class="vbq__check"></span></button>
        <button type="button" class="vbq__opt" data-val="male"><span class="vbq__opt-icon">♂</span><span class="vbq__opt-text">Male<small>His-Biotics + Velo16</small></span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button type="button" class="vbq__btn vbq__btn--ghost" data-vbq-action="prev">← Back</button><button type="button" class="vbq__btn vbq__btn--prime" data-vbq-action="next" disabled>Continue</button></div>
    </section>

    <section class="vbq__step" data-step="inter" data-after="sex">
      <div class="vbq__inter">
        <span class="vbq__inter-emoji" id="vbq-i1-emoji">💚</span>
        <h3 class="vbq__inter-h" id="vbq-i1-h">Got it.</h3>
        <p class="vbq__inter-sub" id="vbq-i1-sub">We'll match you with formulas built specifically for your body's biology.</p>
        <button type="button" class="vbq__btn vbq__btn--prime" data-vbq-action="next" style="max-width:280px;width:100%">Continue →</button>
      </div>
    </section>

    <section class="vbq__step" data-step="q" data-key="age">
      <div class="vbq__eyebrow">Question 3 of 7</div>
      <h2 class="vbq__h">What's your <span class="vbq__hl">age range?</span></h2>
      <p class="vbq__sub">Nutritional needs shift with every life stage.</p>
      <div class="vbq__opts cols-2">
        <button type="button" class="vbq__opt" data-val="under18"><span class="vbq__opt-icon">🧒</span><span class="vbq__opt-text">Under 18<small>BioKid range</small></span><span class="vbq__check"></span></button>
        <button type="button" class="vbq__opt" data-val="18_30"><span class="vbq__opt-icon">🌱</span><span class="vbq__opt-text">18 – 30<small>Early adult</small></span><span class="vbq__check"></span></button>
        <button type="button" class="vbq__opt" data-val="30_45"><span class="vbq__opt-icon">⚡</span><span class="vbq__opt-text">30 – 45<small>Peak years</small></span><span class="vbq__check"></span></button>
        <button type="button" class="vbq__opt" data-val="45_60"><span class="vbq__opt-icon">🌿</span><span class="vbq__opt-text">45 – 60<small>Hormone shift</small></span><span class="vbq__check"></span></button>
        <button type="button" class="vbq__opt" data-val="over60"><span class="vbq__opt-icon">🌟</span><span class="vbq__opt-text">60+<small>Ageless wellness</small></span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button type="button" class="vbq__btn vbq__btn--ghost" data-vbq-action="prev">← Back</button><button type="button" class="vbq__btn vbq__btn--prime" data-vbq-action="next" disabled>Continue</button></div>
    </section>

    <section class="vbq__step" data-step="q" data-key="goal" data-multi="true" data-max="2">
      <div class="vbq__eyebrow">Question 4 of 7</div>
      <h2 class="vbq__h">Your top <span class="vbq__hl">wellness goal?</span></h2>
      <p class="vbq__sub">Pick up to 2 — we'll prioritise these.</p>
      <p class="vbq__hint">You can select up to 2 goals.</p>
      <div class="vbq__opts cols-2" id="vbq-goal-opts">
        <button type="button" class="vbq__opt" data-val="gut"><span class="vbq__opt-icon">🦠</span><span class="vbq__opt-text">Gut & digestion</span><span class="vbq__check"></span></button>
