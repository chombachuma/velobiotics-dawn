{%- comment -%} VB Cart FBT — Frequently Bought Together with /collections/all card style {%- endcomment -%}
<style>
.vbfbt{padding:60px 20px 80px;background:#fff}
.vbfbt__shell{max-width:1280px;margin:0 auto}
.vbfbt__head{text-align:center;max-width:680px;margin:0 auto 36px}
.vbfbt__eb{display:inline-flex;align-items:center;gap:10px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#4d8c44;font-weight:700;margin:0 0 8px}
.vbfbt__eb::before,.vbfbt__eb::after{content:'';width:22px;height:2px;background:#2e5d28;border-radius:2px}
.vbfbt__h{font-family:'Playfair Display',Georgia,serif;font-size:clamp(28px,4vw,40px);font-weight:800;line-height:1.15;margin:0 0 8px;color:#1a2e1a;letter-spacing:-.01em}
.vbfbt__h em{color:#4d8c44;font-style:italic}
.vbfbt__sub{color:#5a6b5a;font-size:16px;line-height:1.5;margin:0 auto;max-width:560px}

/* Same fpg-card styling as /collections/all */
.vbfbt__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;max-width:1280px;margin:0 auto}
@media(max-width:600px){.vbfbt__grid{grid-template-columns:repeat(2,1fr);gap:12px}}
.vbfbt-card{position:relative;display:flex;flex-direction:column;background:#fff;border:1px solid #ece7f0;border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}
.vbfbt-card:hover{transform:translateY(-8px) scale(1.015);box-shadow:0 28px 50px rgba(77,140,68,.22);border-color:color-mix(in srgb,#4d8c44 35%,transparent)}
.vbfbt-card__media{position:relative;width:100%;aspect-ratio:1/1;background:linear-gradient(135deg,#eef7ec 0%,#d4ebd0 100%);overflow:hidden;isolation:isolate}
.vbfbt-card__media img{width:100%;height:100%;object-fit:contain;padding:14px;transition:transform .4s ease;mix-blend-mode:multiply;filter:contrast(1.02) saturate(1.05)}
.vbfbt-card:hover .vbfbt-card__media img{transform:scale(1.06)}
.vbfbt-card__pill{position:absolute;top:12px;left:12px;background:rgba(255,255,255,.97);color:#4d8c44;font-weight:700;font-size:11px;padding:6px 11px;border-radius:99px;box-shadow:0 6px 14px rgba(0,0,0,.1);white-space:nowrap;z-index:2;backdrop-filter:blur(6px)}
@keyframes vbfbtpulse{0%,100%{transform:rotate(-8deg) scale(1)}50%{transform:rotate(-8deg) scale(1.06)}}
.vbfbt-card__save{position:absolute;top:10px;right:10px;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;min-width:64px;height:64px;background:radial-gradient(circle at 30% 30%,#6fb863 0%,#4d8c44 55%,#2e5d28 100%);color:#fff;font-weight:900;font-size:18px;border-radius:50%;box-shadow:0 10px 26px rgba(77,140,68,.48),inset 0 -3px 8px rgba(0,0,0,.18),inset 0 2px 4px rgba(255,255,255,.35);letter-spacing:-.02em;transform:rotate(-8deg);z-index:3;line-height:1;padding:8px;text-align:center;animation:vbfbtpulse 2.4s ease-in-out infinite;border:3px solid rgba(255,255,255,.55)}
.vbfbt-card__save small{display:block;font-size:9px;font-weight:800;letter-spacing:.1em;opacity:.96;margin-top:1px}
.vbfbt-card__body{padding:18px 18px 20px;display:flex;flex-direction:column;flex:1}
.vbfbt-card__meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12px;font-weight:700;letter-spacing:.04em;margin:0 0 10px;min-height:22px}
.vbfbt-card__brandtag{display:inline-flex;align-items:center;gap:4px;background:color-mix(in srgb,#2e5d28 15%,transparent);color:#2e5d28;padding:4px 10px;border-radius:99px;font-size:11px}
.vbfbt-card__title{font-size:17px;font-weight:800;line-height:1.25;margin:0 0 8px;color:#1a2e1a}
.vbfbt-card__desc{font-size:13px;line-height:1.55;color:#555;margin:0 0 14px;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.vbfbt-card__priceline{display:flex;align-items:baseline;gap:10px;margin:0 0 12px;flex-wrap:wrap}
.vbfbt-card__price{font-size:19px;font-weight:800;color:#1a2e1a}
.vbfbt-card__compare{font-size:13px;color:#a0a0a0;text-decoration:line-through}
.vbfbt-card__add{appearance:none;border:none;background:#4d8c44;color:#fff;padding:10px 16px;border-radius:99px;font-weight:700;font-size:13px;cursor:pointer;font-family:inherit;transition:.2s;display:inline-flex;align-items:center;justify-content:center;gap:6px}
.vbfbt-card__add:hover{background:#2e5d28;transform:translateY(-1px)}
.vbfbt-card__add[disabled]{opacity:.6;cursor:wait}
.vbfbt__skeleton{height:380px;background:linear-gradient(135deg,#eef7ec,#d4ebd0);border-radius:16px;animation:vbfbtpulse2 1.6s ease-in-out infinite}
@keyframes vbfbtpulse2{0%,100%{opacity:.5}50%{opacity:.85}}
@media(max-width:600px){
  .vbfbt-card__body{padding:14px 14px 16px}
  .vbfbt-card__title{font-size:14px}
  .vbfbt-card__desc{font-size:12px;-webkit-line-clamp:2}
  .vbfbt-card__price{font-size:16px}
  .vbfbt-card__brandtag{font-size:10px;padding:3px 8px}
  .vbfbt-card__save{min-width:50px;height:50px;font-size:14px;top:8px;right:8px}
}
</style>

<section class="vbfbt" id="vb-fbt">
  <div class="vbfbt__shell">
    <div class="vbfbt__head">
      <p class="vbfbt__eb">{{ section.settings.eyebrow | default: 'Stack & Save' }}</p>
      <h2 class="vbfbt__h">{{ section.settings.title_pre | default: 'Frequently' }} <em>{{ section.settings.title_highlight | default: 'bought together.' }}</em></h2>
      <p class="vbfbt__sub">{{ section.settings.sub | default: 'Customers building the wellness stack you are also reach for these.' }}</p>
    </div>
    <div class="vbfbt__grid" id="vbfbt-grid">
      {%- comment -%} Server-side fallback: render featured collection products if no JS / first paint {%- endcomment -%}
      {%- assign fallback_coll = collections[section.settings.fallback_collection] | default: collections.all -%}
      {%- for p in fallback_coll.products limit: section.settings.products_to_show -%}
        {%- liquid
          assign sav = 0
          if p.compare_at_price > p.price and p.compare_at_price > 0
            assign diff = p.compare_at_price | minus: p.price
            assign sav = diff | times: 100.0 | divided_by: p.compare_at_price | round
          endif
        -%}
        <a href="{{ p.url }}" class="vbfbt-card" data-handle="{{ p.handle }}">
          <div class="vbfbt-card__media">
            {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" loading="lazy">{%- endif -%}
            {%- if sav > 0 -%}<span class="vbfbt-card__save">−{{ sav }}%<small>SAVE</small></span>{%- endif -%}
          </div>
          <div class="vbfbt-card__body">
            <div class="vbfbt-card__meta"><span class="vbfbt-card__brandtag">{{ p.vendor | default: 'Velobiotics™' }}</span></div>
            <h3 class="vbfbt-card__title">{{ p.title }}</h3>
            <p class="vbfbt-card__desc">{{ p.description | strip_html | truncatewords: 18 }}</p>
            <div class="vbfbt-card__priceline">
              <span class="vbfbt-card__price">{{ p.price | money }}</span>
              {%- if p.compare_at_price > p.price -%}<span class="vbfbt-card__compare">{{ p.compare_at_price | money }}</span>{%- endif -%}
            </div>
            <button type="button" class="vbfbt-card__add" data-fbt-add data-variant="{{ p.selected_or_first_available_variant.id }}">+ Add to cart</button>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function(){
  const grid = document.getElementById('vbfbt-grid');
  if(!grid) return;

  function moneyFmt(cents, currency){
    try { return new Intl.NumberFormat(undefined,{style:'currency',currency:currency||'USD'}).format(cents/100); }
    catch(e){ return '$'+(cents/100).toFixed(2); }
  }

  function renderProducts(products){
    if(!products || !products.length) return;
    const currency = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
    grid.innerHTML = products.slice(0,4).map(function(p){
      const v = (p.variants && p.variants[0]) || {};
      const compare = v.compare_at_price && parseInt(v.compare_at_price)>parseInt(v.price);
      const save = compare ? Math.round(((v.compare_at_price - v.price)/v.compare_at_price)*100) : 0;
      const desc = (p.description||'').replace(/<[^>]+>/g,'').split(' ').slice(0,18).join(' ');
      const img = (p.featured_image||p.images && p.images[0]) || '';
      const imgUrl = typeof img === 'string' ? img : (img && img.src) || '';
      return '<a href="'+(p.url||('/products/'+p.handle))+'" class="vbfbt-card" data-handle="'+p.handle+'">'+
        '<div class="vbfbt-card__media">'+
          (imgUrl?'<img src="'+imgUrl+'" alt="'+(p.title||'').replace(/"/g,'')+'" loading="lazy">':'')+
          (save>0?'<span class="vbfbt-card__save">−'+save+'%<small>SAVE</small></span>':'')+
        '</div>'+
        '<div class="vbfbt-card__body">'+
          '<div class="vbfbt-card__meta"><span class="vbfbt-card__brandtag">'+(p.vendor||'Velobiotics™')+'</span></div>'+
          '<h3 class="vbfbt-card__title">'+p.title+'</h3>'+
          '<p class="vbfbt-card__desc">'+desc+'</p>'+
          '<div class="vbfbt-card__priceline">'+
            '<span class="vbfbt-card__price">'+moneyFmt(v.price, currency)+'</span>'+
            (compare?'<span class="vbfbt-card__compare">'+moneyFmt(v.compare_at_price, currency)+'</span>':'')+
          '</div>'+
          '<button type="button" class="vbfbt-card__add" data-fbt-add data-variant="'+v.id+'">+ Add to cart</button>'+
        '</div>'+
      '</a>';
    }).join('');
  }

  async function loadRecs(){
    /* Determine the cart's first product id to anchor recommendations */
    let anchorId = null;
    try {
      const c = await fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(r=>r.json());
      if(c && c.items && c.items.length){
        anchorId = c.items[0].product_id;
      }
    } catch(e){}
    if(!anchorId){
      /* No cart — keep the server-rendered fallback */
      return;
    }
    try {
      const r = await fetch('/recommendations/products.json?product_id='+anchorId+'&limit=4&intent=complementary',{headers:{'Accept':'application/json'}});
      const d = await r.json();
      if(d && d.products && d.products.length){
        renderProducts(d.products);
        return;
      }
    } catch(e){ console.warn('[VBFBT] recommendations failed', e); }
    /* Fallback to related intent */
    try {
      const r = await fetch('/recommendations/products.json?product_id='+anchorId+'&limit=4&intent=related',{headers:{'Accept':'application/json'}});
      const d = await r.json();
      if(d && d.products && d.products.length) renderProducts(d.products);
    } catch(e){}
  }

  /* Add to cart from FBT card */
  grid.addEventListener('click', async function(e){
    const btn = e.target.closest('[data-fbt-add]');
    if(!btn) return;
    e.preventDefault();
    const id = btn.dataset.variant;
    if(!id) return;
    btn.disabled = true;
    const orig = btn.textContent;
    btn.textContent = 'Adding…';
    try {
      const r = await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,quantity:1})});
      if(r.ok){
        btn.textContent = '✓ Added';
        setTimeout(()=>{ window.location.reload(); }, 400);
      } else {
        btn.textContent = 'Try again';
        btn.disabled = false;
      }
    } catch(err){ btn.textContent = orig; btn.disabled = false; }
  });

  window.VBCartFBT = { refresh: loadRecs };
  loadRecs();
})();
</script>

{% schema %}
{
  "name": "VB Cart FBT",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Stack & Save"},
    {"type":"text","id":"title_pre","label":"Title (pre)","default":"Frequently"},
    {"type":"text","id":"title_highlight","label":"Title (highlighted)","default":"bought together."},
    {"type":"textarea","id":"sub","label":"Sub-headline","default":"Customers building the wellness stack you are also reach for these."},
    {"type":"collection","id":"fallback_collection","label":"Fallback collection","info":"Shown when recommendations aren't available (e.g. for new products)."},
    {"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":8,"step":1,"default":4}
  ],
  "presets":[{"name":"VB Cart FBT"}]
}
{% endschema %}
