<style>
.vbr{--g:#4d8c44;--g2:#2e5d28;--tint:#eef7ec;--tint2:#e3f0df;--ink:#1a2e1a;--mute:#5a6b5a;--line:#e3eadf;--warm:#f6b26b;--red:#b3423a;font-family:Poppins,Arial,sans-serif;color:var(--ink);max-width:920px;margin:0 auto;padding:0 16px 48px}
.vbr *{box-sizing:border-box}
.vbr__bar{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--line);margin-bottom:22px}
.vbr__bar img{height:30px}.vbr__bar .sp{flex:1}
.vbr__btn{display:inline-flex;align-items:center;gap:8px;background:var(--g);color:#fff;text-decoration:none;font-weight:700;padding:11px 18px;border-radius:999px;font-size:14px;border:0;cursor:pointer;font-family:inherit}
.vbr__btn.alt{background:#fff;color:var(--g2);border:1.5px solid var(--g)}
.vbr__btn[disabled]{opacity:.6;cursor:wait}
.vbr__hero{background:var(--g);color:#fff;border-radius:22px;padding:28px;display:grid;grid-template-columns:1.4fr 1fr;gap:22px;position:relative;overflow:hidden}
.vbr__hero:before{content:"";position:absolute;right:-60px;top:-80px;width:280px;height:280px;border-radius:50%;background:rgba(255,255,255,.12)}
.vbr__eyebrow{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#d9ead6}
.vbr__hero h1{font-size:clamp(26px,4vw,38px);line-height:1.1;margin:8px 0 10px;color:#fff;font-weight:800}
.vbr__hero p{color:#d9ead6;margin:0}
.vbr__match{background:#fff;color:var(--ink);border-radius:18px;padding:16px;text-align:center;position:relative}
.vbr__match img{max-height:150px;max-width:100%;object-fit:contain;margin:6px auto 8px;display:block}
.vbr__match .b{font-size:11px;color:var(--g);font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.vbr__match h3{font-size:16px;margin:2px 0 8px;line-height:1.25}
.vbr__pill{display:inline-block;background:var(--tint);color:var(--g2);font-weight:700;font-size:12px;padding:4px 12px;border-radius:999px}
.vbr__chips{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}
.vbr__chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:13px}
.vbr__card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px;margin:16px 0;position:relative}
.vbr__card.note{border-left:5px solid var(--g)}
.vbr__lbl{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--g2);margin:0 0 8px}
.vbr__note p{margin:0 0 12px;line-height:1.65;font-size:15px}
.vbr__sig img{height:52px;display:block;margin:6px 0 2px}
.vbr__sig b{display:block}.vbr__sig span{color:var(--mute);font-size:13px}
.vbr h2{font-size:clamp(20px,3vw,26px);line-height:1.2;margin:28px 0 8px;font-weight:800}
.vbr__lead{font-size:16px;line-height:1.6;color:var(--ink);margin:0 0 14px}
.vbr__stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:14px 0}
.vbr__stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px}
.vbr__stat b{display:block;font-size:26px;color:var(--g);line-height:1.1;margin-bottom:6px}
.vbr__stat span{font-size:13px;color:var(--mute);line-height:1.4}
.vbr__why li{margin:0 0 10px;line-height:1.55}
.vbr__fact{background:var(--tint);border-radius:14px;padding:16px 20px;margin:14px 0}
.vbr__plan{display:grid;gap:12px;margin:14px 0}
.vbr__wk{display:grid;grid-template-columns:44px 1fr;gap:12px;align-items:start}
.vbr__wk .n{width:36px;height:36px;border-radius:50%;border:2px solid var(--g);color:var(--g);font-weight:700;display:flex;align-items:center;justify-content:center;background:#fff}
.vbr__wk:first-child .n{background:var(--g);color:#fff}
.vbr__wk .c{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px 16px}
.vbr__wk .c small{font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--g2);text-transform:uppercase;margin-right:10px}
.vbr__wk .c b{font-size:15px}.vbr__wk .c p{margin:6px 0 0;line-height:1.55;font-size:14px}
.vbr__two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.vbr__tint{background:var(--tint);border-radius:14px;padding:18px}
.vbr__tint li{margin:0 0 10px;line-height:1.5;font-size:14px}.vbr__tint li small{display:block;color:var(--mute)}
.vbr__red{background:#fdf0ee;border:1px solid #f2cfc9;border-radius:14px;padding:14px 18px;margin:14px 0}
.vbr__red .vbr__lbl{color:var(--red)}
.vbr__rec{display:grid;grid-template-columns:130px 1fr;gap:18px;background:#fff;border:1.5px solid var(--line);border-radius:18px;padding:18px;margin:26px 0 0;position:relative}
.vbr__rec.top{border-color:var(--g)}
.vbr__rec .role{position:absolute;top:-11px;left:16px;background:var(--g);color:#fff;font-size:11px;font-weight:700;letter-spacing:.06em;padding:3px 12px;border-radius:999px;text-transform:uppercase}
.vbr__rec.top .role{background:var(--warm);color:var(--ink)}
.vbr__rec .img{background:#fdf9f1;border-radius:12px;display:flex;align-items:center;justify-content:center;padding:8px}
.vbr__rec .img img{max-width:100%;max-height:120px;object-fit:contain}
.vbr__rec .brand{font-size:11px;color:var(--g);font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.vbr__rec h3{margin:2px 0 6px;font-size:17px;line-height:1.25}
.vbr__rec p{margin:0 0 6px;line-height:1.5;font-size:14px}.vbr__rec .ing{font-size:12.5px;color:var(--mute)}
.vbr__fit{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--g2);margin:6px 0}
.vbr__fit i{display:block;height:8px;width:90px;border-radius:4px;background:var(--tint2);overflow:hidden}.vbr__fit i b{display:block;height:100%;background:var(--g)}
.vbr__code{display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:center;background:var(--tint);border:1.5px solid var(--g);border-radius:18px;padding:18px 22px;margin:22px 0}
.vbr__code strong{display:block;font-size:30px;color:var(--g2);letter-spacing:.04em}
.vbr__code p{margin:0;font-size:14px;line-height:1.5}
.vbr__fine{font-size:12px;color:var(--mute);line-height:1.55;margin:18px 0 0}
.vbr__err{background:#fdf0ee;border:1px solid #f2cfc9;border-radius:14px;padding:22px;text-align:center}
.vbr__skel{height:220px;border-radius:18px;background:linear-gradient(90deg,#eef7ec,#f7fbf5,#eef7ec);background-size:200% 100%;animation:vbrsk 1.2s infinite}
@keyframes vbrsk{0%{background-position:0 0}100%{background-position:-200% 0}}
@media(max-width:720px){.vbr__hero,.vbr__two,.vbr__code{grid-template-columns:1fr}.vbr__stats{grid-template-columns:1fr}.vbr__rec{grid-template-columns:96px 1fr}.vbr__bar .vbr__btn span{display:none}}
@media print{.vbr__bar .vbr__btn{display:none}}
</style>
