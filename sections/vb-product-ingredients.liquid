{%- comment -%}
  VB · Product Ingredients — elegant cards + supp facts panel on RHS
  Panel shows either: (1) uploaded image, or (2) auto-built table from ingredient blocks
{%- endcomment -%}

{%- liquid
  assign bp = section.settings.brand_primary | default: '#4d8c44'
  assign bt = section.settings.brand_tint | default: '#f3f7f1'
  assign bd = section.settings.brand_dark | default: '#36632f'
  assign bl = section.settings.brand_light | default: '#a0d099'
  assign has_image = false
  if section.settings.facts_image != blank or section.settings.facts_image_url != blank
    assign has_image = true
  endif
-%}

<style>
  .vb-pin { padding: 50px 20px; max-width: 1280px; margin: 0 auto; --bp: {{ bp }}; --bt: {{ bt }}; --bd: {{ bd }}; --bl: {{ bl }}; }
  .vb-pin__head { text-align: center; margin: 0 0 30px; }
  .vb-pin__eyebrow { display: inline-flex; align-items: center; gap: 6px; background: color-mix(in srgb, var(--bp) 12%, #fff); color: var(--bp); padding: 6px 13px; border-radius: 999px; font-size: 11.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-pin__title { font-size: clamp(24px, 3.2vw, 34px); font-weight: 800; color: #1a1a1a; margin: 0 0 8px; letter-spacing: -0.02em; }
  .vb-pin__sub { font-size: 15px; color: #5c6664; margin: 0; max-width: 580px; margin-left: auto; margin-right: auto; }

  .vb-pin__layout { display: grid; grid-template-columns: 1fr 340px; gap: 36px; align-items: flex-start; }
  .vb-pin__cards-col { min-width: 0; }
  .vb-pin__facts-col { position: sticky; top: 80px; }

  /* Supp facts panel — image OR table */
  .vb-pin__facts { background: #fff; border: 1px solid var(--bp); border-radius: 14px; padding: 0; box-shadow: 0 10px 28px rgba(0,0,0,0.06); overflow: hidden; }
  .vb-pin__facts-label { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; color: #fff; background: var(--bp); padding: 12px 16px; letter-spacing: 0.06em; text-transform: uppercase; }
  .vb-pin__facts-label::before { content: '📋'; font-size: 14px; }
  .vb-pin__facts-img { padding: 12px; }
  .vb-pin__facts-img img { width: 100%; height: auto; border-radius: 8px; display: block; background: #fff; }
  .vb-pin__facts-foot { font-size: 11px; color: #5c6664; padding: 0 16px 14px; text-align: center; font-weight: 600; }

  /* Table mode (no image) */
  .vb-pin__facts-table { width: 100%; border-collapse: collapse; }
  .vb-pin__facts-table th, .vb-pin__facts-table td { padding: 11px 16px; font-size: 13px; text-align: left; }
  .vb-pin__facts-table thead th { background: color-mix(in srgb, var(--bp) 8%, #fff); color: #1a1a1a; font-weight: 800; font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; border-bottom: 2px solid color-mix(in srgb, var(--bp) 20%, transparent); }
  .vb-pin__facts-table thead th:last-child { text-align: right; }
  .vb-pin__facts-table tbody td { border-bottom: 1px solid #f0eaf0; color: #1a1a1a; font-weight: 600; }
  .vb-pin__facts-table tbody td:last-child { text-align: right; color: var(--bp); font-weight: 800; white-space: nowrap; }
  .vb-pin__facts-table tbody tr:last-child td { border-bottom: none; }
  .vb-pin__facts-table tbody tr:hover td { background: color-mix(in srgb, var(--bp) 4%, #fff); }
  .vb-pin__facts-table-cap { font-size: 10.5px; color: #6c7a6b; padding: 10px 16px; background: color-mix(in srgb, var(--bp) 4%, #fff); border-top: 1px dashed #e3ece1; font-style: italic; }

  .vb-pin__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .vb-pin__card { background: linear-gradient(180deg, #fff 0%, var(--bt) 100%); border: 1px solid color-mix(in srgb, var(--bp) 15%, #fff); border-radius: 18px; padding: 18px; display: flex; gap: 12px; align-items: flex-start; transition: transform 0.18s ease, box-shadow 0.18s ease; }
  .vb-pin__card:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(0,0,0,0.08); }
  .vb-pin__icon { width: 48px; height: 48px; border-radius: 14px; background: linear-gradient(135deg, var(--bp), var(--bl)); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; box-shadow: 0 6px 14px color-mix(in srgb, var(--bp) 22%, transparent); }
  .vb-pin__body { flex: 1; min-width: 0; }
  .vb-pin__name-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin: 0 0 6px; }
  .vb-pin__name { font-size: 14.5px; font-weight: 800; color: #1a1a1a; }
  .vb-pin__amount { font-size: 11px; font-weight: 800; color: var(--bp); background: color-mix(in srgb, var(--bp) 10%, #fff); padding: 3px 8px; border-radius: 999px; letter-spacing: 0.02em; }
  .vb-pin__desc { font-size: 12.5px; line-height: 1.45; color: #5c6664; margin: 0; }

  @media (max-width: 990px) { .vb-pin__layout { grid-template-columns: 1fr; gap: 28px; } .vb-pin__facts-col { position: static; max-width: 420px; margin: 0 auto; width: 100%; } }
  @media (max-width: 749px) {
    .vb-pin { padding: 30px 14px; }
    .vb-pin__cards { grid-template-columns: 1fr; gap: 10px; }
    .vb-pin__card { padding: 14px; }
    .vb-pin__icon { width: 40px; height: 40px; font-size: 18px; }
    .vb-pin__name { font-size: 13.5px; }
    .vb-pin__desc { font-size: 12px; }
    .vb-pin__facts-table th, .vb-pin__facts-table td { padding: 10px 14px; font-size: 12px; }
  }
</style>

<section class="vb-pin">
  <div class="vb-pin__head">
    <span class="vb-pin__eyebrow">{{ section.settings.eyebrow | default: "What is inside" }}</span>
    <h2 class="vb-pin__title">{{ section.settings.title | default: "Every ingredient earns its place" }}</h2>
    {%- if section.settings.sub != blank -%}<p class="vb-pin__sub">{{ section.settings.sub }}</p>{%- endif -%}
  </div>
  <div class="vb-pin__layout">
    <div class="vb-pin__cards-col">
      <div class="vb-pin__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == "ingredient" -%}
            <div class="vb-pin__card" {{ block.shopify_attributes }}>
              <div class="vb-pin__icon">{{ block.settings.icon | default: "⚛" }}</div>
              <div class="vb-pin__body">
                <div class="vb-pin__name-row">
                  <span class="vb-pin__name">{{ block.settings.name }}</span>
                  {%- if block.settings.amount != blank -%}<span class="vb-pin__amount">{{ block.settings.amount }}</span>{%- endif -%}
                </div>
                <p class="vb-pin__desc">{{ block.settings.desc }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <aside class="vb-pin__facts-col">
      <div class="vb-pin__facts">
        <span class="vb-pin__facts-label">{{ section.settings.facts_label | default: "Supplement facts" }}</span>
        {%- if has_image -%}
          <div class="vb-pin__facts-img">
            {%- if section.settings.facts_image != blank -%}
              <img src="{{ section.settings.facts_image | image_url: width: 600 }}" alt="Supplement facts panel" loading="lazy" />
            {%- else -%}
              <img src="{{ section.settings.facts_image_url }}" alt="Supplement facts panel" loading="lazy" />
            {%- endif -%}
          </div>
        {%- else -%}
          <table class="vb-pin__facts-table">
            <thead>
              <tr>
                <th>{{ section.settings.facts_col_a | default: "Ingredient" }}</th>
                <th>{{ section.settings.facts_col_b | default: "Per serving" }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for block in section.blocks -%}
                {%- if block.type == "ingredient" -%}
                  {%- assign show_in_table = true -%}
                  {%- if block.settings.amount == blank -%}{%- assign show_in_table = false -%}{%- endif -%}
                  {%- if block.settings.amount == 'Always' -%}{%- assign show_in_table = false -%}{%- endif -%}
                  {%- if show_in_table -%}
                    <tr>
                      <td>{{ block.settings.name }}</td>
                      <td>{{ block.settings.amount }}</td>
                    </tr>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
          {%- if section.settings.facts_caption != blank -%}<div class="vb-pin__facts-table-cap">{{ section.settings.facts_caption }}</div>{%- endif -%}
        {%- endif -%}
        {%- if section.settings.facts_foot != blank -%}<p class="vb-pin__facts-foot">{{ section.settings.facts_foot }}</p>{%- endif -%}
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "VB · Ingredients",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "brand_primary", "label": "Brand primary", "default": "#4d8c44" },
    { "type": "color", "id": "brand_dark", "label": "Brand dark", "default": "#36632f" },
    { "type": "color", "id": "brand_tint", "label": "Brand tint", "default": "#f3f7f1" },
    { "type": "color", "id": "brand_light", "label": "Brand light", "default": "#a0d099" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What is inside" },
    { "type": "text", "id": "title", "label": "Title", "default": "Every ingredient earns its place" },
    { "type": "textarea", "id": "sub", "label": "Subtitle" },
    { "type": "header", "content": "Supplement facts panel (RHS)" },
    { "type": "paragraph", "content": "If a supplement-facts IMAGE is set, the panel shows the image. Otherwise it auto-builds a clean TABLE from the ingredient blocks (Name | Amount)." },
    { "type": "image_picker", "id": "facts_image", "label": "Supplement facts image (optional)" },
    { "type": "url", "id": "facts_image_url", "label": "Supplement facts image URL (optional fallback)" },
    { "type": "text", "id": "facts_label", "label": "Panel header", "default": "Supplement facts" },
    { "type": "text", "id": "facts_col_a", "label": "Table column 1 label", "default": "Ingredient" },
    { "type": "text", "id": "facts_col_b", "label": "Table column 2 label", "default": "Per serving" },
    { "type": "textarea", "id": "facts_caption", "label": "Table caption (small print below)", "default": "% Daily Value not established. Other Ingredients: HPMC, Magnesium Stearate." },
    { "type": "text", "id": "facts_foot", "label": "Panel footnote", "default": "Lab-tested · Doctor-formulated · Full transparency" }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingredient", "limit": 12, "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🌿" },
      { "type": "text", "id": "name", "label": "Name", "default": "Ingredient" },
      { "type": "text", "id": "amount", "label": "Amount (also used in supplement facts table)", "default": "5B CFU" },
      { "type": "textarea", "id": "desc", "label": "Description", "default": "Why this ingredient matters." }
    ]}
  ],
  "presets": [{ "name": "VB · Ingredients" }]
}
{% endschema %}
