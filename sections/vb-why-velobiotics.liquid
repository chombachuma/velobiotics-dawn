{%- comment -%}
  VB · Why Choose Velobiotics — 4 reason cards
{%- endcomment -%}

<style>
  .vb-why { padding: 72px 24px; background: #fff; }
  .vb-why__inner { max-width: 1280px; margin: 0 auto; }
  .vb-why__head { text-align: center; max-width: 760px; margin: 0 auto 48px; }
  .vb-why__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-why__title { font-size: clamp(28px, 4.2vw, 44px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; letter-spacing: -0.01em; }
  .vb-why__title em { font-style: normal; color: #4d8c44; }
  .vb-why__sub { font-size: 16.5px; line-height: 1.6; color: #5c6664; margin: 0; }
  .vb-why__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 22px; }
  .vb-why__card { position: relative; padding: 32px 24px 28px; background: linear-gradient(180deg, #fafdf9 0%, #f0f7ee 100%); border-radius: 22px; border: 1px solid #e3ece1; transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease; overflow: hidden; }
  .vb-why__card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #4d8c44, #6ec56e); border-radius: 22px 22px 0 0; transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease; }
  .vb-why__card:hover { transform: translateY(-6px); box-shadow: 0 22px 44px rgba(77, 140, 68, 0.18); border-color: rgba(77, 140, 68, 0.35); }
  .vb-why__card:hover::after { transform: scaleX(1); }
  .vb-why__num { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: #4d8c44; color: #fff; font-weight: 800; font-size: 14px; margin: 0 0 18px; box-shadow: 0 8px 18px rgba(77, 140, 68, 0.34); }
  .vb-why__icon { width: 64px; height: 64px; border-radius: 18px; background: rgba(77, 140, 68, 0.12); color: #4d8c44; display: inline-flex; align-items: center; justify-content: center; font-size: 30px; margin: 0 0 16px; }
  .vb-why__name { font-size: 18px; font-weight: 800; color: #1a1a1a; margin: 0 0 8px; line-height: 1.3; }
  .vb-why__desc { font-size: 14.5px; line-height: 1.55; color: #5c6664; margin: 0; }
  @media (max-width: 749px) {
    .vb-why { padding: 48px 16px; }
    .vb-why__head { margin-bottom: 32px; }
    .vb-why__grid { grid-template-columns: 1fr; gap: 14px; }
    .vb-why__card { padding: 24px 20px; border-radius: 18px; }
    .vb-why__name { font-size: 16px; }
    .vb-why__desc { font-size: 13.5px; }
  }
</style>

<section class="vb-why">
  <div class="vb-why__inner">
    <div class="vb-why__head">
      {%- if section.settings.eyebrow != blank -%}<p class="vb-why__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vb-why__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
      {%- if section.settings.sub != blank -%}<p class="vb-why__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <div class="vb-why__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'reason' -%}
          <article class="vb-why__card" {{ block.shopify_attributes }}>
            {%- if section.settings.show_numbers -%}<span class="vb-why__num">{{ forloop.index }}</span>{%- endif -%}
            <span class="vb-why__icon">{{ block.settings.icon }}</span>
            <h3 class="vb-why__name">{{ block.settings.name }}</h3>
            <p class="vb-why__desc">{{ block.settings.desc }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Why Velobiotics",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Choose Velobiotics" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "99% of Probiotics Never Make It to Your Gut." },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "We Fixed That." },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Traditional probiotics break down in stomach acid before they can do any good. Velobiotics uses patented Microencapsulation with Supercritical CO₂ to shield every culture — so 1000× more reach your gut, where they actually work." },
    { "type": "checkbox", "id": "show_numbers", "label": "Show step numbers", "default": false }
  ],
  "blocks": [
    { "type": "reason", "name": "Reason", "settings": [
      { "type": "text", "id": "icon", "label": "Icon / emoji", "default": "🛡️" },
      { "type": "text", "id": "name", "label": "Name", "default": "Patented MEP Technology" },
      { "type": "textarea", "id": "desc", "label": "Description", "default": "Micro-shield delivery means 1000× more probiotics survive stomach acid alive." }
    ]}
  ],
  "presets": [
    { "name": "VB · Why Velobiotics", "blocks": [
      { "type": "reason", "settings": { "icon": "🛡️", "name": "Survives Stomach Acid", "desc": "Patented MEP coating shields every culture from gastric acid and bile so they reach your gut alive." } },
      { "type": "reason", "settings": { "icon": "🎯", "name": "1000× More Delivered", "desc": "Where 99% of standard probiotics die, ours arrive — by the billions — exactly where you need them." } },
      { "type": "reason", "settings": { "icon": "🩺", "name": "Doctor-Formulated", "desc": "Built by medical doctors and microbiologists using clinically studied strains — not marketing-grade." } },
      { "type": "reason", "settings": { "icon": "🌿", "name": "Real Results, You Can Feel", "desc": "Backed by 3,500+ verified reviews and a 30-day money-back guarantee. No noise, just outcomes." } }
    ]}
  ]
}
{% endschema %}
