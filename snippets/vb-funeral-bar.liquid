<style>
.vb-fbar{background:#050705;border-bottom:2px solid #8cff5a}
.vb-fbar a{display:none;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap;padding:11px 16px;text-decoration:none;color:#f3f1ea;font:400 15px/1.4 Georgia,serif;text-align:center}
