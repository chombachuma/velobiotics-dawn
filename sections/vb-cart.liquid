{%- comment -%} VB Cart — Velobiotics-branded cart page {%- endcomment -%}
<style>
.vbc{--g:#4d8c44;--g2:#2e5d28;--cream:#fdf9f1;--ink:#1a2e1a;--mute:#5a6b5a;--border:#e8efe6;--tint:#eef7ec;--tint2:#d4ebd0;font-family:'Open Sans',system-ui,sans-serif;background:linear-gradient(180deg,#fdf9f1 0%,#fff 60%);color:var(--ink);padding:40px 20px 80px;min-height:60vh}
.vbc__shell{max-width:1280px;margin:0 auto}
.vbc__crumbs{font-size:13px;color:var(--mute);margin-bottom:18px}
.vbc__crumbs a{color:var(--mute);text-decoration:none}.vbc__crumbs a:hover{color:var(--g)}
.vbc__head{text-align:center;max-width:680px;margin:0 auto 40px}
.vbc__eb{display:inline-block;background:var(--tint);color:var(--g2);padding:6px 14px;border-radius:99px;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:16px}
.vbc__h{font-family:'Playfair Display',Georgia,serif;font-size:clamp(32px,5vw,52px);font-weight:700;line-height:1.05;letter-spacing:-.02em;margin:0 0 12px}
.vbc__h em{color:var(--g);font-style:italic}
.vbc__sub{color:var(--mute);font-size:16px;line-height:1.55;margin:0}
.vbc__layout{display:grid;grid-template-columns:1.7fr 1fr;gap:32px;align-items:flex-start}
@media(max-width:900px){.vbc__layout{grid-template-columns:1fr;gap:20px}}
.vbc__items{background:#fff;border:1px solid var(--border);border-radius:20px;padding:8px;box-shadow:0 8px 32px rgba(0,0,0,.04)}
.vbc__items-head{display:flex;align-items:center;justify-content:space-between;padding:14px 20px 8px;border-bottom:1px solid var(--border)}
.vbc__items-head h2{font-family:'Playfair Display',Georgia,serif;font-size:22px;font-weight:700;margin:0;color:var(--ink)}
.vbc__count{background:var(--tint);color:var(--g2);padding:4px 12px;border-radius:99px;font-size:13px;font-weight:700}
.vbc__line{display:grid;grid-template-columns:120px 1fr auto;gap:20px;padding:24px 16px;border-bottom:1px solid var(--border);align-items:center;animation:vbcfade .4s ease}
.vbc__line:last-child{border-bottom:none}
@media(max-width:600px){.vbc__line{grid-template-columns:90px 1fr;gap:14px;padding:18px 12px}.vbc__line-price-wrap{grid-column:1/-1;margin-top:8px}}
@keyframes vbcfade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.vbc__line-img{width:120px;height:120px;background:linear-gradient(135deg,var(--tint),var(--tint2));border-radius:14px;overflow:hidden;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.vbc__line-img img{width:100%;height:100%;object-fit:contain;padding:8px;mix-blend-mode:multiply}
@media(max-width:600px){.vbc__line-img{width:90px;height:90px}}
.vbc__line-body{min-width:0}
.vbc__line-brand{font-size:11px;font-weight:700;color:var(--g);text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px;display:inline-flex;align-items:center;gap:6px;background:color-mix(in srgb,var(--g) 12%,transparent);padding:3px 8px;border-radius:99px}
.vbc__line-title{font-size:17px;font-weight:700;line-height:1.3;margin:6px 0 4px;color:var(--ink)}
.vbc__line-title a{color:inherit;text-decoration:none}
.vbc__line-title a:hover{color:var(--g)}
.vbc__line-variant{font-size:13px;color:var(--mute);margin:0 0 12px}
.vbc__line-props{font-size:12px;color:var(--mute);margin:0 0 12px}
.vbc__line-props small{display:block}
.vbc__line-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.vbc__qty{display:inline-flex;align-items:center;border:1.5px solid var(--border);border-radius:99px;overflow:hidden;background:#fff}
.vbc__qty button{appearance:none;border:none;background:transparent;cursor:pointer;width:36px;height:36px;font-size:18px;font-weight:700;color:var(--ink);transition:.2s;display:flex;align-items:center;justify-content:center}
.vbc__qty button:hover{background:var(--tint);color:var(--g)}
.vbc__qty button:disabled{opacity:.3;cursor:not-allowed}
.vbc__qty input{width:44px;height:36px;border:none;background:transparent;text-align:center;font-weight:700;color:var(--ink);font-size:15px;font-family:inherit;outline:none}
.vbc__line-remove{appearance:none;border:none;background:none;cursor:pointer;color:var(--mute);font-size:13px;text-decoration:underline;font-weight:600;padding:6px 0;font-family:inherit}
.vbc__line-remove:hover{color:#c8163c}
.vbc__line-price-wrap{text-align:right;min-width:100px}
.vbc__line-price{font-family:'Playfair Display',Georgia,serif;font-size:22px;font-weight:700;color:var(--ink);line-height:1;margin:0 0 4px}
.vbc__line-each{font-size:12px;color:var(--mute)}
.vbc__line-compare{display:block;font-size:13px;color:#a0a0a0;text-decoration:line-through;margin-top:2px}

/* Order Summary */
.vbc__summary{background:#fff;border:1px solid var(--border);border-radius:20px;padding:28px;position:sticky;top:24px;box-shadow:0 8px 32px rgba(0,0,0,.04)}
@media(max-width:900px){.vbc__summary{position:static}}
.vbc__summary h2{font-family:'Playfair Display',Georgia,serif;font-size:24px;font-weight:700;margin:0 0 20px;color:var(--ink)}
.vbc__row{display:flex;justify-content:space-between;align-items:baseline;padding:8px 0;font-size:15px;color:var(--ink)}
.vbc__row strong{font-weight:700}
.vbc__divider{height:1px;background:var(--border);margin:14px 0}
.vbc__total{display:flex;justify-content:space-between;align-items:baseline;padding:14px 0;font-size:17px}
.vbc__total-amt{font-family:'Playfair Display',Georgia,serif;font-size:34px;font-weight:700;color:var(--g);letter-spacing:-.01em}
.vbc__shipnote{background:var(--tint);border:1px solid var(--tint2);border-radius:12px;padding:14px 16px;margin:16px 0;font-size:13px;color:var(--g2);line-height:1.45;display:flex;gap:10px;align-items:flex-start}
.vbc__shipnote .vbc__ship-icon{font-size:18px;flex-shrink:0}
.vbc__shipnote strong{color:var(--g2)}
.vbc__progress{height:8px;background:#fff;border-radius:99px;overflow:hidden;margin-top:10px;border:1px solid var(--tint2)}
.vbc__progress-fill{height:100%;background:linear-gradient(90deg,var(--g),var(--g2));border-radius:99px;transition:width .6s ease}
.vbc__checkout{display:block;width:100%;background:var(--g);color:#fff;text-align:center;padding:18px 24px;border-radius:99px;font-weight:700;font-size:17px;text-decoration:none;border:none;cursor:pointer;font-family:inherit;transition:.25s;box-shadow:0 8px 24px rgba(77,140,68,.3);margin-top:8px}
.vbc__checkout:hover{background:var(--g2);transform:translateY(-2px);box-shadow:0 12px 32px rgba(77,140,68,.4);color:#fff}
.vbc__checkout::after{content:' →';display:inline-block;transition:transform .2s}
.vbc__checkout:hover::after{transform:translateX(4px)}
.vbc__continue{display:block;text-align:center;color:var(--mute);font-size:14px;text-decoration:none;margin-top:14px;font-weight:600}
.vbc__continue:hover{color:var(--g)}
.vbc__payments{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:18px;opacity:.6}
.vbc__payments span{background:#f6f6f4;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:700;color:var(--mute);letter-spacing:.04em}
.vbc__trust{margin-top:20px;padding-top:20px;border-top:1px solid var(--border)}
.vbc__trust-row{display:flex;gap:12px;padding:8px 0;align-items:flex-start;font-size:13px;color:var(--mute);line-height:1.5}
.vbc__trust-row strong{color:var(--ink);font-weight:700}
.vbc__trust-icon{font-size:18px;flex-shrink:0;width:24px;text-align:center}

/* Empty state */
.vbc__empty{text-align:center;padding:80px 20px;max-width:480px;margin:0 auto}
.vbc__empty-icon{font-size:80px;margin-bottom:16px;opacity:.6}
.vbc__empty h3{font-family:'Playfair Display',Georgia,serif;font-size:32px;font-weight:700;margin:0 0 12px;color:var(--ink)}
.vbc__empty p{color:var(--mute);font-size:16px;line-height:1.55;margin:0 0 24px}
.vbc__empty a{display:inline-flex;align-items:center;gap:8px;background:var(--g);color:#fff;padding:16px 32px;border-radius:99px;font-weight:700;text-decoration:none;transition:.2s}
.vbc__empty a:hover{background:var(--g2);transform:translateY(-2px);color:#fff}
.vbc__empty-cta-secondary{display:inline-block;color:var(--g);text-decoration:underline;margin-top:16px;font-weight:600;font-size:14px}

/* Note input */
.vbc__note{margin-top:16px}
.vbc__note details{border:1px solid var(--border);border-radius:12px;padding:14px 16px}
.vbc__note summary{cursor:pointer;font-size:13px;color:var(--mute);font-weight:600;list-style:none;outline:none}
.vbc__note summary::-webkit-details-marker{display:none}
.vbc__note summary::before{content:'+ ';color:var(--g);font-weight:700}
.vbc__note[open] summary::before{content:'− '}
.vbc__note textarea{width:100%;border:1px solid var(--border);border-radius:8px;padding:10px;font-family:inherit;font-size:14px;margin-top:10px;resize:vertical;min-height:60px;box-sizing:border-box}
.vbc__note textarea:focus{outline:none;border-color:var(--g)}

.vbc__loading{position:absolute;inset:0;background:rgba(255,255,255,.75);display:flex;align-items:center;justify-content:center;border-radius:20px;z-index:5;opacity:0;pointer-events:none;transition:.2s}
.vbc__loading.is-on{opacity:1;pointer-events:auto}
.vbc__spinner{width:36px;height:36px;border:4px solid var(--tint);border-top-color:var(--g);border-radius:50%;animation:vbcspin 1s linear infinite}
@keyframes vbcspin{to{transform:rotate(360deg)}}
.vbc__items-wrap{position:relative}
</style>

<div class="vbc" id="vb-cart" data-cart-currency="{{ cart.currency.iso_code }}">
  <div class="vbc__shell">
    <nav class="vbc__crumbs"><a href="/">Home</a> / <a href="/collections/all">Shop</a> / <span>Cart</span></nav>

    <header class="vbc__head">
      <div class="vbc__eb">{{ section.settings.eyebrow | default: 'Your Wellness Stack' }}</div>
      <h1 class="vbc__h">{{ section.settings.title_pre | default: 'Almost' }} <em>{{ section.settings.title_highlight | default: 'there.' }}</em></h1>
      <p class="vbc__sub">{{ section.settings.sub | default: 'Review your stack. Free shipping kicks in soon — and a 30-day money-back guarantee covers everything.' }}</p>
    </header>

    {%- if cart.item_count > 0 -%}
      <div class="vbc__layout">
        {%- comment -%} ============ CART ITEMS ============ {%- endcomment -%}
        <form action="{{ routes.cart_url }}" method="post" id="vbc-form" novalidate>
          <div class="vbc__items">
            <div class="vbc__items-head">
              <h2>Your items</h2>
              <span class="vbc__count" id="vbc-count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
            </div>
            <div class="vbc__items-wrap">
              <div class="vbc__loading" id="vbc-loading"><div class="vbc__spinner"></div></div>
              <div id="vbc-lines">
                {%- for item in cart.items -%}
                  <div class="vbc__line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
                    <a href="{{ item.url }}" class="vbc__line-img">
                      {%- if item.image -%}<img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.product.title | escape }}" loading="lazy">{%- endif -%}
                    </a>
                    <div class="vbc__line-body">
                      <span class="vbc__line-brand">{{ item.product.vendor | default: 'Velobiotics™' }}</span>
                      <h3 class="vbc__line-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                      {%- unless item.product.has_only_default_variant -%}
                        <p class="vbc__line-variant">{{ item.variant.title }}</p>
                      {%- endunless -%}
                      {%- if item.properties.size > 0 -%}
                        <p class="vbc__line-props">
                          {%- for p in item.properties -%}
                            {%- unless p.last == blank -%}<small><strong>{{ p.first }}:</strong> {{ p.last }}</small>{%- endunless -%}
                          {%- endfor -%}
                        </p>
                      {%- endif -%}
                      <div class="vbc__line-actions">
                        <div class="vbc__qty">
                          <button type="button" data-vbc-qty="dec" data-line="{{ forloop.index }}" aria-label="Decrease">−</button>
                          <input type="number" name="updates[]" min="0" value="{{ item.quantity }}" data-vbc-qty-input data-line="{{ forloop.index }}" aria-label="Quantity">
                          <button type="button" data-vbc-qty="inc" data-line="{{ forloop.index }}" aria-label="Increase">+</button>
                        </div>
                        <button type="button" class="vbc__line-remove" data-vbc-remove data-line="{{ forloop.index }}">Remove</button>
                      </div>
                    </div>
                    <div class="vbc__line-price-wrap">
                      <p class="vbc__line-price">{{ item.final_line_price | money }}</p>
                      {%- if item.quantity > 1 -%}<span class="vbc__line-each">{{ item.final_price | money }} each</span>{%- endif -%}
                      {%- if item.original_line_price > item.final_line_price -%}
                        <span class="vbc__line-compare">{{ item.original_line_price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>

          <div class="vbc__note">
            <details>
              <summary>Add a gift note or special instructions</summary>
              <textarea name="note" placeholder="e.g. Please leave at front door if no answer.">{{ cart.note }}</textarea>
            </details>
          </div>
        </form>

        {%- comment -%} ============ ORDER SUMMARY ============ {%- endcomment -%}
        <aside class="vbc__summary">
          <h2>Order summary</h2>
          <div class="vbc__row"><span>Subtotal</span><strong id="vbc-subtotal">{{ cart.items_subtotal_price | money }}</strong></div>
          {%- if cart.total_discount > 0 -%}
            <div class="vbc__row" style="color:var(--g)"><span>Discount</span><strong>−{{ cart.total_discount | money }}</strong></div>
          {%- endif -%}
          <div class="vbc__row"><span>Shipping</span><strong>Calculated at checkout</strong></div>
          <div class="vbc__divider"></div>
          <div class="vbc__total"><strong>Total</strong><span class="vbc__total-amt" id="vbc-total">{{ cart.total_price | money }}</span></div>

          {%- assign ship_threshold = section.settings.free_ship_threshold | default: 50000 -%}
          {%- if cart.total_price < ship_threshold -%}
            {%- assign remaining = ship_threshold | minus: cart.total_price -%}
            <div class="vbc__shipnote">
              <span class="vbc__ship-icon">🚚</span>
              <div>You're <strong>{{ remaining | money }}</strong> away from <strong>free shipping</strong>!
                <div class="vbc__progress"><div class="vbc__progress-fill" style="width:{{ cart.total_price | times: 100 | divided_by: ship_threshold }}%"></div></div>
              </div>
            </div>
          {%- else -%}
            <div class="vbc__shipnote"><span class="vbc__ship-icon">✓</span><div>You've unlocked <strong>FREE shipping</strong>.</div></div>
          {%- endif -%}

          <button type="submit" name="checkout" form="vbc-form" class="vbc__checkout">Checkout securely</button>
          <a href="/collections/all" class="vbc__continue">← Continue shopping</a>

          <div class="vbc__payments">
            <span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>PAYPAL</span><span>APPLE PAY</span>
          </div>

          <div class="vbc__trust">
            <div class="vbc__trust-row"><span class="vbc__trust-icon">💚</span><div><strong>30-day money-back.</strong> Don't love it? Full refund, no questions asked.</div></div>
            <div class="vbc__trust-row"><span class="vbc__trust-icon">🌍</span><div><strong>Ships worldwide.</strong> US, EU, UK, AU, SA — tracked, 5-14 working days.</div></div>
            <div class="vbc__trust-row"><span class="vbc__trust-icon">🔒</span><div><strong>Secure checkout.</strong> 256-bit SSL. We never store card details.</div></div>
            <div class="vbc__trust-row"><span class="vbc__trust-icon">🩺</span><div><strong>Doctor-formulated.</strong> Every Velobiotics product is built on the patented MEP technology.</div></div>
          </div>
        </aside>
      </div>
    {%- else -%}
      <div class="vbc__empty">
        <div class="vbc__empty-icon">🛒</div>
        <h3>Your cart is <em style="color:var(--g);font-style:italic">empty</em>.</h3>
        <p>Take our 60-second BioMatch quiz to find your perfect probiotic — or browse the full range below.</p>
        <a href="/pages/quiz">🎯 Take the BioMatch</a>
        <div><a class="vbc__empty-cta-secondary" href="/collections/all">Browse all products</a></div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
(function(){
  const root = document.getElementById('vb-cart');
  if(!root) return;
  const $ = s => root.querySelector(s);
  const $$ = s => Array.from(root.querySelectorAll(s));
  const loading = $('#vbc-loading');
  function showLoad(on){ if(loading) loading.classList.toggle('is-on', !!on); }
  function fmt(cents){
    const cur = root.dataset.cartCurrency || 'USD';
    try { return new Intl.NumberFormat(undefined, {style:'currency', currency:cur}).format(cents/100); }
    catch(e){ return '$'+(cents/100).toFixed(2); }
  }
  async function changeLine(line, qty){
    showLoad(true);
    try {
      const r = await fetch('/cart/change.js', {
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify({line: parseInt(line,10), quantity: parseInt(qty,10)})
      });
      const data = await r.json();
      if(data.item_count === 0){ window.location.reload(); return; }
      /* Update counts */
      const cnt = $('#vbc-count'); if(cnt) cnt.textContent = data.item_count + (data.item_count===1?' item':' items');
      const sub = $('#vbc-subtotal'); if(sub) sub.textContent = fmt(data.items_subtotal_price);
      const tot = $('#vbc-total'); if(tot) tot.textContent = fmt(data.total_price);
      /* Re-fetch full cart HTML to update line prices (simpler than calculating each line) */
      const item = data.items[parseInt(line,10)-1];
      if(item){
        const lineEl = root.querySelector('[data-line="'+line+'"]');
        if(lineEl){
          const priceEl = lineEl.querySelector('.vbc__line-price');
          if(priceEl) priceEl.textContent = fmt(item.final_line_price);
          const input = lineEl.querySelector('[data-vbc-qty-input]');
          if(input) input.value = item.quantity;
        }
      } else {
        /* item removed — remove the line element */
        const lineEl = root.querySelector('[data-line="'+line+'"]');
        if(lineEl) lineEl.remove();
        /* Re-index remaining lines */
        $$('.vbc__line').forEach((el,i)=>{
          const newIdx = i+1;
          el.dataset.line = newIdx;
          el.querySelectorAll('[data-line]').forEach(c=>c.dataset.line=newIdx);
        });
      }
      /* Update free-shipping progress bar */
      const threshold = {{ section.settings.free_ship_threshold | default: 50000 }};
      const remaining = threshold - data.total_price;
      if(remaining > 0){
        const pct = Math.min(100, (data.total_price/threshold)*100);
        const fill = root.querySelector('.vbc__progress-fill');
        if(fill) fill.style.width = pct + '%';
      }
      /* Refresh FBT */
      if(window.VBCartFBT && window.VBCartFBT.refresh) window.VBCartFBT.refresh();
    } catch(e){ console.warn('[VBC] change failed', e); window.location.reload(); }
    showLoad(false);
  }
  root.addEventListener('click', e=>{
    const dec = e.target.closest('[data-vbc-qty="dec"]');
    const inc = e.target.closest('[data-vbc-qty="inc"]');
    const rm = e.target.closest('[data-vbc-remove]');
    if(dec || inc){
      const btn = dec || inc;
      const line = btn.dataset.line;
      const input = root.querySelector('[data-vbc-qty-input][data-line="'+line+'"]');
      if(!input) return;
      const cur = parseInt(input.value,10)||0;
      const newQ = dec ? Math.max(0, cur-1) : cur+1;
      changeLine(line, newQ);
    }
    if(rm){ changeLine(rm.dataset.line, 0); }
  });
  /* Debounced direct input change */
  let inputTimer;
  root.addEventListener('change', e=>{
    const inp = e.target.closest('[data-vbc-qty-input]');
    if(!inp) return;
    clearTimeout(inputTimer);
    inputTimer = setTimeout(()=>changeLine(inp.dataset.line, inp.value), 100);
  });
  /* Save note on blur */
  const noteField = root.querySelector('textarea[name="note"]');
  if(noteField){
    noteField.addEventListener('blur', ()=>{
      fetch('/cart/update.js', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({note: noteField.value})});
    });
  }
})();
</script>

{% schema %}
{
  "name": "VB Cart",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Your Wellness Stack"},
    {"type":"text","id":"title_pre","label":"Title (pre)","default":"Almost"},
    {"type":"text","id":"title_highlight","label":"Title (highlighted)","default":"there."},
    {"type":"textarea","id":"sub","label":"Sub-headline","default":"Review your stack. Free shipping kicks in soon — and a 30-day money-back guarantee covers everything."},
    {"type":"number","id":"free_ship_threshold","label":"Free-shipping threshold (in cents/lowest unit)","default":50000,"info":"50000 = $500 ZAR cents (R 500) or $50 USD. Adjust per currency."}
  ],
  "presets":[{"name":"VB Cart"}]
}
{% endschema %}
