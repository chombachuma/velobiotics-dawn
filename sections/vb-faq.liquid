{%- comment -%} VB · FAQ — accordion {%- endcomment -%}

<style>
  .vb-faq { padding: 72px 24px; max-width: 880px; margin: 0 auto; }
  .vb-faq__head { text-align: center; max-width: 720px; margin: 0 auto 40px; }
  .vb-faq__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-faq__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; }
  .vb-faq__title em { color: #4d8c44; font-style: normal; }
  .vb-faq__list { display: flex; flex-direction: column; gap: 12px; }
  .vb-faq__item { background: #fff; border: 1px solid #e3ece1; border-radius: 16px; overflow: hidden; transition: border-color 0.18s ease, box-shadow 0.18s ease; }
  .vb-faq__item[open] { border-color: rgba(77,140,68,0.4); box-shadow: 0 16px 32px rgba(77,140,68,0.08); }
  .vb-faq__q { display: flex; align-items: center; justify-content: space-between; padding: 20px 22px; cursor: pointer; font-weight: 700; font-size: 15.5px; color: #1a1a1a; list-style: none; user-select: none; gap: 18px; }
  .vb-faq__q::-webkit-details-marker { display: none; }
  .vb-faq__plus { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(77,140,68,0.12); color: #4d8c44; font-weight: 900; font-size: 18px; line-height: 1; flex-shrink: 0; transition: transform 0.3s ease, background-color 0.18s ease; }
  .vb-faq__item[open] .vb-faq__plus { transform: rotate(45deg); background: #4d8c44; color: #fff; }
  .vb-faq__a { padding: 0 22px 22px; font-size: 14.5px; line-height: 1.65; color: #5c6664; }
  .vb-faq__a p { margin: 0 0 10px; }
  .vb-faq__a p:last-child { margin: 0; }
  @media (max-width: 749px) {
    .vb-faq { padding: 48px 14px; }
    .vb-faq__head { margin-bottom: 28px; }
    .vb-faq__q { padding: 16px 18px; font-size: 14px; gap: 12px; }
    .vb-faq__plus { width: 28px; height: 28px; font-size: 16px; }
    .vb-faq__a { padding: 0 18px 18px; font-size: 13.5px; }
  }
</style>

<section class="vb-faq">
  <div class="vb-faq__head">
    {%- if section.settings.eyebrow != blank -%}<p class="vb-faq__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="vb-faq__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
  </div>
  <div class="vb-faq__list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'q' -%}
        <details class="vb-faq__item" {{ block.shopify_attributes }}>
          <summary class="vb-faq__q">
            <span>{{ block.settings.question }}</span>
            <span class="vb-faq__plus">+</span>
          </summary>
          <div class="vb-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "VB · FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "Questions People Ask" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Before They Buy" }
  ],
  "blocks": [
    { "type": "q", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "What makes Velobiotics different?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Our patented MEP Technology shields every probiotic so 1000× more reach your gut alive.</p>" }
    ]}
  ],
  "presets": [
    { "name": "VB · FAQ", "blocks": [
      { "type": "q", "settings": { "question": "What makes Velobiotics different from other probiotics?", "answer": "<p>Velobiotics uses patented MEP Technology — Microencapsulation with Supercritical CO₂ — to shield every live probiotic strain so 1000× more survive stomach acid and reach the gut alive. Most probiotics break down before they help.</p>" } },
      { "type": "q", "settings": { "question": "Are these safe to take daily?", "answer": "<p>Yes. All Velobiotics products are manufactured under GMP conditions in SAHPRA-aware facilities and classified as food supplements. Daily use is safe and recommended for sustained gut wellness.</p>" } },
      { "type": "q", "settings": { "question": "How fast will I see results?", "answer": "<p>Most customers report feeling a difference within 7–14 days — improved digestion, less bloating, more energy. Full microbiome rebalancing takes 4–6 weeks of consistent use.</p>" } },
      { "type": "q", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes. We ship globally with delivery times of 5–14 working days depending on location. South Africa orders ship within 2–5 working days; international 7–14.</p>" } },
      { "type": "q", "settings": { "question": "What if it doesn't work for me?", "answer": "<p>If you don't feel the difference in 30 days, we'll refund you in full — no questions asked. Our 30-day money-back guarantee covers your entire first order.</p>" } },
      { "type": "q", "settings": { "question": "Are these doctor-approved?", "answer": "<p>Every Velobiotics formula is developed by medical doctors and microbiologists, using clinically-studied probiotic strains. Each batch is independently lab-tested before shipping.</p>" } }
    ]}
  ]
}
{% endschema %}
