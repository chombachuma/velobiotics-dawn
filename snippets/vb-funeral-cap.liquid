{%- comment -%} Funeral BF 2026: Survivor Offer limit of 5 offer products per order, 25 Nov 06:00 to 30 Nov 23:59 SAST.
  Sets vb_cap_units (offer units in cart) and vb_cap_over. Usage: {% render 'vb-funeral-cap', mode: 'notice' %} prints the notice when over the limit;
  mode 'script' prints the storefront guard. Remove after 30 Nov 2026. {%- endcomment -%}
{%- liquid
  assign vb_now = 'now' | date: '%s' | plus: 0
  assign vb_cap_on = false
  if vb_now >= 1 and vb_now < 1796075999
    assign vb_cap_on = true
  endif
  assign vb_cap_ids = '8259512041643,8259512205483,8259512238251,8259512271019,8259512533163,8259512598699,8259512893611,8259512959147,8259512991915,8259513057451,8259513221291,8259513254059,8414576279723,8414583193771,8414583488683,8414583816363,8414584209579,8415347900587,8415349735595,8415352324267,8415353405611,8487176569003,8487181451435,8487184892075,8488400945323,8488412577963,8488417263787,8491260215467,8491262705835,8491265589419,8491267424427,8491272044715,8491273289899,8491277385899,8491278991531,8491284594859,8491292295339,8491296555179,8491297702059,8491346559147,8491348852907,8491355701419,8513389035691,8546280374443' | split: ','
  assign vb_cap_units = 0
  for item in cart.items
    assign pid = item.product_id | append: ''
    if vb_cap_ids contains pid
      assign vb_cap_units = vb_cap_units | plus: item.quantity
    endif
  endfor
-%}
{%- if mode == 'notice' -%}
  {%- if vb_cap_on and vb_cap_units > 5 -%}
  <div class="vb-cap-notice" data-vb-cap-over role="alert" style="margin:0 0 12px;padding:12px 14px;border:2px solid #b3261e;border-radius:8px;background:#fdf1f0;color:#7a1611;font-weight:700;font-size:1.4rem;line-height:1.45;text-align:left">
    The Survivor Offer is limited to 5 products per order. You have {{ vb_cap_units }}.
    <span style="display:block;font-weight:400">Please remove {{ vb_cap_units | minus: 5 }} to check out.</span>
  </div>
  <style>#CartDrawer-Checkout,.vbc__checkout{opacity:.45;pointer-events:none}</style>
  {%- endif -%}
{%- elsif mode == 'script' -%}
<script>
(function(){
  var T2=1,T3=1796075999000,MAX=5,IDS={8259512041643:1,8259512205483:1,8259512238251:1,8259512271019:1,8259512533163:1,8259512598699:1,8259512893611:1,8259512959147:1,8259512991915:1,8259513057451:1,8259513221291:1,8259513254059:1,8414576279723:1,8414583193771:1,8414583488683:1,8414583816363:1,8414584209579:1,8415347900587:1,8415349735595:1,8415352324267:1,8415353405611:1,8487176569003:1,8487181451435:1,8487184892075:1,8488400945323:1,8488412577963:1,8488417263787:1,8491260215467:1,8491262705835:1,8491265589419:1,8491267424427:1,8491272044715:1,8491273289899:1,8491277385899:1,8491278991531:1,8491284594859:1,8491292295339:1,8491296555179:1,8491297702059:1,8491346559147:1,8491348852907:1,8491355701419:1,8513389035691:1,8546280374443:1};
  function on(){var n=Date.now();return n>=T2&&n<T3}
  if(!on())return;
  var MSG='The Survivor Offer is limited to 5 products per order. Please reduce your order to 5 products to check out.';
  function units(c){var n=0;(c.items||[]).forEach(function(i){if(IDS[i.product_id])n+=i.quantity});return n}
  function cart(){return fetch('/cart.js',{credentials:'same-origin',headers:{'Accept':'application/json'}}).then(function(r){return r.json()})}
  var pass=false;
  function guard(e){
    if(pass||!on())return;
    var t=e.target.closest&&e.target.closest('[name="checkout"],a[href="/checkout"],a[href^="/checkout?"],a[href$="/checkout"]');
    if(!t)return;
    e.preventDefault();e.stopPropagation();
    cart().then(function(c){
      var n=units(c);
      if(n>MAX){alert(MSG+' You have '+n+'.');if(location.pathname.indexOf('/cart')!==0)location.href='/cart'}
      else{pass=true;if(t.tagName==='A'){location.href=t.href}else if(t.form||t.getAttribute('form')){var f=t.form||document.getElementById(t.getAttribute('form'));var h=document.createElement('input');h.type='hidden';h.name='checkout';h.value='1';f.appendChild(h);f.submit()}else{location.href='/checkout'}}
    }).catch(function(){pass=true;t.click()});
  }
  document.addEventListener('click',guard,true);
  var PID={{ product.id | default: 0 | json }};
  if(PID&&IDS[PID]){
    function clamp(){document.querySelectorAll('input[name="quantity"]').forEach(function(q){q.max=MAX;if(+q.value>MAX){q.value=MAX;q.dispatchEvent(new Event('change',{bubbles:true}))}})}
    clamp();document.addEventListener('change',clamp,true);
    document.addEventListener('click',function(e){
      var b=e.target.closest&&e.target.closest('.shopify-payment-button');if(!b)return;
      var q=document.querySelector('input[name="quantity"]');if(q&&+q.value>MAX){e.preventDefault();e.stopPropagation();alert(MSG)}
    },true);
  }
})();
</script>
{%- endif -%}
