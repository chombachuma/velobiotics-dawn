{%- comment -%} VB · Judge.me / Real customer stories — review carousel placeholder {%- endcomment -%}

<style>
  .vb-jm { padding: 72px 24px; background: #fff; }
  .vb-jm__inner { max-width: 1280px; margin: 0 auto; }
  .vb-jm__head { text-align: center; max-width: 720px; margin: 0 auto 36px; }
  .vb-jm__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-jm__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; }
  .vb-jm__title em { color: #4d8c44; font-style: normal; }
  .vb-jm__sub { font-size: 16px; line-height: 1.6; color: #5c6664; margin: 0; }
  .vb-jm__stats { display: flex; flex-wrap: wrap; gap: 28px; justify-content: center; align-items: center; margin: 0 auto 32px; padding: 22px; background: #fafdf9; border: 1px solid #e3ece1; border-radius: 18px; max-width: 760px; }
  .vb-jm__stat { display: flex; align-items: center; gap: 12px; }
  .vb-jm__stat-value { font-size: 28px; font-weight: 900; color: #4d8c44; line-height: 1; letter-spacing: -0.02em; }
  .vb-jm__stat-meta { font-size: 12px; color: #5c6664; line-height: 1.3; }
  .vb-jm__stat-meta strong { display: block; color: #1a1a1a; font-size: 13.5px; }
  .vb-jm__divider { width: 1px; height: 32px; background: #d1dccf; }
  .vb-jm__placeholder { background: #f7faf6; border: 2px dashed #c9d6c7; border-radius: 18px; padding: 40px 22px; text-align: center; color: #5c6664; }
  .vb-jm__placeholder strong { display: block; color: #4d8c44; font-size: 16px; font-weight: 800; margin-bottom: 8px; }
  .vb-jm__placeholder code { background: #fff; padding: 4px 10px; border-radius: 6px; font-size: 12.5px; border: 1px solid #e3ece1; }
  @media (max-width: 749px) {
    .vb-jm { padding: 48px 14px; }
    .vb-jm__stats { gap: 16px; padding: 16px; }
    .vb-jm__divider { display: none; }
    .vb-jm__stat-value { font-size: 22px; }
  }
  .vb-jm__embed { max-width: 1080px; margin: 0 auto; }
  .vb-jm__embed .jdgm-rev-widg, .vb-jm__embed .jdgm-all-reviews-widget { border: 0; padding: 0; }
  .vb-jm__embed .jdgm-rev-widg__title, .vb-jm__embed .jdgm-all-reviews__header-title { display: none; }
  .vb-jm__stat-meta small { display:block; font-size: 11px; color:#8a948a; }
  .vb-jm__empty { text-align:center; color:#5c6664; padding: 28px; background:#f7faf6; border-radius: 16px; }
</style>
{%- comment -%}
  VB · Judge.me reviews v2 (15 Sep 2026). Renders Judge.me's own embed code so reviews always show:
   - on a product page (scope auto/product): the Review Widget for this product
   - elsewhere (scope auto/store): the Happy Customers / All Reviews widget
  Numbers come from Judge.me metafields, never hardcoded.
{%- endcomment -%}
{%- assign jm = shop.metafields.judgeme -%}
{%- assign scope = section.settings.scope | default: 'auto' -%}
{%- if scope == 'auto' -%}{%- if product -%}{%- assign scope = 'product' -%}{%- else -%}{%- assign scope = 'store' -%}{%- endif -%}{%- endif -%}
{%- if scope == 'product' -%}
  {%- assign rw = product.metafields.judgeme.review_widget_data.value -%}
  {%- assign stat_rating = rw.average_rating | default: jm.all_reviews_rating -%}
  {%- assign stat_count = rw.number_of_reviews | default: 0 -%}
{%- else -%}
  {%- assign stat_rating = jm.all_reviews_rating -%}
  {%- assign stat_count = jm.all_reviews_count -%}
{%- endif -%}
<section class="vb-jm" id="vb-reviews">
  <div class="vb-jm__inner">
    <div class="vb-jm__head">
      {%- if section.settings.eyebrow != blank -%}<p class="vb-jm__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vb-jm__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
      {%- if section.settings.sub != blank -%}<p class="vb-jm__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    {%- if section.settings.show_stats -%}
    <div class="vb-jm__stats">
      <div class="vb-jm__stat">
        <div class="vb-jm__stat-value">{{ stat_rating | round: 1 }}</div>
        <div class="vb-jm__stat-meta"><strong>★★★★★</strong>Average rating{% if scope == 'product' %}<small>this product</small>{% endif %}</div>
      </div>
      <div class="vb-jm__divider"></div>
      <div class="vb-jm__stat">
        <div class="vb-jm__stat-value">{{ stat_count }}</div>
        <div class="vb-jm__stat-meta"><strong>Verified reviews</strong>via Judge.me{% if scope == 'product' %}<small>{{ jm.all_reviews_count }} across Velobiotics</small>{% endif %}</div>
      </div>
      <div class="vb-jm__divider"></div>
      <div class="vb-jm__stat">
        <div class="vb-jm__stat-value">{{ jm['trust_badge.verified_reviews_count'] | default: jm.shop_reviews_count }}</div>
        <div class="vb-jm__stat-meta"><strong>Verified buyers</strong>independently checked</div>
      </div>
    </div>
    {%- endif -%}

    <div class="vb-jm__embed">
    {%- if scope == 'product' -%}
      <!-- Start of Judge.me code -->
      {%- assign has_legacy = false -%}{%- if product.metafields.judgeme.widget.size > 20 -%}{%- assign has_legacy = true -%}{%- endif -%}
      <div style='clear:both'></div>
      <div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-product-id='{{ product.id }}' data-widget='review' data-auto-install='false' data-shop-reviews-count='{{ jm.shop_reviews_count | default: 0 | escape }}' data-entry-point='review_widget.js' data-entry-key='review-widget/main.js'>
        {%- if has_legacy -%}<div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>{%- endif -%}
      </div>
      {%- if product.metafields.judgeme.review_widget_data -%}<script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>{%- endif -%}
      <!-- End of Judge.me code -->
    {%- else -%}
      <!-- Start of Judge.me code -->
      {%- assign has_legacy = false -%}{%- if jm.all_reviews_header.size > 20 -%}{%- assign has_legacy = true -%}{%- endif -%}
      <div class='jdgm-widget jdgm-all-reviews-widget-v2025' data-widget='all-reviews-v2025' data-auto-install='false' data-entry-point='all_reviews_widget_v2025.js' data-entry-key='all-reviews-widget-v2025/main.js'>
        {%- if has_legacy -%}<div class='jdgm-legacy-widget-content' style='display: none;'><article class='jdgm-widget jdgm-all-reviews-widget'><style class='jdgm-temp-hiding-style'>.jdgm-all-reviews-widget{ display: none }</style>{{ jm.all_reviews_header }}<div class='jdgm-all-reviews__body'>{%- assign prefix = 'all_reviews_' -%}{%- for count in (0..65535) -%}{%- assign metafield_key = prefix | append: count -%}{%- assign current_metafield = jm[metafield_key] -%}{%- unless current_metafield -%}{%- break -%}{%- endunless -%}{{ current_metafield }}{%- endfor -%}</div></article></div>{%- endif -%}
      </div>
      {%- if jm.all_reviews_widget_v2025_data -%}<script>jdgm.data ||= {}; jdgm.data.allReviewsWidgetV2025 = {{ jm.all_reviews_widget_v2025_data }};</script>{%- endif -%}
      <!-- End of Judge.me code -->
    {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Judge.me reviews",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "scope", "label": "Which reviews", "default": "auto", "options": [
      { "value": "auto", "label": "Auto (product page → product; else store)" },
      { "value": "product", "label": "This product only" },
      { "value": "store", "label": "Whole store (Happy Customers)" } ] },
    { "type": "checkbox", "id": "show_stats", "label": "Show live rating / count strip", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real Reviews" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "What our customers" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "are saying" },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Unfiltered, verified reviews collected independently by Judge.me." }
  ],
  "presets": [{ "name": "VB · Judge.me reviews" }]
}
{% endschema %}
