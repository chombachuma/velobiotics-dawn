{{ 'vb-science-strip.css' | asset_url | stylesheet_tag }}

{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0668/5848/3883/files' -%}

<section class="vb-science">
  <div class="vb-science__inner page-width">

    <div class="vb-science__copy">
      <span class="vb-label-tag" style="color:var(--vb-green-400)">The Science Behind the Difference</span>
      <h2 class="vb-h2" style="color:#fff">We Built Armour Around Every Probiotic So It Survives Where Others Don't.</h2>
      <p class="vb-lead" style="color:rgba(255,255,255,0.75)">Microencapsulation with Supercritical Carbon Dioxide (scCO₂) is a breakthrough way of protecting probiotics so they actually work. Think of it as wrapping each probiotic in a microscopic coat of armour.</p>

      <div class="vb-science__steps">
        <div class="vb-science__step">
          <div class="vb-science__step-num">1</div>
          <div>
            <strong>Micro-Shield Protection</strong>
            <p>Each probiotic is wrapped in a protective polymer layer that blocks heat, oxygen, moisture and stomach acid.</p>
          </div>
        </div>
        <div class="vb-science__step">
          <div class="vb-science__step-num">2</div>
          <div>
            <strong>Survives Stomach Acid</strong>
            <p>Our probiotics stay dormant through your stomach, resisting destruction where 99% of others die.</p>
          </div>
        </div>
        <div class="vb-science__step">
          <div class="vb-science__step-num">3</div>
          <div>
            <strong>Smart Release in the Gut</strong>
            <p>Once in the alkaline intestines, the capsule dissolves — releasing billions of live probiotics where they're actually needed.</p>
          </div>
        </div>
      </div>

      <div class="vb-science__ctas">
        <a href="/pages/our-science" class="vb-btn vb-btn--primary vb-btn--lg">See the Science</a>
        <a href="/collections/all" class="vb-btn vb-btn--outline-white vb-btn--lg">Shop Velobiotics</a>
      </div>
    </div>

    <div class="vb-science__visual">
      <div class="vb-science__img-stack">
        <img
          src="{{ cdn }}/1000x-More-Probiotics-to-Your-Gut.jpg"
          alt="1000x more probiotics to your gut"
          loading="lazy"
          class="vb-science__img-main"
          width="2000" height="2000"
        >
        <div class="vb-science__img-badge">
          <div class="vb-science__img-badge-icon">🔬</div>
          <span class="vb-science__img-badge-num">1000×</span>
          <span class="vb-science__img-badge-text">More Live Probiotics<br>Reach Your Gut</span>
        </div>
        <div class="vb-science__img-pill">
          <span>scCO₂ Patented Technology</span>
        </div>
      </div>
    </div>

  </div>

  {%- comment -%} Bottom comparison badges {%- endcomment -%}
  <div class="vb-science__compare">
    <div class="vb-science__compare-inner page-width">
      <div class="vb-science__compare-item vb-science__compare-item--win">
        <span class="vb-science__compare-icon">✅</span>
        <span>Velobiotics</span>
        <span class="vb-science__compare-tag">Patented MEP Delivery</span>
      </div>
      <div class="vb-science__compare-vs">VS</div>
      <div class="vb-science__compare-item">
        <span class="vb-science__compare-icon">❌</span>
        <span>Other Probiotics</span>
        <span class="vb-science__compare-tag">No protection — most die in stomach</span>
      </div>
      <div class="vb-science__compare-vs">VS</div>
      <div class="vb-science__compare-item">
        <span class="vb-science__compare-icon">❌</span>
        <span>Multivitamins</span>
        <span class="vb-science__compare-tag">No probiotics — no gut benefit</span>
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "VB Science Strip",
  "tag": "div",
  "class": "vb-section-wrap",
  "settings": [],
  "presets": [{ "name": "VB Science Strip" }]
}
{% endschema %}
