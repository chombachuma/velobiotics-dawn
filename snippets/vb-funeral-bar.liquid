</style>
<script>
(function(){var el=document.querySelector('[data-vb-fbar]');if(!el)return;var T0=1794801600000,T1=1795194000000,T2=1795579200000,T3=1796075999000;
function set(){var n=Date.now(),s=n<T0?'':n<T1?'a':n<T2?'b':n<T3?'c':'';var m=location.pathname.indexOf('vb-bar-test')>-1&&location.hash.match(/^#([abc])$/);if(m)s=m[1];el.hidden=!s;el.querySelectorAll('a').forEach(function(a){a.classList.toggle('is-on',a.getAttribute('data-s')===s)})}
set();setInterval(set,30000)})();
</script>
