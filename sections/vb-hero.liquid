{%- comment -%}
  VB · Home Hero v3 — full-bleed background image with horizontal edge fade
{%- endcomment -%}

{%- liquid
  assign hero_image_src = ''
  if section.settings.bg_image_url != blank
    assign hero_image_src = section.settings.bg_image_url
  elsif section.settings.bg_image != blank
    assign hero_image_src = section.settings.bg_image | image_url: width: 1800
  endif
-%}

<style>
  .vb-hero3 { position: relative; padding: 72px 24px 60px; background: linear-gradient(180deg, #f5f9f3 0%, #e3efdf 100%); overflow: hidden; }
  .vb-hero3__bg { position: absolute; inset: 0; z-index: 0; }
  .vb-hero3__bg-img { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; opacity: 0.85; }
  .vb-hero3__bg-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.3) 35%, rgba(245,249,243,0.55) 70%, rgba(227,239,223,0.92) 100%); }
  .vb-hero3__inner { max-width: 1080px; margin: 0 auto; position: relative; z-index: 2; text-align: center; }
  .vb-hero3__eyebrow { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 8px 16px; border-radius: 999px; border: 1.5px solid #4d8c44; margin: 0 0 16px; box-shadow: 0 6px 14px rgba(77,140,68,0.10); max-width: 100%; }
  @media (max-width: 749px) { .vb-hero3__eyebrow { font-size: 9.5px; padding: 6px 12px; letter-spacing: 0.04em; } }
  .vb-hero3__eyebrow::before { content: ''; width: 8px; height: 8px; background: #4d8c44; border-radius: 50%; box-shadow: 0 0 10px #4d8c44; }
  .vb-hero3__rating { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; margin: 0 0 16px; font-size: 13.5px; color: #2b3a2a; }
  .vb-hero3__rating .stars { color: #ffb43a; letter-spacing: 1px; font-size: 14px; }
  .vb-hero3__rating .divider { width: 1px; height: 14px; background: #8db786; }
  .vb-hero3__rating strong { color: #1a1a1a; font-weight: 700; }
  .vb-hero3__headline { font-size: clamp(34px, 6vw, 64px); line-height: 1.04; font-weight: 800; color: #1a1a1a; margin: 0 auto 18px; letter-spacing: -0.015em; max-width: 920px; text-shadow: 0 1px 2px rgba(255,255,255,0.4); }
  .vb-hero3__headline em { font-style: normal; color: #4d8c44; }
  .vb-hero3__sub { font-size: 17px; line-height: 1.6; color: #2b3a2a; max-width: 620px; margin: 0 auto 24px; font-weight: 500; }
  .vb-hero3__ctas { display: inline-flex; flex-wrap: wrap; gap: 12px; margin: 0 0 32px; justify-content: center; }
  .vb-hero3 a.vb-hero3__cta { display: inline-flex; align-items: center; gap: 6px; padding: 15px 32px; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: 15px; transition: all 0.18s ease; }
  .vb-hero3 a.vb-hero3__cta--primary { background: #4d8c44; color: #fff !important; box-shadow: 0 12px 28px rgba(77, 140, 68, 0.40); }
  .vb-hero3 a.vb-hero3__cta--primary:hover { background: #36632f; transform: translateY(-2px); box-shadow: 0 16px 32px rgba(77, 140, 68, 0.50); }
  .vb-hero3 a.vb-hero3__cta--secondary { background: rgba(255,255,255,0.94); color: #2b3a2a !important; border: 2px solid #c9d6c7; backdrop-filter: blur(8px); }
  .vb-hero3 a.vb-hero3__cta--secondary:hover { border-color: #4d8c44; color: #4d8c44 !important; transform: translateY(-2px); }

  /* Floating badges around hero centred area */
  .vb-hero3__floats { position: relative; max-width: 760px; margin: 0 auto 36px; height: 80px; }
  .vb-hero3__badge { position: absolute; background: #fff; padding: 10px 16px; border-radius: 999px; box-shadow: 0 14px 32px rgba(0, 0, 0, 0.12); display: inline-flex; flex-direction: column; align-items: center; line-height: 1.1; border: 1px solid #e3ece1; }
  .vb-hero3__badge--green { background: #4d8c44; color: #fff !important; border: none; }
  .vb-hero3__badge--green strong, .vb-hero3__badge--green small { color: #fff; }
  .vb-hero3__badge strong { font-size: 16px; font-weight: 900; color: #1a1a1a; letter-spacing: -0.02em; }
  .vb-hero3__badge small { font-size: 9.5px; font-weight: 700; opacity: 0.85; margin-top: 2px; letter-spacing: 0.06em; text-transform: uppercase; color: #4d8c44; }
  .vb-hero3__badge--tl { top: 0; left: 5%; transform: rotate(-5deg); }
  .vb-hero3__badge--tr { top: 12px; right: 5%; transform: rotate(4deg); }
  .vb-hero3__badge--bl { bottom: 0; left: 18%; transform: rotate(2deg); }
  .vb-hero3__badge--br { bottom: 6px; right: 18%; transform: rotate(-3deg); }

  /* Trust pills */
  .vb-hero3__pills { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; max-width: 820px; margin: 0 auto; }
  .vb-hero3__pill { background: rgba(255,255,255,0.94); backdrop-filter: blur(10px); padding: 14px 14px; border-radius: 14px; border: 1px solid rgba(195,212,193,0.6); display: flex; align-items: center; gap: 10px; transition: all 0.18s ease; text-align: left; }
  .vb-hero3__pill:hover { transform: translateY(-3px); box-shadow: 0 10px 22px rgba(77, 140, 68, 0.16); background: #fff; border-color: rgba(77,140,68,0.4); }
  .vb-hero3__pill-icon { width: 36px; height: 36px; border-radius: 50%; background: rgba(77,140,68,0.14); color: #4d8c44; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
  .vb-hero3__pill-text { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
  .vb-hero3__pill-title { font-size: 13px; font-weight: 800; color: #1a1a1a; }
  .vb-hero3__pill-sub { font-size: 11px; color: #6c7a6b; margin-top: 2px; }

  @media (max-width: 749px) {
    .vb-hero3 { padding: 36px 16px 40px; }
    .vb-hero3__bg-img { object-position: center 25%; opacity: 0.35; -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); }
    .vb-hero3__headline { font-size: clamp(28px, 9vw, 38px); }
    .vb-hero3__sub { font-size: 14.5px; }
    .vb-hero3__floats { height: 64px; margin-bottom: 24px; max-width: 100%; }
    .vb-hero3__badge { padding: 7px 11px; }
    .vb-hero3__badge strong { font-size: 12.5px; }
    .vb-hero3__badge small { font-size: 8px; }
    .vb-hero3__badge--tl { left: 0; }
    .vb-hero3__badge--tr { right: 0; }
    .vb-hero3__badge--bl { left: 10%; bottom: 0; }
    .vb-hero3__badge--br { right: 10%; bottom: 4px; }
    .vb-hero3__pills { grid-template-columns: 1fr 1fr; gap: 8px; }
    .vb-hero3__pill { padding: 10px 12px; gap: 8px; border-radius: 12px; }
    .vb-hero3__pill-icon { width: 30px; height: 30px; font-size: 14px; }
    .vb-hero3__pill-title { font-size: 12px; }
    .vb-hero3__pill-sub { font-size: 10px; }
    .vb-hero3 a.vb-hero3__cta { padding: 12px 22px; font-size: 13.5px; }
  }
</style>

<section class="vb-hero3">
  {%- if hero_image_src != blank -%}
    <div class="vb-hero3__bg">
      <img class="vb-hero3__bg-img" src="{{ hero_image_src }}" alt="" loading="eager" />
    </div>
    <div class="vb-hero3__bg-overlay"></div>
  {%- endif -%}

  <div class="vb-hero3__inner">
    {%- if section.settings.eyebrow != blank -%}<span class="vb-hero3__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.show_rating -%}
      <div class="vb-hero3__rating">
        <span class="stars">★★★★★</span>
        <span>Over <strong>{{ section.settings.review_count }}</strong> Reviews</span>
        <span class="divider"></span>
        <span><strong>{{ section.settings.customer_count }}</strong> Happy Customers Worldwide</span>
      </div>
    {%- endif -%}
    <h1 class="vb-hero3__headline">
      {{ section.settings.headline_pre }}
      {%- if section.settings.headline_highlight != blank %} <em>{{ section.settings.headline_highlight }}</em>{%- endif -%}
    </h1>
    {%- if section.settings.sub != blank -%}<p class="vb-hero3__sub">{{ section.settings.sub }}</p>{%- endif -%}
    <div class="vb-hero3__ctas">
      {%- if section.settings.cta1_text != blank -%}<a href="{{ section.settings.cta1_link | default: '#' }}" class="vb-hero3__cta vb-hero3__cta--primary">{{ section.settings.cta1_text }}</a>{%- endif -%}
      {%- if section.settings.cta2_text != blank -%}<a href="{{ section.settings.cta2_link | default: '#' }}" class="vb-hero3__cta vb-hero3__cta--secondary">{{ section.settings.cta2_text }}</a>{%- endif -%}
    </div>

    <div class="vb-hero3__floats">
      {%- if section.settings.badge_tl_value != blank -%}<span class="vb-hero3__badge vb-hero3__badge--green vb-hero3__badge--tl"><strong>{{ section.settings.badge_tl_value }}</strong><small>{{ section.settings.badge_tl_label }}</small></span>{%- endif -%}
      {%- if section.settings.badge_tr_value != blank -%}<span class="vb-hero3__badge vb-hero3__badge--tr"><strong>{{ section.settings.badge_tr_value }}</strong><small>{{ section.settings.badge_tr_label }}</small></span>{%- endif -%}
      {%- if section.settings.badge_bl_value != blank -%}<span class="vb-hero3__badge vb-hero3__badge--bl"><strong>{{ section.settings.badge_bl_value }}</strong><small>{{ section.settings.badge_bl_label }}</small></span>{%- endif -%}
      {%- if section.settings.badge_br_value != blank -%}<span class="vb-hero3__badge vb-hero3__badge--green vb-hero3__badge--br"><strong>{{ section.settings.badge_br_value }}</strong><small>{{ section.settings.badge_br_label }}</small></span>{%- endif -%}
    </div>

    <div class="vb-hero3__pills">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pill' -%}
          <div class="vb-hero3__pill" {{ block.shopify_attributes }}>
            <span class="vb-hero3__pill-icon">{{ block.settings.icon }}</span>
            <span class="vb-hero3__pill-text">
              <span class="vb-hero3__pill-title">{{ block.settings.title }}</span>
              <span class="vb-hero3__pill-sub">{{ block.settings.sub }}</span>
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Home hero",
  "tag": "section",
  "class": "vb-home-hero-section",
  "settings": [
    { "type": "header", "content": "Background image (fades at edges)" },
    { "type": "text", "id": "bg_image_url", "label": "External image URL" },
    { "type": "image_picker", "id": "bg_image", "label": "Hero image (uploaded)" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Patented Probiotics That Actually Reach Your Gut" },
    { "type": "text", "id": "headline_pre", "label": "Headline (start)", "default": "Most Probiotics Die in Your Stomach." },
    { "type": "text", "id": "headline_highlight", "label": "Headline (highlight)", "default": "Ours Don't!" },
    { "type": "textarea", "id": "sub", "label": "Sub-headline", "default": "Velobiotics protects every live culture through stomach acid delivering 1000× more probiotics to your gut, where they're needed for real results, you can feel." },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating row", "default": true },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "3,500" },
    { "type": "text", "id": "customer_count", "label": "Customer count", "default": "300,000" },
    { "type": "header", "content": "CTAs" },
    { "type": "text", "id": "cta1_text", "label": "Primary CTA", "default": "Shop Products" },
    { "type": "url", "id": "cta1_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA", "default": "🧬 Take The Quiz" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" },
    { "type": "header", "content": "Floating badges" },
    { "type": "text", "id": "badge_tl_value", "label": "Top-left value", "default": "1000×" },
    { "type": "text", "id": "badge_tl_label", "label": "Top-left label", "default": "More Probiotics" },
    { "type": "text", "id": "badge_tr_value", "label": "Top-right value", "default": "300K+" },
    { "type": "text", "id": "badge_tr_label", "label": "Top-right label", "default": "Happy Customers" },
    { "type": "text", "id": "badge_bl_value", "label": "Bottom-left value", "default": "16" },
    { "type": "text", "id": "badge_bl_label", "label": "Bottom-left label", "default": "Probiotic Strains" },
    { "type": "text", "id": "badge_br_value", "label": "Bottom-right value", "default": "30-day" },
    { "type": "text", "id": "badge_br_label", "label": "Bottom-right label", "default": "Money Back" }
  ],
  "blocks": [
    { "type": "pill", "name": "Trust pill", "limit": 4, "settings": [
      { "type": "text", "id": "icon", "label": "Icon / emoji", "default": "💊" },
      { "type": "text", "id": "title", "label": "Title", "default": "Patented MEP" },
      { "type": "text", "id": "sub", "label": "Sub-text", "default": "Technology" }
    ]}
  ],
  "presets": [
    { "name": "VB · Home hero", "blocks": [
      { "type": "pill", "settings": { "icon": "💊", "title": "Patented MEP", "sub": "Technology" } },
      { "type": "pill", "settings": { "icon": "🩺", "title": "Doctor", "sub": "Formulated" } },
      { "type": "pill", "settings": { "icon": "🔬", "title": "Lab-Tested", "sub": "Every Batch" } },
      { "type": "pill", "settings": { "icon": "🔄", "title": "Money-Back", "sub": "Guarantee" } }
    ]}
  ]
}
{% endschema %}
