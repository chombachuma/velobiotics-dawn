{%- comment -%}
Velobiotics Marketing Tracking & UTM Persistence Snippet
Handled: GA4, Meta Pixel (with event_id for CAPI dedup), TikTok Pixel, UTM / Referrer cart attribute persistence.
{%- endcomment -%}

<script>
(function() {
  var GA4_ID = 'G-6773VKB51J';
  var META_PIXEL_ID = '1254989789237546';
  var TIKTOK_PIXEL_ID = 'D8KR83RC77U29JSH6S60';
  var GOOGLE_ADS_ID = 'AW-10893546606';

  function getConsent() {
    if (window.Shopify && window.Shopify.customerPrivacy) {
      try {
        var c = window.Shopify.customerPrivacy.getTrackingConsent();
        if (c === 'declined' || c === 'no' || c === false) {
          return { analytics: false, marketing: false };
        }
      } catch(e) {}
    }
    return { analytics: true, marketing: true };
  }

  // --- 1. UTM & REFERRER PERSISTENCE ---
  function captureUTMs() {
    var params = new URLSearchParams(window.location.search);
    var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'fbclid', 'ttclid'];
    var captured = {};

    keys.forEach(function(k) {
      var val = params.get(k);
      if (val) {
        captured[k] = val;
        try {
          sessionStorage.setItem('vb_' + k, val);
          localStorage.setItem('vb_' + k, val);
        } catch(e){}
      } else {
        try {
          var stored = sessionStorage.getItem('vb_' + k) || localStorage.getItem('vb_' + k);
          if (stored) captured[k] = stored;
        } catch(e){}
      }
    });

    try {
      if (!sessionStorage.getItem('vb_landing_page')) {
        sessionStorage.setItem('vb_landing_page', window.location.href);
        sessionStorage.setItem('vb_referrer', document.referrer || '');
      }
      captured['landing_page'] = sessionStorage.getItem('vb_landing_page');
      captured['referrer'] = sessionStorage.getItem('vb_referrer');
    } catch(e){}

    return captured;
  }

  function syncCartAttributes(attr) {
    if (!attr || Object.keys(attr).length === 0) return;
    var cartData = {
      attributes: {
        'utm_source': attr.utm_source || '',
        'utm_medium': attr.utm_medium || '',
        'utm_campaign': attr.utm_campaign || '',
        'utm_content': attr.utm_content || '',
        'landing_page': attr.landing_page || '',
        'gclid': attr.gclid || '',
        'fbclid': attr.fbclid || '',
        'ttclid': attr.ttclid || '',
        'biomatchAttribution': JSON.stringify(attr)
      }
    };

    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(cartData)
    }).catch(function(e){ console.warn('Cart attr sync failed', e); });
  }

  var utmAttrs = captureUTMs();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { syncCartAttributes(utmAttrs); });
  } else {
    syncCartAttributes(utmAttrs);
  }

  // Helper for generating event_id (for Meta CAPI dedup)
  function generateEventId(eventName) {
    return 'vb_' + eventName + '_' + Date.now() + '_' + Math.floor(Math.random() * 100000);
  }

  // --- 2. TRACKING EVENTS ---
  var consent = getConsent();

  // Meta Pixel Initialization
  if (consent.marketing && META_PIXEL_ID) {
    if (!window.fbq) {
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', META_PIXEL_ID);
    }
  }

  // TikTok Pixel Initialization
  if (consent.marketing && TIKTOK_PIXEL_ID) {
    if (!window.ttq) {
      !function (w, d, t) {
        w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e},ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};n=document.createElement("script");n.type="text/javascript",n.async=!0,n.src=r+"?sdkid="+e+"&lib="+t;e=document.getElementsByTagName("script")[0];e.parentNode.insertBefore(n,e)};
        ttq.load(TIKTOK_PIXEL_ID);
      }(window, document, 'ttq');
    }
  }

  // Track Page View
  var pageEventId = generateEventId('page_view');
  if (consent.marketing && window.fbq) {
    fbq('track', 'PageView', {}, { eventID: pageEventId });
  }
  if (consent.marketing && window.ttq) {
    window.ttq.page();
  }

  // Track Product View (view_item / ViewContent)
  {% if template.name == 'product' %}
    var prodData = {
      id: {{ product.id | json }},
      title: {{ product.title | json }},
      price: {{ product.price | divided_by: 100.0 | json }},
      vendor: {{ product.vendor | json }},
      type: {{ product.type | json }},
      variant_id: {{ product.selected_or_first_available_variant.id | json }},
      sku: {{ product.selected_or_first_available_variant.sku | json }}
    };

    var prodEventId = generateEventId('view_item');

    if (consent.analytics && window.gtag) {
      gtag('event', 'view_item', {
        send_to: GA4_ID,
        currency: 'ZAR',
        value: prodData.price,
        items: [{
          item_id: prodData.sku || prodData.variant_id,
          item_name: prodData.title,
          item_category: prodData.type,
          price: prodData.price,
          quantity: 1
        }]
      });
    }

    if (consent.marketing && window.fbq) {
      fbq('track', 'ViewContent', {
        content_name: prodData.title,
        content_category: prodData.type,
        content_ids: [prodData.variant_id],
        content_type: 'product',
        value: prodData.price,
        currency: 'ZAR'
      }, { eventID: prodEventId });
    }

    if (consent.marketing && window.ttq) {
      ttq.track('ViewContent', {
        content_id: prodData.variant_id,
        content_type: 'product',
        content_name: prodData.title,
        quantity: 1,
        price: prodData.price,
        value: prodData.price,
        currency: 'ZAR'
      });
    }
  {% endif %}

  // Listen for Add To Cart clicks and Cart Form submits
  document.addEventListener('click', function(e) {
    var target = e.target.closest('button[name="add"], button.product-form__submit, [data-add-to-cart], .product-form__submit');
    if (target) {
      var atcEventId = generateEventId('add_to_cart');
      if (consent.analytics && window.gtag) {
        gtag('event', 'add_to_cart', { send_to: GA4_ID, currency: 'ZAR' });
      }
      if (consent.marketing && window.fbq) {
        fbq('track', 'AddToCart', { currency: 'ZAR' }, { eventID: atcEventId });
      }
      if (consent.marketing && window.ttq) {
        ttq.track('AddToCart', { currency: 'ZAR' });
      }
    }
  });

})();
</script>
