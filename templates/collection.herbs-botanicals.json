        "faq_meds": {
          "type": "faq",
          "settings": {
            "q": "Are herbal supplements safe to take alongside prescription medication?",
            "a": "<p>Botanical supplements contain active plant compounds that may interact with certain medications. You should always consult your doctor or healthcare professional before taking herbal supplements if you are taking prescription drugs.</p>"
          }
        },
        "faq_timing": {
          "type": "faq",
          "settings": {
            "q": "How long does it usually take to notice the benefits of botanical extracts?",
            "a": "<p>Individual responses vary depending on the herb, dosage and your individual metabolism. Some botanicals provide noticeable support within a few days, while adaptogens and traditional herbs often build benefits gradually over 2 to 4 weeks of consistent use.</p>"
          }
        },
        "faq_extract": {
          "type": "faq",
          "settings": {
            "q": "What does 'standardised extract' mean and why is it important?",
            "a": "<p>A standardised extract is processed to guarantee a precise percentage of the plant's key active phytonutrients in every dose. This ensures consistent quality, strength and effectiveness from capsule to capsule, unlike unstandardised raw powders.</p>"
          }
        },
        "faq_combine": {
          "type": "faq",
          "settings": {
            "q": "Can I combine different adaptogens and botanical supplements?",
            "a": "<p>Many botanical supplements are designed to complement one another, such as pairing adaptogens for stress with digestive botanicals. However, it is best to introduce new supplements one at a time and consult a qualified practitioner to ensure compatibility.</p>"
          }
        },
        "faq_pregnancy": {
          "type": "faq",
          "settings": {
            "q": "Can I take botanical supplements while pregnant or breastfeeding?",
            "a": "<p>Many herbs and botanical extracts are not recommended during pregnancy or breastfeeding due to potential effects on hormone balance or uterine tone. Always speak with your doctor or midwife before using any herbal supplement during pregnancy or lactation.</p>"
          }
        }
