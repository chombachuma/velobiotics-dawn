{{ 'vb-footer.css' | asset_url | stylesheet_tag }}

<footer class="vb-footer" role="contentinfo">

  {%- comment -%} Email capture band {%- endcomment -%}
  <div class="vb-footer__email-band">
    <div class="vb-footer__email-inner page-width">
      <div class="vb-footer__email-copy">
        <h3 class="vb-footer__email-heading">Your Health. Our Knowledge.</h3>
        <p class="vb-footer__email-sub">Get science-backed health tips, exclusive offers, and early access to new products.</p>
      </div>
      <form class="vb-footer__email-form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <label for="vb-footer-email" class="visually-hidden">Email address</label>
        <div class="vb-footer__email-row">
          <input
            type="email"
            id="vb-footer-email"
            name="contact[email]"
            placeholder="Enter your email address"
            required
            class="vb-footer__email-input"
            autocomplete="email"
          >
          <button type="submit" class="vb-btn vb-btn--primary vb-btn--md">Subscribe</button>
        </div>
        <p class="vb-footer__email-note">No spam. Unsubscribe any time.</p>
      </form>
    </div>
  </div>

  {%- comment -%} Main footer columns {%- endcomment -%}
  <div class="vb-footer__main page-width">
    <div class="vb-footer__brand-col">
      {%- if section.settings.footer_logo != blank -%}
        {{
          section.settings.footer_logo
          | image_url: width: 240
          | image_tag: loading: 'lazy', width: 140, height: 44, alt: shop.name, class: 'vb-footer__logo'
        }}
      {%- else -%}
        <span class="vb-footer__logo-text">{{ shop.name }}</span>
      {%- endif -%}
      <p class="vb-footer__brand-desc">Probiotics engineered to survive. Formulated by doctors. Trusted by 300,000+ South Africans.</p>

      {%- comment -%} Trust badges {%- endcomment -%}
      <div class="vb-footer__badges">
        <div class="vb-footer__badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V7L12 2z" fill="currentColor" opacity=".2"/><path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V7L12 2z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Patented MEP Tech
        </div>
        <div class="vb-footer__badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M4 20c0-4 3.58-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          Doctor Formulated
        </div>
        <div class="vb-footer__badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          SAHPRA Certified
        </div>
        <div class="vb-footer__badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h16v2a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" stroke="currentColor" stroke-width="1.5"/><path d="M4 8v10a2 2 0 002 2h12a2 2 0 002-2V8" stroke="currentColor" stroke-width="1.5"/><path d="M10 12h4M12 10v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          Money-Back Guarantee
        </div>
      </div>

      {%- comment -%} Social icons {%- endcomment -%}
      <div class="vb-footer__socials">
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" class="vb-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_facebook != blank -%}
          <a href="{{ section.settings.social_facebook }}" class="vb-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_tiktok != blank -%}
          <a href="{{ section.settings.social_tiktok }}" class="vb-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_youtube != blank -%}
          <a href="{{ section.settings.social_youtube }}" class="vb-footer__social-link" aria-label="YouTube" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="4" stroke="currentColor" stroke-width="1.5"/><path d="M10 9l5 3-5 3V9z" fill="currentColor"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="vb-footer__nav-col">
      <p class="vb-footer__col-heading">Shop</p>
      <ul class="vb-footer__links" role="list">
        <li><a href="/collections/all">All Products</a></li>
        <li><a href="/collections/bundles">Bundles & Combos</a></li>
        <li><a href="/collections/femina">Femina™</a></li>
        <li><a href="/collections/gutslim">GutSlim™</a></li>
        <li><a href="/collections/velo16">Velo16™</a></li>
        <li><a href="/collections/biokid">BioKid™</a></li>
        <li><a href="/collections/his-biotics">His-Biotics™</a></li>
        <li><a href="/collections/her-biotics">Her-Biotics™</a></li>
      </ul>
    </div>

    <div class="vb-footer__nav-col">
      <p class="vb-footer__col-heading">Learn</p>
      <ul class="vb-footer__links" role="list">
        <li><a href="/pages/our-science">Our Science & Technology</a></li>
        <li><a href="/pages/quiz">Product Recommendation Quiz</a></li>
        <li><a href="/blogs/news">Health Blog</a></li>
        <li><a href="/pages/about">About Velobiotics</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
      </ul>
    </div>

    <div class="vb-footer__nav-col">
      <p class="vb-footer__col-heading">Support</p>
      <ul class="vb-footer__links" role="list">
        <li><a href="/pages/contact">Contact Us</a></li>
        <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
        <li><a href="/policies/refund-policy">Returns & Refunds</a></li>
        <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
        <li><a href="/policies/terms-of-service">Terms of Service</a></li>
        <li><a href="{{ routes.account_url }}">My Account</a></li>
      </ul>
    </div>

  </div>

  {%- comment -%} Bottom bar {%- endcomment -%}
  <div class="vb-footer__bottom">
    <div class="vb-footer__bottom-inner page-width">
      <p class="vb-footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        Registered in South Africa. Products not intended to diagnose, treat, cure, or prevent any disease.
      </p>
      <div class="vb-footer__payment-icons" aria-label="Accepted payment methods">
        <span class="vb-footer__payment-badge">Visa</span>
        <span class="vb-footer__payment-badge">Mastercard</span>
        <span class="vb-footer__payment-badge">EFT</span>
        <span class="vb-footer__payment-badge">Instant EFT</span>
        <span class="vb-footer__payment-badge">PayFlex</span>
      </div>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "VB Footer",
  "tag": "div",
  "class": "vb-section",
  "settings": [
    { "type": "image_picker", "id": "footer_logo",      "label": "Footer logo" },
    { "type": "text",         "id": "social_instagram",  "label": "Instagram URL" },
    { "type": "text",         "id": "social_facebook",   "label": "Facebook URL" },
    { "type": "text",         "id": "social_tiktok",     "label": "TikTok URL" },
    { "type": "text",         "id": "social_youtube",    "label": "YouTube URL" }
  ],
  "presets": [{ "name": "VB Footer" }]
}
{% endschema %}
