{%- comment -%}
  VB · Brand family — image-based brand cards, each linking to its branded collection
{%- endcomment -%}

<style>
  .vb-bf { padding: 72px 24px; max-width: 1280px; margin: 0 auto; }
  .vb-bf__head { text-align: center; max-width: 760px; margin: 0 auto 44px; }
  .vb-bf__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-bf__title { font-size: clamp(28px, 4vw, 44px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; letter-spacing: -0.01em; }
  .vb-bf__title em { color: #4d8c44; font-style: normal; }
  .vb-bf__sub { font-size: 16.5px; line-height: 1.6; color: #5c6664; margin: 0; }
  .vb-bf__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
  .vb-bf__card { position: relative; padding: 0; border-radius: 20px; text-decoration: none; color: inherit; overflow: hidden; transition: transform 0.22s ease, box-shadow 0.22s ease; display: flex; flex-direction: column; min-height: 320px; background: var(--card-bg, #f3f7f1); border: 1px solid rgba(0,0,0,0.06); }
  .vb-bf__card:hover { transform: translateY(-6px); box-shadow: 0 28px 56px rgba(0, 0, 0, 0.16); }
  .vb-bf__card-media { position: relative; width: 100%; aspect-ratio: 1 / 0.78; overflow: hidden; background: linear-gradient(160deg, #fff 0%, var(--card-bg, #f3f7f1) 100%); }
  .vb-bf__card-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.45s ease; }
  .vb-bf__card:hover .vb-bf__card-media img { transform: scale(1.06); }
  .vb-bf__card-pill { position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.94); color: var(--card-accent, #4d8c44); padding: 5px 11px; border-radius: 999px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; backdrop-filter: blur(8px); z-index: 2; box-shadow: 0 6px 14px rgba(0,0,0,0.08); }
  .vb-bf__card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; background: #fff; }
  .vb-bf__card-logo { font-size: 22px; font-weight: 800; color: var(--card-accent, #4d8c44); letter-spacing: -0.02em; margin: 0 0 6px; line-height: 1.1; }
  .vb-bf__card-tag { font-size: 13px; color: #5c6664; margin: 0 0 14px; line-height: 1.4; flex: 1; }
  .vb-bf__card-cta { font-size: 12.5px; font-weight: 700; color: var(--card-accent, #4d8c44); letter-spacing: 0.02em; display: inline-flex; align-items: center; gap: 4px; transition: gap 0.18s ease; align-self: flex-start; }
  .vb-bf__card:hover .vb-bf__card-cta { gap: 8px; }
  @media (max-width: 749px) {
    .vb-bf { padding: 48px 14px; }
    .vb-bf__head { margin-bottom: 28px; }
    .vb-bf__grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .vb-bf__card { min-height: 240px; border-radius: 16px; }
    .vb-bf__card-pill { font-size: 9px; padding: 4px 9px; }
    .vb-bf__card-body { padding: 12px 14px 14px; }
    .vb-bf__card-logo { font-size: 16px; }
    .vb-bf__card-tag { font-size: 11.5px; margin-bottom: 8px; }
    .vb-bf__card-cta { font-size: 11px; }
  }
</style>

<section class="vb-bf">
  <div class="vb-bf__head">
    {%- if section.settings.eyebrow != blank -%}<p class="vb-bf__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="vb-bf__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
    {%- if section.settings.sub != blank -%}<p class="vb-bf__sub">{{ section.settings.sub }}</p>{%- endif -%}
  </div>
  <div class="vb-bf__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'brand' -%}
        {%- liquid
          assign card_img = ''
          if block.settings.image_url != blank
            assign card_img = block.settings.image_url
          elsif block.settings.image != blank
            assign card_img = block.settings.image | image_url: width: 600
          endif
        -%}
        <a href="{{ block.settings.link }}" class="vb-bf__card" style="--card-bg: {{ block.settings.bg }}; --card-accent: {{ block.settings.accent }};" {{ block.shopify_attributes }}>
          <div class="vb-bf__card-media">
            {%- if card_img != blank -%}
              <img src="{{ card_img }}" alt="{{ block.settings.brand_name | escape }}" loading="lazy" />
            {%- endif -%}
            {%- if block.settings.tagline != blank -%}<span class="vb-bf__card-pill">{{ block.settings.tagline }}</span>{%- endif -%}
          </div>
          <div class="vb-bf__card-body">
            <span class="vb-bf__card-logo">{{ block.settings.brand_name }}</span>
            {%- if block.settings.target != blank -%}<p class="vb-bf__card-tag">{{ block.settings.target }}</p>{%- endif -%}
            <span class="vb-bf__card-cta">Explore <span>→</span></span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "VB · Brand family",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Velobiotics Family" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "Explore the" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Velobiotics Family" },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "From women's intimate care to kids' immunity and digestive wellness — a targeted solution for every member of your family." }
  ],
  "blocks": [
    { "type": "brand", "name": "Brand card", "settings": [
      { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Femina™" },
      { "type": "text", "id": "tagline", "label": "Pill text", "default": "Intimate Health" },
      { "type": "text", "id": "target", "label": "Target line", "default": "For women" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "image_picker", "id": "image", "label": "Card image (uploaded)" },
      { "type": "text", "id": "image_url", "label": "Card image URL (overrides upload)" },
      { "type": "color", "id": "bg", "label": "Card background", "default": "#fdf8fd" },
      { "type": "color", "id": "accent", "label": "Accent colour", "default": "#8d2a89" }
    ]}
  ],
  "presets": [
    { "name": "VB · Brand family", "blocks": [
