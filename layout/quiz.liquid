<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta http-equiv="X-UA-Compatible" content="IE=edge"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#4d8c44">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
  <title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,700;0,800;1,700&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <style>html,body{margin:0;padding:0;background:#fdf9f1}body{font-family:Poppins,Arial,sans-serif}
  /* quiz layout: no header, footer, announcement, chat or pop-ups */
  #omnisend-forms-wrapper,.omnisend-form-wrapper,[id^="omnisend-form"],#zipchat-root,[id*="zipchat"],[class*="zipchat"],.jdgm-floating-tab,#judgeme_floating_tab,#shopify-pc__banner{display:none !important}</style>
</head>
<body class="vbq-layout">
  <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
</body>
</html>