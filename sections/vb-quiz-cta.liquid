{%- comment -%}
  VB · Quiz CTA — personalised recommendation banner
{%- endcomment -%}

<style>
  .vb-quiz { padding: 56px 24px; max-width: 1280px; margin: 0 auto; }
  .vb-quiz__inner { position: relative; background: linear-gradient(135deg, #4d8c44 0%, #6ec56e 100%); border-radius: 28px; padding: 56px 48px; overflow: hidden; display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center; box-shadow: 0 24px 56px rgba(77, 140, 68, 0.28); }
  .vb-quiz__inner::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 80% 50%, rgba(255,255,255,0.16) 0%, transparent 50%), radial-gradient(circle at 20% 90%, rgba(255,255,255,0.10) 0%, transparent 50%); pointer-events: none; }
  .vb-quiz__body { position: relative; z-index: 2; color: #fff; }
  .vb-quiz__eyebrow { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.18); color: #fff; padding: 7px 14px; border-radius: 999px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 18px; border: 1px solid rgba(255,255,255,0.28); backdrop-filter: blur(8px); }
  .vb-quiz__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; line-height: 1.1; margin: 0 0 14px; color: #fff !important; letter-spacing: -0.01em; }
  .vb-quiz__title em { font-style: italic; color: #fffaca; font-weight: 700; }
  .vb-quiz__sub { font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.94); margin: 0 0 26px; max-width: 560px; }
  .vb-quiz__cta { display: inline-flex; align-items: center; gap: 8px; padding: 16px 34px; border-radius: 999px; background: #fff; color: #36632f !important; text-decoration: none; font-weight: 800; font-size: 15.5px; box-shadow: 0 16px 32px rgba(0,0,0,0.22); transition: transform 0.18s ease, box-shadow 0.18s ease; }
  .vb-quiz__cta:hover { transform: translateY(-3px); box-shadow: 0 22px 40px rgba(0,0,0,0.30); }
  .vb-quiz__cta::after { content: '→'; transition: transform 0.18s ease; }
  .vb-quiz__cta:hover::after { transform: translateX(4px); }
  .vb-quiz__sub-cta { display: inline-block; margin-left: 14px; color: rgba(255,255,255,0.88); font-size: 13px; font-weight: 600; }
  .vb-quiz__visual { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; }
  .vb-quiz__steps { display: grid; gap: 12px; width: 100%; max-width: 320px; }
  .vb-quiz__step { display: flex; align-items: center; gap: 14px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.22); border-radius: 14px; padding: 14px 16px; backdrop-filter: blur(10px); }
  .vb-quiz__step-num { width: 32px; height: 32px; border-radius: 50%; background: #fff; color: #4d8c44; font-weight: 900; font-size: 13px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .vb-quiz__step-text { color: #fff; font-size: 13.5px; font-weight: 700; line-height: 1.3; }
  @media (max-width: 749px) {
    .vb-quiz { padding: 36px 14px; }
    .vb-quiz__inner { grid-template-columns: 1fr; padding: 32px 22px; border-radius: 20px; gap: 24px; }
    .vb-quiz__cta { padding: 14px 26px; font-size: 14px; }
    .vb-quiz__sub-cta { display: block; margin: 12px 0 0; }
    .vb-quiz__steps { max-width: 100%; }
    .vb-quiz__step { padding: 12px 14px; }
    .vb-quiz__step-text { font-size: 12.5px; }
  }
</style>

<section class="vb-quiz">
  <div class="vb-quiz__inner">
    <div class="vb-quiz__body">
      {%- if section.settings.eyebrow != blank -%}<span class="vb-quiz__eyebrow">⚡ {{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vb-quiz__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
      {%- if section.settings.sub != blank -%}<p class="vb-quiz__sub">{{ section.settings.sub }}</p>{%- endif -%}
      <div>
        {%- if section.settings.cta_text != blank -%}<a href="{{ section.settings.cta_link | default: '#' }}" class="vb-quiz__cta">{{ section.settings.cta_text }}</a>{%- endif -%}
        {%- if section.settings.sub_cta != blank -%}<span class="vb-quiz__sub-cta">{{ section.settings.sub_cta }}</span>{%- endif -%}
      </div>
    </div>
    <div class="vb-quiz__visual">
      <div class="vb-quiz__steps">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div class="vb-quiz__step" {{ block.shopify_attributes }}>
              <span class="vb-quiz__step-num">{{ forloop.index }}</span>
              <span class="vb-quiz__step-text">{{ block.settings.text }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Quiz CTA",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Personalised Recommendation" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "Not Sure Which Probiotic Is Right for You?" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Let's Find Out." },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Answer a few quick questions and we'll match you with the perfect Velobiotics formula for your gut, your goals, and your lifestyle." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Take the 2-minute Quiz" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "text", "id": "sub_cta", "label": "Sub-CTA text", "default": "Free · No email required" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "limit": 4, "settings": [
      { "type": "text", "id": "text", "label": "Step text", "default": "Tell us about your gut" }
    ]}
  ],
  "presets": [
    { "name": "VB · Quiz CTA", "blocks": [
      { "type": "step", "settings": { "text": "Tell us about your wellness goals" } },
      { "type": "step", "settings": { "text": "Answer a few lifestyle questions" } },
      { "type": "step", "settings": { "text": "Get your personalised formula match" } }
    ]}
  ]
}
{% endschema %}
