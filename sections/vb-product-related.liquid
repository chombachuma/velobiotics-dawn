{%- comment -%}
  VB · Related Products — 4-product carousel, Add-to-Cart JS (immediate add via /cart/add.js)
{%- endcomment -%}

{%- liquid
  assign bp = section.settings.brand_primary | default: '#4d8c44'
  assign bt = section.settings.brand_tint | default: '#f3f7f1'
  assign bd = section.settings.brand_dark | default: '#36632f'
  assign use_tint_bg = section.settings.tint
-%}

<style>
  .vb-pr { padding: 40px 20px; max-width: 1280px; margin: 0 auto; --bp: {{ bp }}; --bt: {{ bt }}; --bd: {{ bd }}; {% if use_tint_bg %}background: var(--bt); border-radius: 24px; margin-top: 40px; margin-bottom: 40px;{% endif %} }
  .vb-pr__head { text-align: center; margin: 0 0 28px; }
  .vb-pr__eyebrow { display: inline-flex; align-items: center; gap: 6px; background: color-mix(in srgb, var(--bp) 12%, #fff); color: var(--bp); padding: 6px 13px; border-radius: 999px; font-size: 11.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-pr__title { font-size: clamp(22px, 3vw, 30px); font-weight: 800; color: #1a1a1a; margin: 0 0 6px; letter-spacing: -0.01em; }
  .vb-pr__sub { font-size: 14px; color: #5c6664; margin: 0; }
  .vb-pr__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .vb-pr__card { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 6px 18px rgba(0,0,0,0.05); border: 1px solid #f0eaf0; display: flex; flex-direction: column; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .vb-pr__card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(0,0,0,0.1); }
  .vb-pr__img-wrap { aspect-ratio: 1/1; background: var(--bt); padding: 14px; position: relative; display: block; }
  .vb-pr__img-wrap img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .vb-pr__badge { position: absolute; top: 10px; left: 10px; background: var(--bp); color: #fff; font-size: 10px; font-weight: 800; padding: 4px 10px; border-radius: 999px; letter-spacing: 0.04em; }
  .vb-pr__body { padding: 14px; flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .vb-pr__brand { font-size: 10.5px; font-weight: 800; color: var(--bp); letter-spacing: 0.06em; text-transform: uppercase; }
  .vb-pr__name { font-size: 14.5px; font-weight: 800; color: #1a1a1a; line-height: 1.3; text-decoration: none; }
  .vb-pr__name:hover { color: var(--bp); }
  .vb-pr__rating { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: #5c6664; }
  .vb-pr__rating .stars { color: #ffb43a; font-size: 11px; letter-spacing: 0.5px; }
  .vb-pr__price-row { display: flex; align-items: baseline; gap: 8px; margin-top: auto; }
  .vb-pr__price { font-size: 17px; font-weight: 800; color: #1a1a1a; }
  .vb-pr__compare { font-size: 12.5px; color: #a0a0a0; text-decoration: line-through; }
  .vb-pr__atc { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 9px 12px; background: var(--bp); color: #fff !important; border: none; border-radius: 999px; font-size: 12px; font-weight: 800; cursor: pointer; transition: all 0.18s ease; box-shadow: 0 6px 14px color-mix(in srgb, var(--bp) 22%, transparent); width: 100%; margin-top: 4px; }
  .vb-pr__atc:hover { background: var(--bd); transform: translateY(-1px); }
  .vb-pr__atc:disabled { opacity: 0.55; cursor: not-allowed; }
  .vb-pr__atc.is-added { background: #2d8f3a; }
  .vb-pr__atc.is-loading { opacity: 0.7; cursor: wait; }

  @media (max-width: 990px) { .vb-pr__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 749px) {
    .vb-pr { padding: 28px 14px; }
    .vb-pr__grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .vb-pr__name { font-size: 13px; }
    .vb-pr__price { font-size: 15.5px; }
    .vb-pr__atc { font-size: 11.5px; padding: 8px 10px; }
  }
</style>

<section class="vb-pr">
  <div class="vb-pr__head">
    <span class="vb-pr__eyebrow">{{ section.settings.eyebrow | default: 'Complete your routine' }}</span>
    <h2 class="vb-pr__title">{{ section.settings.title | default: 'You may also love' }}</h2>
    {%- if section.settings.sub != blank -%}<p class="vb-pr__sub">{{ section.settings.sub }}</p>{%- endif -%}
  </div>
  <div class="vb-pr__grid">
    {%- for block in section.blocks -%}
      {%- assign p = all_products[block.settings.product_handle] -%}
      {%- if p != blank and p.id -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        {%- assign saved_pct = 0 -%}
        {%- if v.compare_at_price > v.price -%}{%- assign diff_p = v.compare_at_price | minus: v.price -%}{%- assign saved_pct = diff_p | times: 100.0 | divided_by: v.compare_at_price | round -%}{%- endif -%}
        <div class="vb-pr__card" {{ block.shopify_attributes }}>
          <a href="{{ p.url }}" class="vb-pr__img-wrap">
            {%- if saved_pct > 0 -%}<span class="vb-pr__badge">−{{ saved_pct }}%</span>{%- endif -%}
            {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.title | escape }}" loading="lazy" />{%- endif -%}
          </a>
          <div class="vb-pr__body">
            {%- if block.settings.brand != blank -%}<span class="vb-pr__brand">{{ block.settings.brand }}</span>{%- endif -%}
            <a href="{{ p.url }}" class="vb-pr__name">{{ p.title }}</a>
            <span class="vb-pr__rating"><span class="stars">★★★★★</span> {{ block.settings.rating | default: '4.8' }} ({{ block.settings.reviews | default: '120+' }})</span>
            <div class="vb-pr__price-row">
              <span class="vb-pr__price">{{ v.price | money }}</span>
              {%- if v.compare_at_price > v.price -%}<span class="vb-pr__compare">{{ v.compare_at_price | money }}</span>{%- endif -%}
            </div>
            <button type="button" class="vb-pr__atc" data-vbpr-atc data-variant-id="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
              {% if v.available %}🛒 Add to Cart{% else %}Sold out{% endif %}
            </button>
          </div>
        </div>
      {%- elsif block.settings.fallback_title != blank -%}
        <div class="vb-pr__card" {{ block.shopify_attributes }}>
          {%- if block.settings.fallback_url != blank -%}<a href="{{ block.settings.fallback_url }}" class="vb-pr__img-wrap">{%- else -%}<div class="vb-pr__img-wrap">{%- endif -%}
            {%- if block.settings.fallback_image != blank -%}<img src="{{ block.settings.fallback_image | image_url: width: 500 }}" alt="" loading="lazy" />{%- endif -%}
          {%- if block.settings.fallback_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
          <div class="vb-pr__body">
            {%- if block.settings.brand != blank -%}<span class="vb-pr__brand">{{ block.settings.brand }}</span>{%- endif -%}
            <a href="{{ block.settings.fallback_url | default: '#' }}" class="vb-pr__name">{{ block.settings.fallback_title }}</a>
            <span class="vb-pr__rating"><span class="stars">★★★★★</span> {{ block.settings.rating | default: '4.8' }} ({{ block.settings.reviews | default: '120+' }})</span>
            <div class="vb-pr__price-row">
              <span class="vb-pr__price">{{ block.settings.fallback_price | default: 'R 0.00' }}</span>
            </div>
            <a href="{{ block.settings.fallback_url | default: '#' }}" class="vb-pr__atc">View →</a>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<script>
  (function(){
    document.querySelectorAll('.vb-pr [data-vbpr-atc]').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const id = btn.dataset.variantId;
        if (!id || btn.classList.contains('is-loading') || btn.classList.contains('is-added')) return;
        const originalText = btn.innerHTML;
        btn.classList.add('is-loading');
        btn.innerHTML = '⏳ Adding...';
        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: [{ id: parseInt(id), quantity: 1 }] })
          });
          if (!res.ok) throw new Error('Add failed');
          btn.classList.remove('is-loading');
          btn.classList.add('is-added');
          btn.innerHTML = '✓ Added';
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          if (window.location.pathname.indexOf('/cart') === -1) {
            // optional: open cart drawer if Dawn theme exposes it
            const cartDrawer = document.querySelector('cart-drawer');
            if (cartDrawer && typeof cartDrawer.open === 'function') cartDrawer.open();
            else if (cartDrawer && cartDrawer.classList) cartDrawer.classList.add('active', 'animate');
          }
          setTimeout(() => { btn.classList.remove('is-added'); btn.innerHTML = originalText; }, 2400);
        } catch (err) {
          btn.classList.remove('is-loading');
          btn.innerHTML = '⚠ Error — try cart';
          setTimeout(() => { btn.innerHTML = originalText; }, 2400);
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "VB · Related products",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "brand_primary", "label": "Brand primary", "default": "#4d8c44" },
    { "type": "color", "id": "brand_dark", "label": "Brand dark", "default": "#36632f" },
    { "type": "color", "id": "brand_tint", "label": "Brand tint", "default": "#f3f7f1" },
    { "type": "checkbox", "id": "tint", "label": "Tinted background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete your routine" },
    { "type": "text", "id": "title", "label": "Title", "default": "You may also love" },
    { "type": "text", "id": "sub", "label": "Subtitle" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "limit": 8, "settings": [
      { "type": "text", "id": "product_handle", "label": "Product handle" },
      { "type": "text", "id": "brand", "label": "Brand label", "default": "Femina™" },
      { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
      { "type": "text", "id": "reviews", "label": "Review count", "default": "120+" },
      { "type": "header", "content": "Fallback (if product handle missing)" },
      { "type": "text", "id": "fallback_title", "label": "Fallback title" },
      { "type": "url", "id": "fallback_url", "label": "Fallback URL" },
      { "type": "image_picker", "id": "fallback_image", "label": "Fallback image" },
      { "type": "text", "id": "fallback_price", "label": "Fallback price" }
    ]}
  ],
  "presets": [{ "name": "VB · Related products" }]
}
{% endschema %}
