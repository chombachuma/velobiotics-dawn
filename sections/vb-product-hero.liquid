{%- comment -%}
  VB · Product Hero v5 — native Subscription + Quantity Discount selectors
{%- endcomment -%}

{%- liquid
  assign product = product
  assign brand_primary = section.settings.brand_primary | default: '#4d8c44'
  assign brand_tint   = section.settings.brand_tint    | default: '#f3f7f1'
  assign brand_dark   = section.settings.brand_dark    | default: '#36632f'
  assign brand_label  = section.settings.brand_label   | default: 'Velobiotics™'
  assign current_variant = product.selected_or_first_available_variant

  assign default_match_raw = section.settings.default_plan_slug | default: 'every-2-months'
  assign default_match = default_match_raw | replace: '-', ' '
  assign has_subscription = false
  assign sub_plan_id = ''
  assign sub_plan_label = ''
  for group in product.selling_plan_groups
    for plan in group.selling_plans
      assign plan_name_lower = plan.name | downcase
      if plan_name_lower contains default_match
        assign sub_plan_id = plan.id
        assign sub_plan_label = plan.name
        assign has_subscription = true
        break
      endif
    endfor
    if has_subscription
      break
    endif
  endfor

  assign sub_pct_off = section.settings.sub_pct_off | default: 15
  assign sub_each_pct = 100 | minus: sub_pct_off
  assign sub_price = current_variant.price | times: sub_each_pct | divided_by: 100

  assign tier2_pct = section.settings.tier2_pct | default: 10
  assign tier3_pct = section.settings.tier3_pct | default: 15
  assign tier2_each_pct = 100 | minus: tier2_pct
  assign tier3_each_pct = 100 | minus: tier3_pct
  assign tier1_total = current_variant.price
  assign tier2_total = current_variant.price | times: 2 | times: tier2_each_pct | divided_by: 100
  assign tier3_total = current_variant.price | times: 3 | times: tier3_each_pct | divided_by: 100
  assign tier2_each = tier2_total | divided_by: 2
  assign tier3_each = tier3_total | divided_by: 3

  assign default_freq_days = section.settings.default_frequency_days | default: 60
  assign freq_label = 'Every 2 months'
  if default_freq_days == 30
    assign freq_label = 'Monthly'
  elsif default_freq_days == 90
    assign freq_label = 'Every 3 months'
  elsif default_freq_days == 14
    assign freq_label = 'Every 2 weeks'
  endif
-%}

<style>
  .vb-ph { padding: 24px 20px 24px; max-width: 1280px; margin: 0 auto; --bp: {{ brand_primary }}; --bd: {{ brand_dark }}; --bt: {{ brand_tint }}; overflow: hidden; }
  .vb-ph__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: flex-start; }
  .vb-ph__grid > * { min-width: 0; }
  .vb-pg { position: sticky; top: 80px; min-width: 0; }

  .vb-pg__track-wrap { position: relative; border-radius: 22px; overflow: hidden; background: var(--bt); margin: 0 0 14px; }
  .vb-pg__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none; }
  .vb-pg__track::-webkit-scrollbar { display: none; }
  .vb-pg__slide { flex: 0 0 100%; aspect-ratio: 1/1; scroll-snap-align: center; scroll-snap-stop: always; display: flex; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box; }
  .vb-pg__slide img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .vb-pg__save { position: absolute; top: 14px; right: 14px; background: radial-gradient(circle at 30% 30%, #ff5c8a 0%, #ff2e63 50%, #cd1f4c 100%); color: #fff; font-weight: 900; font-size: 16px; padding: 14px 8px; min-width: 64px; height: 64px; border-radius: 50%; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 10px 26px rgba(214, 39, 90, 0.45); transform: rotate(-8deg); border: 3px solid rgba(255,255,255,0.55); line-height: 1; text-align: center; z-index: 3; pointer-events: none; }
  .vb-pg__save small { font-size: 9px; font-weight: 800; letter-spacing: 0.08em; margin-top: 2px; }

  .vb-pg__dots { display: flex; gap: 6px; justify-content: center; margin: 10px 0 4px; }
  .vb-pg__dot { width: 8px; height: 8px; border-radius: 50%; background: color-mix(in srgb, var(--bp) 25%, #fff); border: none; padding: 0; cursor: pointer; transition: all 0.18s ease; }
  .vb-pg__dot.is-active { background: var(--bp); width: 22px; border-radius: 999px; }

  .vb-pg__thumbs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .vb-pg__thumb { aspect-ratio: 1/1; border-radius: 10px; overflow: hidden; background: var(--bt); border: 2px solid transparent; cursor: pointer; transition: border-color 0.18s ease, transform 0.18s ease; padding: 0; }
  .vb-pg__thumb img { width: 100%; height: 100%; object-fit: contain; padding: 6px; mix-blend-mode: multiply; }
  .vb-pg__thumb.is-active { border-color: var(--bp); }

  .vb-pb { min-width: 0; }
  .vb-pb__brand { display: inline-flex; align-items: center; gap: 8px; background: color-mix(in srgb, var(--bp) 12%, #fff); color: var(--bp); padding: 6px 13px; border-radius: 999px; font-size: 11.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-pb__pill { display: inline-flex; align-items: center; gap: 6px; background: #fff; color: var(--bp); padding: 4px 11px; border-radius: 999px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; border: 1px solid color-mix(in srgb, var(--bp) 25%, #fff); }
  .vb-pb__title { font-size: clamp(26px, 3.4vw, 36px); font-weight: 800; line-height: 1.15; margin: 0 0 12px; color: #1a1a1a; letter-spacing: -0.01em; }
  .vb-pb__rating { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 16px; font-size: 13.5px; color: #2b3a2a; flex-wrap: wrap; }
  .vb-pb__rating .stars { color: #ffb43a; letter-spacing: 1px; font-size: 15px; }
  .vb-pb__rating a { color: var(--bp); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .vb-pb__hook { font-size: 16px; line-height: 1.55; color: #4a5a48; margin: 0 0 20px; padding: 14px 16px; background: var(--bt); border-left: 3px solid var(--bp); border-radius: 4px 14px 14px 4px; }
  .vb-pb__benefits { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0 0 22px; }
  .vb-pb__benefit { display: flex; align-items: center; gap: 10px; padding: 11px 13px; background: var(--bt); border-radius: 12px; min-width: 0; }
  .vb-pb__benefit-icon { width: 32px; height: 32px; border-radius: 50%; background: #fff; color: var(--bp); display: inline-flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
  .vb-pb__benefit-text { font-size: 12.5px; font-weight: 700; color: #1a1a1a; line-height: 1.3; min-width: 0; }

  .vb-pb__variants-label, .vb-pb__group-label { font-size: 12.5px; font-weight: 800; color: #1a1a1a; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 10px; }
  .vb-pb__variants { display: grid; gap: 10px; margin: 0 0 20px; }
  .vb-pb__variant { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border: 2px solid #e3ece1; border-radius: 14px; cursor: pointer; transition: all 0.18s ease; background: #fff; }
  .vb-pb__variant:hover { border-color: var(--bp); }
  .vb-pb__variant input { position: absolute; opacity: 0; pointer-events: none; }
  .vb-pb__variant:has(input:checked) { border-color: var(--bp); background: color-mix(in srgb, var(--bp) 6%, #fff); box-shadow: 0 8px 20px color-mix(in srgb, var(--bp) 18%, transparent); }
  .vb-pb__variant-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .vb-pb__variant-name { font-size: 14.5px; font-weight: 800; color: #1a1a1a; }
  .vb-pb__variant-meta { font-size: 11.5px; color: #6c7a6b; font-weight: 600; }
  .vb-pb__variant-price-row { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; flex-shrink: 0; }
  .vb-pb__variant-price { font-size: 16px; font-weight: 800; color: #1a1a1a; }
  .vb-pb__variant-compare { font-size: 12px; color: #a0a0a0; text-decoration: line-through; }
  .vb-pb__variant-best { position: absolute; top: -10px; right: 14px; background: var(--bp); color: #fff; font-size: 9.5px; font-weight: 800; padding: 4px 9px; border-radius: 999px; letter-spacing: 0.06em; text-transform: uppercase; }

  /* ============ SUBSCRIPTION SELECTOR ============ */
  .vb-pb__sub-group { margin: 0 0 16px; }
  .vb-pb__sub-options { display: grid; gap: 10px; }
  .vb-pb__sub-opt { position: relative; display: block; padding: 16px 18px 16px 50px; background: #fff; border: 2px solid #e3ece1; border-radius: 14px; cursor: pointer; transition: all 0.18s ease; }
  .vb-pb__sub-opt:hover { border-color: var(--bp); }
  .vb-pb__sub-opt input { position: absolute; left: 18px; top: 22px; width: 20px; height: 20px; accent-color: var(--bp); cursor: pointer; margin: 0; }
  .vb-pb__sub-opt:has(input:checked) { border-color: var(--bp); background: color-mix(in srgb, var(--bp) 7%, #fff); box-shadow: 0 8px 20px color-mix(in srgb, var(--bp) 18%, transparent); }
  .vb-pb__sub-opt-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin: 0 0 4px; }
  .vb-pb__sub-opt-title { font-size: 14.5px; font-weight: 800; color: #1a1a1a; display: inline-flex; align-items: center; gap: 6px; }
  .vb-pb__sub-opt-price-group { display: inline-flex; align-items: baseline; gap: 8px; flex-shrink: 0; }
  .vb-pb__sub-opt-price { font-size: 17px; font-weight: 800; color: #1a1a1a; }
  .vb-pb__sub-opt-compare { font-size: 13px; color: #a0a0a0; text-decoration: line-through; }
  .vb-pb__sub-opt-sub { font-size: 12.5px; color: #5c6664; line-height: 1.4; }
  .vb-pb__sub-opt-badge { position: absolute; top: -10px; right: 14px; background: linear-gradient(135deg, var(--bp), var(--bd)); color: #fff; font-size: 9.5px; font-weight: 900; padding: 5px 11px; border-radius: 999px; letter-spacing: 0.08em; text-transform: uppercase; box-shadow: 0 6px 14px color-mix(in srgb, var(--bp) 45%, transparent); animation: vb-pb-badgepulse 2.6s ease-in-out infinite; }
  @keyframes vb-pb-badgepulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }
  .vb-pb__sub-opt-save { background: var(--bp); color: #fff; padding: 2px 8px; border-radius: 999px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.04em; margin-left: 6px; }
  /* Stand-out subscribe card */
  .vb-pb__sub-opt--star { position: relative; overflow: hidden; }
  .vb-pb__sub-opt--star::before { content: ''; position: absolute; inset: -3px; border-radius: 16px; background: linear-gradient(135deg, color-mix(in srgb, var(--bp) 65%, transparent), color-mix(in srgb, #ff9500 35%, transparent), color-mix(in srgb, var(--bp) 65%, transparent)); background-size: 200% 200%; opacity: 0; transition: opacity 0.3s ease; z-index: -1; animation: vb-pb-glow 4s ease-in-out infinite; }
  .vb-pb__sub-opt--star:has(input:checked)::before { opacity: 1; }
  @keyframes vb-pb-glow { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  .vb-pb__sub-opt--star:has(input:checked) { border-color: transparent; background: linear-gradient(135deg, color-mix(in srgb, var(--bp) 10%, #fff), color-mix(in srgb, var(--bp) 3%, #fff)); box-shadow: 0 14px 32px color-mix(in srgb, var(--bp) 28%, transparent); }
  .vb-pb__sub-perks { display: flex; gap: 6px; flex-wrap: wrap; margin: 8px 0 0; }
  .vb-pb__sub-perk { display: inline-flex; align-items: center; gap: 4px; background: var(--bp); color: #fff; padding: 4px 9px; border-radius: 999px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.04em; }
  .vb-pb__sub-perk--ship { background: linear-gradient(135deg, #ff9500, #b25800); }
  .vb-pb__sub-perk--social { background: #1a2e1a; }
  .vb-pb__sub-annual { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 13px; color: var(--bd); font-weight: 800; background: color-mix(in srgb, var(--bp) 8%, #fff); padding: 6px 11px; border-radius: 8px; border-left: 3px solid var(--bp); }
  .vb-pb__sub-annual-icon { font-size: 16px; }

  /* ============ QUANTITY DISCOUNT TIERS ============ */
  .vb-pb__tier-group { margin: 0 0 16px; }
  .vb-pb__tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .vb-pb__tier { position: relative; display: block; background: #fff; border: 2px solid #e3ece1; border-radius: 14px; padding: 18px 12px 14px; text-align: center; cursor: pointer; transition: all 0.2s ease; }
  .vb-pb__tier:hover { border-color: var(--bp); transform: translateY(-2px); }
  .vb-pb__tier input { position: absolute; opacity: 0; pointer-events: none; }
  .vb-pb__tier:has(input:checked) { border-color: var(--bp); background: color-mix(in srgb, var(--bp) 6%, #fff); box-shadow: 0 10px 24px color-mix(in srgb, var(--bp) 22%, transparent); }
  .vb-pb__tier--best { border-color: #ff9500; }
  .vb-pb__tier--best:hover { border-color: #ff9500; }
  .vb-pb__tier--best:has(input:checked) { border-color: #ff9500; background: linear-gradient(135deg, #fff8eb 0%, #fff 100%); box-shadow: 0 10px 26px rgba(255, 149, 0, 0.22); }
  .vb-pb__tier-badge { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); padding: 4px 10px; border-radius: 999px; font-size: 9.5px; font-weight: 900; letter-spacing: 0.08em; white-space: nowrap; }
  .vb-pb__tier--best .vb-pb__tier-badge { background: linear-gradient(135deg, #ff9500, #b25800); color: #fff; box-shadow: 0 4px 10px rgba(255, 149, 0, 0.35); }
  .vb-pb__tier-qty { font-size: 17px; font-weight: 900; color: #1a1a1a; letter-spacing: -0.01em; margin: 0 0 4px; }
  .vb-pb__tier-save { font-size: 11.5px; font-weight: 800; color: #5c6664; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 0.04em; }
  .vb-pb__tier--best .vb-pb__tier-save { color: #b25800; }
  .vb-pb__tier:has(input:checked) .vb-pb__tier-save { color: var(--bp); }
  .vb-pb__tier-price { font-size: 14.5px; font-weight: 800; color: #1a1a1a; line-height: 1.2; }
  .vb-pb__tier-each { font-size: 10.5px; color: #5c6664; font-weight: 600; margin-top: 3px; }

  .vb-pb__price-block { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; padding: 14px 16px; background: linear-gradient(135deg, var(--bt) 0%, #fff 100%); border-radius: 14px; margin: 0 0 14px; border: 1px solid color-mix(in srgb, var(--bp) 14%, transparent); }
  .vb-pb__price-block .price__container { display: inline-flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .vb-pb__price-now { font-size: 28px; font-weight: 900; color: #1a1a1a; letter-spacing: -0.02em; transition: color 0.3s ease; }
  .vb-pb__price-was { font-size: 14px; color: #a0a0a0; text-decoration: line-through; }
  .vb-pb__price-save { background: var(--bp); color: #fff; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.04em; }
  .vb-pb__price-mode { display: inline-flex; align-items: center; gap: 4px; background: color-mix(in srgb, var(--bp) 14%, #fff); color: var(--bd); padding: 3px 9px; border-radius: 999px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; }
  .vb-pb__price-mode:empty { display: none; }
  .vb-pb__price-block.is-sub .vb-pb__price-now { color: var(--bd); }
  .vb-pb__price-unit { display: block; width: 100%; font-size: 11.5px; color: #6c7a6b; font-weight: 600; }
  .vb-pb__shipnote { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: color-mix(in srgb, var(--bp) 8%, #fff); border-radius: 12px; margin: 0 0 14px; font-size: 13px; color: #2b3a2a; font-weight: 600; }
  .vb-pb__shipnote-icon { color: var(--bp); font-size: 16px; }

  .vb-pb__qty-row { display: flex; align-items: stretch; gap: 12px; margin: 0 0 14px; }
  .vb-pb__qty { display: inline-flex; align-items: center; border: 2px solid #e3ece1; border-radius: 999px; overflow: hidden; flex-shrink: 0; }
  .vb-pb__qty button { width: 40px; height: 48px; background: #fff; border: none; font-size: 18px; font-weight: 700; cursor: pointer; color: #1a1a1a; }
  .vb-pb__qty button:hover { background: var(--bt); color: var(--bp); }
  .vb-pb__qty input { width: 44px; height: 48px; border: none; text-align: center; font-size: 15px; font-weight: 800; outline: none; -moz-appearance: textfield; background: #fff; }
  .vb-pb__qty input::-webkit-outer-spin-button, .vb-pb__qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .vb-pb__atc { flex: 1; min-width: 0; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 24px; background: var(--bp); color: #fff !important; border: none; border-radius: 999px; font-weight: 800; font-size: 15px; cursor: pointer; transition: all 0.18s ease; box-shadow: 0 12px 26px color-mix(in srgb, var(--bp) 32%, transparent); }
  .vb-pb__atc:hover { background: var(--bd); transform: translateY(-2px); }
  .vb-pb__atc.is-added { background: #2d8f3a; }
  .vb-pb__atc.is-loading { opacity: 0.7; cursor: wait; }
  .vb-pb__buynow { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 14px 24px; background: #1a1a1a; color: #fff !important; border: none; border-radius: 999px; font-weight: 800; font-size: 14px; cursor: pointer; transition: background-color 0.18s ease; margin: 0 0 14px; }
  .vb-pb__buynow:hover { background: #000; }

  .vb-pb__pay { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-content: center; padding: 12px 8px; margin: 0 0 16px; border-top: 1px dashed #e3ece1; border-bottom: 1px dashed #e3ece1; }
  .vb-pb__pay-label { font-size: 10.5px; font-weight: 700; color: #6c7a6b; letter-spacing: 0.08em; text-transform: uppercase; margin-right: 4px; }
  .vb-pb__pay-icon { height: 22px; padding: 2px 6px; background: #fff; border: 1px solid #e3ece1; border-radius: 6px; font-size: 11px; font-weight: 800; color: #1a1a1a; display: inline-flex; align-items: center; min-width: 40px; justify-content: center; letter-spacing: 0.02em; white-space: nowrap; }

  .vb-pb__trust { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 0 0 18px; }
  .vb-pb__trust-item { display: flex; align-items: center; gap: 8px; padding: 9px 11px; background: #fff; border: 1px solid #e3ece1; border-radius: 11px; font-size: 12px; color: #1a1a1a; font-weight: 600; min-width: 0; }
  .vb-pb__trust-item span:first-child { color: var(--bp); font-size: 15px; flex-shrink: 0; }
  .vb-pb__trust-item span:last-child { min-width: 0; }

  .vb-pb__testi-marquee { overflow: hidden; padding: 14px 0; margin-top: 6px; border-top: 1px solid #e3ece1; width: 100%; max-width: 100%; position: relative; }
  .vb-pb__testi-track { display: flex; gap: 14px; white-space: nowrap; animation: vb-pb-testi 32s linear infinite; width: max-content; will-change: transform; }
  .vb-pb__testi-marquee:hover .vb-pb__testi-track { animation-play-state: paused; }
  @keyframes vb-pb-testi { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .vb-pb__testi { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; background: var(--bt); border-radius: 999px; font-size: 12px; color: #2b3a2a; white-space: nowrap; flex-shrink: 0; }
  .vb-pb__testi .stars { color: #ffb43a; letter-spacing: 0.5px; font-size: 10px; }
  .vb-pb__testi strong { color: var(--bp); font-weight: 800; }

  @media (max-width: 990px) {
    .vb-ph__grid { grid-template-columns: 1fr; gap: 28px; }
    .vb-pg { position: static; }
    .vb-pg__thumbs { display: none; }
  }
  @media (max-width: 749px) {
    .vb-ph { padding: 16px 14px 24px; }
    .vb-pg__track-wrap { border-radius: 16px; }
    .vb-pb__title { font-size: clamp(22px, 5.6vw, 28px); }
    .vb-pb__benefits { grid-template-columns: 1fr 1fr; gap: 8px; }
    .vb-pb__benefit-icon { width: 28px; height: 28px; font-size: 14px; }
    .vb-pb__benefit-text { font-size: 11.5px; }
    .vb-pb__hook { font-size: 14.5px; padding: 12px 14px; }
    .vb-pb__price-now { font-size: 24px; }
    .vb-pb__atc { font-size: 14px; padding: 0 18px; }
    .vb-pb__qty button, .vb-pb__qty input { height: 44px; }
    .vb-pb__qty button { width: 36px; }
    .vb-pb__qty input { width: 38px; font-size: 14px; }
    .vb-pb__trust { gap: 6px; }
    .vb-pb__trust-item { font-size: 11px; padding: 7px 9px; }
    .vb-pg__save { min-width: 54px; height: 54px; font-size: 13.5px; top: 10px; right: 10px; }
    .vb-pb__pay-icon { font-size: 10px; height: 20px; min-width: 36px; padding: 2px 5px; }
    .vb-pb__price-now { font-size: 24px; }
    .vb-pb__testi { font-size: 11px; padding: 6px 11px; }
    .vb-pb__tier-qty { font-size: 14px; }
    .vb-pb__tier-price { font-size: 13px; }
    .vb-pb__tier { padding: 16px 8px 12px; }
    .vb-pb__sub-opt { padding: 14px 14px 14px 44px; }
    .vb-pb__sub-opt-title { font-size: 13px; }
    .vb-pb__sub-opt-price { font-size: 15px; }
  }
</style>

<section class="vb-ph" data-product-section data-product-id="{{ product.id }}">
  <div class="vb-ph__grid">
    <div class="vb-pg">
      <div class="vb-pg__track-wrap">
        <div class="vb-pg__track" data-vbpg-track>
          {%- if product.images.size > 0 -%}
            {%- for img in product.images limit: 10 -%}
              <div class="vb-pg__slide" data-vbpg-slide="{{ forloop.index0 }}">
                <img src="{{ img | image_url: width: 1200 }}" alt="{{ product.title | escape }} — image {{ forloop.index }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" />
              </div>
            {%- endfor -%}
          {%- elsif product.featured_image -%}
            <div class="vb-pg__slide"><img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" /></div>
          {%- endif -%}
        </div>
        {%- liquid
          assign savings_pct = 0
          if current_variant.compare_at_price > current_variant.price
            assign diff = current_variant.compare_at_price | minus: current_variant.price
            assign savings_pct = diff | times: 100.0 | divided_by: current_variant.compare_at_price | round
          endif
        -%}
        {%- if savings_pct > 0 -%}<span class="vb-pg__save" data-vbpg-save>−{{ savings_pct }}%<small>SAVE</small></span>{%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="vb-pg__dots" data-vbpg-dots>
          {%- for img in product.images limit: 10 -%}
            <button type="button" class="vb-pg__dot{% if forloop.first %} is-active{% endif %}" data-vbpg-dot="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
        <div class="vb-pg__thumbs">
          {%- for img in product.images limit: 10 -%}
            <button class="vb-pg__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-vbpg-thumb="{{ forloop.index0 }}">
              <img src="{{ img | image_url: width: 200 }}" alt="" loading="lazy" />
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="vb-pb">
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <span class="vb-pb__brand">{{ brand_label }}</span>
        {%- for tag in product.tags -%}{%- if tag contains 'pill:' -%}<span class="vb-pb__pill">{{ tag | remove_first: 'pill:' | strip }}</span>{%- endif -%}{%- endfor -%}
      </div>
      <h1 class="vb-pb__title">{{ product.title }}</h1>
      <div class="vb-pb__rating">
        <span class="stars">★★★★★</span>
        <strong>{{ section.settings.rating | default: '4.8' }}</strong>
        <a href="#vb-reviews">({{ section.settings.review_count | default: '3,500+' }} reviews)</a>
      </div>
      {%- if section.settings.hook != blank -%}<p class="vb-pb__hook">{{ section.settings.hook }}</p>{%- endif -%}
      {%- assign benefit_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'benefit' -%}{%- assign benefit_count = benefit_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if benefit_count > 0 -%}
        <div class="vb-pb__benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <div class="vb-pb__benefit" {{ block.shopify_attributes }}>
                <span class="vb-pb__benefit-icon">{{ block.settings.icon }}</span>
                <span class="vb-pb__benefit-text">{{ block.settings.text }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <form id="vbpForm" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-vbp-form>
        {%- if product.variants.size > 1 -%}
          <p class="vb-pb__variants-label">Choose your pack</p>
          <div class="vb-pb__variants">
            {%- for variant in product.variants -%}
              <label class="vb-pb__variant">
                <input type="radio" name="id" value="{{ variant.id }}" {% if variant == current_variant %}checked{% endif %} {% unless variant.available %}disabled{% endunless %} data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price }}" data-available="{{ variant.available }}" data-money-price="{{ variant.price | money }}" data-money-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}" />
                {%- if forloop.first -%}<span class="vb-pb__variant-best">Best value</span>{%- endif -%}
                <div class="vb-pb__variant-info">
                  <span class="vb-pb__variant-name">{{ variant.title }}</span>
                  <span class="vb-pb__variant-meta">{% if variant.available %}In stock{% else %}Sold out{% endif %}</span>
                </div>
                <div class="vb-pb__variant-price-row">
                  <span class="vb-pb__variant-price">{{ variant.price | money }}</span>
                  {%- if variant.compare_at_price > variant.price -%}<span class="vb-pb__variant-compare">{{ variant.compare_at_price | money }}</span>{%- endif -%}
                </div>
              </label>
            {%- endfor -%}
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" />
        {%- endif -%}

        {%- comment -%} ============ SUBSCRIPTION SELECTOR (replaces PayWhirl widget visually) ============ {%- endcomment -%}
        {%- if section.settings.show_subscription -%}
        <div class="vb-pb__sub-group" data-vbp-sub-group>
          <p class="vb-pb__group-label">🔁 Choose how you buy</p>
          <div class="vb-pb__sub-options">
            <label class="vb-pb__sub-opt">
              <input type="radio" name="purchase_mode" value="onetime" {% unless section.settings.default_subscribe %}checked{% endunless %} data-selling-plan="">
              <div class="vb-pb__sub-opt-row">
                <span class="vb-pb__sub-opt-title">One-time purchase</span>
                <span class="vb-pb__sub-opt-price-group">
                  <span class="vb-pb__sub-opt-price">{{ current_variant.price | money }}</span>
                </span>
              </div>
              <span class="vb-pb__sub-opt-sub">Single order · No commitment</span>
            </label>
            {%- liquid
              assign deliveries_per_year = 6
              if default_freq_days == 30
                assign deliveries_per_year = 12
              endif
              if default_freq_days == 90
                assign deliveries_per_year = 4
              endif
              if default_freq_days == 14
                assign deliveries_per_year = 26
              endif
              assign per_delivery_savings = current_variant.price | times: sub_pct_off | divided_by: 100
              assign annual_savings = per_delivery_savings | times: deliveries_per_year
            -%}
            <label class="vb-pb__sub-opt vb-pb__sub-opt--star">
              <span class="vb-pb__sub-opt-badge">✨ Best Value</span>
              <input type="radio" name="purchase_mode" value="subscribe" {% if section.settings.default_subscribe %}checked{% endif %} data-selling-plan="{{ sub_plan_id }}">
              <div class="vb-pb__sub-opt-row">
                <span class="vb-pb__sub-opt-title">🔁 Subscribe & Save <span class="vb-pb__sub-opt-save">−{{ sub_pct_off }}%</span></span>
                <span class="vb-pb__sub-opt-price-group">
                  <span class="vb-pb__sub-opt-price" data-vbp-sub-price>{{ sub_price | money }}</span>
                  <span class="vb-pb__sub-opt-compare" data-vbp-sub-compare>{{ current_variant.price | money }}</span>
                </span>
              </div>
              <span class="vb-pb__sub-opt-sub"><strong data-vbp-freq-label>{{ freq_label }} delivery</strong> · Pause, skip, or cancel anytime</span>
              <div class="vb-pb__sub-perks">
                <span class="vb-pb__sub-perk vb-pb__sub-perk--ship">🎁 FREE SHIPPING · No minimum</span>
                <span class="vb-pb__sub-perk">🔄 Cancel anytime</span>
                <span class="vb-pb__sub-perk vb-pb__sub-perk--social">★ 8,400+ subscribers</span>
              </div>
              <div class="vb-pb__sub-annual"><span class="vb-pb__sub-annual-icon">💚</span><span>You save <strong data-vbp-annual-save>{{ annual_savings | money }}</strong>/year vs one-time</span></div>
            </label>
          </div>
          {%- comment -%} Hidden field — populated by JS on radio change. Shopify natively reads `selling_plan` to attach the subscription. {%- endcomment -%}
          <input type="hidden" name="selling_plan" value="{% if section.settings.default_subscribe %}{{ sub_plan_id }}{% endif %}" data-vbp-selling-plan>

          {%- comment -%} Render any PayWhirl app block dragged into the section via Theme editor (kept for backward compat) {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div style="margin-top:10px">{% render block %}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

        {%- comment -%} ============ QUANTITY DISCOUNT TIERS (replaces Vital/HulkApps widget visually) ============ {%- endcomment -%}
        {%- if section.settings.show_qty_discount -%}
        <div class="vb-pb__tier-group" data-vbp-tier-group>
          <p class="vb-pb__group-label">💰 Stack & save more</p>
          <div class="vb-pb__tiers">
            <label class="vb-pb__tier">
              <input type="radio" name="qty_tier" value="1" checked>
              <div class="vb-pb__tier-qty">1 {{ section.settings.tier_unit | default: 'Bottle' }}</div>
              <div class="vb-pb__tier-save">Full Price</div>
              <div class="vb-pb__tier-price">{{ tier1_total | money }}</div>
            </label>
            <label class="vb-pb__tier">
              <input type="radio" name="qty_tier" value="2">
              <div class="vb-pb__tier-qty">2 {{ section.settings.tier_unit_plural | default: 'Bottles' }}</div>
              <div class="vb-pb__tier-save">Save {{ tier2_pct }}%</div>
              <div class="vb-pb__tier-price">{{ tier2_total | money }}</div>
              <div class="vb-pb__tier-each">{{ tier2_each | money }} each</div>
            </label>
            <label class="vb-pb__tier vb-pb__tier--best">
              <span class="vb-pb__tier-badge">★ BEST DEAL</span>
              <input type="radio" name="qty_tier" value="3">
              <div class="vb-pb__tier-qty">3 {{ section.settings.tier_unit_plural | default: 'Bottles' }}</div>
              <div class="vb-pb__tier-save">Save {{ tier3_pct }}%</div>
              <div class="vb-pb__tier-price">{{ tier3_total | money }}</div>
              <div class="vb-pb__tier-each">{{ tier3_each | money }} each</div>
            </label>
          </div>
          <p style="font-size:11.5px;color:#6c7a6b;margin:10px 0 0;text-align:center;font-weight:600">Discount automatically applied at checkout</p>
        </div>
        {%- endif -%}

        {%- comment -%}
          Price block — preserves regional pricing plugin compatibility.
          The plugin owns the BASE displayed text. Our JS reads the displayed value, applies subscription/qty multipliers,
          and re-renders in the same currency format. MutationObserver detects external plugin updates (e.g. region change)
          and re-applies our multiplier without breaking the plugin's localisation.
        {%- endcomment -%}
        <div class="vb-pb__price-block price" data-vbp-price-block data-base-price-cents="{{ current_variant.price }}" data-base-compare-cents="{{ current_variant.compare_at_price | default: 0 }}" data-sub-pct-off="{{ sub_pct_off }}" data-tier2-pct="{{ tier2_pct }}" data-tier3-pct="{{ tier3_pct }}" data-deliveries-per-year="{% if section.settings.default_frequency_days == 30 %}12{% elsif section.settings.default_frequency_days == 90 %}4{% elsif section.settings.default_frequency_days == 14 %}26{% else %}6{% endif %}">
          <span class="price__container">
            <span class="price-item price-item--regular vb-pb__price-now" data-vbp-price-display data-vbp-base-text="{{ current_variant.price | money }}">{{ current_variant.price | money }}</span>
            <span class="price-item price-item--regular vb-pb__price-was" data-vbp-compare-display data-vbp-base-compare-text="{{ current_variant.compare_at_price | money }}"{% if current_variant.compare_at_price <= current_variant.price %} style="display:none"{% endif %}>{{ current_variant.compare_at_price | money }}</span>
            <span class="vb-pb__price-save" data-vbp-save-display{% if current_variant.compare_at_price <= current_variant.price %} style="display:none"{% endif %}>SAVE −{{ savings_pct }}%</span>
            <span class="vb-pb__price-mode" data-vbp-mode-label></span>
          </span>
          {%- if current_variant.unit_price_measurement -%}
            <span class="vb-pb__price-unit">{{ current_variant.unit_price | money }} / {{ current_variant.unit_price_measurement.reference_value }} {{ current_variant.unit_price_measurement.reference_unit }}</span>
          {%- endif -%}
        </div>

        <div class="vb-pb__shipnote">
          <span class="vb-pb__shipnote-icon">🚚</span>
          <span>{{ section.settings.ship_note | default: 'Free shipping over the free-shipping threshold · 30-day money-back guarantee' }}</span>
        </div>

        <div class="vb-pb__qty-row">
          <div class="vb-pb__qty">
            <button type="button" aria-label="Decrease" data-qty-minus>−</button>
            <input type="number" name="quantity" value="1" min="1" data-vbp-qty />
            <button type="button" aria-label="Increase" data-qty-plus>+</button>
          </div>
          <button type="submit" class="vb-pb__atc" data-vbp-atc {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}🛒 Add to Cart{% else %}Sold out{% endif %}</button>
        </div>
        {%- if section.settings.show_buynow and current_variant.available -%}
          <button type="submit" name="checkout" class="vb-pb__buynow">⚡ Buy It Now</button>
        {%- endif -%}
      </form>

      <div class="vb-pb__pay">
        <span class="vb-pb__pay-label">We accept</span>
        <span class="vb-pb__pay-icon" style="color:#1a1f71;">VISA</span>
        <span class="vb-pb__pay-icon" style="color:#eb001b;">MC</span>
        <span class="vb-pb__pay-icon" style="color:#003087;">AMEX</span>
        <span class="vb-pb__pay-icon" style="color:#5f259f;">PayPal</span>
        <span class="vb-pb__pay-icon" style="color:#000;">Apple Pay</span>
        <span class="vb-pb__pay-icon" style="color:#4285f4;">G Pay</span>
        <span class="vb-pb__pay-icon" style="color:#5a31f4;">Shop</span>
      </div>

      <div class="vb-pb__trust">
        <div class="vb-pb__trust-item"><span>🚚</span><span>Free shipping over threshold</span></div>
        <div class="vb-pb__trust-item"><span>🔄</span><span>30-day money-back</span></div>
        <div class="vb-pb__trust-item"><span>🔬</span><span>Lab-tested every batch</span></div>
        <div class="vb-pb__trust-item"><span>🩺</span><span>Doctor-formulated</span></div>
      </div>

      {%- assign testi_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'testi' -%}{%- assign testi_count = testi_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if section.settings.show_testi_marquee and testi_count > 0 -%}
        <div class="vb-pb__testi-marquee" aria-label="Recent reviews">
          <div class="vb-pb__testi-track">
            {%- for i in (1..2) -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'testi' -%}
                  <span class="vb-pb__testi"><span class="stars">★★★★★</span> "{{ block.settings.quote }}" — <strong>{{ block.settings.author }}</strong></span>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function(){
    const root = document.querySelector('.vb-ph');
    if (!root) return;
    const track = root.querySelector('[data-vbpg-track]');
    const slides = root.querySelectorAll('[data-vbpg-slide]');
    const dots = root.querySelectorAll('[data-vbpg-dot]');
    const thumbs = root.querySelectorAll('[data-vbpg-thumb]');
    const setActive = (idx) => {
      dots.forEach(d => d.classList.toggle('is-active', parseInt(d.dataset.vbpgDot) === idx));
      thumbs.forEach(t => t.classList.toggle('is-active', parseInt(t.dataset.vbpgThumb) === idx));
    };
    const goTo = (idx) => {
      if (!slides[idx]) return;
      track.scrollTo({left: slides[idx].offsetLeft, behavior: 'smooth'});
      setActive(idx);
    };
    dots.forEach(d => d.addEventListener('click', () => goTo(parseInt(d.dataset.vbpgDot))));
    thumbs.forEach(t => t.addEventListener('click', () => goTo(parseInt(t.dataset.vbpgThumb))));
    let scrollT;
    track?.addEventListener('scroll', () => {
      clearTimeout(scrollT);
      scrollT = setTimeout(() => {
        const idx = Math.round(track.scrollLeft / track.clientWidth);
        setActive(idx);
      }, 80);
    });

    const qty = root.querySelector('[data-vbp-qty]');
    root.querySelector('[data-qty-minus]')?.addEventListener('click', () => { qty.value = Math.max(1, parseInt(qty.value||1)-1); qty.dispatchEvent(new Event('input',{bubbles:true})); });
    root.querySelector('[data-qty-plus]')?.addEventListener('click', () => { qty.value = parseInt(qty.value||1)+1; qty.dispatchEvent(new Event('input',{bubbles:true})); });

    /* ============ Subscription radio → set selling_plan hidden input ============ */
    const sellingInput = root.querySelector('[data-vbp-selling-plan]');
    root.querySelectorAll('input[name="purchase_mode"]').forEach(r => {
      r.addEventListener('change', () => {
        if (sellingInput) sellingInput.value = r.dataset.sellingPlan || '';
      });
    });

    /* ============ Quantity tier radio → set quantity input ============ */
    root.querySelectorAll('input[name="qty_tier"]').forEach(r => {
      r.addEventListener('change', () => {
        if (qty) qty.value = parseInt(r.value, 10) || 1;
      });
    });

    /* When user manually changes qty via stepper, sync the tier highlight */
    if (qty) {
      qty.addEventListener('input', () => {
        const v = parseInt(qty.value, 10);
        const tier = root.querySelector('input[name="qty_tier"][value="'+v+'"]');
        if (tier) {
          tier.checked = true;
        } else {
          /* For qty > 3, keep tier 3 selected (3+ tier) */
          if (v >= 3) {
            const t3 = root.querySelector('input[name="qty_tier"][value="3"]');
            if (t3) t3.checked = true;
          }
        }
      });
    }

    /* Variant change — only update variant ID + ATC availability. Prices NOT touched (regional pricing plugin owns them) */
    const atcBtn = root.querySelector('[data-vbp-atc]');
    root.querySelectorAll('input[name="id"]').forEach(r => {
      r.addEventListener('change', () => {
        const isAvailable = r.dataset.available === 'true';
        if (atcBtn) {
          atcBtn.disabled = !isAvailable;
          atcBtn.innerHTML = isAvailable ? '🛒 Add to Cart' : 'Sold out';
        }
        if (window.history && window.history.replaceState) {
          const u = new URL(window.location);
          u.searchParams.set('variant', r.value);
          window.history.replaceState({}, '', u);
        }
        document.dispatchEvent(new CustomEvent('variant:change', { detail: { variantId: r.value } }));
      });
    });

    /* ============ Dynamic price display ============
       Watches subscription + qty selection and updates the displayed price
       WITHOUT breaking regional pricing plugin compatibility.
       Approach:
         1. Read the currently-displayed price text (already localised by plugin)
         2. Parse currency format (prefix, decimal sep, thousand sep)
         3. Multiply by qty * factor
         4. Re-render in the same currency format
         5. MutationObserver detects when plugin re-renders (e.g. region change)
            and re-applies our multiplier without conflict.
    */
    const priceBlock = root.querySelector('[data-vbp-price-block]');
    const priceDisp = priceBlock?.querySelector('[data-vbp-price-display]');
    const compDisp = priceBlock?.querySelector('[data-vbp-compare-display]');
    const saveDisp = priceBlock?.querySelector('[data-vbp-save-display]');
    const modeLabel = priceBlock?.querySelector('[data-vbp-mode-label]');
    const subPriceDisp = root.querySelector('[data-vbp-sub-price]');
    const subCompareDisp = root.querySelector('[data-vbp-sub-compare]');
    const annualSaveDisp = root.querySelector('[data-vbp-annual-save]');

    let baseDisplayText = priceDisp?.textContent || '';
    let baseCompareText = compDisp?.textContent || '';
    let isInternalUpdate = false;

    function parseCurrency(text) {
      if (!text) return null;
      const m = String(text).trim().match(/^([^\d-]*)([\d., ]+)([^\d.,]*)$/);
      if (!m) return null;
      const prefix = m[1] || '';
      const suffix = m[3] || '';
      const numStr = m[2].replace(/ /g, '');
      const lastDot = numStr.lastIndexOf('.');
      const lastComma = numStr.lastIndexOf(',');
      let decimal = '.', thousand = ',';
      if (lastComma > lastDot && numStr.length - lastComma - 1 <= 2) { decimal = ','; thousand = '.'; }
      const clean = numStr.split('').map(c => c === decimal ? '.' : (c === thousand ? '' : c)).join('');
      const value = parseFloat(clean);
      if (!isFinite(value)) return null;
      return { prefix, suffix, decimal, thousand, value };
    }

    function formatCurrency(fmt, value) {
      if (!fmt) return String(value);
      const fixed = value.toFixed(2);
      const [maj, min] = fixed.split('.');
      const majSep = maj.replace(/\B(?=(\d{3})+(?!\d))/g, fmt.thousand);
      return `${fmt.prefix}${majSep}${fmt.decimal}${min}${fmt.suffix}`;
    }

    function setText(el, text) {
      if (!el) return;
      isInternalUpdate = true;
      el.textContent = text;
      setTimeout(() => { isInternalUpdate = false; }, 80);
    }

    function getCurrentFactors() {
      const isSub = !!root.querySelector('input[name="purchase_mode"][value="subscribe"]:checked');
      const qty = parseInt(root.querySelector('[data-vbp-qty]')?.value || '1', 10) || 1;
      const subPct = parseFloat(priceBlock?.dataset.subPctOff || '15') / 100;
      const t2 = parseFloat(priceBlock?.dataset.tier2Pct || '10') / 100;
      const t3 = parseFloat(priceBlock?.dataset.tier3Pct || '15') / 100;
      let factor = 1;
      if (isSub) factor *= (1 - subPct);
      if (qty >= 3) factor *= (1 - t3);
      else if (qty === 2) factor *= (1 - t2);
      return { isSub, qty, factor, subPct, t2, t3 };
    }

    function updatePriceDisplay() {
      if (!priceDisp) return;
      if (!baseDisplayText) baseDisplayText = priceDisp.textContent;
      const fmt = parseCurrency(baseDisplayText);
      if (!fmt) return;
      const { isSub, qty, factor } = getCurrentFactors();
      const total = fmt.value * qty * factor;
      const totalText = formatCurrency(fmt, total);
      setText(priceDisp, totalText);
      /* Compare = base × qty (no discount) — only show if there IS a discount */
      const compareVal = fmt.value * qty;
      if (factor < 1) {
        if (compDisp) {
          setText(compDisp, formatCurrency(fmt, compareVal));
          compDisp.style.display = '';
        }
        if (saveDisp) {
          const pct = Math.round((1 - factor) * 100);
          setText(saveDisp, `SAVE −${pct}%`);
          saveDisp.style.display = '';
        }
      } else {
        /* No discount — show compare only if variant has one (line-through on regular price) */
        const baseCompare = parseCurrency(baseCompareText);
        if (baseCompare && baseCompare.value > fmt.value) {
          if (compDisp) {
            setText(compDisp, formatCurrency(baseCompare, baseCompare.value * qty));
            compDisp.style.display = '';
          }
          if (saveDisp) {
            const sp = Math.round((1 - fmt.value / baseCompare.value) * 100);
            setText(saveDisp, `SAVE −${sp}%`);
            saveDisp.style.display = '';
          }
        } else {
          if (compDisp) compDisp.style.display = 'none';
          if (saveDisp) saveDisp.style.display = 'none';
        }
      }
      /* Mode label */
      if (modeLabel) {
        let label = '';
        if (isSub && qty > 1) label = `${qty}× per delivery · Subscription`;
        else if (isSub) label = 'Per delivery · Subscription';
        else if (qty > 1) label = `${qty} pack total`;
        setText(modeLabel, label);
      }
      /* Class on block for subscription styling */
      priceBlock.classList.toggle('is-sub', isSub);

      /* Update the subscription card's displayed price too (it shows base × sub factor for 1 unit) */
      if (subPriceDisp && fmt) {
        const subPct = parseFloat(priceBlock?.dataset.subPctOff || '15') / 100;
        setText(subPriceDisp, formatCurrency(fmt, fmt.value * (1 - subPct)));
      }
      if (subCompareDisp && fmt) {
        setText(subCompareDisp, formatCurrency(fmt, fmt.value));
      }
      if (annualSaveDisp && fmt) {
        const freq = parseInt(priceBlock?.dataset.deliveriesPerYear || '6', 10) || 6;
        const subPct2 = parseFloat(priceBlock?.dataset.subPctOff || '15') / 100;
        const yearSav = fmt.value * subPct2 * freq;
        setText(annualSaveDisp, formatCurrency(fmt, yearSav));
      }
    }

    /* MutationObserver — re-capture base when plugin updates display externally */
    if (priceDisp) {
      const obs = new MutationObserver(() => {
        if (isInternalUpdate) return;
        /* External update — re-capture base then re-apply */
        baseDisplayText = priceDisp.textContent;
        const { factor, qty } = getCurrentFactors();
        if (factor !== 1 || qty !== 1) updatePriceDisplay();
      });
      obs.observe(priceDisp, { childList: true, characterData: true, subtree: true });
    }
    if (compDisp) {
      const obs2 = new MutationObserver(() => {
        if (isInternalUpdate) return;
        baseCompareText = compDisp.textContent;
      });
      obs2.observe(compDisp, { childList: true, characterData: true, subtree: true });
    }

    /* Trigger updates */
    root.querySelectorAll('input[name="purchase_mode"]').forEach(r => r.addEventListener('change', updatePriceDisplay));
    root.querySelectorAll('input[name="qty_tier"]').forEach(r => r.addEventListener('change', () => setTimeout(updatePriceDisplay, 0)));
    if (qty) qty.addEventListener('input', () => setTimeout(updatePriceDisplay, 0));
    /* Variant change — re-cache base from new variant after plugin updates */
    root.querySelectorAll('input[name="id"]').forEach(r => {
      r.addEventListener('change', () => {
        baseDisplayText = '';
        baseCompareText = '';
        /* Update base attribute values from variant data */
        if (priceBlock) {
          priceBlock.dataset.basePriceCents = r.dataset.price || priceBlock.dataset.basePriceCents;
          priceBlock.dataset.baseCompareCents = r.dataset.compare || '0';
        }
        /* Reset displayed price to variant's localised base, then re-apply if needed */
        if (priceDisp && r.dataset.moneyPrice) setText(priceDisp, r.dataset.moneyPrice);
        if (compDisp && r.dataset.moneyCompare) {
          setText(compDisp, r.dataset.moneyCompare);
          compDisp.style.display = '';
        } else if (compDisp) {
          compDisp.style.display = 'none';
        }
        setTimeout(() => {
          if (priceDisp) baseDisplayText = priceDisp.textContent;
          if (compDisp) baseCompareText = compDisp.textContent;
          updatePriceDisplay();
        }, 300);
      });
    });
    /* Apply on first paint */
    setTimeout(updatePriceDisplay, 50);

    /* AJAX add to cart */
    const form = root.querySelector('[data-vbp-form]');
    if (form && atcBtn) {
      form.addEventListener('submit', async (e) => {
        const submitter = e.submitter;
        if (submitter && submitter.name === 'checkout') return;
        e.preventDefault();
        if (atcBtn.disabled || atcBtn.classList.contains('is-loading')) return;
        const original = atcBtn.innerHTML;
        atcBtn.classList.add('is-loading');
        atcBtn.innerHTML = '⏳ Adding...';
        try {
          const fd = new FormData(form);
          /* Strip empty selling_plan so Shopify treats as one-time */
          if (fd.get('selling_plan') === '') fd.delete('selling_plan');
          const res = await fetch('/cart/add.js', { method: 'POST', headers: { 'Accept': 'application/json' }, body: fd });
          if (!res.ok) throw new Error('Add failed');
          atcBtn.classList.remove('is-loading');
          atcBtn.classList.add('is-added');
          atcBtn.innerHTML = '✓ Added — redirecting...';
          window.location.href = '/cart';
        } catch (err) {
          atcBtn.classList.remove('is-loading');
          atcBtn.innerHTML = '⚠ Try again';
          setTimeout(() => { atcBtn.innerHTML = original; }, 2400);
        }
      });
    }
  })();
</script>

