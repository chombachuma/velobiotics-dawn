{%- comment -%}
  vb-icon: renders a named icon as an inline SVG (currentColor, 1em) so product-page blocks never show
  the icon's *name* as text. Unknown values (emoji, digits, symbols) pass straight through.
  Usage: {% render 'vb-icon', name: block.settings.icon, default: '✓' %}
{%- endcomment -%}
{%- assign n = name | default: default | strip | downcase -%}
{%- assign svg_open = '<svg class="vb-ico" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-0.125em">' -%}
{%- case n -%}
  {%- when 'check', 'tick' -%}{{ svg_open }}<path d="M20 6 9 17l-5-5"/></svg>
  {%- when 'alert', 'warning' -%}{{ svg_open }}<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
  {%- when 'shield' -%}{{ svg_open }}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'zap', 'bolt', 'lightning' -%}{{ svg_open }}<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
  {%- when 'heart' -%}{{ svg_open }}<path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3.4 1-4.5 2.5C10.9 4 9.3 3 7.5 3A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z"/></svg>
  {%- when 'sparkles', 'sparkle', 'star' -%}{{ svg_open }}<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 17v4"/><path d="M17 19h4"/><path d="M5 3v3"/><path d="M3.5 4.5h3"/></svg>
  {%- when 'refresh', 'cycle', 'renew' -%}{{ svg_open }}<path d="M21 12a9 9 0 0 1-15.4 6.4L3 16"/><path d="M3 21v-5h5"/><path d="M3 12a9 9 0 0 1 15.4-6.4L21 8"/><path d="M21 3v5h-5"/></svg>
  {%- when 'sun' -%}{{ svg_open }}<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.9 4.9 1.4 1.4"/><path d="m17.7 17.7 1.4 1.4"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.3 17.7-1.4 1.4"/><path d="m19.1 4.9-1.4 1.4"/></svg>
  {%- when 'moon', 'night', 'sleep' -%}{{ svg_open }}<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  {%- when 'leaf', 'plant', 'herb' -%}{{ svg_open }}<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.5 3.5-7"/></svg>
  {%- when 'berry', 'cranberry', 'fruit' -%}{{ svg_open }}<circle cx="9" cy="14" r="5"/><circle cx="16" cy="12" r="4"/><path d="M12 4c1.5 0 3 1 3.5 2.5"/><path d="M9 9V5"/></svg>
  {%- when 'pill', 'capsule' -%}{{ svg_open }}<path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7z"/><path d="m8.5 8.5 7 7"/></svg>
  {%- when 'bottle', 'jar' -%}{{ svg_open }}<path d="M9 2h6v3H9z"/><path d="M8 5h8l1 4v11a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V9z"/><path d="M8 13h8"/></svg>
  {%- when 'truck', 'shipping', 'delivery' -%}{{ svg_open }}<path d="M14 17H2V6h12v11z"/><path d="M14 9h4l4 4v4h-8z"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>
  {%- when 'lock', 'secure' -%}{{ svg_open }}<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
  {%- when 'drop', 'water' -%}{{ svg_open }}<path d="M12 2.7 6.8 9.4a6.5 6.5 0 1 0 10.4 0z"/></svg>
  {%- when 'brain' -%}{{ svg_open }}<path d="M9.5 2a2.5 2.5 0 0 0-2.4 3.2A3 3 0 0 0 4 8a3 3 0 0 0 .4 1.5A3 3 0 0 0 5 15a3 3 0 0 0 2.5 4.5A2.5 2.5 0 0 0 12 21V5a3 3 0 0 0-2.5-3z"/><path d="M14.5 2a2.5 2.5 0 0 1 2.4 3.2A3 3 0 0 1 20 8a3 3 0 0 1-.4 1.5A3 3 0 0 1 19 15a3 3 0 0 1-2.5 4.5A2.5 2.5 0 0 1 12 21V5a3 3 0 0 1 2.5-3z"/></svg>
  {%- when 'clock', 'time' -%}{{ svg_open }}<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
  {%- when 'flame', 'fire' -%}{{ svg_open }}<path d="M12 22c4.4 0 7-2.9 7-7 0-3-2-5.5-3.5-7-.5 2-1.5 3-3 3.5C12.5 8 12 5 9.5 2 8 5 5 8.5 5 15c0 4.1 2.6 7 7 7z"/></svg>
  {%- when 'target', 'aim' -%}{{ svg_open }}<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
  {%- when 'microscope', 'science', 'lab' -%}{{ svg_open }}<path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
  {%- else -%}{{ name | default: default }}
{%- endcase -%}
