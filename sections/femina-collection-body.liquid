{%- comment -%}
  Femina collection body — renders the rich collection.description below the hero.
  Drops the auto h1 title for a clean handoff from the hero.
{%- endcomment -%}

<style>
  .femina-body { padding: 28px 20px 12px; max-width: 1200px; margin: 0 auto; }
  .femina-body .femina-intro { max-width: 100% !important; }
  @media (max-width: 749px) {
    .femina-body { padding: 18px 14px 8px; }
    .femina-body .femina-intro [style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
    .femina-body .femina-intro [style*="display:flex"][style*="flex-wrap"] { gap: 10px 16px !important; }
  }
</style>

<div class="femina-body" id="femina-body-{{ section.id }}">
  {%- if collection.description != blank -%}
    <div class="rte femina-body__rte">{{ collection.description }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Femina collection body",
  "tag": "section",
  "class": "femina-collection-body",
  "settings": [
    { "type": "paragraph", "content": "Renders the rich Femina collection description (trust badges, stats, 3-step, testimonials) without a duplicate page title. Edit the actual content via Products → Collections → Femina → Description." }
  ],
  "presets": [
    { "name": "Femina collection body" }
  ]
}
{% endschema %}
