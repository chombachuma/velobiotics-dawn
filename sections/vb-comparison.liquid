{%- comment -%} VB · Velobiotics vs Others — head-to-head comparison table {%- endcomment -%}

<style>
  .vb-cmp { padding: 72px 24px; max-width: 1080px; margin: 0 auto; }
  .vb-cmp__head { text-align: center; max-width: 720px; margin: 0 auto 44px; }
  .vb-cmp__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-cmp__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; }
  .vb-cmp__title em { color: #4d8c44; font-style: normal; }
  .vb-cmp__sub { font-size: 16px; line-height: 1.6; color: #5c6664; margin: 0; }
  .vb-cmp__table { display: grid; grid-template-columns: 1.4fr 1fr 1fr; background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 24px 56px rgba(0,0,0,0.06); border: 1px solid #e3ece1; }
  .vb-cmp__cell { padding: 18px 22px; border-bottom: 1px solid #f0f3ee; display: flex; align-items: center; }
  .vb-cmp__cell--header { background: #f7faf6; font-weight: 700; }
  .vb-cmp__cell--us { background: rgba(77,140,68,0.05); }
  .vb-cmp__cell--feature { font-size: 14.5px; color: #1a1a1a; font-weight: 600; }
  .vb-cmp__head-us { font-size: 18px; font-weight: 900; color: #4d8c44; }
  .vb-cmp__head-them { font-size: 15px; font-weight: 700; color: #6c7a6b; }
  .vb-cmp__check { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; font-weight: 900; font-size: 13px; }
  .vb-cmp__check--yes { background: #4d8c44; color: #fff; }
  .vb-cmp__check--no { background: #fde7e7; color: #c93d3d; }
  .vb-cmp__check--partial { background: #fff3d1; color: #b88914; }
  .vb-cmp__value { font-size: 14px; font-weight: 700; }
  .vb-cmp__value--good { color: #4d8c44; }
  .vb-cmp__value--bad { color: #c93d3d; }
  .vb-cmp__bottom { text-align: center; margin-top: 28px; }
  .vb-cmp__cta { display: inline-flex; align-items: center; gap: 8px; padding: 14px 30px; border-radius: 999px; background: #4d8c44; color: #fff !important; text-decoration: none; font-weight: 700; font-size: 14.5px; box-shadow: 0 12px 26px rgba(77,140,68,0.28); transition: all 0.18s ease; }
  .vb-cmp__cta:hover { background: #36632f; transform: translateY(-2px); }
  @media (max-width: 749px) {
    .vb-cmp { padding: 48px 14px; }
    .vb-cmp__table { grid-template-columns: 1.2fr 0.9fr 0.9fr; border-radius: 14px; }
    .vb-cmp__cell { padding: 12px 12px; }
    .vb-cmp__cell--feature { font-size: 12.5px; }
    .vb-cmp__head-us { font-size: 14px; }
    .vb-cmp__head-them { font-size: 12.5px; }
    .vb-cmp__check { width: 24px; height: 24px; font-size: 11px; }
    .vb-cmp__value { font-size: 12px; }
  }
</style>

<section class="vb-cmp">
  <div class="vb-cmp__head">
    {%- if section.settings.eyebrow != blank -%}<p class="vb-cmp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="vb-cmp__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
    {%- if section.settings.sub != blank -%}<p class="vb-cmp__sub">{{ section.settings.sub }}</p>{%- endif -%}
  </div>
  <div class="vb-cmp__table">
    <div class="vb-cmp__cell vb-cmp__cell--header"></div>
    <div class="vb-cmp__cell vb-cmp__cell--header vb-cmp__cell--us"><span class="vb-cmp__head-us">{{ section.settings.us_label | default: 'Velobiotics™' }}</span></div>
    <div class="vb-cmp__cell vb-cmp__cell--header"><span class="vb-cmp__head-them">{{ section.settings.them_label | default: 'Other Probiotics' }}</span></div>
    {%- for block in section.blocks -%}
      {%- if block.type == 'row' -%}
        <div class="vb-cmp__cell vb-cmp__cell--feature" {{ block.shopify_attributes }}>{{ block.settings.feature }}</div>
        <div class="vb-cmp__cell vb-cmp__cell--us">
          {%- if block.settings.us_type == 'yes' -%}<span class="vb-cmp__check vb-cmp__check--yes">✓</span>
          {%- elsif block.settings.us_type == 'no' -%}<span class="vb-cmp__check vb-cmp__check--no">✗</span>
          {%- else -%}<span class="vb-cmp__value vb-cmp__value--good">{{ block.settings.us_value }}</span>{%- endif -%}
        </div>
        <div class="vb-cmp__cell">
          {%- if block.settings.them_type == 'yes' -%}<span class="vb-cmp__check vb-cmp__check--yes">✓</span>
          {%- elsif block.settings.them_type == 'no' -%}<span class="vb-cmp__check vb-cmp__check--no">✗</span>
          {%- elsif block.settings.them_type == 'partial' -%}<span class="vb-cmp__check vb-cmp__check--partial">!</span>
          {%- else -%}<span class="vb-cmp__value vb-cmp__value--bad">{{ block.settings.them_value }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.cta_text != blank -%}
    <div class="vb-cmp__bottom"><a href="{{ section.settings.cta_link | default: '#' }}" class="vb-cmp__cta">{{ section.settings.cta_text }} →</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "VB · Comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Velobiotics vs Others" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "See Why Thousands" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Choose Velobiotics" },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Velobiotics stands apart with real science, superior delivery technology, and formulas designed for actual results — not marketing." },
    { "type": "text", "id": "us_label", "label": "Us column label", "default": "Velobiotics™" },
    { "type": "text", "id": "them_label", "label": "Them column label", "default": "Other Probiotics" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop the Range" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Survives stomach acid" },
      { "type": "select", "id": "us_type", "label": "Us cell type", "options": [{"value":"yes","label":"Yes"},{"value":"no","label":"No"},{"value":"value","label":"Custom value"}], "default": "yes" },
      { "type": "text", "id": "us_value", "label": "Us value (if custom)", "default": "—" },
      { "type": "select", "id": "them_type", "label": "Them cell type", "options": [{"value":"yes","label":"Yes"},{"value":"no","label":"No"},{"value":"partial","label":"Partial"},{"value":"value","label":"Custom value"}], "default": "no" },
      { "type": "text", "id": "them_value", "label": "Them value (if custom)", "default": "—" }
    ]}
  ],
  "presets": [
    { "name": "VB · Comparison", "blocks": [
      { "type": "row", "settings": { "feature": "Patented MEP coating (survives stomach acid)", "us_type": "yes", "them_type": "no" } },
      { "type": "row", "settings": { "feature": "Probiotics that reach your gut alive", "us_type": "value", "us_value": "1000×", "them_type": "value", "them_value": "1%" } },
      { "type": "row", "settings": { "feature": "Doctor-formulated", "us_type": "yes", "them_type": "partial" } },
      { "type": "row", "settings": { "feature": "Clinically-studied strains", "us_type": "yes", "them_type": "partial" } },
      { "type": "row", "settings": { "feature": "Lab-tested every batch", "us_type": "yes", "them_type": "no" } },
      { "type": "row", "settings": { "feature": "30-day money-back guarantee", "us_type": "yes", "them_type": "no" } },
      { "type": "row", "settings": { "feature": "Verified customer reviews", "us_type": "value", "us_value": "3,500+", "them_type": "value", "them_value": "Mixed" } }
    ]}
  ]
}
{% endschema %}
