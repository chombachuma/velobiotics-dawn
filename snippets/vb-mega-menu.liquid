<style>
  .vb-mm, .vb-mm *, .vb-mmd, .vb-mmd *, .vb-mm-burger, .vb-mm-burger * {
    font-family: 'Poppins','Helvetica Neue',Arial,sans-serif !important;
    box-sizing: border-box !important;
  }

  /* ============ HIDE DAWN DRAWER + BUDDHA MOBILE ============ */
  @media screen and (max-width:989px){
    header-drawer,.header__icon--menu,.menu-drawer-container,.menu-drawer,
    .bmm-burger,.buddha-mega-menu,[class*="bmm-mobile"],[class*="bmm_mobile"],
    [data-bmm-mobile],[class^="bmm-"][class*="hamburger"]{display:none !important;visibility:hidden !important}
  }

  /* ============ HAMBURGER ============ */
  .vb-mm-burger{
    display:none;background:transparent;border:1px solid rgba(255,255,255,0.3);
    color:#ffffff;width:42px;height:42px;border-radius:8px;cursor:pointer;
    align-items:center;justify-content:center;padding:0;flex-shrink:0;position:relative;z-index:5
  }
  .vb-mm-burger:hover{background:rgba(255,255,255,0.1);border-color:rgba(255,255,255,0.55)}
  .vb-mm-burger__bars{display:flex;flex-direction:column;gap:4px;width:18px}
  .vb-mm-burger__bars span{display:block;width:100%;height:2px;background:#ffffff;border-radius:2px;transition:all .25s ease}
  .vb-mm-burger[aria-expanded="true"] .vb-mm-burger__bars span:nth-child(1){transform:translateY(6px) rotate(45deg)}
  .vb-mm-burger[aria-expanded="true"] .vb-mm-burger__bars span:nth-child(2){opacity:0}
  .vb-mm-burger[aria-expanded="true"] .vb-mm-burger__bars span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

  /* ============ DESKTOP NAV ============ */
  .vb-mm{display:none}
  @media screen and (min-width:990px){.vb-mm{display:block !important}}

  .vb-mm__list{
    list-style:none !important;margin:0 !important;padding:0 !important;
    display:flex !important;gap:2px !important;align-items:stretch !important
  }
  .vb-mm__item{position:static !important;display:flex !important;align-items:stretch !important}
  .vb-mm__trigger,.vb-mm__link{
    background:transparent !important;border:0 !important;
    padding:12px 12px !important;font-size:12.5px !important;font-weight:500 !important;
    letter-spacing:0.06em !important;text-transform:uppercase !important;
    color:#ffffff !important;text-decoration:none !important;cursor:pointer !important;
    display:inline-flex !important;align-items:center !important;gap:5px !important;
    transition:opacity .15s ease !important;line-height:1 !important
  }
  .vb-mm__trigger:hover,.vb-mm__trigger[aria-expanded="true"],.vb-mm__link:hover{opacity:0.75 !important}
  .vb-mm__chev{width:8px;height:8px;transition:transform .2s ease;flex-shrink:0}
  .vb-mm__trigger[aria-expanded="true"] .vb-mm__chev{transform:rotate(180deg)}

  /* ============ MEGA PANEL ============ */
  .vb-mm__panel{
    position:absolute !important;left:0 !important;right:0 !important;top:100% !important;
    background:#fdfaf2 !important;color:#1a4015 !important;
    border-top:2px solid #4d8c44 !important;
    box-shadow:0 20px 40px -12px rgba(0,0,0,0.22) !important;
    opacity:0;visibility:hidden;transform:translateY(-8px);
    transition:opacity .22s ease,transform .22s ease,visibility 0s linear .22s;
    z-index:90 !important;pointer-events:none
  }
  .vb-mm__panel[data-vb-mm-open="true"]{
    opacity:1;visibility:visible;transform:translateY(0);
    transition:opacity .22s ease,transform .22s ease,visibility 0s linear 0s;
    pointer-events:auto
  }
  .vb-mm__panel-inner{
    max-width:1400px !important;margin:0 auto !important;
    padding:24px 36px 28px !important;
    display:grid !important;
    grid-template-columns:1fr 230px !important;
    grid-template-rows:auto auto !important;
    gap:18px 28px !important
  }

  /* ============ COLUMN GRID ============ */
  .vb-mm__cols{display:grid !important;gap:6px 22px !important;grid-column:1 !important}
