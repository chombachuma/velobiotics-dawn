{{ 'vb-quiz-cta.css' | asset_url | stylesheet_tag }}

{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0668/5848/3883/files' -%}

<section class="vb-quiz">
  <div class="vb-quiz__inner page-width">

    <div class="vb-quiz__copy">
      <span class="vb-label-tag" style="color:rgba(255,255,255,0.7)">Personalised Recommendation</span>
      <h2 class="vb-h2" style="color:#fff">Not Sure Which Probiotic Is Right for You?<br>Let's Find Out.</h2>
      <p class="vb-lead" style="color:rgba(255,255,255,0.8)">Answer a few quick questions and we'll match you with the perfect Velobiotics probiotic — backed by science, doctor-developed, personalised for you.</p>
      <div class="vb-quiz__facts">
        <span>⏱️ 60 seconds</span>
        <span class="vb-dot">•</span>
        <span>🔬 Evidence-based</span>
        <span class="vb-dot">•</span>
        <span>🎁 Completely free</span>
      </div>
      <div class="vb-quiz__ctas">
        <a href="/pages/quiz" class="vb-btn vb-btn--white vb-btn--xl">Take the Free Quiz →</a>
        <a href="/collections/all" class="vb-btn vb-btn--outline-white vb-btn--xl">Browse All Products</a>
      </div>
    </div>

    <div class="vb-quiz__visual">
      <img
        src="{{ cdn }}/Femina-Probiotic-Caps-Testimonial.jpg"
        alt="Find your perfect probiotic"
        loading="lazy"
        class="vb-quiz__img"
        width="600" height="600"
      >
      <div class="vb-quiz__cards-overlay">
        <div class="vb-quiz__mini-card">🌸 <strong>Women's Health</strong></div>
        <div class="vb-quiz__mini-card">⚖️ <strong>Weight &amp; Gut</strong></div>
        <div class="vb-quiz__mini-card">🧒 <strong>Kids' Health</strong></div>
        <div class="vb-quiz__mini-card">💪 <strong>Performance</strong></div>
        <div class="vb-quiz__mini-card">🤱 <strong>Prenatal</strong></div>
        <div class="vb-quiz__mini-card">✨ <strong>Beauty &amp; Skin</strong></div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "VB Quiz CTA",
  "tag": "div",
  "class": "vb-section-wrap",
  "settings": [],
  "presets": [{ "name": "VB Quiz CTA" }]
}
{% endschema %}
