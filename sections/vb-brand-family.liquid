      { "type": "brand", "settings": { "brand_name": "Velo16™", "tagline": "Total Vitality", "target": "Daily probiotics for clear skin & gut", "link": "/collections/velo16", "image_url": "https://media.base44.com/images/public/69e738ecdc7682bdadfe7c82/3806ee1d7_generated_image.png", "bg": "#fff5f7", "accent": "#c8163c" } },
      { "type": "brand", "settings": { "brand_name": "Her-Biotics™", "tagline": "Women's Wellness", "target": "Hormonal & cycle-aware formulas", "link": "/collections/her-biotics", "image_url": "https://media.base44.com/images/public/69e734d64c8c66c266bc562d/45b5dc51a_generated_image.png", "bg": "#fff5f3", "accent": "#d2585a" } },
      { "type": "brand", "settings": { "brand_name": "His-Biotics®", "tagline": "Male Microbiome", "target": "Clinical-grade for men", "link": "/collections/his-biotics", "image_url": "https://media.base44.com/images/public/69e736ff6d73a02b90e291d4/bc2878b14_generated_image.png", "bg": "#e8f3f1", "accent": "#0a3d3d" } },
      { "type": "brand", "settings": { "brand_name": "PregBiotics™", "tagline": "Motherhood", "target": "Pregnancy & postnatal support", "link": "/collections/pregbiotics", "image_url": "https://media.base44.com/images/public/69e77ffe13bf3474223d0647/6791da2a0_generated_image.png", "bg": "#f2f9ec", "accent": "#1f6b3d" } },
      { "type": "brand", "settings": { "brand_name": "BioKid™", "tagline": "Kids' Daily", "target": "Daily defence for growing guts", "link": "/collections/biokid", "image_url": "https://media.base44.com/images/public/69e759b0da20f593135a4754/b63520eb0_generated_image.png", "bg": "#f0fbf2", "accent": "#16a34a" } },
