    "faq": {
      "type": "vb-faq",
      "blocks": {
        "q1": {
          "type": "q",
          "settings": {
            "question": "When will my Founders Case ship?",
            "answer": "<p>Production is planned for Q2 2027, subject to final production validation. You will get an email the moment your case is on its way, and we will keep you posted on progress in between.</p>"
          }
        },
        "q2": {
          "type": "q",
          "settings": {
            "question": "Can I get a refund if I change my mind?",
            "answer": "<p>Yes. Pre-orders are 100% refundable any time before dispatch. Email <a href=\"mailto:support@velobiotics.com\">support@velobiotics.com</a> with your order number.</p>"
          }
        },
        "q3": {
          "type": "q",
          "settings": {
            "question": "Am I charged now or when it ships?",
            "answer": "<p>You are charged in full at checkout, which is what reserves your case at the Founders price. South African orders are charged in rand; US and international orders in US dollars.</p>"
          }
        },
        "q4": {
          "type": "q",
          "settings": {
            "question": "Can I mix flavours?",
            "answer": "<p>Choose the Variety Pack to get all five flavours in one case, or pick a single flavour. Flavours may still be fine-tuned before launch; if anything changes we will tell you first.</p>"
          }
        },
        "q5": {
          "type": "q",
          "settings": {
            "question": "What is a synbiotic?",
            "answer": "<p>A synbiotic combines probiotics (live beneficial bacteria) with prebiotics (the fibre those bacteria feed on). Fizzoy has 1 billion live probiotics from 16 strains plus 3 g of prebiotic fibre in every can.</p>"
          }
        },
        "q6": {
          "type": "q",
          "settings": {
            "question": "Is Fizzoy a medicine?",
            "answer": "<p>No. Fizzoy supports digestive health as part of a balanced diet. It is not intended to diagnose, treat, cure or prevent any disease. Speak to your doctor if you have a medical condition.</p>"
          }
        }
      },
