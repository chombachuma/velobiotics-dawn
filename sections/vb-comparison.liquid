{%- comment -%} VB · Velobiotics vs Other Probiotics vs Multivitamins — 3-column tick/cross table {%- endcomment -%}

<style>
  .vb-cmp { padding: 72px 16px; max-width: 1100px; margin: 0 auto; }
  .vb-cmp__head { text-align: center; max-width: 720px; margin: 0 auto 36px; padding: 0 8px; }
  .vb-cmp__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-cmp__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; }
  .vb-cmp__title em { color: #4d8c44; font-style: normal; }
  .vb-cmp__sub { font-size: 16px; line-height: 1.55; color: #5c6664; margin: 0; }
  .vb-cmp__wrap { background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 24px 56px rgba(0,0,0,0.06); border: 1px solid #e3ece1; }
  .vb-cmp__table { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; }
  .vb-cmp__cell { padding: 16px 18px; border-bottom: 1px solid #f0f3ee; display: flex; align-items: center; justify-content: center; text-align: center; }
  .vb-cmp__cell:first-child, .vb-cmp__cell[data-feature] { justify-content: flex-start; text-align: left; }
  .vb-cmp__cell--header { background: #f7faf6; padding: 18px; }
  .vb-cmp__cell--us-header { background: rgba(77,140,68,0.10); }
  .vb-cmp__cell--us { background: rgba(77,140,68,0.04); }
  .vb-cmp__cell--feature { font-size: 14.5px; color: #1a1a1a; font-weight: 600; }
  .vb-cmp__head-us { font-size: 17px; font-weight: 900; color: #4d8c44; letter-spacing: -0.01em; }
  .vb-cmp__head-them { font-size: 14px; font-weight: 700; color: #6c7a6b; }
  .vb-cmp__check { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; font-weight: 900; font-size: 16px; }
  .vb-cmp__check--yes { background: #4d8c44; color: #fff; box-shadow: 0 4px 12px rgba(77,140,68,0.32); }
  .vb-cmp__check--no { background: #fde7e7; color: #c93d3d; }
  .vb-cmp__bottom { text-align: center; margin-top: 28px; }
  .vb-cmp__cta { display: inline-flex; align-items: center; gap: 8px; padding: 14px 30px; border-radius: 999px; background: #4d8c44; color: #fff !important; text-decoration: none; font-weight: 700; font-size: 14.5px; box-shadow: 0 12px 26px rgba(77,140,68,0.28); transition: all 0.18s ease; }
  .vb-cmp__cta:hover { background: #36632f; transform: translateY(-2px); }
  @media (max-width: 749px) {
    .vb-cmp { padding: 44px 12px; }
    .vb-cmp__head { margin-bottom: 22px; }
    .vb-cmp__wrap { border-radius: 14px; }
    .vb-cmp__table { grid-template-columns: 1.4fr 0.85fr 0.85fr 0.85fr; }
    .vb-cmp__cell { padding: 11px 8px; }
    .vb-cmp__cell--header { padding: 14px 8px; }
    .vb-cmp__cell--feature { font-size: 11.5px; line-height: 1.3; }
    .vb-cmp__head-us { font-size: 12.5px; }
    .vb-cmp__head-them { font-size: 11px; line-height: 1.2; }
    .vb-cmp__check { width: 26px; height: 26px; font-size: 13px; }
  }
</style>

<section class="vb-cmp">
  <div class="vb-cmp__head">
    {%- if section.settings.eyebrow != blank -%}<p class="vb-cmp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="vb-cmp__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
    {%- if section.settings.sub != blank -%}<p class="vb-cmp__sub">{{ section.settings.sub }}</p>{%- endif -%}
  </div>
  <div class="vb-cmp__wrap">
    <div class="vb-cmp__table">
      <div class="vb-cmp__cell vb-cmp__cell--header"></div>
      <div class="vb-cmp__cell vb-cmp__cell--header vb-cmp__cell--us-header"><span class="vb-cmp__head-us">{{ section.settings.us_label | default: 'Velobiotics™' }}</span></div>
      <div class="vb-cmp__cell vb-cmp__cell--header"><span class="vb-cmp__head-them">{{ section.settings.them1_label | default: 'Other Probiotics' }}</span></div>
      <div class="vb-cmp__cell vb-cmp__cell--header"><span class="vb-cmp__head-them">{{ section.settings.them2_label | default: 'Multivitamins' }}</span></div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="vb-cmp__cell vb-cmp__cell--feature" data-feature {{ block.shopify_attributes }}>{{ block.settings.feature }}</div>
          <div class="vb-cmp__cell vb-cmp__cell--us">{%- if block.settings.us == 'yes' -%}<span class="vb-cmp__check vb-cmp__check--yes">✓</span>{%- else -%}<span class="vb-cmp__check vb-cmp__check--no">✗</span>{%- endif -%}</div>
          <div class="vb-cmp__cell">{%- if block.settings.them1 == 'yes' -%}<span class="vb-cmp__check vb-cmp__check--yes">✓</span>{%- else -%}<span class="vb-cmp__check vb-cmp__check--no">✗</span>{%- endif -%}</div>
          <div class="vb-cmp__cell">{%- if block.settings.them2 == 'yes' -%}<span class="vb-cmp__check vb-cmp__check--yes">✓</span>{%- else -%}<span class="vb-cmp__check vb-cmp__check--no">✗</span>{%- endif -%}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.cta_text != blank -%}<div class="vb-cmp__bottom"><a href="{{ section.settings.cta_link | default: '#' }}" class="vb-cmp__cta">{{ section.settings.cta_text }} →</a></div>{%- endif -%}
</section>

{% schema %}
{
  "name": "VB · Comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Velobiotics vs Others" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "See Why Thousands" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Choose Velobiotics" },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Velobiotics stands apart with real science, superior delivery technology, and formulas designed for actual results — not marketing." },
    { "type": "text", "id": "us_label", "label": "Us column label", "default": "Velobiotics™" },
    { "type": "text", "id": "them1_label", "label": "Other Probiotics label", "default": "Other Probiotics" },
    { "type": "text", "id": "them2_label", "label": "Multivitamins label", "default": "Multivitamins" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop the Range" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Survives stomach acid" },
      { "type": "select", "id": "us", "label": "Velobiotics", "options": [{"value":"yes","label":"Yes"},{"value":"no","label":"No"}], "default": "yes" },
      { "type": "select", "id": "them1", "label": "Other Probiotics", "options": [{"value":"yes","label":"Yes"},{"value":"no","label":"No"}], "default": "no" },
      { "type": "select", "id": "them2", "label": "Multivitamins", "options": [{"value":"yes","label":"Yes"},{"value":"no","label":"No"}], "default": "no" }
    ]}
  ],
  "presets": [
    { "name": "VB · Comparison", "blocks": [
      { "type": "row", "settings": { "feature": "Patented MEP shielding (survives stomach acid)", "us": "yes", "them1": "no", "them2": "no" } },
      { "type": "row", "settings": { "feature": "1000× more probiotics reach the gut alive", "us": "yes", "them1": "no", "them2": "no" } },
      { "type": "row", "settings": { "feature": "Doctor-formulated by medical professionals", "us": "yes", "them1": "no", "them2": "no" } },
      { "type": "row", "settings": { "feature": "Clinically-studied probiotic strains", "us": "yes", "them1": "no", "them2": "no" } },
      { "type": "row", "settings": { "feature": "Live bacteria delivered to gut", "us": "yes", "them1": "yes", "them2": "no" } },
      { "type": "row", "settings": { "feature": "Essential vitamins & minerals", "us": "yes", "them1": "no", "them2": "yes" } },
      { "type": "row", "settings": { "feature": "Targets gut microbiome health", "us": "yes", "them1": "yes", "them2": "no" } },
      { "type": "row", "settings": { "feature": "Lab-tested every batch", "us": "yes", "them1": "no", "them2": "no" } },
      { "type": "row", "settings": { "feature": "30-day money-back guarantee", "us": "yes", "them1": "no", "them2": "no" } },
      { "type": "row", "settings": { "feature": "Clean label (no fillers, no allergens)", "us": "yes", "them1": "no", "them2": "no" } }
    ]}
  ]
}
{% endschema %}
