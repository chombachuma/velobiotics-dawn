<style>
.vb-vids { background: #fff; padding: 5rem 1.5rem; overflow: hidden; }
.vb-vids__inner { max-width: 1380px; margin: 0 auto; }
.vb-vids__header { text-align: center; max-width: 680px; margin: 0 auto 3rem; }
.vb-vids__footer { text-align: center; margin-top: 2rem; }

.vb-vids__rail {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.vb-vids__rail::-webkit-scrollbar { display: none; }
@media screen and (min-width: 600px) { .vb-vids__rail { grid-template-columns: repeat(5, minmax(200px, 1fr)); } }

.vb-vids__card {
  scroll-snap-align: start;
  background: var(--vb-green-50);
  border-radius: 1.25rem;
  overflow: hidden;
  border: 1.5px solid var(--vb-green-100);
  display: flex;
  flex-direction: column;
}
.vb-vids__media {
  position: relative;
  aspect-ratio: 9/16;
  background: #0a1a08;
  cursor: pointer;
  overflow: hidden;
}
.vb-vids__thumb {
  width: 100%; height: 100%;
  object-fit: cover; object-position: top;
  transition: transform 0.3s ease;
}
.vb-vids__card:hover .vb-vids__thumb { transform: scale(1.04); }
.vb-vids__thumb-placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: var(--vb-green-600); color: #fff;
  font-size: 4rem; font-weight: 800;
}
.vb-vids__play {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.25); border: none; cursor: pointer;
  transition: background 0.2s;
}
.vb-vids__play:hover { background: rgba(0,0,0,0.45); }
.vb-vids__play svg { filter: drop-shadow(0 2px 8px rgba(0,0,0,0.4)); }
.vb-vids__badge {
  position: absolute; bottom: 0.75rem; left: 0.75rem;
  background: rgba(255,255,255,0.9); backdrop-filter: blur(4px);
  font-size: 0.7rem; font-weight: 700;
  padding: 0.2rem 0.6rem; border-radius: 100px; color: var(--vb-neutral-800);
}

.vb-vids__caption { padding: 1rem; flex: 1; display: flex; flex-direction: column; gap: 0.35rem; }
.vb-vids__stars { color: #f59e0b; font-size: 0.9rem; }
.vb-vids__caption p { font-size: 0.83rem; font-style: italic; color: var(--vb-neutral-700); line-height: 1.55; margin: 0; flex: 1; }
.vb-vids__caption strong { font-size: 0.82rem; font-weight: 700; color: var(--vb-neutral-900); }
.vb-vids__caption span { font-size: 0.73rem; color: var(--vb-neutral-500); }

.vb-vids__nav {
  display: flex; gap: 0.75rem; justify-content: center; margin-top: 1.5rem;
}
.vb-vids__arrow {
  width: 44px; height: 44px; border-radius: 50%;
  background: #fff; border: 2px solid var(--vb-green-200);
  font-size: 1.1rem; cursor: pointer; color: var(--vb-green-600);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s;
}
.vb-vids__arrow:hover { background: var(--vb-green-600); color: #fff; border-color: var(--vb-green-600); }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Click-to-play inline video
  document.querySelectorAll('.vb-vids__media').forEach(function(wrap) {
    wrap.addEventListener('click', function() {
      var src = wrap.getAttribute('data-vid');
      if (!src) return;
      var vid = document.createElement('video');
      vid.src = src; vid.controls = true; vid.autoplay = true;
      vid.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:10;background:#000';
      wrap.appendChild(vid);
      wrap.querySelector('.vb-vids__play').style.display = 'none';
      var thumb = wrap.querySelector('.vb-vids__thumb, .vb-vids__thumb-placeholder');
      if (thumb) thumb.style.display = 'none';
    });
  });
});
</script>

