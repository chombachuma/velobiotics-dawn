    var h='';
    h+='<section class="vbr__hero"><div><div class="vbr__eyebrow">Personalised BioMatch report</div><h1>'+esc(m.name)+', here is your '+esc(need.label||'gut health')+' plan.</h1><p>Prepared '+esc(m.date)+' from your BioMatch answers</p></div>';
    h+='<div class="vbr__match"><div class="vbr__eyebrow" style="color:var(--g2)">Your best match</div>'+(top.img?'<img src="'+esc(img(top.img))+'" alt="">':'')+'<div class="b">'+esc(top.brand||'Velobiotics')+'</div><h3>'+esc(top.title||'')+'</h3><span class="vbr__pill">Match '+esc(top.fit||96)+'% · '+esc(top.role||'Best match')+'</span></div></section>';
    h+='<div class="vbr__chips">'+chips.map(function(c){return '<span class="vbr__chip">'+esc(c)+'</span>';}).join('')+'</div>';
    h+='<div class="vbr__card note"><p class="vbr__lbl">A note from our founder</p><div class="vbr__note">'+note(a,need,top,m.name).map(function(p){return '<p>'+esc(p)+'</p>';}).join('')+'</div><div class="vbr__sig">'+(SIG?'<img src="'+esc(SIG)+'" alt="Signature">':'')+'<b>Dr Chomba Chuma, MD</b><span>Founder &amp; Managing Director, Velobiotics</span></div></div>';
    h+='<h2>What\'s going on</h2><p class="vbr__lbl">Your focus · '+esc(need.label||a.focus_label||'')+'</p><p class="vbr__lead"><b>'+esc(need.blurb||'')+'</b></p><p class="vbr__lead">'+esc(need.science_snippet||'')+'</p>';
    h+='<p class="vbr__lbl">Three numbers worth knowing</p><div class="vbr__stats">'+stats.map(function(s){return '<div class="vbr__stat"><b>'+esc(s[0])+'</b><span>'+esc(s[1])+'</span></div>';}).join('')+'</div>';
    h+='<p class="vbr__lbl">Why this is happening — in your case</p><ul class="vbr__why">'+why.slice(0,3).map(function(t){return '<li>'+esc(t)+'</li>';}).join('')+'</ul>';
    if(top.fun_fact)h+='<div class="vbr__fact"><p class="vbr__lbl">Did you know?</p>'+esc(top.fun_fact)+'</div>';
    h+='<h2>Your 4-week plan</h2><p class="vbr__lead">Probiotics work by changing who lives in your gut — that takes weeks, not hours. Here is what to do and what to expect.</p><div class="vbr__plan">'+plan(a,top).map(function(p,i){return '<div class="vbr__wk"><div class="n">'+(i+1)+'</div><div class="c"><small>'+esc(p[0])+'</small><b>'+esc(p[1])+'</b><p>'+esc(p[2])+'</p></div></div>';}).join('')+'</div>';
    h+='<div class="vbr__two"><div class="vbr__tint"><p class="vbr__lbl">How to take your stack</p><ul>'+recs.map(function(r){return '<li><b>'+esc(r.title)+'</b><small>'+esc(how(r))+'</small></li>';}).join('')+'</ul></div><div class="vbr__tint" style="background:#fff;border:1px solid var(--line)"><p class="vbr__lbl">Doctor\'s tips</p><ul>'+(TIPS[grp]||TIPS.gut).map(function(t){return '<li>'+esc(t)+'</li>';}).join('')+'</ul></div></div>';
    h+='<div class="vbr__red"><p class="vbr__lbl">When to see a doctor</p>'+esc(RED[grp]||RED.gut)+'</div>';
    h+='<h2>Your recommended stack</h2><p class="vbr__lead">Ranked by fit. Start with your best match; add the supporting product if you want faster or broader results.</p>';
    h+=recs.map(function(r,i){return '<div class="vbr__rec'+(i===0?' top':'')+'"><span class="role">'+esc(r.role||'')+'</span><div class="img">'+(r.img?'<img src="'+esc(img(r.img))+'" alt="">':'')+'</div><div><div class="brand">'+esc(r.brand||'Velobiotics')+'</div><h3>'+esc(r.title||'')+'</h3><div class="vbr__fit"><i><b style="width:'+esc(r.fit||90)+'%"></b></i>'+esc(r.fit||90)+'% match</div><p>'+esc(r.why_copy||'')+'</p>'+(r.key_ingredients&&r.key_ingredients.length?'<p class="ing">Inside: '+esc(r.key_ingredients.slice(0,4).join(' · '))+'</p>':'')+'<a class="vbr__btn" href="'+esc(r.url)+'">Shop with '+pct+'% off →</a></div></div>';}).join('');
    h+='<div class="vbr__code"><div><p class="vbr__lbl">Your '+pct+'% code</p><strong>'+esc(code)+'</strong></div><p>Use it at checkout on www.velobiotics.com — or tap any “Shop” button above and it is applied for you. One use per customer.<br>Questions? Reply to your BioMatch email or write to support@velobiotics.com.</p></div>';
    h+='<p class="vbr__fine">Velobiotics™ formulas use MEP microencapsulation so live cultures survive stomach acid and reach the gut. Food supplements are not a substitute for a varied diet or medical care. This report is generated from your quiz answers and is general wellness information, not a diagnosis. If you are pregnant, breastfeeding, under 18 or on chronic medication, discuss supplements with your doctor.</p>';
    body.innerHTML=h;
    document.title=m.name+"'s BioMatch report – Velobiotics";
  }
  function fail(msg){body.innerHTML='<div class="vbr__err"><p class="vbr__lbl">Report</p><p>'+esc(msg)+'</p><p><a class="vbr__btn" href="/pages/quiz">Take the BioMatch quiz</a></p></div>';}
  if(!tok){fail('We could not find a report link. Take the 2-minute BioMatch quiz and your personalised report will be ready straight away.');return;}
  var pdfUrl=FN+'?t='+encodeURIComponent(tok)+'&format=pdf';
  function getJson(n){return fetch(FN+'?t='+encodeURIComponent(tok)+'&format=json',{cache:'no-store'}).then(function(r){if(!r.ok)throw new Error(r.status===404?'This report link has expired or was not found.':'The report service is busy ('+r.status+').');return r.json();}).catch(function(e){if(n>0)return new Promise(function(res){setTimeout(res,900)}).then(function(){return getJson(n-1)});throw e;});}
  getJson(2).then(function(m){render(m);btn.disabled=false;}).catch(function(e){fail(e.message||'Something went wrong. Please try again in a minute.');});
  // PDF: fetch as blob (with retry) so the browser saves it directly; fall back to opening the link.
  btn.addEventListener('click',function(){
    btn.disabled=true;var label=btn.innerHTML;btn.innerHTML='Preparing…';
    function tryFetch(n){return fetch(pdfUrl,{cache:'no-store'}).then(function(r){if(!r.ok||(r.headers.get('content-type')||'').indexOf('pdf')<0)throw new Error('bad');return r.blob();}).catch(function(e){if(n>0)return new Promise(function(res){setTimeout(res,1200)}).then(function(){return tryFetch(n-1)});throw e;});}
    tryFetch(2).then(function(b){var u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='Velobiotics-BioMatch-Report.pdf';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(u);a.remove();},4000);}).catch(function(){window.open(pdfUrl,'_blank');}).then(function(){btn.disabled=false;btn.innerHTML=label;});
  });
})();
</script>
