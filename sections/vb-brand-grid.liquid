{{ 'vb-brand-grid.css' | asset_url | stylesheet_tag }}

{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0668/5848/3883/files' -%}

<section class="vb-brands">
  <div class="vb-brands__inner page-width">

    <div class="vb-brands__header">
      <span class="vb-label-tag">The Velobiotics Family</span>
      <h2 class="vb-h2">Explore the Velobiotics Family</h2>
      <p class="vb-lead">From women's intimate care to kids' immunity and digestive wellness — a targeted solution for everyone in the family.</p>
    </div>

    <div class="vb-brands__grid">

      <a href="/collections/femina" class="vb-brand-card vb-brand-card--purple">
        <div class="vb-brand-card__img-wrap">
          <img src="{{ cdn }}/Femina-Probiotic-Caps-Main-Image.jpg" alt="Femina Probiotic" loading="lazy" class="vb-brand-card__img" width="400" height="400">
        </div>
        <div class="vb-brand-card__body">
          <span class="vb-brand-card__tag">Women's Health</span>
          <h3 class="vb-brand-card__name">Femina™</h3>
          <p class="vb-brand-card__desc">For women's intimate and urinary health. Freshness, confidence, and pH balance.</p>
          <span class="vb-brand-card__cta">Shop Femina →</span>
        </div>
      </a>

      <a href="/collections/gutslim" class="vb-brand-card vb-brand-card--teal">
        <div class="vb-brand-card__img-wrap">
          <img src="{{ cdn }}/GutBundle-HimHer-Pack-3D.png" alt="GutSlim Probiotic" loading="lazy" class="vb-brand-card__img" width="400" height="400">
        </div>
        <div class="vb-brand-card__body">
          <span class="vb-brand-card__tag">Weight Support</span>
          <h3 class="vb-brand-card__name">GutSlim™</h3>
          <p class="vb-brand-card__desc">Gut balance and weight support. A lighter, healthier you — powered by science.</p>
          <span class="vb-brand-card__cta">Shop GutSlim →</span>
        </div>
      </a>

      <a href="/collections/velo16" class="vb-brand-card vb-brand-card--green">
        <div class="vb-brand-card__img-wrap">
          <img src="{{ cdn }}/VELO16-30s.jpg" alt="Velo16 Probiotic" loading="lazy" class="vb-brand-card__img" width="400" height="400">
        </div>
        <div class="vb-brand-card__body">
          <span class="vb-brand-card__tag">Daily Wellness</span>
          <h3 class="vb-brand-card__name">Velo16™</h3>
          <p class="vb-brand-card__desc">Daily digestive and immune support. Our flagship 16-strain probiotic for everyone.</p>
          <span class="vb-brand-card__cta">Shop Velo16 →</span>
        </div>
      </a>

      <a href="/collections/pregbiotics" class="vb-brand-card vb-brand-card--pink">
        <div class="vb-brand-card__img-wrap">
          <img src="{{ cdn }}/Femina-Probiotics-4-Key-BEnefits.jpg" alt="PregBiotics" loading="lazy" class="vb-brand-card__img" width="400" height="400">
        </div>
        <div class="vb-brand-card__body">
          <span class="vb-brand-card__tag">Prenatal Health</span>
          <h3 class="vb-brand-card__name">PregBiotics™</h3>
          <p class="vb-brand-card__desc">Prenatal & maternal health. Supports digestion, immunity during pregnancy.</p>
          <span class="vb-brand-card__cta">Shop PregBiotics →</span>
        </div>
      </a>

      <a href="/collections/her-biotics" class="vb-brand-card vb-brand-card--rose">
        <div class="vb-brand-card__img-wrap">
          <img src="{{ cdn }}/Her-Biotics_Original_-_Two_Ladies.png" alt="Her-Biotics" loading="lazy" class="vb-brand-card__img" width="400" height="400">
        </div>
        <div class="vb-brand-card__body">
          <span class="vb-brand-card__tag">For Her</span>
          <h3 class="vb-brand-card__name">Her-Biotics™</h3>
          <p class="vb-brand-card__desc">Female microbiome, hormonal and skin support. Formulated for her.</p>
          <span class="vb-brand-card__cta">Shop Her-Biotics →</span>
        </div>
      </a>

      <a href="/collections/his-biotics" class="vb-brand-card vb-brand-card--navy">
        <div class="vb-brand-card__img-wrap">
          <img src="{{ cdn }}/Femina-Probiotic-Caps-Key-Benefits.jpg" alt="His-Biotics" loading="lazy" class="vb-brand-card__img" width="400" height="400">
        </div>
        <div class="vb-brand-card__body">
          <span class="vb-brand-card__tag">For Him</span>
          <h3 class="vb-brand-card__name">His-Biotics™</h3>
          <p class="vb-brand-card__desc">Male gut health, vitality and immune balance. Designed for him.</p>
          <span class="vb-brand-card__cta">Shop His-Biotics →</span>
        </div>
      </a>

      <a href="/collections/biokid" class="vb-brand-card vb-brand-card--orange">
        <div class="vb-brand-card__img-wrap">
          <img src="{{ cdn }}/BIOKID-30s.jpg" alt="BioKid" loading="lazy" class="vb-brand-card__img" width="400" height="400">
        </div>
        <div class="vb-brand-card__body">
          <span class="vb-brand-card__tag">For Kids</span>
          <h3 class="vb-brand-card__name">BioKid™</h3>
          <p class="vb-brand-card__desc">Kids' gut & immune health. Tasty chewables for happy, healthy tummies.</p>
          <span class="vb-brand-card__cta">Shop BioKid →</span>
        </div>
      </a>

      <a href="/collections/biogain" class="vb-brand-card vb-brand-card--blue">
        <div class="vb-brand-card__img-wrap">
          <img src="{{ cdn }}/BioGain-Strawberry.png" alt="BioGain" loading="lazy" class="vb-brand-card__img" width="400" height="400">
        </div>
        <div class="vb-brand-card__body">
          <span class="vb-brand-card__tag">Performance</span>
          <h3 class="vb-brand-card__name">BioGain™</h3>
          <p class="vb-brand-card__desc">Growth & recovery support. Probiotic nutrition for peak performance.</p>
          <span class="vb-brand-card__cta">Shop BioGain →</span>
        </div>
      </a>

    </div>

    <div class="vb-brands__footer">
      <a href="/collections/all" class="vb-btn vb-btn--primary vb-btn--lg">View All Products</a>
    </div>
  </div>
</section>

{% schema %}
