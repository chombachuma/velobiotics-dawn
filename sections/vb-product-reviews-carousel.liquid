{%- comment -%}
  VB · Product Reviews Carousel — scrolling testimonial cards with diverse avatar portraits
{%- endcomment -%}

{%- liquid
  assign bp = section.settings.brand_primary | default: '#4d8c44'
  assign bt = section.settings.brand_tint | default: '#f3f7f1'
  assign bd = section.settings.brand_dark | default: '#36632f'
-%}

<style>
  .vb-prc { padding: 28px 0 36px; --bp: {{ bp }}; --bt: {{ bt }}; --bd: {{ bd }}; background: linear-gradient(180deg, #fff 0%, var(--bt) 50%, #fff 100%); overflow: hidden; }
  .vb-prc__head { max-width: 1280px; margin: 0 auto 20px; padding: 0 20px; text-align: center; }
  .vb-prc__eyebrow { display: inline-flex; align-items: center; gap: 6px; background: color-mix(in srgb, var(--bp) 12%, #fff); color: var(--bp); padding: 5px 12px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 10px; }
  .vb-prc__title { font-size: clamp(20px, 2.6vw, 26px); font-weight: 800; color: #1a1a1a; margin: 0; letter-spacing: -0.01em; }
  .vb-prc__wrap { position: relative; }
  .vb-prc__wrap::before, .vb-prc__wrap::after { content: ''; position: absolute; top: 0; bottom: 0; width: 80px; z-index: 2; pointer-events: none; }
  .vb-prc__wrap::before { left: 0; background: linear-gradient(90deg, var(--bt) 0%, rgba(243, 247, 241, 0) 100%); }
  .vb-prc__wrap::after { right: 0; background: linear-gradient(270deg, var(--bt) 0%, rgba(243, 247, 241, 0) 100%); }
  .vb-prc__track { display: flex; gap: 16px; animation: vb-prc-scroll 38s linear infinite; width: max-content; padding: 4px 20px; will-change: transform; }
  .vb-prc__wrap:hover .vb-prc__track { animation-play-state: paused; }
  @keyframes vb-prc-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .vb-prc__card { width: 320px; padding: 18px; background: #fff; border-radius: 16px; box-shadow: 0 8px 24px rgba(0,0,0,0.06); border: 1px solid #f0eaf0; flex-shrink: 0; }
  .vb-prc__top { display: flex; align-items: center; gap: 12px; margin: 0 0 12px; }
  .vb-prc__avatar { width: 44px; height: 44px; border-radius: 50%; overflow: hidden; background: var(--bt); border: 2px solid var(--bp); flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; color: var(--bp); font-weight: 800; font-size: 16px; }
  .vb-prc__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vb-prc__author { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .vb-prc__name { font-size: 13.5px; font-weight: 800; color: #1a1a1a; display: inline-flex; align-items: center; gap: 6px; }
  .vb-prc__name::after { content: '✓'; display: inline-flex; align-items: center; justify-content: center; width: 14px; height: 14px; background: var(--bp); color: #fff; border-radius: 50%; font-size: 8px; font-weight: 900; }
  .vb-prc__meta { font-size: 11px; color: #6c7a6b; font-weight: 600; }
  .vb-prc__stars { color: #ffb43a; font-size: 13px; letter-spacing: 1px; margin: 0 0 8px; }
  .vb-prc__quote { font-size: 13px; line-height: 1.5; color: #2b3a2a; margin: 0; font-style: italic; white-space: normal; }
  .vb-prc__quote::before { content: '"'; color: var(--bp); font-weight: 900; }
  .vb-prc__quote::after { content: '"'; color: var(--bp); font-weight: 900; }

  @media (max-width: 749px) {
    .vb-prc__card { width: 280px; padding: 14px; }
    .vb-prc__avatar { width: 38px; height: 38px; }
    .vb-prc__name { font-size: 12.5px; }
    .vb-prc__quote { font-size: 12px; }
  }
</style>

<section class="vb-prc">
  <div class="vb-prc__head">
    <span class="vb-prc__eyebrow">{{ section.settings.eyebrow | default: '★ Verified reviews' }}</span>
    <h2 class="vb-prc__title">{{ section.settings.title | default: 'Real women, real relief' }}</h2>
  </div>
  <div class="vb-prc__wrap">
    <div class="vb-prc__track">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <div class="vb-prc__card" {{ block.shopify_attributes }}>
            <div class="vb-prc__top">
              <span class="vb-prc__avatar">
                {%- if block.settings.avatar != blank -%}
                  <img src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.author | escape }}" loading="lazy" />
                {%- elsif block.settings.avatar_url != blank -%}
                  <img src="{{ block.settings.avatar_url }}" alt="{{ block.settings.author | escape }}" loading="lazy" />
                {%- else -%}
                  {{ block.settings.author | slice: 0, 1 }}
                {%- endif -%}
              </span>
              <div class="vb-prc__author">
                <span class="vb-prc__name">{{ block.settings.author }}</span>
                <span class="vb-prc__meta">{{ block.settings.meta | default: 'Verified buyer' }}</span>
              </div>
            </div>
            <div class="vb-prc__stars">★★★★★</div>
            <p class="vb-prc__quote">{{ block.settings.quote }}</p>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Reviews carousel",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "brand_primary", "label": "Brand primary", "default": "#4d8c44" },
    { "type": "color", "id": "brand_dark", "label": "Brand dark", "default": "#36632f" },
    { "type": "color", "id": "brand_tint", "label": "Brand tint", "default": "#f3f7f1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "★ Verified reviews" },
    { "type": "text", "id": "title", "label": "Title", "default": "Real women, real relief" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "avatar", "label": "Avatar (upload)" },
      { "type": "url", "id": "avatar_url", "label": "Avatar URL (fallback)" },
      { "type": "text", "id": "author", "label": "Author name", "default": "Jane D." },
      { "type": "text", "id": "meta", "label": "Meta", "default": "Verified buyer · 2 weeks ago" },
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "Game-changer." }
    ]}
  ],
  "presets": [{ "name": "VB · Reviews carousel" }]
}
{% endschema %}
