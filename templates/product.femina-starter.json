          "type": "q",
          "settings": {
            "question": "Are the suppositories safe for oral intake?",
            "answer": "<p>NO. Boric acid suppositories are strictly for vaginal use only. Never swallow suppositories. Keep out of reach of children.</p>"
          }
        },
        "q4": {
          "type": "q",
          "settings": {
            "question": "Can I use this pack during pregnancy or while taking medication?",
            "answer": "<p>If you are pregnant, nursing, planning pregnancy, or taking prescription medication, please consult your healthcare professional before using suppositories or new dietary supplements.</p>"
          }
        },
        "q5": {
          "type": "q",
          "settings": {
            "question": "Do the probiotic capsules require refrigeration?",
            "answer": "<p>No. Thanks to Velobiotics patented micro-shielding technology, individual bacteria are protected against heat, moisture, and light, making them 100% shelf-stable at room temperature.</p>"
