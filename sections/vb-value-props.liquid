{%- comment -%}
  Velobiotics value props — 4-column icon + title + sub strip
{%- endcomment -%}

<style>
  .vb-vp { padding: 56px 24px; max-width: 1280px; margin: 0 auto; }
  .vb-vp__head { text-align: center; max-width: 720px; margin: 0 auto 40px; }
  .vb-vp__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 10px; }
  .vb-vp__title { font-size: clamp(26px, 3.4vw, 38px); font-weight: 800; color: #1a1a1a; line-height: 1.15; margin: 0 0 10px; }
  .vb-vp__sub { font-size: 16px; line-height: 1.55; color: #555; margin: 0; }
  .vb-vp__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
  .vb-vp__card { padding: 28px 22px; background: #fff; border: 1px solid #e3ece1; border-radius: 18px; text-align: center; transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease; }
  .vb-vp__card:hover { transform: translateY(-4px); box-shadow: 0 18px 38px rgba(77, 140, 68, 0.14); border-color: rgba(77, 140, 68, 0.35); }
  .vb-vp__icon { width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #4d8c44 0%, #6ec56e 100%); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 0 16px; box-shadow: 0 10px 22px rgba(77, 140, 68, 0.28); }
  .vb-vp__name { font-size: 16px; font-weight: 800; color: #1a1a1a; margin: 0 0 6px; }
  .vb-vp__desc { font-size: 13.5px; line-height: 1.5; color: #5c6664; margin: 0; }
  @media (max-width: 749px) {
    .vb-vp { padding: 36px 16px; }
    .vb-vp__head { margin-bottom: 24px; }
    .vb-vp__grid { grid-template-columns: 1fr 1fr; gap: 12px; }
    .vb-vp__card { padding: 20px 14px; border-radius: 14px; }
    .vb-vp__icon { width: 52px; height: 52px; font-size: 24px; margin-bottom: 12px; }
    .vb-vp__name { font-size: 14px; }
    .vb-vp__desc { font-size: 12px; }
  }
</style>

<section class="vb-vp">
  {%- if section.settings.show_head -%}
    <div class="vb-vp__head">
      {%- if section.settings.eyebrow != blank -%}<p class="vb-vp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="vb-vp__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.sub != blank -%}<p class="vb-vp__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="vb-vp__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'prop' -%}
        <div class="vb-vp__card" {{ block.shopify_attributes }}>
          <div class="vb-vp__icon">{{ block.settings.icon }}</div>
          <h3 class="vb-vp__name">{{ block.settings.name }}</h3>
          <p class="vb-vp__desc">{{ block.settings.desc }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "VB · Value props",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_head", "label": "Show heading", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Velobiotics" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "sub", "label": "Sub-text" }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Prop card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / emoji", "default": "🛡️" },
        { "type": "text", "id": "name", "label": "Name", "default": "Patented MEP Technology" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "Micro-shield delivery — 1000× more probiotics survive" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VB · Value props",
      "blocks": [
        { "type": "prop", "settings": { "icon": "🛡️", "name": "Patented MEP Technology", "desc": "Micro-shield delivery — 1000× more probiotics survive" } },
        { "type": "prop", "settings": { "icon": "🩺", "name": "Doctor Formulated", "desc": "Developed by medical doctors and microbiologists" } },
        { "type": "prop", "settings": { "icon": "🧪", "name": "Clinically Backed", "desc": "Strains studied in peer-reviewed clinical trials" } },
        { "type": "prop", "settings": { "icon": "🔄", "name": "Money-Back Guarantee", "desc": "30-day no-questions-asked return policy" } }
      ]
    }
  ]
}
{% endschema %}
