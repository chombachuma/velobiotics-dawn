{% liquid
  assign primary = section.settings.primary | default: '#4d8c44'
  assign dark = section.settings.dark | default: '#2e5d28'
  assign tint = section.settings.tint | default: '#eef7ec'
%}
<style>
  #vb-fc-{{ section.id }} { background: linear-gradient(180deg, #fff 0%, {{ tint }} 55%, #fff 100%); padding: 80px 24px; }
  #vb-fc-{{ section.id }} .vb-fc-wrap { max-width: 1180px; margin: 0 auto; }
  #vb-fc-{{ section.id }} .vb-fc-head { text-align: center; max-width: 760px; margin: 0 auto 50px; }
  #vb-fc-{{ section.id }} .vb-fc-eyebrow { color: {{ primary }}; font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 14px; display: inline-block; padding: 6px 14px; background: rgba(255,255,255,0.7); border: 1px solid {{ primary }}; border-radius: 999px; }
  #vb-fc-{{ section.id }} .vb-fc-title { font-size: clamp(32px, 5vw, 52px); font-weight: 800; color: #111; line-height: 1.1; margin: 0 0 18px; letter-spacing: -0.02em; }
  #vb-fc-{{ section.id }} .vb-fc-title span { color: {{ primary }}; }
  #vb-fc-{{ section.id }} .vb-fc-sub { color: #444; font-size: 18px; line-height: 1.65; margin: 0; }

  #vb-fc-{{ section.id }} .vb-fc-define { background: #fff; border-radius: 24px; padding: 40px; box-shadow: 0 12px 36px rgba(0,0,0,0.08); display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; margin: 0 0 60px; }
  #vb-fc-{{ section.id }} .vb-fc-define__copy h3 { font-size: 24px; font-weight: 800; color: #111; margin: 0 0 12px; }
  #vb-fc-{{ section.id }} .vb-fc-define__copy p { font-size: 16px; line-height: 1.65; color: #444; margin: 0 0 18px; }
  #vb-fc-{{ section.id }} .vb-fc-benefits { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 10px; }
  #vb-fc-{{ section.id }} .vb-fc-benefits li { display: flex; gap: 12px; align-items: flex-start; color: #222; font-size: 15px; line-height: 1.5; }
  #vb-fc-{{ section.id }} .vb-fc-benefits li::before { content: '✓'; flex-shrink: 0; width: 22px; height: 22px; background: {{ primary }}; color: #fff; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 900; font-size: 12px; margin-top: 1px; }

  #vb-fc-{{ section.id }} .vb-fc-define__visual { aspect-ratio: 4/3; background: linear-gradient(135deg, {{ primary }}, {{ dark }}); border-radius: 18px; display: flex; align-items: center; justify-content: center; color: #fff; padding: 0; position: relative; overflow: hidden; }
  #vb-fc-{{ section.id }} .vb-fc-define__visual img { width: 100%; height: 100%; object-fit: cover; border-radius: 18px; position: absolute; inset: 0; }
  #vb-fc-{{ section.id }} .vb-fc-define__icon { font-size: 80px; line-height: 1; z-index: 1; position: relative; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.25)); }

  #vb-fc-{{ section.id }} .vb-fc-top { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin: 0 0 30px; }
  #vb-fc-{{ section.id }} .vb-fc-top__card { background: #fff; border-radius: 20px; padding: 28px; box-shadow: 0 8px 24px rgba(0,0,0,0.06); border: 2px solid transparent; transition: all 0.2s ease; }
  #vb-fc-{{ section.id }} .vb-fc-top__card:hover { border-color: {{ primary }}; transform: translateY(-4px); box-shadow: 0 16px 36px rgba(0,0,0,0.12); }
  #vb-fc-{{ section.id }} .vb-fc-top__badge { display: inline-block; background: {{ primary }}; color: #fff; padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 14px; }
  #vb-fc-{{ section.id }} .vb-fc-top__img { width: 100%; aspect-ratio: 16/10; background: {{ tint }}; border-radius: 14px; object-fit: contain; margin: 0 0 16px; padding: 12px; }
  #vb-fc-{{ section.id }} .vb-fc-top__title { font-size: 20px; font-weight: 800; color: #111; margin: 0 0 8px; }
  #vb-fc-{{ section.id }} .vb-fc-top__desc { color: #555; line-height: 1.5; font-size: 14px; margin: 0 0 16px; }
  #vb-fc-{{ section.id }} .vb-fc-top__btn { background: {{ primary }}; color: #fff; padding: 10px 20px; border-radius: 10px; text-decoration: none; font-weight: 700; font-size: 14px; display: inline-block; }
  #vb-fc-{{ section.id }} .vb-fc-top__btn:hover { background: {{ dark }}; }

  @media (max-width: 749px) {
    #vb-fc-{{ section.id }} { padding: 48px 14px; }
    #vb-fc-{{ section.id }} .vb-fc-define { grid-template-columns: 1fr; padding: 24px; gap: 24px; }
    #vb-fc-{{ section.id }} .vb-fc-top { grid-template-columns: 1fr; }
  }
  #vb-fc-{{ section.id }} .vb-fc-synergy { margin-top: 22px; padding: 16px 18px; background: {{ tint }}; border-left: 4px solid {{ primary }}; border-radius: 12px; }
  #vb-fc-{{ section.id }} .vb-fc-synergy h4 { margin: 0 0 6px; font-size: 15px; font-weight: 800; color: {{ dark }}; }
  #vb-fc-{{ section.id }} .vb-fc-synergy p { margin: 0; font-size: 14px; line-height: 1.55; color: #333; }
  #vb-fc-{{ section.id }} .vb-fc-synergy a { color: {{ primary }}; font-weight: 700; text-decoration: none; }
</style>

{%- liquid
  assign ing_intro = collection.metafields.custom.ingredient_intro | default: ''
  assign ing_mode = false
  if template.name == 'collection' and ing_intro != blank
    assign ing_mode = true
  endif
  assign ing_name = collection.metafields.custom.ingredient_name | default: collection.title
  assign ing_short = collection.metafields.custom.ingredient_short
  assign ing_synergy = collection.metafields.custom.ingredient_synergy
  assign ing_benefits = collection.metafields.custom.ingredient_benefits.value
  assign hero_img = collection.metafields.custom.hero_image.value
  assign hero_head = collection.metafields.custom.hero_headline
  assign star = collection.metafields.custom.star_product.value
-%}
{%- if ing_mode and hero_img != blank -%}
<style>
  .vb-ih { position: relative; width: 100vw; margin-left: calc(50% - 50vw); overflow: hidden; background: #dfeedd; color: #10250f; isolation: isolate; }
  .vb-ih__media { position: absolute; inset: 0; z-index: 0; }
  .vb-ih__media img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 30%; display: block; }
  .vb-ih__scrim { position: absolute; inset: 0; z-index: 1; display: block !important; pointer-events: none; background: linear-gradient(90deg, rgba(242,248,240,.96) 0%, rgba(242,248,240,.88) 32%, rgba(242,248,240,.55) 48%, rgba(242,248,240,0) 64%); }
  .vb-ih__wrap { position: relative; z-index: 2; max-width: 1280px; margin: 0 auto; padding: 72px 40px; min-height: min(560px, 70vh); display: flex; align-items: center; }
  .vb-ih__copy { max-width: 520px; }
  .vb-ih__eyebrow { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: #4d8c44; font-size: 11.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 8px 14px; border-radius: 999px; border: 1.5px solid #4d8c44; margin: 0 0 16px; }
  .vb-ih h1 { font-size: clamp(32px, 4.2vw, 56px); line-height: 1.04; font-weight: 800; letter-spacing: -.02em; margin: 0 0 14px; text-wrap: balance; }
  .vb-ih h1 em { font-style: normal; color: #4d8c44; }
  .vb-ih__sub { font-size: 17px; line-height: 1.55; color: #243a22; margin: 0 0 22px; font-weight: 500; }
  .vb-ih__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .vb-ih__cta { display: inline-flex; align-items: center; padding: 14px 26px; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: 15px; }
  .vb-ih__cta--p { background: #4d8c44; color: #fff !important; box-shadow: 0 10px 24px rgba(20,60,20,.25); }
  .vb-ih__cta--s { background: rgba(255,255,255,.92); color: #10250f !important; border: 2px solid #bcd1b8; }
  .vb-star { max-width: 1280px; margin: -48px auto 0; padding: 0 40px; position: relative; z-index: 3; }
  .vb-star__card { display: grid; grid-template-columns: 180px 1fr auto; gap: 24px; align-items: center; background: #fff; border: 1px solid #e3ece1; border-radius: 22px; padding: 20px 24px; box-shadow: 0 18px 40px rgba(20,60,20,.10); }
  .vb-star__card img { width: 180px; height: 180px; object-fit: contain; border-radius: 14px; background: #f5f9f3; }
  .vb-star__tag { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #4d8c44; margin-bottom: 8px; }
  .vb-star__card h2 { font-size: clamp(20px, 2.2vw, 28px); font-weight: 800; margin: 0 0 8px; line-height: 1.15; }
  .vb-star__card p { font-size: 15px; line-height: 1.55; color: #3d5542; margin: 0; }
  .vb-star__price { font-size: 22px; font-weight: 800; color: #10250f; margin-bottom: 10px; text-align: right; }
  .vb-star__price s { color: #8aa08e; font-weight: 600; font-size: 15px; margin-right: 6px; }
  .vb-star__buy { display: inline-flex; padding: 13px 24px; border-radius: 999px; background: #4d8c44; color: #fff !important; font-weight: 700; text-decoration: none; white-space: nowrap; }
  @media (max-width: 749px) {
    .vb-ih__media img { object-position: 60% 20%; }
    .vb-ih__scrim { background: linear-gradient(0deg, rgba(242,248,240,.97) 0%, rgba(242,248,240,.9) 46%, rgba(242,248,240,.5) 60%, rgba(242,248,240,0) 74%); }
    .vb-ih__wrap { padding: 24px 20px 32px; min-height: min(640px, 88svh); align-items: flex-end; }
    .vb-ih h1 { font-size: clamp(28px, 8.4vw, 38px); }
    .vb-ih__sub { font-size: 15px; }
    .vb-ih__cta { padding: 12px 18px; font-size: 14px; flex: 1 1 auto; justify-content: center; }
    .vb-star { margin-top: -20px; padding: 0 14px; }
    .vb-star__card { grid-template-columns: 96px 1fr; gap: 14px; padding: 16px; }
    .vb-star__card img { width: 96px; height: 96px; }
    .vb-star__side { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; }
    .vb-star__price { margin: 0; text-align: left; }
  }
</style>
<section class="vb-ih" aria-label="{{ ing_name | escape }}">
  <div class="vb-ih__media"><img src="{{ hero_img | image_url: width: 2400 }}" srcset="{{ hero_img | image_url: width: 1200 }} 1200w, {{ hero_img | image_url: width: 2400 }} 2400w" sizes="100vw" alt="{{ hero_img.alt | default: ing_name | escape }}" loading="eager" fetchpriority="high" width="2400" height="1350"></div>
  <div class="vb-ih__scrim"></div>
  <div class="vb-ih__wrap"><div class="vb-ih__copy">
    <span class="vb-ih__eyebrow">Shop by Ingredient</span>
    {%- if hero_head != blank -%}<h1>{{ hero_head }}</h1>{%- else -%}<h1>{{ ing_name }}, <em>delivered by live probiotics.</em></h1>{%- endif -%}
    {%- if ing_short != blank -%}<p class="vb-ih__sub">{{ ing_short }}</p>{%- endif -%}
    <div class="vb-ih__ctas">{%- if star != blank -%}<a class="vb-ih__cta vb-ih__cta--p" href="{{ star.url }}">Shop {{ star.title | split: 'Probiotics' | last | strip | default: star.title }}</a>{%- endif -%}<a class="vb-ih__cta vb-ih__cta--s" href="#vb-fc-{{ section.id }}">Learn about {{ ing_name }}</a></div>
  </div></div>
</section>
{%- endif -%}
{%- if ing_mode and star != blank -%}
<div class="vb-star{% if hero_img == blank %} vb-star--nohero{% endif %}"><div class="vb-star__card">
  <a href="{{ star.url }}"><img src="{{ star.featured_image | image_url: width: 400 }}" alt="{{ star.featured_image.alt | default: star.title | escape }}" width="180" height="180" loading="eager"></a>
  <div><span class="vb-star__tag">Our star {{ ing_name }} product</span><h2><a href="{{ star.url }}" style="color:inherit;text-decoration:none">{{ star.title }}</a></h2><p>{{ star.description | strip_html | truncatewords: 32 }}</p></div>
  <div class="vb-star__side"><div class="vb-star__price">{% if star.compare_at_price > star.price %}<s>{{ star.compare_at_price | money }}</s>{% endif %}{{ star.price | money }}</div><a class="vb-star__buy" href="{{ star.url }}">View product</a></div>
</div></div>
{%- endif -%}
<style>.vb-star--nohero{margin-top:32px}</style>
<section id="vb-fc-{{ section.id }}">
  <div class="vb-fc-wrap">
    <div class="vb-fc-head">
      {%- if ing_mode and hero_img != blank -%}
        {%- comment -%} full-bleed photo hero (custom.hero_image); head text moves onto the photo {%- endcomment -%}
      {%- elsif ing_mode -%}
        <span class="vb-fc-eyebrow">Shop by Ingredient</span>
        <h1 class="vb-fc-title">Powered by <span>{{ collection.title }}.</span></h1>
        {%- if ing_short != blank -%}<p class="vb-fc-sub">{{ ing_short }}</p>{%- endif -%}
      {%- else -%}
        {%- if section.settings.eyebrow != blank -%}<span class="vb-fc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1 class="vb-fc-title">{{ section.settings.title_pre }} <span>{{ section.settings.title_highlight }}</span></h1>
        {%- if section.settings.sub != blank -%}<p class="vb-fc-sub">{{ section.settings.sub }}</p>{%- endif -%}
      {%- endif -%}
    </div>

    {%- if ing_mode or section.settings.define_title != blank or section.settings.define_desc != blank -%}
    <div class="vb-fc-define">
      <div class="vb-fc-define__copy">
        {%- if ing_mode -%}
          <h3>The benefits of {{ ing_name }}</h3>
          <p>{{ ing_intro | newline_to_br }}</p>
          {%- if ing_benefits.size > 0 -%}
            <ul class="vb-fc-benefits">
              {%- for b in ing_benefits -%}<li>{{ b }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if ing_synergy != blank -%}
            <div class="vb-fc-synergy">
              <h4>Why probiotics make {{ ing_name }} work better</h4>
              <p>{{ ing_synergy }} <a href="/pages/what-is-microencapsulation">See how we keep every good bacterium alive →</a></p>
            </div>
          {%- endif -%}
        {%- else -%}
          {%- if section.settings.define_title != blank -%}<h3>{{ section.settings.define_title }}</h3>{%- endif -%}
          {%- if section.settings.define_desc != blank -%}<p>{{ section.settings.define_desc }}</p>{%- endif -%}
          {%- if section.blocks.size > 0 -%}
            <ul class="vb-fc-benefits">
              {%- for block in section.blocks -%}
                {%- if block.type == 'benefit' -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endif -%}
      </div>
      <div class="vb-fc-define__visual">
        {%- if ing_mode and collection.image != blank -%}
          <img src="{{ collection.image | image_url: width: 900 }}" alt="{{ collection.image.alt | default: ing_name | escape }}" loading="lazy" width="900" height="900">
        {%- elsif section.settings.visual_url != blank -%}
          <img src="{{ section.settings.visual_url }}" alt="{{ section.settings.define_title | default: section.settings.title_highlight | escape }}" loading="lazy" width="800" height="800">
        {%- elsif collection.image != blank -%}
          <img src="{{ collection.image | image_url: width: 800 }}" alt="{{ collection.image.alt | default: collection.title | escape }}" loading="lazy" width="800" height="800">
        {%- else -%}
          <span class="vb-fc-define__icon">{{ section.settings.visual_emoji | default: '🌿' }}</span>
        {%- endif -%}
      </div>
    </div>
    {%- endif -%}

    {%- liquid
      assign top1 = blank
      assign top2 = blank
      if ing_mode
        assign top1 = collection.products[0]
        assign top2 = collection.products[1]
        assign badge1 = 'Our most popular ' | append: ing_name | append: ' product'
        assign badge2 = 'Also made with ' | append: ing_name
      else
        assign top1 = all_products[section.settings.top1_handle]
        assign top2 = all_products[section.settings.top2_handle]
        assign badge1 = section.settings.top1_badge | default: 'Top Pick'
        assign badge2 = section.settings.top2_badge | default: 'Also Loved'
      endif
    -%}
    {%- if top1 != blank or top2 != blank -%}
    <div class="vb-fc-top">
      {%- if top1 != blank and top1.available -%}
        <a class="vb-fc-top__card" href="{{ top1.url }}" style="text-decoration:none;color:inherit;">
          <span class="vb-fc-top__badge">{{ badge1 }}</span>
          {%- if top1.featured_image != blank -%}<img class="vb-fc-top__img" src="{{ top1.featured_image | image_url: width: 600 }}" alt="{{ top1.title | escape }}">{%- endif -%}
          <h4 class="vb-fc-top__title">{{ top1.title }}</h4>
          <p class="vb-fc-top__desc">{{ top1.description | strip_html | truncate: 120 }}</p>
          <span class="vb-fc-top__btn">Shop now →</span>
        </a>
      {%- endif -%}
      {%- if top2 != blank and top2.available -%}
        <a class="vb-fc-top__card" href="{{ top2.url }}" style="text-decoration:none;color:inherit;">
          <span class="vb-fc-top__badge">{{ badge2 }}</span>
          {%- if top2.featured_image != blank -%}<img class="vb-fc-top__img" src="{{ top2.featured_image | image_url: width: 600 }}" alt="{{ top2.title | escape }}">{%- endif -%}
          <h4 class="vb-fc-top__title">{{ top2.title }}</h4>
          <p class="vb-fc-top__desc">{{ top2.description | strip_html | truncate: 120 }}</p>
          <span class="vb-fc-top__btn">Shop now →</span>
        </a>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VB · Functional",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by Ingredient" },
    { "type": "text", "id": "title_pre", "label": "Title (pre)", "default": "Powered by" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Iron." },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Combat fatigue, support oxygen transport, and restore energy with our iron-rich probiotic supplements." },
    { "type": "header", "content": "Define the benefit" },
    { "type": "text", "id": "define_title", "label": "Definition title", "default": "Why does iron matter?" },
    { "type": "richtext", "id": "define_desc", "label": "Definition description", "default": "<p>Iron is essential for haemoglobin production and oxygen delivery. Low iron causes fatigue, brain fog, and weakened immunity — especially in women.</p>" },
    { "type": "text", "id": "visual_emoji", "label": "Visual emoji (fallback)", "default": "🔥" },
    { "type": "url", "id": "visual_url", "label": "Visual image URL (optional)" },
    { "type": "header", "content": "Top product highlights" },
    { "type": "text", "id": "top1_handle", "label": "Top product 1 handle" },
    { "type": "text", "id": "top1_badge", "label": "Top 1 badge", "default": "Bestseller" },
    { "type": "text", "id": "top2_handle", "label": "Top product 2 handle" },
    { "type": "text", "id": "top2_badge", "label": "Top 2 badge", "default": "Also Loved" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "primary", "label": "Primary", "default": "#4d8c44" },
    { "type": "color", "id": "dark", "label": "Dark", "default": "#2e5d28" },
    { "type": "color", "id": "tint", "label": "Tint", "default": "#eef7ec" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "text", "id": "text", "label": "Benefit", "default": "Restores healthy iron levels" }
    ]}
  ],
  "presets": [ { "name": "VB · Functional" } ]
}
{% endschema %}
