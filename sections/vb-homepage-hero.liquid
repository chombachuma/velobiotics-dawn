{{ 'vb-homepage-hero.css' | asset_url | stylesheet_tag }}

{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0668/5848/3883/files' -%}

<section class="vb-hero" id="vb-hero">

  {%- comment -%} Scrolling trust ticker {%- endcomment -%}
  <div class="vb-hero__ticker" aria-hidden="true">
    <div class="vb-hero__ticker-track">
      {%- for i in (1..3) -%}
        <span>☑️ Science-Backed</span><span class="vb-dot">•</span>
        <span>🩺 Doctor-Recommended</span><span class="vb-dot">•</span>
        <span>🧪 Patented MEP Technology</span><span class="vb-dot">•</span>
        <span>🔄 100% Money-Back Guarantee</span><span class="vb-dot">•</span>
        <span>🚚 Free Shipping Over R400</span><span class="vb-dot">•</span>
        <span>⭐ 3,500+ Verified Reviews</span><span class="vb-dot">•</span>
        <span>💊 1000× More Probiotics Delivered</span><span class="vb-dot">•</span>
        <span>🏭 SAHPRA-Certified Manufacturing</span><span class="vb-dot">•</span>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Hero split layout {%- endcomment -%}
  <div class="vb-hero__split">

    {%- comment -%} LEFT copy {%- endcomment -%}
    <div class="vb-hero__copy">
      <span class="vb-badge vb-badge--green">Patented Probiotics That Actually Reach Your Gut</span>

      <div class="vb-hero__stars">
        <span class="vb-stars" aria-hidden="true">★★★★★</span>
        <span>Over <strong>3,500 Reviews</strong> &nbsp;|&nbsp; <strong>300,000</strong> Happy Customers</span>
      </div>

      <h1 class="vb-hero__h1">
        Most Probiotics Die<br>in Your Stomach.<br>
        <em class="vb-hero__h1-em">Ours Don't!</em>
      </h1>

      <p class="vb-hero__body">
        Velobiotics protects every live culture through stomach acid delivering
        <strong>1000× more probiotics to your gut</strong>, where they're needed for real results, you can feel.
      </p>

      <div class="vb-hero__ctas">
        <a href="/collections/all" class="vb-btn vb-btn--primary vb-btn--xl">
          Shop Products
        </a>
        <a href="/pages/quiz" class="vb-btn vb-btn--ghost-white vb-btn--xl">
          🎯 Take The Quiz
        </a>
      </div>

      {%- comment -%} 4 trust pills {%- endcomment -%}
      <div class="vb-hero__badges">
        <div class="vb-trust-pill">
          <div class="vb-trust-pill__icon">🛡️</div>
          <div><strong>Patented MEP</strong><span>Technology</span></div>
        </div>
        <div class="vb-trust-pill">
          <div class="vb-trust-pill__icon">💊</div>
          <div><strong>1000×</strong><span>More Delivered</span></div>
        </div>
        <div class="vb-trust-pill">
          <div class="vb-trust-pill__icon">🩺</div>
          <div><strong>Doctor</strong><span>Formulated</span></div>
        </div>
        <div class="vb-trust-pill">
          <div class="vb-trust-pill__icon">🔄</div>
          <div><strong>Money-Back</strong><span>Guarantee</span></div>
        </div>
      </div>
    </div>

    {%- comment -%} RIGHT image {%- endcomment -%}
    <div class="vb-hero__media">
      <img
        src="{{ cdn }}/new-hero-section-image-003.jpg"
        alt="Velobiotics — Probiotics that survive"
        class="vb-hero__img"
        width="700" height="700"
        fetchpriority="high"
        loading="eager"
      >

      <div class="vb-hero__chip vb-hero__chip--review" aria-hidden="true">
        <div class="vb-hero__chip-stars">★★★★★</div>
        <p class="vb-hero__chip-quote">"Lost 42kgs — Velo16 helped me lose the last kg!"</p>
        <p class="vb-hero__chip-name">— Nicky vd Westhuizen ✅</p>
      </div>

      <div class="vb-hero__chip vb-hero__chip--stat" aria-hidden="true">
        <span class="vb-hero__chip-big">300K+</span>
        <span class="vb-hero__chip-label">Happy Customers</span>
      </div>

      <div class="vb-hero__chip vb-hero__chip--mep" aria-hidden="true">
        <span class="vb-hero__chip-mep-num">1000×</span>
        <span class="vb-hero__chip-label">More Probiotics</span>
      </div>
    </div>
  </div>

  {%- comment -%} As-seen-on logos {%- endcomment -%}
  <div class="vb-hero__seen-on">
    <p class="vb-hero__seen-on-label">As Seen On</p>
    <div class="vb-hero__seen-on-logos">
      <img src="{{ cdn }}/as-seen-on-logo-001.png" alt="Media coverage" loading="lazy" class="vb-hero__seen-logo" width="120" height="40">
      <img src="{{ cdn }}/as-seen-on-logo-002.png" alt="Media coverage" loading="lazy" class="vb-hero__seen-logo" width="120" height="40">
      <img src="{{ cdn }}/as-seen-on-logo-003.png" alt="Media coverage" loading="lazy" class="vb-hero__seen-logo" width="120" height="40">
      <img src="{{ cdn }}/as-seen-on-logo-004.png" alt="Media coverage" loading="lazy" class="vb-hero__seen-logo" width="120" height="40">
      <img src="{{ cdn }}/as-seen-on-logo-005.png" alt="Media coverage" loading="lazy" class="vb-hero__seen-logo" width="120" height="40">
    </div>
  </div>

</section>

{% schema %}
{
  "name": "VB Hero",
  "tag": "div",
  "class": "vb-section-wrap",
  "settings": [],
  "presets": [{ "name": "VB Hero" }]
}
{% endschema %}
