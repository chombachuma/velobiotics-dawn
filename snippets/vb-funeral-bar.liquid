.vb-fbar b{color:#fff;font-weight:700}
.vb-fbar i{font:800 12px/1 Arial,Helvetica,sans-serif;font-style:normal;letter-spacing:.14em;text-transform:uppercase;color:#050705;background:#8cff5a;border-radius:4px;padding:9px 14px;white-space:nowrap}
