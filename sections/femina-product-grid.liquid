{%- comment -%}
  Femina product grid — femina.care "Products That Perform" style.
  Cards: transparent product imagery, big save-% starburst,
  no CTA on sold-out (card itself is clickable), Velobiotics green accent.
  Single-product collections: card auto-centers at sensible max width.
{%- endcomment -%}

{%- liquid
  assign brand_primary = section.settings.brand_primary | default: '#8d2a89'
  assign brand_secondary = section.settings.brand_secondary | default: '#4d8c44'
  assign card_bg = section.settings.card_bg | default: '#fdf8fd'
  assign card_bg2 = section.settings.card_bg2 | default: '#f5e9f4'
  assign card_min = section.settings.card_min_width | default: 300
-%}

<style>
  .fpg-section { padding: 24px 20px 60px; max-width: 1280px; margin: 0 auto; --bp: {{ brand_primary }}; --bs: {{ brand_secondary }}; }
  .fpg-section__head { margin: 0 0 32px; text-align: center; }
  .fpg-section__eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--bp); font-weight: 700; margin: 0 0 8px; }
  .fpg-section__eyebrow::before, .fpg-section__eyebrow::after { content: ''; width: 22px; height: 2px; background: var(--bs); border-radius: 2px; }
  .fpg-section__title { font-size: clamp(24px, 3.4vw, 36px); font-weight: 800; margin: 0 0 8px; line-height: 1.15; color: #1a1a1a; }
  .fpg-section__title em { color: var(--bp); font-style: italic; font-weight: 700; }
  .fpg-section__sub { font-size: 16px; line-height: 1.5; color: #555; max-width: 640px; margin: 0 auto; }

  .fpg-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax({{ card_min }}px, 1fr)); gap: 24px; }
  /* Single-product collections — cap card width and centre */
  .fpg-grid:has(> .fpg-card:only-child) { grid-template-columns: minmax({{ card_min }}px, 380px); justify-content: center; }
  /* Two-product collections — keep cards reasonably sized */
  .fpg-grid:has(> .fpg-card:nth-child(2):last-child) { grid-template-columns: repeat(2, minmax({{ card_min }}px, 380px)); justify-content: center; }

  .fpg-card { position: relative; display: flex; flex-direction: column; background: #fff; border: 1px solid #ece7f0; border-radius: 16px; overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease; }
  .fpg-card:hover { transform: translateY(-8px) scale(1.015); box-shadow: 0 28px 50px rgba(77, 140, 68, 0.22); border-color: color-mix(in srgb, var(--bp) 35%, transparent); }
  .fpg-card--soldout { opacity: 0.74; }
  .fpg-card--soldout:hover { transform: none; box-shadow: 0 8px 18px rgba(0,0,0,0.08); }

  .fpg-card__media { position: relative; width: 100%; aspect-ratio: 1 / 1; background: linear-gradient(135deg, var(--cardbg, #fdf8fd) 0%, var(--cardbg2, #f5e9f4) 100%); overflow: hidden; isolation: isolate; }
  .fpg-card__media img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform 0.4s ease; mix-blend-mode: multiply; filter: contrast(1.02) saturate(1.05); }
  .fpg-card:hover .fpg-card__media img { transform: scale(1.06); }
  .fpg-card__pill { position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,0.97); color: var(--bp); font-weight: 700; font-size: 11px; padding: 6px 11px; border-radius: 999px; box-shadow: 0 6px 14px rgba(0,0,0,0.10); white-space: nowrap; z-index: 2; backdrop-filter: blur(6px); }
  .fpg-card__sold { position: absolute; top: 12px; right: 12px; background: #1a1a1a; color: #fff; font-weight: 700; font-size: 10px; padding: 6px 12px; border-radius: 999px; letter-spacing: .08em; text-transform: uppercase; z-index: 2; }

  @keyframes fpg-savepulse { 0%,100% { transform: rotate(-8deg) scale(1); } 50% { transform: rotate(-8deg) scale(1.06); } }
  .fpg-card__save { position: absolute; top: 10px; right: 10px; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; min-width: 64px; height: 64px; background: radial-gradient(circle at 30% 30%, #6fb863 0%, #4d8c44 55%, #2e5d28 100%); color: #fff !important; font-weight: 900; font-size: 18px; border-radius: 50%; box-shadow: 0 10px 26px rgba(77, 140, 68, 0.48), inset 0 -3px 8px rgba(0,0,0,0.18), inset 0 2px 4px rgba(255,255,255,0.35); letter-spacing: -0.02em; transform: rotate(-8deg); z-index: 3; line-height: 1; padding: 8px; text-align: center; animation: fpg-savepulse 2.4s ease-in-out infinite; border: 3px solid rgba(255,255,255,0.55); }
  .fpg-card__save small { display: block; font-size: 9px; font-weight: 800; letter-spacing: .1em; opacity: 0.96; margin-top: 1px; }
  .fpg-card--soldout .fpg-card__save { display: none; }

  .fpg-card__body { padding: 18px 18px 20px; display: flex; flex-direction: column; flex: 1; }
  .fpg-card__meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 12px; font-weight: 700; letter-spacing: .04em; margin: 0 0 10px; min-height: 22px; }
  .fpg-card__brandtag { display: inline-flex; align-items: center; gap: 4px; background: color-mix(in srgb, var(--bs) 15%, transparent); color: var(--bs); padding: 4px 10px; border-radius: 999px; font-size: 11px; }
  .fpg-card__bestseller { color: var(--bp); }
  .fpg-card__title { font-size: 17px; font-weight: 800; line-height: 1.25; margin: 0 0 8px; color: #1a1a1a; }
  .fpg-card__desc { font-size: 13px; line-height: 1.55; color: #555; margin: 0 0 14px; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .fpg-card__priceline { display: flex; align-items: baseline; gap: 10px; margin: 0; flex-wrap: wrap; }
  .fpg-card__price { font-size: 19px; font-weight: 800; color: #1a1a1a; }
  .fpg-card__compare { font-size: 13px; color: #a0a0a0; text-decoration: line-through; }
  .fpg-card__soldlabel { color: #999; font-weight: 700; font-size: 13px; letter-spacing: .03em; }

  .fpg-pagination { display: flex; justify-content: center; align-items: center; gap: 8px; margin: 40px 0 0; flex-wrap: wrap; }
  .fpg-pagination a, .fpg-pagination span { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 14px; border-radius: 999px; font-size: 14px; font-weight: 700; text-decoration: none; color: #555; border: 1px solid #ece7f0; background: #fff; transition: all 0.18s ease; }
  .fpg-pagination a:hover { border-color: var(--bp); color: var(--bp); transform: translateY(-1px); }
  .fpg-pagination .fpg-current { background: var(--bp); color: #fff !important; border-color: var(--bp); }
  .fpg-pagination .fpg-disabled { opacity: 0.4; cursor: not-allowed; }

  @media (max-width: 749px) {
    .fpg-section { padding: 8px 14px 40px; }
    .fpg-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
    .fpg-grid:has(> .fpg-card:only-child) { grid-template-columns: 1fr; }
    .fpg-card__body { padding: 14px 14px 16px; }
    .fpg-card__title { font-size: 14px; }
    .fpg-card__desc { font-size: 12px; -webkit-line-clamp: 2; }
    .fpg-card__price { font-size: 16px; }
    .fpg-card__brandtag { font-size: 10px; padding: 3px 8px; }
    .fpg-card__save { min-width: 50px; height: 50px; font-size: 14px; top: 8px; right: 8px; }
    .fpg-card__save small { font-size: 8px; }
    .fpg-card__pill { font-size: 10px; padding: 5px 9px; }
  }
</style>

<div class="fpg-section" style="--cardbg: {{ card_bg }}; --cardbg2: {{ card_bg2 }};">
  {%- if section.settings.show_heading -%}
    <div class="fpg-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fpg-section__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="fpg-section__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.sub != blank -%}
        <p class="fpg-section__sub">{{ section.settings.sub }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="fpg-grid">
      {%- for product in collection.products -%}
        {%- liquid
          assign pill_text = ''
          assign is_bestseller = false
          for tag in product.tags
            if tag contains 'pill:'
              assign pill_text = tag | remove_first: 'pill:' | strip
            endif
            if tag == 'best-seller' or tag == 'bestseller' or tag == 'Best Seller'
              assign is_bestseller = true
            endif
          endfor
          assign savings_pct = 0
          if product.compare_at_price > product.price and product.compare_at_price > 0
            assign diff = product.compare_at_price | minus: product.price
            assign savings_pct = diff | times: 100.0 | divided_by: product.compare_at_price | round
          endif
          assign card_classes = 'fpg-card'
          unless product.available
            assign card_classes = 'fpg-card fpg-card--soldout'
          endunless
        -%}
        <a href="{{ product.url }}" class="{{ card_classes }}" aria-label="{{ product.title | escape }}">
          <div class="fpg-card__media">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="600" />
            {%- endif -%}
            {%- if pill_text != blank -%}
              <span class="fpg-card__pill">{{ pill_text }}</span>
            {%- endif -%}
            {%- if product.available == false -%}
              <span class="fpg-card__sold">Sold out</span>
            {%- elsif savings_pct > 0 -%}
              <span class="fpg-card__save">−{{ savings_pct }}%<small>SAVE</small></span>
            {%- endif -%}
          </div>
          <div class="fpg-card__body">
            <div class="fpg-card__meta">
              {%- if is_bestseller -%}<span class="fpg-card__bestseller">🏆 Best Seller</span>{%- endif -%}
              <span class="fpg-card__brandtag">{{ section.settings.brand_label | default: 'Femina™' }}</span>
            </div>
            <h3 class="fpg-card__title">{{ product.title }}</h3>
            <p class="fpg-card__desc">{{ product.description | strip_html | truncatewords: 20 }}</p>
            <div class="fpg-card__priceline">
              {%- if product.available -%}
                <span class="fpg-card__price">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="fpg-card__compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              {%- else -%}
                <span class="fpg-card__soldlabel">Currently unavailable</span>
              {%- endif -%}
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="fpg-pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>
        {%- else -%}
          <span class="fpg-disabled" aria-hidden="true">←</span>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span class="fpg-current">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" aria-label="Next page">→</a>
        {%- else -%}
          <span class="fpg-disabled" aria-hidden="true">→</span>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Femina product grid",
  "tag": "section",
  "class": "femina-product-grid-section",
  "settings": [
    { "type": "header", "content": "Section heading" },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading above grid", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "title", "label": "Title", "default": "Products That Perform" },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Every Femina product is formulated to work in harmony with your body's natural ecosystem — and backed by 2,000+ verified five-star stories." },
    { "type": "header", "content": "Brand colours" },
    { "type": "color", "id": "brand_primary", "label": "Brand primary (accent)", "default": "#8d2a89" },
    { "type": "color", "id": "brand_secondary", "label": "Brand secondary (Velobiotics green)", "default": "#4d8c44" },
    { "type": "color", "id": "card_bg", "label": "Card background gradient start", "default": "#fdf8fd" },
    { "type": "color", "id": "card_bg2", "label": "Card background gradient end", "default": "#f5e9f4" },
    { "type": "text", "id": "brand_label", "label": "Brand label on each card", "default": "Femina™" },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 4, "max": 48, "step": 2, "default": 12 },
    { "type": "range", "id": "card_min_width", "label": "Card minimum width (px)", "min": 200, "max": 360, "step": 20, "default": 300, "info": "Smaller = more columns on desktop. Use 240 for compact, 300 for default, 340 for spacious." }
  ],
  "presets": [
    { "name": "Femina product grid" }
  ]
}
{% endschema %}
