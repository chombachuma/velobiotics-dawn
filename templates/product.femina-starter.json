        "q1": {
          "type": "q",
          "settings": {
            "question": "How much do I save with the Femina Starter Pack?",
            "answer": "<p>You save R279.90 (over 30% discount) compared to purchasing the pH Self-Test Kit (R199.95), Cookie Fresh Suppositories (R399.95), and Femina Probiotic Capsules (R299.95) individually.</p>"
          }
