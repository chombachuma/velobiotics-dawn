    {"type":"text","id":"cta_start","label":"Start button text","default":"Start the BioMatch"},
    {"type":"url","id":"hero_image_url","label":"Hero image URL (full-bleed background)","info":"Wide editorial portrait — preferably a confident person, soft natural light. Fades to cream at the edges."},
    {"type":"header","content":"Lead Capture"},
    {"type":"textarea","id":"lead_sub","label":"Lead capture sub-text","default":"Get your recommendation plus a free 7-day wellness email series, science guides, and exclusive subscriber pricing."},
    {"type":"header","content":"Integrations"},
    {"type":"text","id":"omnisend_api_key","label":"Omnisend API Key","info":"Paste your Omnisend API key (Settings → API in Omnisend)."},
