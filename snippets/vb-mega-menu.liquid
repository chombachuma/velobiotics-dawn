{%- comment -%}
  VB · Native Mega Menu v2
  Desktop: full-width mega panels with cream-tinted background + explicit colors
  Mobile: slide-from-left drawer (no fallback to Dawn/Buddha)
  Drop-in replacement for `header-mega-menu` snippet.
{%- endcomment -%}

{%- assign menu = section.settings.menu -%}

{%- comment -%} ============ HAMBURGER TRIGGER (mobile only) ============ {%- endcomment -%}
<button
  type="button"
  class="vb-mm-burger"
  data-vb-mm-burger
  aria-expanded="false"
  aria-label="Open menu"
  aria-controls="vb-mm-drawer"
>
  <span class="vb-mm-burger__bars" aria-hidden="true">
    <span></span><span></span><span></span>
  </span>
</button>

{%- comment -%} ============ DESKTOP MEGA MENU ============ {%- endcomment -%}
<nav class="vb-mm" aria-label="Main" data-vb-mm>
  <ul class="vb-mm__list" role="menubar">
    {%- for link in menu.links -%}
      {%- assign has_children = false -%}
      {%- if link.links.size > 0 -%}{%- assign has_children = true -%}{%- endif -%}
      {%- assign link_handle = link.title | handle -%}

      {%- if has_children -%}
        <li class="vb-mm__item vb-mm__item--mega" role="none">
          <button
            type="button"
            class="vb-mm__trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="vb-mm-panel-{{ forloop.index }}"
            data-vb-mm-trigger="{{ forloop.index }}"
            role="menuitem"
          >
            <span class="vb-mm__trigger-text">{{ link.title }}</span>
            <svg class="vb-mm__chev" viewBox="0 0 12 8" aria-hidden="true">
              <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div
            class="vb-mm__panel"
            id="vb-mm-panel-{{ forloop.index }}"
            data-vb-mm-panel="{{ forloop.index }}"
            aria-hidden="true"
            role="menu"
          >
            <div class="vb-mm__panel-inner">
              <div class="vb-mm__panel-cols">
                <div class="vb-mm__panel-heading">
                  <span class="vb-mm__eyebrow">Explore</span>
                  <h3 class="vb-mm__title">{{ link.title }}</h3>
                </div>
                <ul class="vb-mm__panel-list" role="none">
                  {%- for child in link.links -%}
                    {%- liquid
                      assign child_handle = child.title | handle
                      assign emoji = '→'
                      case child_handle
                        when 'female-intimate-health' or 'femina'
                          assign emoji = '🌸'
                        when 'weight-loss-management' or 'gutslim'
                          assign emoji = '🔥'
                        when 'gut-health'
                          assign emoji = '🌿'
                        when 'pregnancy-support' or 'pregbiotics'
                          assign emoji = '🤰'
                        when 'skin-hair-nails' or 'almasi'
                          assign emoji = '✨'
                        when 'meal-replacements'
                          assign emoji = '🥤'
                        when 'velobiotics-story' or 'founder-s-story'
                          assign emoji = '📖'
                        when 'microencapsulation' or 'what-is-microencapsulation'
                          assign emoji = '🧬'
                        when 'microencapsulation-research'
                          assign emoji = '🔬'
                        when 'heat-stability-and-shelf-life'
                          assign emoji = '🌡️'
                        when 'probiotics-tolerance-to-gastric-acid'
                          assign emoji = '🛡️'
                        when 'probiotics-what-are-the-challenges'
                          assign emoji = '❓'
                        when 'contact-us' or 'new-contact-us'
                          assign emoji = '💬'
                        when 'affiliates'
                          assign emoji = '🤝'
                        when 'collabs' or 'collab'
                          assign emoji = '🎯'
                        when 'store-locator' or 'find-our-stockists'
                          assign emoji = '📍'
                      endcase
                    -%}
                    <li class="vb-mm__panel-li" role="none">
                      <a href="{{ child.url }}" class="vb-mm__panel-link" role="menuitem">
                        <span class="vb-mm__panel-link-icon">{{ emoji }}</span>
                        <span class="vb-mm__panel-link-text">{{ child.title }}</span>
                        <span class="vb-mm__panel-link-arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>

              <aside class="vb-mm__feature" aria-label="Featured">
                {%- case link_handle -%}
                  {%- when 'shop-now' -%}
                    <div class="vb-mm__feature-card vb-mm__feature-card--quiz">
                      <span class="vb-mm__feature-eyebrow">Not sure which one?</span>
                      <h4 class="vb-mm__feature-title">Take the 60-second V-Check</h4>
                      <p class="vb-mm__feature-desc">Answer 7 quick questions and get matched to your perfect Velobiotics probiotic — built by doctors, tailored for your goal.</p>
                      <a href="/pages/quiz" class="vb-mm__feature-btn">🧬 Start the V-Check →</a>
                    </div>
                  {%- when 'velobiotics' or 'probiotics' or 'science' -%}
                    <div class="vb-mm__feature-card vb-mm__feature-card--science">
                      <span class="vb-mm__feature-eyebrow">Velobiotics™ MEP</span>
                      <h4 class="vb-mm__feature-title">1000× more probiotics survive your stomach</h4>
                      <p class="vb-mm__feature-desc">Most probiotics die before they reach your gut. Our patented Microencapsulation with Supercritical CO₂ keeps every culture alive — clinically proven.</p>
                      <a href="/pages/what-is-microencapsulation" class="vb-mm__feature-btn">Discover the science →</a>
                    </div>
                  {%- when 'resources' -%}
                    <div class="vb-mm__feature-card vb-mm__feature-card--bundle">
                      <span class="vb-mm__feature-eyebrow">Best Sellers</span>
                      <h4 class="vb-mm__feature-title">Save up to 25% with curated bundles</h4>
                      <p class="vb-mm__feature-desc">Doctor-designed product stacks — perfect for gut reset, pregnancy, weight management, and intimate health.</p>
                      <a href="/collections/gut-bundles" class="vb-mm__feature-btn">Shop bundles →</a>
                    </div>
                  {%- else -%}
                    <div class="vb-mm__feature-card vb-mm__feature-card--default">
                      <span class="vb-mm__feature-eyebrow">Velobiotics</span>
                      <h4 class="vb-mm__feature-title">Patented MEP™ Probiotics</h4>
                      <p class="vb-mm__feature-desc">Trusted globally. Doctor-formulated. Clinically studied. Nine brands. One uncompromising science.</p>
                      <a href="/collections/all" class="vb-mm__feature-btn">Shop the range →</a>
                    </div>
                {%- endcase -%}
              </aside>
            </div>
          </div>
        </li>
      {%- else -%}
        <li class="vb-mm__item" role="none">
          <a href="{{ link.url }}" class="vb-mm__link" role="menuitem">{{ link.title }}</a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</nav>

{%- comment -%} ============ MOBILE DRAWER ============ {%- endcomment -%}
<div class="vb-mmd" id="vb-mm-drawer" data-vb-mm-drawer aria-hidden="true">
  <div class="vb-mmd__overlay" data-vb-mmd-close></div>
  <aside class="vb-mmd__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <header class="vb-mmd__header">
      <a href="{{ routes.root_url }}" class="vb-mmd__logo">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 200 | image_tag: alt: shop.name, class: 'vb-mmd__logo-img', loading: 'lazy', widths: '100,200' }}
        {%- else -%}
          <span class="vb-mmd__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <button type="button" class="vb-mmd__close" data-vb-mmd-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M6 6l12 12M6 18L18 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <nav class="vb-mmd__nav" aria-label="Mobile main">
      <ul class="vb-mmd__list">
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <li class="vb-mmd__item vb-mmd__item--has-children">
              <button type="button" class="vb-mmd__item-toggle" data-vb-mmd-toggle aria-expanded="false">
                <span>{{ link.title }}</span>
                <svg class="vb-mmd__chev" viewBox="0 0 12 8" width="11" height="11" aria-hidden="true">
                  <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <ul class="vb-mmd__sub" data-vb-mmd-sub>
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}" class="vb-mmd__sub-link">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            </li>
          {%- else -%}
            <li class="vb-mmd__item">
              <a href="{{ link.url }}" class="vb-mmd__item-link">{{ link.title }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <footer class="vb-mmd__footer">
      <a href="/pages/quiz" class="vb-mmd__cta">🧬 Take the V-Check Quiz</a>
      <div class="vb-mmd__support">
        <a href="/cart" class="vb-mmd__support-link">🛒 Cart</a>
        <a href="/account" class="vb-mmd__support-link">👤 Account</a>
      </div>
    </footer>
  </aside>
</div>

<style>
  .vb-mm, .vb-mm *, .vb-mmd, .vb-mmd *, .vb-mm-burger, .vb-mm-burger * {
    font-family: 'Poppins', 'Helvetica Neue', Arial, sans-serif !important;
    box-sizing: border-box;
  }

  /* ====== HAMBURGER (mobile only) ====== */
  .vb-mm-burger {
    display: none;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.25);
    color: #ffffff;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    padding: 0;
    flex-shrink: 0;
  }
  .vb-mm-burger:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.5); }
  .vb-mm-burger__bars { display: flex; flex-direction: column; gap: 4px; width: 20px; }
  .vb-mm-burger__bars span { display: block; width: 100%; height: 2px; background: #ffffff; border-radius: 2px; transition: all 0.25s ease; }
  .vb-mm-burger[aria-expanded="true"] .vb-mm-burger__bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .vb-mm-burger[aria-expanded="true"] .vb-mm-burger__bars span:nth-child(2) { opacity: 0; }
  .vb-mm-burger[aria-expanded="true"] .vb-mm-burger__bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* ====== DESKTOP MEGA MENU ====== */
  .vb-mm { display: none; }
  @media screen and (min-width: 990px) { .vb-mm { display: block !important; } }

  .vb-mm__list {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    gap: 4px !important;
    align-items: stretch !important;
  }
  .vb-mm__item { position: static !important; display: flex !important; align-items: stretch !important; }

  .vb-mm__trigger,
  .vb-mm__link {
    background: transparent !important;
    border: 0 !important;
    padding: 14px 14px !important;
    font-size: 13.5px !important;
    font-weight: 500 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    text-decoration: none !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    transition: opacity 0.15s ease !important;
    line-height: 1 !important;
  }
  .vb-mm__trigger:hover,
  .vb-mm__trigger[aria-expanded="true"],
  .vb-mm__link:hover { opacity: 0.78 !important; }

  .vb-mm__chev { width: 9px; height: 9px; transition: transform 0.2s ease; flex-shrink: 0; }
  .vb-mm__trigger[aria-expanded="true"] .vb-mm__chev { transform: rotate(180deg); }

  /* ========== MEGA PANEL ========== */
  .vb-mm__panel {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    top: 100% !important;
    background: #fdfaf2 !important;
    color: #2e5d28 !important;
    border-top: 2px solid #4d8c44 !important;
    box-shadow: 0 24px 50px -14px rgba(0,0,0,0.22) !important;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
    z-index: 90 !important;
    pointer-events: none;
  }
  .vb-mm__panel[data-vb-mm-open="true"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0s;
    pointer-events: auto;
  }
  .vb-mm__panel-inner {
    max-width: 1400px !important;
    margin: 0 auto !important;
    padding: 42px 48px 48px !important;
    display: grid !important;
    grid-template-columns: 1.5fr 1fr !important;
    gap: 64px !important;
  }
  .vb-mm__panel-heading {
    margin-bottom: 24px !important;
    padding-bottom: 18px !important;
    border-bottom: 1px solid #e2efde !important;
  }
  .vb-mm__eyebrow {
    display: inline-block !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
    color: #4d8c44 !important;
    margin-bottom: 8px !important;
    opacity: 1 !important;
  }
  .vb-mm__title {
    font-family: 'Playfair Display', 'Poppins', serif !important;
    font-weight: 600 !important;
    font-size: 28px !important;
    line-height: 1.2 !important;
    color: #1a4015 !important;
    margin: 0 !important;
  }
  .vb-mm__panel-list {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 4px 18px !important;
  }
  .vb-mm__panel-li { margin: 0 !important; }
  .vb-mm__panel-link {
    display: flex !important;
    align-items: center !important;
    gap: 14px !important;
    padding: 12px 14px !important;
    border-radius: 10px !important;
    text-decoration: none !important;
    color: #1a4015 !important;
    font-size: 14.5px !important;
    font-weight: 500 !important;
    background: transparent !important;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease !important;
  }
  .vb-mm__panel-link:hover {
    background: #eef7ec !important;
    color: #4d8c44 !important;
    text-decoration: none !important;
  }
  .vb-mm__panel-link:hover .vb-mm__panel-link-arrow {
    transform: translateX(4px) !important;
    opacity: 1 !important;
  }
  .vb-mm__panel-link-icon {
    font-size: 18px !important;
    flex-shrink: 0 !important;
    width: 26px !important;
    text-align: center !important;
    color: inherit !important;
  }
  .vb-mm__panel-link-text { flex: 1 !important; color: inherit !important; }
  .vb-mm__panel-link-arrow {
    color: #4d8c44 !important;
    font-weight: 600 !important;
    opacity: 0;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  /* ========== FEATURE CARD ========== */
  .vb-mm__feature-card {
    border-radius: 14px !important;
    padding: 28px 26px !important;
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    position: relative !important;
    overflow: hidden !important;
  }
  .vb-mm__feature-card--quiz {
    background: linear-gradient(135deg, #4d8c44 0%, #2e5d28 100%) !important;
    color: #ffffff !important;
  }
  .vb-mm__feature-card--science {
    background: #eef7ec !important;
    color: #1a4015 !important;
    border: 1px solid #c4e8be !important;
  }
  .vb-mm__feature-card--bundle {
    background: linear-gradient(135deg, #fff8eb 0%, #ffe9c0 100%) !important;
    color: #6b4a00 !important;
    border: 1px solid #f5d690 !important;
  }
  .vb-mm__feature-card--default {
    background: #ffffff !important;
    color: #1a4015 !important;
    border: 1px solid #d5ead0 !important;
  }
  .vb-mm__feature-eyebrow {
    display: inline-block !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    opacity: 0.85 !important;
    margin-bottom: 10px !important;
    color: inherit !important;
  }
  .vb-mm__feature-title {
    font-family: 'Playfair Display', 'Poppins', serif !important;
    font-weight: 600 !important;
    font-size: 22px !important;
    line-height: 1.25 !important;
    margin: 0 0 12px !important;
    color: inherit !important;
  }
  .vb-mm__feature-desc {
    margin: 0 0 18px !important;
    font-size: 13.5px !important;
    line-height: 1.55 !important;
    opacity: 0.92 !important;
    color: inherit !important;
  }
  .vb-mm__feature-btn {
    display: inline-flex !important;
    align-self: flex-start !important;
    align-items: center !important;
    gap: 6px !important;
    padding: 11px 18px !important;
    border-radius: 8px !important;
    background: #ffffff !important;
    color: #2e5d28 !important;
    font-weight: 600 !important;
    font-size: 13.5px !important;
    text-decoration: none !important;
    transition: transform 0.15s ease, box-shadow 0.15s ease !important;
  }
  .vb-mm__feature-card--quiz .vb-mm__feature-btn { background: #ffffff !important; color: #2e5d28 !important; }
  .vb-mm__feature-card--science .vb-mm__feature-btn { background: #4d8c44 !important; color: #ffffff !important; }
  .vb-mm__feature-card--bundle .vb-mm__feature-btn { background: #ffa500 !important; color: #ffffff !important; }
  .vb-mm__feature-card--default .vb-mm__feature-btn { background: #4d8c44 !important; color: #ffffff !important; }
  .vb-mm__feature-btn:hover {
    transform: translateY(-1px) !important;
    box-shadow: 0 8px 18px -4px rgba(0,0,0,0.22) !important;
    text-decoration: none !important;
  }

  /* ========== BACKDROP ========== */
  .vb-mm-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 89;
  }
  .vb-mm-backdrop[data-vb-mm-backdrop-open="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  /* ========== HAMBURGER on mobile ========== */
  @media screen and (max-width: 989px) {
    .vb-mm { display: none !important; }
    .vb-mm-burger { display: inline-flex !important; }
  }
  @media screen and (min-width: 990px) {
    .vb-mm-burger { display: none !important; }
  }

  /* ========== MOBILE DRAWER ========== */
  .vb-mmd {
    position: fixed !important;
    inset: 0 !important;
    z-index: 1000 !important;
    pointer-events: none !important;
    visibility: hidden;
  }
  .vb-mmd[data-vb-mmd-open="true"] {
    pointer-events: auto !important;
    visibility: visible;
  }
  .vb-mmd__overlay {
    position: absolute !important;
    inset: 0 !important;
    background: rgba(0,0,0,0.55);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .vb-mmd[data-vb-mmd-open="true"] .vb-mmd__overlay { opacity: 1; }
  .vb-mmd__panel {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    bottom: 0 !important;
    width: 88% !important;
    max-width: 380px !important;
    background: #fdfaf2 !important;
    color: #1a4015 !important;
    display: flex !important;
    flex-direction: column !important;
    transform: translateX(-100%);
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 8px 0 32px -8px rgba(0,0,0,0.3);
    overflow: hidden !important;
  }
  .vb-mmd[data-vb-mmd-open="true"] .vb-mmd__panel { transform: translateX(0); }
  .vb-mmd__header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 18px 22px !important;
    border-bottom: 1px solid #e2efde !important;
    flex-shrink: 0 !important;
    background: #ffffff !important;
  }
  .vb-mmd__logo { display: inline-flex !important; align-items: center !important; height: 38px !important; text-decoration: none !important; }
  .vb-mmd__logo-img { height: 38px !important; width: auto !important; display: block !important; max-width: 160px !important; object-fit: contain !important; }
  .vb-mmd__logo-text { font-family: 'Playfair Display', serif !important; font-weight: 700 !important; font-size: 20px !important; color: #1a4015 !important; }
  .vb-mmd__close {
    background: #eef7ec !important;
    border: 0 !important;
    width: 38px !important;
    height: 38px !important;
    border-radius: 10px !important;
    color: #2e5d28 !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    transition: background 0.15s ease;
  }
  .vb-mmd__close:hover { background: #c4e8be !important; }
  .vb-mmd__nav {
    flex: 1 !important;
    overflow-y: auto !important;
    padding: 14px 16px !important;
    -webkit-overflow-scrolling: touch !important;
  }
  .vb-mmd__list { list-style: none !important; margin: 0 !important; padding: 0 !important; }
  .vb-mmd__item { margin: 0 !important; border-bottom: 1px solid rgba(77,140,68,0.1) !important; }
  .vb-mmd__item:last-child { border-bottom: 0 !important; }
  .vb-mmd__item-link,
  .vb-mmd__item-toggle {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
    background: transparent !important;
    border: 0 !important;
    padding: 16px 10px !important;
    text-align: left !important;
    text-decoration: none !important;
    color: #1a4015 !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    letter-spacing: 0.02em !important;
    cursor: pointer !important;
    font-family: 'Poppins', sans-serif !important;
  }
  .vb-mmd__item-link:hover,
  .vb-mmd__item-toggle:hover { color: #4d8c44 !important; }
  .vb-mmd__chev { transition: transform 0.25s ease; flex-shrink: 0; }
  .vb-mmd__item-toggle[aria-expanded="true"] .vb-mmd__chev { transform: rotate(180deg); }
  .vb-mmd__sub {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 0 12px 8px !important;
    max-height: 0 !important;
    overflow: hidden !important;
    transition: max-height 0.35s ease !important;
  }
  .vb-mmd__item-toggle[aria-expanded="true"] + .vb-mmd__sub {
    max-height: 720px !important;
  }
  .vb-mmd__sub li { margin: 0 !important; }
  .vb-mmd__sub-link {
    display: block !important;
    padding: 12px 14px !important;
    color: #3d4f3a !important;
    text-decoration: none !important;
    font-size: 14.5px !important;
    font-weight: 500 !important;
    border-radius: 8px !important;
    transition: background 0.15s ease, color 0.15s ease !important;
  }
  .vb-mmd__sub-link:hover {
    background: #eef7ec !important;
    color: #4d8c44 !important;
    text-decoration: none !important;
  }
  .vb-mmd__footer {
    padding: 16px 22px 22px !important;
    background: #ffffff !important;
    border-top: 1px solid #e2efde !important;
    flex-shrink: 0 !important;
  }
  .vb-mmd__cta {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    width: 100% !important;
    padding: 14px 18px !important;
    background: #4d8c44 !important;
    color: #ffffff !important;
    border-radius: 10px !important;
    font-size: 14.5px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    margin-bottom: 14px !important;
    transition: background 0.15s ease;
  }
  .vb-mmd__cta:hover { background: #2e5d28 !important; color: #ffffff !important; text-decoration: none !important; }
  .vb-mmd__support {
    display: flex !important;
    gap: 10px !important;
  }
  .vb-mmd__support-link {
    flex: 1 !important;
    text-align: center !important;
    padding: 11px 14px !important;
    background: #eef7ec !important;
    color: #2e5d28 !important;
    border-radius: 10px !important;
    font-size: 13.5px !important;
    font-weight: 500 !important;
    text-decoration: none !important;
    transition: background 0.15s ease;
  }
  .vb-mmd__support-link:hover { background: #c4e8be !important; color: #2e5d28 !important; text-decoration: none !important; }

  body.vb-mmd-open { overflow: hidden !important; }
</style>

<script>
(function(){
  /* ============ DESKTOP MEGA PANELS ============ */
  const nav = document.querySelector('[data-vb-mm]');
  if (nav) {
    const triggers = nav.querySelectorAll('[data-vb-mm-trigger]');
    const panels = nav.querySelectorAll('[data-vb-mm-panel]');
    let openIdx = null, hoverTimeout = null, closeTimeout = null;

    let backdrop = document.querySelector('.vb-mm-backdrop');
    if (!backdrop) {
      backdrop = document.createElement('div');
      backdrop.className = 'vb-mm-backdrop';
      document.body.appendChild(backdrop);
    }

    function openPanel(idx) {
      clearTimeout(closeTimeout);
      if (openIdx === idx) return;
      closeAll(false);
      const trig = nav.querySelector('[data-vb-mm-trigger="' + idx + '"]');
      const panel = nav.querySelector('[data-vb-mm-panel="' + idx + '"]');
      if (!trig || !panel) return;
      trig.setAttribute('aria-expanded', 'true');
      panel.setAttribute('data-vb-mm-open', 'true');
      panel.setAttribute('aria-hidden', 'false');
      backdrop.setAttribute('data-vb-mm-backdrop-open', 'true');
      openIdx = idx;
    }
    function closeAll(removeBackdrop) {
      if (removeBackdrop === undefined) removeBackdrop = true;
      triggers.forEach(t => t.setAttribute('aria-expanded', 'false'));
      panels.forEach(p => { p.removeAttribute('data-vb-mm-open'); p.setAttribute('aria-hidden', 'true'); });
      if (removeBackdrop) backdrop.removeAttribute('data-vb-mm-backdrop-open');
      openIdx = null;
    }
    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const idx = trigger.dataset.vbMmTrigger;
        if (openIdx === idx) { closeAll(); } else { openPanel(idx); }
      });
      trigger.addEventListener('mouseenter', () => {
        clearTimeout(hoverTimeout); clearTimeout(closeTimeout);
        const idx = trigger.dataset.vbMmTrigger;
        hoverTimeout = setTimeout(() => openPanel(idx), 120);
      });
      trigger.addEventListener('mouseleave', () => { clearTimeout(hoverTimeout); });
    });
    panels.forEach(panel => {
      panel.addEventListener('mouseenter', () => { clearTimeout(closeTimeout); });
      panel.addEventListener('mouseleave', () => { closeTimeout = setTimeout(closeAll, 200); });
    });
    nav.addEventListener('mouseleave', () => { closeTimeout = setTimeout(closeAll, 250); });
    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target) && openIdx !== null) closeAll();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && openIdx !== null) {
        closeAll();
        const trig = nav.querySelector('[data-vb-mm-trigger="' + openIdx + '"]');
        if (trig) trig.focus();
      }
    });
    backdrop.addEventListener('click', closeAll);
  }

  /* ============ MOBILE DRAWER ============ */
  const burger = document.querySelector('[data-vb-mm-burger]');
  const drawer = document.querySelector('[data-vb-mm-drawer]');
  if (burger && drawer) {
    const closers = drawer.querySelectorAll('[data-vb-mmd-close]');
    const toggles = drawer.querySelectorAll('[data-vb-mmd-toggle]');

    function openDrawer() {
      drawer.setAttribute('data-vb-mmd-open', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', 'Close menu');
      document.body.classList.add('vb-mmd-open');
    }
    function closeDrawer() {
      drawer.removeAttribute('data-vb-mmd-open');
      drawer.setAttribute('aria-hidden', 'true');
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open menu');
      document.body.classList.remove('vb-mmd-open');
      toggles.forEach(t => t.setAttribute('aria-expanded', 'false'));
    }
    burger.addEventListener('click', () => {
      if (drawer.dataset.vbMmdOpen === 'true') closeDrawer(); else openDrawer();
    });
    closers.forEach(c => c.addEventListener('click', closeDrawer));
    drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.dataset.vbMmdOpen === 'true') closeDrawer();
    });
    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggles.forEach(t => { if (t !== toggle) t.setAttribute('aria-expanded', 'false'); });
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    });
  }
})();
</script>
