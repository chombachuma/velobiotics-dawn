{{ 'vb-why-choose.css' | asset_url | stylesheet_tag }}

<section class="vb-why page-width">
  <div class="vb-why__header">
    <p class="vb-section-eyebrow">Why Choose Velobiotics</p>
    <h2 class="vb-section-h2">99% of Probiotics Never Make It to Your Gut.</h2>
    <p class="vb-section-lead">Traditional probiotics break down in stomach acid before they can do any good. Velobiotics uses advanced micro-shield technology to keep probiotics alive — all the way to your gut.</p>
  </div>

  <div class="vb-why__grid">
    {%- for block in section.blocks -%}
      <div class="vb-why__card" {{ block.shopify_attributes }}>
        <div class="vb-why__card-icon" aria-hidden="true">
          {%- if block.settings.icon == 'shield' -%}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V7L12 2z" fill="currentColor" opacity=".15"/><path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V7L12 2z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {%- elsif block.settings.icon == 'flask' -%}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M9 3h6M9 3v7l-4 8h14l-4-8V3M9 3H8M15 3h1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="14" cy="16" r="1" fill="currentColor"/><circle cx="10" cy="17" r="0.5" fill="currentColor"/></svg>
          {%- elsif block.settings.icon == 'doctor' -%}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M4 20c0-4 3.58-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M18 14v4M16 16h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          {%- elsif block.settings.icon == 'leaf' -%}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M17 8C8 10 5.9 16.17 3.82 19.34 3.82 19.34 3 21 4 21c1 0 3-1 5-3 2.18 1.09 4.4 1 6-.5 3-3 3.18-6.5 2-9.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M3.82 19.34C4.5 17 6 14 9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          {%- else -%}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v4l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          {%- endif -%}
        </div>
        <h3 class="vb-why__card-title">{{ block.settings.title }}</h3>
        <p class="vb-why__card-body">{{ block.settings.body }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "VB Why Choose",
  "tag": "div",
  "class": "vb-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield / Patented" },
            { "value": "flask",  "label": "Flask / Science" },
            { "value": "doctor","label": "Doctor / Person" },
            { "value": "leaf",   "label": "Leaf / Natural" },
            { "value": "clock",  "label": "Clock / Time" }
          ],
          "default": "shield"
        },
        { "type": "text",     "id": "title", "label": "Title",   "default": "Reason title" },
        { "type": "textarea", "id": "body",  "label": "Body",    "default": "Explanation of why this matters." }
      ]
    }
  ],
  "presets": [
    {
      "name": "VB Why Choose",
      "blocks": [
        {
          "type": "reason",
          "settings": {
            "icon": "shield",
            "title": "Patented Delivery System",
            "body": "Our micro-shield protects probiotics from heat and stomach acid — so billions more reach your gut alive."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "flask",
            "title": "Clinically Chosen Strains",
            "body": "Every probiotic strain we use is backed by research to support gut balance, women's health, and immunity."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "doctor",
            "title": "Doctor Formulated & Recommended",
            "body": "Created and endorsed by medical professionals for safe, daily use by the whole family."
          }
        },
        {
          "type": "reason",
          "settings": {
            "icon": "leaf",
            "title": "Made for Real Life",
            "body": "Shelf-stable and trusted worldwide — no fridge, no fuss, just real results."
          }
        }
      ]
    }
  ]
}
{% endschema %}
