{%- comment -%}
  VB · Home Hero v4 — fully user-controlled (image, font sizes, opacity, padding, overlay)
{%- endcomment -%}

{%- liquid
  assign hero_image_src = ''
  if section.settings.bg_image_url != blank
    assign hero_image_src = section.settings.bg_image_url
  elsif section.settings.bg_image != blank
    assign hero_image_src = section.settings.bg_image | image_url: width: 2400
  endif
  assign pad_t = section.settings.padding_top | default: 96
  assign pad_b = section.settings.padding_bottom | default: 80
  assign img_op = section.settings.image_opacity | default: 85 | times: 1.0 | divided_by: 100
  assign ovly_op = section.settings.overlay_opacity | default: 35 | times: 1.0 | divided_by: 100
  assign min_h = section.settings.min_height | default: 520
  assign eyebrow_fs = section.settings.eyebrow_fs | default: 12
  assign headline_fs = section.settings.headline_fs | default: 56
  assign sub_fs = section.settings.sub_fs | default: 17
  assign text_align = section.settings.text_align | default: 'center'
  assign text_color = section.settings.text_color | default: '#1a1a1a'
  assign accent = section.settings.accent_color | default: '#4d8c44'
-%}

<style>
  #vbh-{{ section.id }} {
    position: relative;
    padding: {{ pad_t }}px 24px {{ pad_b }}px;
    min-height: {{ min_h }}px;
    background: linear-gradient(180deg, #f5f9f3 0%, #e3efdf 100%);
    overflow: hidden;
    color: {{ text_color }};
  }
  #vbh-{{ section.id }} .vbh__bg { position: absolute; inset: 0; z-index: 0; }
  #vbh-{{ section.id }} .vbh__bg-img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit | default: 'cover' }};
    object-position: {{ section.settings.image_position | default: 'center 35%' }};
    opacity: {{ img_op }};
    {% if section.settings.image_edge_fade %}
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
    {% endif %}
  }
  #vbh-{{ section.id }} .vbh__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,{{ ovly_op }}) 0%, rgba(255,255,255,{{ ovly_op | times: 0.5 }}) 35%, rgba(245,249,243,{{ ovly_op }}) 70%, rgba(227,239,223,{{ ovly_op | plus: 0.4 | at_most: 1 }}) 100%);
  }
  #vbh-{{ section.id }} .vbh__inner { max-width: 1080px; margin: 0 auto; position: relative; z-index: 2; text-align: {{ text_align }}; }
  #vbh-{{ section.id }} .vbh__eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: #fff; color: {{ accent }};
    font-size: {{ eyebrow_fs }}px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 8px 16px; border-radius: 999px; border: 1.5px solid {{ accent }};
    margin: 0 0 16px; box-shadow: 0 6px 14px rgba(0,0,0,0.08);
  }
  #vbh-{{ section.id }} .vbh__eyebrow::before { content: ''; width: 8px; height: 8px; background: {{ accent }}; border-radius: 50%; }
  #vbh-{{ section.id }} .vbh__rating { display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: {{ text_align }}; margin: 0 0 16px; font-size: 13.5px; color: {{ text_color }}; }
  #vbh-{{ section.id }} .vbh__rating .stars { color: #ffb43a; letter-spacing: 1px; font-size: 14px; }
  #vbh-{{ section.id }} .vbh__rating .divider { width: 1px; height: 14px; background: #8db786; }
  #vbh-{{ section.id }} .vbh__rating strong { color: {{ text_color }}; font-weight: 700; }
  #vbh-{{ section.id }} .vbh__headline { font-size: clamp(32px, {{ headline_fs | divided_by: 16.0 }}vw, {{ headline_fs }}px); line-height: 1.05; font-weight: 800; color: {{ text_color }}; margin: 0 auto 18px; letter-spacing: -0.015em; max-width: 920px; }
  #vbh-{{ section.id }} .vbh__headline em { font-style: normal; color: {{ accent }}; }
  #vbh-{{ section.id }} .vbh__sub { font-size: {{ sub_fs }}px; line-height: 1.6; color: {{ text_color }}; max-width: 620px; margin: 0 auto 24px; font-weight: 500; opacity: 0.9; }
  #vbh-{{ section.id }} .vbh__ctas { display: inline-flex; flex-wrap: wrap; gap: 12px; margin: 0; justify-content: {{ text_align }}; }
  #vbh-{{ section.id }} .vbh__cta { display: inline-flex; align-items: center; gap: 6px; padding: 15px 32px; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: 15px; transition: all 0.18s ease; }
  #vbh-{{ section.id }} .vbh__cta--primary { background: {{ accent }}; color: #fff !important; box-shadow: 0 12px 28px rgba(0,0,0,0.18); }
  #vbh-{{ section.id }} .vbh__cta--primary:hover { filter: brightness(0.88); transform: translateY(-2px); }
  #vbh-{{ section.id }} .vbh__cta--secondary { background: rgba(255,255,255,0.94); color: {{ text_color }} !important; border: 2px solid #c9d6c7; backdrop-filter: blur(8px); }
  #vbh-{{ section.id }} .vbh__cta--secondary:hover { border-color: {{ accent }}; color: {{ accent }} !important; transform: translateY(-2px); }

  @media (max-width: 749px) {
    #vbh-{{ section.id }} { padding: {{ pad_t | times: 0.55 | round: 0 }}px 16px {{ pad_b | times: 0.6 | round: 0 }}px; min-height: {{ min_h | times: 0.7 | round: 0 }}px; }
    #vbh-{{ section.id }} .vbh__eyebrow { font-size: {{ eyebrow_fs | times: 0.78 | round }}px; padding: 6px 12px; letter-spacing: 0.04em; }
    #vbh-{{ section.id }} .vbh__headline { font-size: clamp(26px, 8vw, {{ headline_fs | times: 0.6 | round }}px); }
    #vbh-{{ section.id }} .vbh__sub { font-size: {{ sub_fs | times: 0.85 | round }}px; }
    #vbh-{{ section.id }} .vbh__cta { padding: 12px 22px; font-size: 13.5px; }
  }
</style>

<section id="vbh-{{ section.id }}">
  {%- if hero_image_src != blank -%}
    <div class="vbh__bg"><img class="vbh__bg-img" src="{{ hero_image_src }}" alt="" loading="eager" /></div>
    <div class="vbh__overlay"></div>
  {%- endif -%}

  <div class="vbh__inner">
    {%- if section.settings.eyebrow != blank -%}<span class="vbh__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.show_rating -%}
      <div class="vbh__rating">
        <span class="stars">★★★★★</span>
        <span>Over <strong>{{ section.settings.review_count }}</strong> Reviews</span>
        <span class="divider"></span>
        <span><strong>{{ section.settings.customer_count }}</strong> Happy Customers</span>
      </div>
    {%- endif -%}
    <h1 class="vbh__headline">
      {{ section.settings.headline_pre }}
      {%- if section.settings.headline_highlight != blank %} <em>{{ section.settings.headline_highlight }}</em>{%- endif -%}
    </h1>
    {%- if section.settings.sub != blank -%}<p class="vbh__sub">{{ section.settings.sub }}</p>{%- endif -%}
    <div class="vbh__ctas">
      {%- if section.settings.cta1_text != blank -%}<a href="{{ section.settings.cta1_link | default: '#' }}" class="vbh__cta vbh__cta--primary">{{ section.settings.cta1_text }}</a>{%- endif -%}
      {%- if section.settings.cta2_text != blank -%}<a href="{{ section.settings.cta2_link | default: '#' }}" class="vbh__cta vbh__cta--secondary">{{ section.settings.cta2_text }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Home hero",
  "tag": "section",
  "class": "vb-home-hero-section",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "text", "id": "bg_image_url", "label": "External image URL" },
    { "type": "image_picker", "id": "bg_image", "label": "Hero image (uploaded)" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover", "options": [
      { "value": "cover", "label": "Cover (fill area, may crop)" },
      { "value": "contain", "label": "Contain (whole image visible)" }
    ]},
    { "type": "text", "id": "image_position", "label": "Image position (CSS object-position)", "default": "center 35%", "info": "e.g. 'center top', 'center 35%', 'left center'" },
    { "type": "range", "id": "image_opacity", "label": "Image opacity %", "min": 10, "max": 100, "step": 5, "default": 85 },
    { "type": "checkbox", "id": "image_edge_fade", "label": "Fade image edges (like femina.care)", "default": false },
    { "type": "range", "id": "overlay_opacity", "label": "Text-area overlay strength %", "min": 0, "max": 100, "step": 5, "default": 35, "info": "Higher = stronger white overlay over the image so text reads cleanly." },

    { "type": "header", "content": "Layout & sizing" },
    { "type": "range", "id": "min_height", "label": "Minimum hero height (px)", "min": 320, "max": 900, "step": 20, "default": 520 },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 200, "step": 8, "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 200, "step": 8, "default": 80 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ]},

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "eyebrow_fs", "label": "Eyebrow font size (desktop, px)", "min": 8, "max": 20, "step": 1, "default": 12 },
    { "type": "range", "id": "headline_fs", "label": "Headline font size (desktop max, px)", "min": 28, "max": 96, "step": 2, "default": 56 },
    { "type": "range", "id": "sub_fs", "label": "Sub-text font size (px)", "min": 12, "max": 24, "step": 1, "default": 17 },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#4d8c44" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small tag above headline)", "default": "Patented Probiotics That Actually Reach Your Gut" },
    { "type": "text", "id": "headline_pre", "label": "Headline (start)", "default": "Most Probiotics Die in Your Stomach." },
    { "type": "text", "id": "headline_highlight", "label": "Headline (highlight — green)", "default": "Ours Don't!" },
    { "type": "textarea", "id": "sub", "label": "Sub-headline", "default": "Velobiotics protects every live culture through stomach acid — delivering 1000× more probiotics to your gut, where they actually work." },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating row", "default": true },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "3,500" },
    { "type": "text", "id": "customer_count", "label": "Customer count", "default": "300,000" },

    { "type": "header", "content": "CTAs" },
    { "type": "text", "id": "cta1_text", "label": "Primary CTA", "default": "Shop Products" },
    { "type": "url", "id": "cta1_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA", "default": "🧬 Take The Quiz" },
    { "type": "url", "id": "cta2_link", "label": "Secondary CTA link" }
  ],
  "presets": [ { "name": "VB · Home hero" } ]
}
{% endschema %}
