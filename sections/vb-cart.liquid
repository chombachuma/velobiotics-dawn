{%- comment -%} VB Cart — Velobiotics-branded · Poppins · compact · subscription + discount meta {%- endcomment -%}
<style>
.vbc, .vbc *, .vbc *::before, .vbc *::after { font-family: 'Poppins', system-ui, -apple-system, sans-serif !important; }
.vbc { --g:#4d8c44;--g2:#2e5d28;--cream:#fdf9f1;--ink:#1a2e1a;--mute:#5a6b5a;--border:#e8efe6;--tint:#eef7ec;--tint2:#d4ebd0; background:linear-gradient(180deg,#fdf9f1 0%,#fff 60%); color:var(--ink); padding:28px 20px 56px; min-height:60vh }
.vbc__shell { max-width:1240px; margin:0 auto }
.vbc__head { display:flex; align-items:baseline; justify-content:space-between; gap:14px; flex-wrap:wrap; margin:0 0 22px; padding-bottom:18px; border-bottom:1px solid var(--border) }
.vbc__title-group { display:flex; flex-direction:column; gap:4px }
.vbc__eb { font-size:11px; color:var(--g2); font-weight:700; letter-spacing:.12em; text-transform:uppercase; background:var(--tint); padding:4px 10px; border-radius:99px; align-self:flex-start }
.vbc__h { font-family:'Playfair Display',Georgia,serif !important; font-size:clamp(28px,4vw,40px); font-weight:700; line-height:1.05; letter-spacing:-.02em; margin:0; color:var(--ink) }
.vbc__h em { color:var(--g); font-style:italic; font-weight:700 }
.vbc__sub { color:var(--mute); font-size:14px; line-height:1.5; margin:0; max-width:520px }

.vbc__layout { display:grid; grid-template-columns:1.6fr 1fr; gap:24px; align-items:flex-start }
@media(max-width:900px){ .vbc__layout{ grid-template-columns:1fr; gap:18px } }

/* Items column */
.vbc__items { background:#fff; border:1px solid var(--border); border-radius:18px; padding:4px 0; box-shadow:0 4px 18px rgba(0,0,0,.03) }
.vbc__items-head { display:flex; align-items:center; justify-content:space-between; padding:14px 22px 10px; border-bottom:1px solid var(--border) }
.vbc__items-head h2 { font-family:'Playfair Display',Georgia,serif !important; font-size:18px; font-weight:700; margin:0; color:var(--ink) }
.vbc__count { background:var(--tint); color:var(--g2); padding:3px 11px; border-radius:99px; font-size:12px; font-weight:700 }

.vbc__line { display:grid; grid-template-columns:100px 1fr auto; gap:16px; padding:18px 22px; border-bottom:1px solid var(--border); align-items:flex-start; animation:vbcfade .4s ease }
.vbc__line:last-child { border-bottom:none }
@media(max-width:600px){ .vbc__line{ grid-template-columns:80px 1fr; gap:12px; padding:14px 16px } .vbc__line-price-wrap{ grid-column:1/-1; margin-top:6px; text-align:left; display:flex; justify-content:space-between; align-items:baseline } }
@keyframes vbcfade { from{ opacity:0; transform:translateY(8px) } to{ opacity:1; transform:none } }
.vbc__line-img { width:100px; height:100px; background:linear-gradient(135deg,var(--tint),var(--tint2)); border-radius:12px; overflow:hidden; display:flex; align-items:center; justify-content:center; flex-shrink:0 }
.vbc__line-img img { width:100%; height:100%; object-fit:contain; padding:6px; mix-blend-mode:multiply }
@media(max-width:600px){ .vbc__line-img{ width:80px; height:80px } }
.vbc__line-body { min-width:0 }
.vbc__line-brand { font-size:10px; font-weight:800; color:var(--g); text-transform:uppercase; letter-spacing:.08em; display:inline-block; background:color-mix(in srgb,var(--g) 12%,transparent); padding:2px 7px; border-radius:99px; margin-bottom:4px }
.vbc__line-title { font-size:15px; font-weight:700; line-height:1.3; margin:2px 0 3px; color:var(--ink) }
.vbc__line-title a { color:inherit; text-decoration:none }
.vbc__line-title a:hover { color:var(--g) }
.vbc__line-variant { font-size:12px; color:var(--mute); margin:0 0 8px }
.vbc__line-meta { display:flex; gap:6px; flex-wrap:wrap; margin:0 0 8px }
.vbc__line-tag { display:inline-flex; align-items:center; gap:4px; padding:3px 8px; border-radius:99px; font-size:10.5px; font-weight:700; letter-spacing:.02em; line-height:1.3 }
.vbc__line-tag--sub { background:linear-gradient(135deg,color-mix(in srgb,var(--g) 14%,#fff),color-mix(in srgb,var(--g) 6%,#fff)); color:var(--g2); border:1px solid color-mix(in srgb,var(--g) 25%,transparent) }
.vbc__line-tag--disc { background:linear-gradient(135deg,#fff8eb,#fff); color:#b25800; border:1px solid color-mix(in srgb,#ff9500 30%,transparent) }
.vbc__line-tag--ship { background:#1a2e1a; color:#fff }
.vbc__line-actions { display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:6px }
.vbc__qty { display:inline-flex; align-items:center; border:1.5px solid var(--border); border-radius:99px; overflow:hidden; background:#fff }
.vbc__qty button { appearance:none; border:none; background:transparent; cursor:pointer; width:30px; height:30px; font-size:16px; font-weight:700; color:var(--ink); transition:.2s; display:flex; align-items:center; justify-content:center }
.vbc__qty button:hover { background:var(--tint); color:var(--g) }
.vbc__qty input { width:36px; height:30px; border:none; background:transparent; text-align:center; font-weight:700; color:var(--ink); font-size:13px; outline:none }
.vbc__line-remove { appearance:none; border:none; background:none; cursor:pointer; color:var(--mute); font-size:12px; text-decoration:underline; font-weight:600; padding:4px 0 }
.vbc__line-remove:hover { color:#c8163c }
.vbc__line-price-wrap { text-align:right; min-width:90px }
.vbc__line-price { font-family:'Playfair Display',Georgia,serif !important; font-size:19px; font-weight:700; color:var(--ink); line-height:1; margin:0 0 3px }
.vbc__line-each { font-size:11px; color:var(--mute) }
.vbc__line-compare { display:block; font-size:12px; color:#a0a0a0; text-decoration:line-through; margin-top:2px }
.vbc__line-discount { font-size:11px; color:var(--g); font-weight:700; margin-top:2px }

/* Order Summary */
.vbc__summary { background:#fff; border:1px solid var(--border); border-radius:18px; padding:22px; position:sticky; top:24px; box-shadow:0 4px 18px rgba(0,0,0,.03) }
@media(max-width:900px){ .vbc__summary{ position:static } }
.vbc__summary h2 { font-family:'Playfair Display',Georgia,serif !important; font-size:20px; font-weight:700; margin:0 0 16px; color:var(--ink) }
.vbc__row { display:flex; justify-content:space-between; align-items:baseline; padding:6px 0; font-size:14px; color:var(--ink) }
.vbc__row strong { font-weight:700 }
.vbc__divider { height:1px; background:var(--border); margin:10px 0 }
.vbc__total { display:flex; justify-content:space-between; align-items:baseline; padding:10px 0; font-size:16px }
.vbc__total-amt { font-family:'Playfair Display',Georgia,serif !important; font-size:28px; font-weight:700; color:var(--g); letter-spacing:-.01em }
.vbc__shipnote { background:var(--tint); border:1px solid var(--tint2); border-radius:11px; padding:12px 14px; margin:12px 0; font-size:12.5px; color:var(--g2); line-height:1.45; display:flex; gap:9px; align-items:flex-start }
.vbc__shipnote .vbc__ship-icon { font-size:17px; flex-shrink:0 }
.vbc__shipnote strong { color:var(--g2) }
.vbc__progress { height:6px; background:#fff; border-radius:99px; overflow:hidden; margin-top:8px; border:1px solid var(--tint2) }
.vbc__progress-fill { height:100%; background:linear-gradient(90deg,var(--g),var(--g2)); border-radius:99px; transition:width .6s ease }
.vbc__checkout { display:block; width:100%; background:var(--g); color:#fff; text-align:center; padding:15px 22px; border-radius:99px; font-weight:800; font-size:15.5px; text-decoration:none; border:none; cursor:pointer; transition:.25s; box-shadow:0 6px 18px rgba(77,140,68,.3); margin-top:8px; letter-spacing:.02em }
.vbc__checkout:hover { background:var(--g2); transform:translateY(-2px); box-shadow:0 10px 26px rgba(77,140,68,.4); color:#fff }
.vbc__checkout::after { content:' →'; display:inline-block; transition:transform .2s }
.vbc__checkout:hover::after { transform:translateX(4px) }
.vbc__continue { display:block; text-align:center; color:var(--mute); font-size:13px; text-decoration:none; margin-top:12px; font-weight:600 }
.vbc__continue:hover { color:var(--g) }
.vbc__payments { display:flex; gap:6px; justify-content:center; flex-wrap:wrap; margin-top:14px; opacity:.65 }
.vbc__payments span { background:#f6f6f4; border-radius:5px; padding:3px 8px; font-size:10px; font-weight:700; color:var(--mute); letter-spacing:.04em }
.vbc__trust { margin-top:16px; padding-top:14px; border-top:1px solid var(--border) }
.vbc__trust-row { display:flex; gap:10px; padding:5px 0; align-items:flex-start; font-size:12px; color:var(--mute); line-height:1.45 }
.vbc__trust-row strong { color:var(--ink); font-weight:700 }
.vbc__trust-icon { font-size:16px; flex-shrink:0; width:22px; text-align:center }

/* Below-cart sections: trust strip + testimonials */
.vbc__below { max-width:1240px; margin:36px auto 0; padding:0 20px }
.vbc__trust-strip { background:#fff; border:1px solid var(--border); border-radius:14px; padding:14px 20px; display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:28px }
@media(max-width:700px){ .vbc__trust-strip{ grid-template-columns:repeat(2,1fr); padding:14px } }
.vbc__trust-strip-item { display:flex; align-items:center; gap:10px; min-width:0 }
.vbc__trust-strip-icon { width:38px; height:38px; border-radius:50%; background:var(--tint); color:var(--g); display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0 }
.vbc__trust-strip-text { font-size:12.5px; line-height:1.3 }
.vbc__trust-strip-text strong { display:block; font-weight:700; color:var(--ink) }
.vbc__trust-strip-text span { color:var(--mute) }

.vbc__reviews { padding:18px 0 }
.vbc__reviews-head { text-align:center; margin-bottom:22px }
.vbc__reviews-eb { display:inline-block; background:var(--tint); color:var(--g2); padding:4px 12px; border-radius:99px; font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; margin-bottom:10px }
.vbc__reviews-h { font-family:'Playfair Display',Georgia,serif !important; font-size:clamp(22px,3vw,30px); font-weight:700; margin:0 0 6px; color:var(--ink) }
.vbc__reviews-h em { color:var(--g); font-style:italic }
.vbc__reviews-sub { color:var(--mute); font-size:14px; margin:0 }
.vbc__reviews-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px }
@media(max-width:768px){ .vbc__reviews-grid{ grid-template-columns:1fr; gap:12px } }
.vbc__review { background:#fff; border:1px solid var(--border); border-radius:14px; padding:18px 18px 16px; transition:.25s; min-width:0 }
.vbc__review:hover { transform:translateY(-2px); box-shadow:0 12px 28px rgba(77,140,68,.1) }
.vbc__review-stars { color:#ffb43a; font-size:14px; letter-spacing:1px; margin-bottom:8px }
.vbc__review-quote { font-size:14px; line-height:1.55; color:var(--ink); margin:0 0 12px; font-style:italic }
.vbc__review-author { display:flex; align-items:center; gap:10px; font-size:12px }
.vbc__review-avatar { width:32px; height:32px; border-radius:50%; background:var(--tint); color:var(--g2); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:12px; flex-shrink:0 }
.vbc__review-author strong { display:block; color:var(--ink); font-weight:700 }
.vbc__review-author small { color:var(--mute); font-size:11px }
.vbc__review-source { display:inline-flex; align-items:center; gap:3px; background:var(--tint); color:var(--g2); padding:2px 7px; border-radius:99px; font-size:9.5px; font-weight:700; letter-spacing:.04em; margin-left:auto }

/* Note input */
.vbc__note { margin-top:14px }
.vbc__note details { border:1px solid var(--border); border-radius:11px; padding:12px 14px }
.vbc__note summary { cursor:pointer; font-size:12.5px; color:var(--mute); font-weight:600; list-style:none; outline:none }
.vbc__note summary::-webkit-details-marker { display:none }
.vbc__note summary::before { content:'+ '; color:var(--g); font-weight:700 }
.vbc__note[open] summary::before { content:'− ' }
.vbc__note textarea { width:100%; border:1px solid var(--border); border-radius:7px; padding:9px; font-family:inherit; font-size:13px; margin-top:9px; resize:vertical; min-height:55px; box-sizing:border-box }
.vbc__note textarea:focus { outline:none; border-color:var(--g) }

.vbc__loading { position:absolute; inset:0; background:rgba(255,255,255,.75); display:flex; align-items:center; justify-content:center; border-radius:18px; z-index:5; opacity:0; pointer-events:none; transition:.2s }
.vbc__loading.is-on { opacity:1; pointer-events:auto }
.vbc__spinner { width:32px; height:32px; border:3px solid var(--tint); border-top-color:var(--g); border-radius:50%; animation:vbcspin 1s linear infinite }
@keyframes vbcspin { to{ transform:rotate(360deg) } }
.vbc__items-wrap { position:relative }

/* Empty state */
.vbc__empty { text-align:center; padding:60px 20px; max-width:480px; margin:0 auto }
.vbc__empty-icon { font-size:64px; margin-bottom:14px; opacity:.6 }
.vbc__empty h3 { font-family:'Playfair Display',Georgia,serif !important; font-size:28px; font-weight:700; margin:0 0 10px; color:var(--ink) }
.vbc__empty p { color:var(--mute); font-size:15px; line-height:1.55; margin:0 0 22px }
.vbc__empty a { display:inline-flex; align-items:center; gap:8px; background:var(--g); color:#fff; padding:14px 30px; border-radius:99px; font-weight:700; text-decoration:none; transition:.2s }
.vbc__empty a:hover { background:var(--g2); transform:translateY(-2px); color:#fff }
.vbc__empty-cta-secondary { display:inline-block; color:var(--g); text-decoration:underline; margin-top:14px; font-weight:600; font-size:14px }
</style>

<div class="vbc" id="vb-cart" data-cart-currency="{{ cart.currency.iso_code }}">
  <div class="vbc__shell">
    <header class="vbc__head">
      <div class="vbc__title-group">
        <span class="vbc__eb">{{ section.settings.eyebrow | default: 'Your wellness stack' }}</span>
        <h1 class="vbc__h">{{ section.settings.title_pre | default: 'Almost' }} <em>{{ section.settings.title_highlight | default: 'there.' }}</em></h1>
      </div>
      <p class="vbc__sub">{{ section.settings.sub | default: 'Free shipping kicks in soon · 30-day money-back covers everything.' }}</p>
    </header>

    {%- if cart.item_count > 0 -%}
      <div class="vbc__layout">
        <form action="{{ routes.cart_url }}" method="post" id="vbc-form" novalidate>
          <div class="vbc__items">
            <div class="vbc__items-head">
              <h2>Your items</h2>
              <span class="vbc__count" id="vbc-count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
            </div>
            <div class="vbc__items-wrap">
              <div class="vbc__loading" id="vbc-loading"><div class="vbc__spinner"></div></div>
              <div id="vbc-lines">
                {%- for item in cart.items -%}
                  <div class="vbc__line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
                    <a href="{{ item.url }}" class="vbc__line-img">
                      {%- if item.image -%}<img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.product.title | escape }}" loading="lazy">{%- endif -%}
                    </a>
                    <div class="vbc__line-body">
                      <span class="vbc__line-brand">{{ item.product.vendor | default: 'Velobiotics™' }}</span>
                      <h3 class="vbc__line-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                      {%- unless item.product.has_only_default_variant -%}
                        <p class="vbc__line-variant">{{ item.variant.title }}</p>
                      {%- endunless -%}
                      {%- comment -%} Subscription + Discount meta tags {%- endcomment -%}
                      <div class="vbc__line-meta">
                        {%- if item.selling_plan_allocation -%}
                          <span class="vbc__line-tag vbc__line-tag--sub">🔁 {{ item.selling_plan_allocation.selling_plan.name }}</span>
                          <span class="vbc__line-tag vbc__line-tag--ship">🎁 Free shipping</span>
                        {%- endif -%}
                        {%- if item.line_level_discount_allocations.size > 0 -%}
                          {%- for alloc in item.line_level_discount_allocations -%}
                            <span class="vbc__line-tag vbc__line-tag--disc">💰 Save {{ alloc.amount | money }}</span>
                          {%- endfor -%}
                        {%- endif -%}
                      </div>
                      <div class="vbc__line-actions">
                        <div class="vbc__qty">
                          <button type="button" data-vbc-qty="dec" data-line="{{ forloop.index }}" aria-label="Decrease">−</button>
                          <input type="number" name="updates[]" min="0" value="{{ item.quantity }}" data-vbc-qty-input data-line="{{ forloop.index }}" aria-label="Quantity">
                          <button type="button" data-vbc-qty="inc" data-line="{{ forloop.index }}" aria-label="Increase">+</button>
                        </div>
                        <button type="button" class="vbc__line-remove" data-vbc-remove data-line="{{ forloop.index }}">Remove</button>
                      </div>
                    </div>
                    <div class="vbc__line-price-wrap">
                      <p class="vbc__line-price">{{ item.final_line_price | money }}</p>
                      {%- if item.quantity > 1 -%}<span class="vbc__line-each">{{ item.final_price | money }} each</span>{%- endif -%}
                      {%- if item.original_line_price > item.final_line_price -%}
                        <span class="vbc__line-compare">{{ item.original_line_price | money }}</span>
                        <span class="vbc__line-discount">You save {{ item.original_line_price | minus: item.final_line_price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </div>

          <div class="vbc__note">
            <details>
              <summary>Add a gift note or special instructions</summary>
              <textarea name="note" placeholder="e.g. Please leave at front door if no answer.">{{ cart.note }}</textarea>
            </details>
          </div>
        </form>

        <aside class="vbc__summary">
          <h2>Order summary</h2>
          <div class="vbc__row"><span>Subtotal</span><strong id="vbc-subtotal">{{ cart.items_subtotal_price | money }}</strong></div>
          {%- if cart.total_discount > 0 -%}
            <div class="vbc__row" style="color:var(--g)"><span>Discount</span><strong>−{{ cart.total_discount | money }}</strong></div>
          {%- endif -%}
          <div class="vbc__row"><span>Shipping</span><strong>Calculated at checkout</strong></div>
          <div class="vbc__divider"></div>
          <div class="vbc__total"><strong>Total</strong><span class="vbc__total-amt" id="vbc-total">{{ cart.total_price | money }}</span></div>

          {%- comment -%} Dynamic free-shipping threshold per currency {%- endcomment -%}
          {%- case cart.currency.iso_code -%}
            {%- when 'USD' -%}{%- assign ship_threshold = section.settings.free_ship_threshold_usd | default: 3000 -%}
            {%- when 'GBP' -%}{%- assign ship_threshold = section.settings.free_ship_threshold_gbp | default: 2500 -%}
            {%- when 'EUR' -%}{%- assign ship_threshold = section.settings.free_ship_threshold_eur | default: 3000 -%}
            {%- when 'AUD' -%}{%- assign ship_threshold = section.settings.free_ship_threshold_aud | default: 5000 -%}
            {%- else -%}{%- assign ship_threshold = section.settings.free_ship_threshold | default: 50000 -%}
          {%- endcase -%}
          {%- if cart.total_price < ship_threshold -%}
            {%- assign remaining = ship_threshold | minus: cart.total_price -%}
            <div class="vbc__shipnote">
              <span class="vbc__ship-icon">🚚</span>
              <div>You're <strong>{{ remaining | money }}</strong> away from <strong>free shipping</strong>!
                <div class="vbc__progress"><div class="vbc__progress-fill" style="width:{{ cart.total_price | times: 100 | divided_by: ship_threshold }}%"></div></div>
              </div>
            </div>
          {%- else -%}
            <div class="vbc__shipnote"><span class="vbc__ship-icon">✓</span><div>You've unlocked <strong>FREE shipping</strong>.</div></div>
          {%- endif -%}

          <button type="submit" name="checkout" form="vbc-form" class="vbc__checkout">Checkout securely</button>
          <a href="/collections/all" class="vbc__continue">← Continue shopping</a>

          <div class="vbc__payments">
            <span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>PAYPAL</span><span>APPLE PAY</span>
          </div>

          <div class="vbc__trust">
            <div class="vbc__trust-row"><span class="vbc__trust-icon">💚</span><div><strong>30-day money-back.</strong> Don't love it? Full refund, no questions asked.</div></div>
            <div class="vbc__trust-row"><span class="vbc__trust-icon">🌍</span><div><strong>Ships worldwide.</strong> US, EU, UK, AU, SA — tracked, 5-14 working days.</div></div>
            <div class="vbc__trust-row"><span class="vbc__trust-icon">🔒</span><div><strong>Secure checkout.</strong> 256-bit SSL. We never store card details.</div></div>
          </div>
        </aside>
      </div>
    {%- else -%}
      <div class="vbc__empty">
        <div class="vbc__empty-icon">🛒</div>
        <h3>Your cart is <em style="color:var(--g);font-style:italic">empty</em>.</h3>
        <p>Take our 60-second BioMatch quiz to find your perfect probiotic — or browse the full range below.</p>
        <a href="/pages/quiz">🎯 Take the BioMatch</a>
        <div><a class="vbc__empty-cta-secondary" href="/collections/all">Browse all products</a></div>
      </div>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
  <div class="vbc__below">
    {%- comment -%} Trust strip — 4 quick reassurances {%- endcomment -%}
    <div class="vbc__trust-strip">
      <div class="vbc__trust-strip-item">
        <div class="vbc__trust-strip-icon">🚚</div>
        <div class="vbc__trust-strip-text"><strong>Free shipping</strong><span>Over the threshold · Subscriptions always free</span></div>
      </div>
      <div class="vbc__trust-strip-item">
        <div class="vbc__trust-strip-icon">💚</div>
        <div class="vbc__trust-strip-text"><strong>30-day refund</strong><span>Full refund · No questions</span></div>
      </div>
      <div class="vbc__trust-strip-item">
        <div class="vbc__trust-strip-icon">🩺</div>
        <div class="vbc__trust-strip-text"><strong>Doctor-formulated</strong><span>SAHPRA & FDA-aware</span></div>
      </div>
      <div class="vbc__trust-strip-item">
        <div class="vbc__trust-strip-icon">🧪</div>
        <div class="vbc__trust-strip-text"><strong>Lab-tested</strong><span>Every batch · Independent labs</span></div>
      </div>
    </div>

    {%- comment -%} Testimonials — 3 placeholder cards. User can edit copy in Theme editor or wire judge.me / Google reviews widget via section setting {%- endcomment -%}
    <section class="vbc__reviews">
      <div class="vbc__reviews-head">
        <span class="vbc__reviews-eb">{{ section.settings.reviews_eyebrow | default: 'Loved by 300,000+' }}</span>
        <h2 class="vbc__reviews-h">{{ section.settings.reviews_title_pre | default: 'You are in' }} <em>{{ section.settings.reviews_title_highlight | default: 'good company.' }}</em></h2>
        <p class="vbc__reviews-sub">{{ section.settings.reviews_sub | default: '4.8★ average across 30,000+ verified reviews.' }}</p>
      </div>
      <div class="vbc__reviews-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="vbc__review" {{ block.shopify_attributes }}>
              <div class="vbc__review-stars">★★★★★</div>
              <p class="vbc__review-quote">"{{ block.settings.quote }}"</p>
              <div class="vbc__review-author">
                <div class="vbc__review-avatar">{{ block.settings.initials | default: 'V' }}</div>
                <div><strong>{{ block.settings.author }}</strong><small>{{ block.settings.meta }}</small></div>
                <span class="vbc__review-source">{{ block.settings.source | default: 'Verified' }}</span>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.judgeme_html != blank -%}
          <div style="grid-column:1/-1;margin-top:18px">{{ section.settings.judgeme_html }}</div>
        {%- endif -%}
      </div>
    </section>
  </div>
  {%- endif -%}
</div>

<script>
(function(){
  const root = document.getElementById('vb-cart');
  if(!root) return;
  const $ = s => root.querySelector(s);
  const $$ = s => Array.from(root.querySelectorAll(s));
  const loading = $('#vbc-loading');
  function showLoad(on){ if(loading) loading.classList.toggle('is-on', !!on); }
  function fmt(cents){
    const cur = root.dataset.cartCurrency || 'USD';
    try { return new Intl.NumberFormat(undefined, {style:'currency', currency:cur}).format(cents/100); }
    catch(e){ return '$'+(cents/100).toFixed(2); }
  }
  async function changeLine(line, qty){
    showLoad(true);
    try {
      const r = await fetch('/cart/change.js', {
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify({line: parseInt(line,10), quantity: parseInt(qty,10)})
      });
      const data = await r.json();
      if(data.item_count === 0){ window.location.reload(); return; }
      const cnt = $('#vbc-count'); if(cnt) cnt.textContent = data.item_count + (data.item_count===1?' item':' items');
      const sub = $('#vbc-subtotal'); if(sub) sub.textContent = fmt(data.items_subtotal_price);
      const tot = $('#vbc-total'); if(tot) tot.textContent = fmt(data.total_price);
      const item = data.items[parseInt(line,10)-1];
      if(item){
        const lineEl = root.querySelector('[data-line="'+line+'"]');
        if(lineEl){
          const priceEl = lineEl.querySelector('.vbc__line-price');
          if(priceEl) priceEl.textContent = fmt(item.final_line_price);
          const input = lineEl.querySelector('[data-vbc-qty-input]');
          if(input) input.value = item.quantity;
        }
      } else {
        const lineEl = root.querySelector('[data-line="'+line+'"]');
        if(lineEl) lineEl.remove();
        $$('.vbc__line').forEach((el,i)=>{
          const newIdx = i+1;
          el.dataset.line = newIdx;
          el.querySelectorAll('[data-line]').forEach(c=>c.dataset.line=newIdx);
        });
      }
      const threshold = {%- case cart.currency.iso_code -%}{%- when 'USD' -%}{{ section.settings.free_ship_threshold_usd | default: 3000 }}{%- when 'GBP' -%}{{ section.settings.free_ship_threshold_gbp | default: 2500 }}{%- when 'EUR' -%}{{ section.settings.free_ship_threshold_eur | default: 3000 }}{%- when 'AUD' -%}{{ section.settings.free_ship_threshold_aud | default: 5000 }}{%- else -%}{{ section.settings.free_ship_threshold | default: 50000 }}{%- endcase -%};
      const remaining = threshold - data.total_price;
      if(remaining > 0){
        const pct = Math.min(100, (data.total_price/threshold)*100);
        const fill = root.querySelector('.vbc__progress-fill');
        if(fill) fill.style.width = pct + '%';
      }
      if(window.VBCartFBT && window.VBCartFBT.refresh) window.VBCartFBT.refresh();
    } catch(e){ console.warn('[VBC] change failed', e); window.location.reload(); }
    showLoad(false);
  }
  root.addEventListener('click', e=>{
    const dec = e.target.closest('[data-vbc-qty="dec"]');
    const inc = e.target.closest('[data-vbc-qty="inc"]');
    const rm = e.target.closest('[data-vbc-remove]');
    if(dec || inc){
      const btn = dec || inc;
      const line = btn.dataset.line;
      const input = root.querySelector('[data-vbc-qty-input][data-line="'+line+'"]');
      if(!input) return;
      const cur = parseInt(input.value,10)||0;
      const newQ = dec ? Math.max(0, cur-1) : cur+1;
      changeLine(line, newQ);
    }
    if(rm){ changeLine(rm.dataset.line, 0); }
  });
  let inputTimer;
  root.addEventListener('change', e=>{
    const inp = e.target.closest('[data-vbc-qty-input]');
    if(!inp) return;
    clearTimeout(inputTimer);
    inputTimer = setTimeout(()=>changeLine(inp.dataset.line, inp.value), 100);
  });
  const noteField = root.querySelector('textarea[name="note"]');
  if(noteField){
    noteField.addEventListener('blur', ()=>{
      fetch('/cart/update.js', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({note: noteField.value})});
    });
  }
})();
</script>

