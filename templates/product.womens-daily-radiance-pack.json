          "type": "q",
          "settings": {
            "question": "Do any of these products require refrigeration?",
            "answer": "<p>No. Thanks to Velobiotics micro-shielding technology, all live probiotic cultures in this pack are shelf-stable at room temperature (below 25°C). Keep in a cool, dry place out of direct sunlight.</p>"
          }
        },
