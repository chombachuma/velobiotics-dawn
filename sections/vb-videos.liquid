{%- comment -%}
  VB · Customer videos — Trusted by Thousands. Uses Shopify CDN video thumbnails.
{%- endcomment -%}

<style>
  .vb-vids { padding: 72px 24px; background: #fff; }
  .vb-vids__inner { max-width: 1280px; margin: 0 auto; }
  .vb-vids__head { text-align: center; max-width: 760px; margin: 0 auto 44px; }
  .vb-vids__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-vids__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; }
  .vb-vids__title em { color: #4d8c44; font-style: normal; }
  .vb-vids__sub { font-size: 16.5px; line-height: 1.6; color: #5c6664; margin: 0; }
  .vb-vids__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .vb-vids__card { position: relative; aspect-ratio: 9 / 14; border-radius: 18px; overflow: hidden; cursor: pointer; background: #1a1a1a; transition: transform 0.22s ease, box-shadow 0.22s ease; border: none; padding: 0; }
  .vb-vids__card:hover { transform: translateY(-5px); box-shadow: 0 22px 44px rgba(0, 0, 0, 0.24); }
  .vb-vids__card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.45s ease; }
  .vb-vids__card:hover img { transform: scale(1.06); }
  .vb-vids__play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,0.5) 100%); }
  .vb-vids__play-btn { width: 60px; height: 60px; border-radius: 50%; background: rgba(255,255,255,0.95); display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 12px 28px rgba(0,0,0,0.32); transition: transform 0.22s ease, background-color 0.22s ease; }
  .vb-vids__card:hover .vb-vids__play-btn { transform: scale(1.1); background: #4d8c44; }
  .vb-vids__play-btn::before { content: ''; width: 0; height: 0; border-left: 18px solid #4d8c44; border-top: 11px solid transparent; border-bottom: 11px solid transparent; margin-left: 4px; transition: border-color 0.22s ease; }
  .vb-vids__card:hover .vb-vids__play-btn::before { border-left-color: #fff; }
  .vb-vids__caption { position: absolute; bottom: 14px; left: 14px; right: 14px; color: #fff; font-size: 13px; font-weight: 700; text-shadow: 0 2px 8px rgba(0,0,0,0.5); line-height: 1.3; }
  @media (max-width: 749px) {
    .vb-vids { padding: 48px 14px; }
    .vb-vids__grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .vb-vids__card { border-radius: 14px; }
    .vb-vids__play-btn { width: 48px; height: 48px; }
    .vb-vids__play-btn::before { border-left-width: 14px; border-top-width: 9px; border-bottom-width: 9px; }
    .vb-vids__caption { font-size: 11.5px; bottom: 10px; left: 10px; right: 10px; }
  }
</style>

<section class="vb-vids">
  <div class="vb-vids__inner">
    <div class="vb-vids__head">
      {%- if section.settings.eyebrow != blank -%}<p class="vb-vids__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vb-vids__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
      {%- if section.settings.sub != blank -%}<p class="vb-vids__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <div class="vb-vids__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'video' -%}
          <a class="vb-vids__card" href="{{ block.settings.video_url | default: '#' }}" {%- if block.settings.video_url contains 'http' %} target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.thumb_url != blank -%}
              <img src="{{ block.settings.thumb_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy" />
            {%- endif -%}
            <div class="vb-vids__play"><span class="vb-vids__play-btn"></span></div>
            {%- if block.settings.caption != blank -%}<div class="vb-vids__caption">{{ block.settings.caption }}</div>{%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Customer videos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real Customer Stories" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "Trusted by Thousands." },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Backed by Science." },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Watch real people share their Velobiotics experience — in their own words." }
  ],
  "blocks": [
    { "type": "video", "name": "Video", "settings": [
      { "type": "text", "id": "thumb_url", "label": "Thumbnail URL" },
      { "type": "text", "id": "video_url", "label": "Video URL (optional)" },
      { "type": "text", "id": "caption", "label": "Caption", "default": "Real result" }
    ]}
  ],
  "presets": [
    { "name": "VB · Customer videos", "blocks": [
      { "type": "video", "settings": { "thumb_url": "https://www.velobiotics.com/cdn/shop/files/preview_images/f0fd8fd49a3744ad9e90235146a7d475.thumbnail.0000000000_1100x.jpg?v=1763719718", "caption": "From bloated to brilliant" } },
      { "type": "video", "settings": { "thumb_url": "https://www.velobiotics.com/cdn/shop/files/preview_images/5ecc5e63fe5a49499af24850c49789c7.thumbnail.0000000000_1100x.jpg?v=1763719604", "caption": "Clearer skin in 21 days" } },
      { "type": "video", "settings": { "thumb_url": "https://www.velobiotics.com/cdn/shop/files/preview_images/bb2ce6220768459abce27ac7094e03db.thumbnail.0000000000_1100x.jpg?v=1763719721", "caption": "Lost 42kg with Velo16" } },
      { "type": "video", "settings": { "thumb_url": "https://www.velobiotics.com/cdn/shop/files/preview_images/d33cc78e6e03488d95f56b86e3b14038.thumbnail.0000000000_1100x.jpg?v=1763719696", "caption": "Goodbye recurring BV" } },
      { "type": "video", "settings": { "thumb_url": "https://www.velobiotics.com/cdn/shop/files/preview_images/528b2fb7bf6041f1ac71b0dad68f375e.thumbnail.0000000000_1100x.jpg?v=1763719738", "caption": "My kids never get sick" } }
    ]}
  ]
}
{% endschema %}
