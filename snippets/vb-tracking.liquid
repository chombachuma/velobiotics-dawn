{%- comment -%}
Velobiotics Marketing Attribution Snippet (v2, 25 Sep 2026, Velo Marketing)

WHAT THIS FILE DOES NOW: first-party attribution only (UTM / click-id / landing page /
referrer / internal promo persistence -> Shopify cart attributes -> order note_attributes).

WHAT IT NO LONGER DOES (removed 25 Sep 2026 to stop duplicate & dead events):
  - Meta Pixel init / PageView / ViewContent / AddToCart  -> handled by the "Facebook & Instagram"
    sales channel web pixel (pixel 1254989789237546, browser + Conversions API with dedup).
  - TikTok Pixel D8KR83RC77U29JSH6S60                       -> handled by the TikTok sales channel
    web pixel (D70KD2RC77U7L4DO1U00, full funnel incl. CompletePayment + Events API).
  - GA4 / Google Ads gtag calls (gtag was never loaded here) -> handled by the "Google & YouTube"
    sales channel web pixel (G-6773VKB51J, AW-10893546606, GT-K4ZN5LJ3: page_view, view_item,
    add_to_cart, begin_checkout, add_payment_info, purchase...).
Do NOT add pixel code back into the theme. One source per platform = clean attribution.

ATTRIBUTION RULES
  - Acquisition (first touch in the session) wins: utm_*, gclid, fbclid, ttclid, landing_page,
    referrer are captured once per session and never overwritten by later internal clicks.
  - Internal promo clicks use ?vbref=<name> (NOT utm_*), stored separately as internal_promo.
    Never put utm_* on links that point back to this store; it resets GA4 sessions.
  - Cart attributes are synced when the signature changes and again after add-to-cart.
{%- endcomment -%}

<script>
(function () {
  'use strict';

  function marketingAllowed() {
    try {
      if (window.Shopify && window.Shopify.customerPrivacy) {
        var c = window.Shopify.customerPrivacy.getTrackingConsent();
        if (c === 'declined' || c === 'no' || c === false) return false;
      }
    } catch (e) {}
    return true;
  }

  var ACQ_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'fbclid', 'ttclid'];
  var INTERNAL_SOURCES = ['website', 'velobiotics', 'internal', 'site', 'shopify'];
  var INTERNAL_MEDIUMS = ['announcement_bar', 'splash', 'popup', 'banner', 'sticky', 'countdown', 'internal'];
  var MAX_LEN = 480;

  function clip(v) { v = String(v || ''); return v.length > MAX_LEN ? v.slice(0, MAX_LEN) : v; }
  function ss(k, v) { try { if (v === undefined) return sessionStorage.getItem(k); sessionStorage.setItem(k, v); } catch (e) { return null; } }
  function ls(k, v) { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch (e) { return null; } }

  function cleanUrl(href) {
    try {
      var u = new URL(href, window.location.origin);
      ['_gl', '_ga', '_gac', 'omnisendContactID'].forEach(function (p) { u.searchParams.delete(p); });
      return clip(u.toString());
    } catch (e) { return clip(href); }
  }

  function isInternal(params) {
    var s = (params.get('utm_source') || '').toLowerCase();
    var m = (params.get('utm_medium') || '').toLowerCase();
    return INTERNAL_SOURCES.indexOf(s) > -1 || INTERNAL_MEDIUMS.indexOf(m) > -1;
  }

  function capture() {
    var params = new URLSearchParams(window.location.search);
    var out = {};

    // 1) Acquisition touch: first touch in this session wins.
    var hasAcq = ACQ_KEYS.some(function (k) { return !!params.get(k); });
    var sessionHasAcq = !!ss('vb_acq_set');
    if (hasAcq && !isInternal(params) && !sessionHasAcq) {
      ACQ_KEYS.forEach(function (k) {
        var v = params.get(k);
        if (v) { ss('vb_' + k, clip(v)); ls('vb_' + k, clip(v)); }
      });
      ss('vb_acq_set', '1');
    }
    ACQ_KEYS.forEach(function (k) {
      var v = ss('vb_' + k) || ls('vb_' + k);
      if (v) out[k] = v;
    });

    // 2) Landing page + referrer: once per session.
    if (!ss('vb_landing_page')) {
      ss('vb_landing_page', cleanUrl(window.location.href));
      ss('vb_referrer', clip(document.referrer || ''));
    }
    out.landing_page = ss('vb_landing_page') || '';
    out.referrer = ss('vb_referrer') || '';

    // 3) Internal promo click (?vbref=payday_bar etc.) - last internal click wins, kept separate.
    var ref = params.get('vbref');
    if (!ref && isInternal(params)) ref = (params.get('utm_medium') || 'internal') + ':' + (params.get('utm_campaign') || '');
    if (ref) ss('vb_internal_promo', clip(ref));
    if (ss('vb_internal_promo')) out.internal_promo = ss('vb_internal_promo');

    // 4) Market / storefront context.
    out.market = (window.Shopify && Shopify.country) ? Shopify.country : '';
    out.store_host = window.location.host;
    return out;
  }

  function signature(a) { return JSON.stringify(a); }

  function syncCart(attr, force) {
    if (!attr) return;
    var sig = signature(attr);
    if (!force && ss('vb_cart_sig') === sig) return;
    var payload = {
      attributes: {
        utm_source: attr.utm_source || '',
        utm_medium: attr.utm_medium || '',
        utm_campaign: attr.utm_campaign || '',
        utm_content: attr.utm_content || '',
        utm_term: attr.utm_term || '',
        gclid: attr.gclid || '',
        fbclid: attr.fbclid || '',
        ttclid: attr.ttclid || '',
        landing_page: attr.landing_page || '',
        referrer: attr.referrer || '',
        internal_promo: attr.internal_promo || '',
        market: attr.market || '',
        biomatchAttribution: JSON.stringify(attr)
      }
    };
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload),
      credentials: 'same-origin',
      keepalive: true
    }).then(function () { ss('vb_cart_sig', sig); })
      .catch(function () {});
  }

  if (!marketingAllowed()) return;

  var attrs = capture();
  window.vbAttribution = attrs;

  function run() { syncCart(attrs, false); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();

  // Re-apply after add-to-cart (AJAX drawers create/replace carts without attributes).
  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (f && f.action && String(f.action).indexOf('/cart/add') > -1) setTimeout(function () { syncCart(attrs, true); }, 1500);
  }, true);
  document.addEventListener('click', function (e) {
    var t = e.target && e.target.closest && e.target.closest('button[name="add"], .product-form__submit, [data-add-to-cart], [name="add"]');
    if (t) setTimeout(function () { syncCart(attrs, true); }, 1500);
  }, true);
  (function () {
    var of = window.fetch;
    if (!of) return;
    window.fetch = function (input, init) {
      var p = of.apply(this, arguments);
      try {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        if (url.indexOf('/cart/add') > -1) p.then(function () { setTimeout(function () { syncCart(attrs, true); }, 800); }).catch(function () {});
      } catch (e) {}
      return p;
    };
  })();
})();
</script>
