{%- comment -%}
  VB · Ingredient dossier page (Ingredient Repository) — 15 Sep 2026
  Renders a structured ingredient page from page.content generated by the repository build script.
  page.content contains: .vb-ing[data-category][data-icon][data-evidence] > .vb-ing__oneliner + section[data-k] blocks
  + <script type="application/json" data-vb-ing> { found_in:[product handles], aliases:[...] }
{%- endcomment -%}
<style>
  .vbi { --bp:#4d8c44; --bd:#2e5d28; --bt:#eef7ec; --ink:#1a2e1a; --mut:#5c6a5c; }
  .vbi__hero { background: radial-gradient(120% 100% at 50% 0%, #fff 0%, var(--bt) 70%); padding: 56px 20px 34px; }
  .vbi__hero-in { max-width: 980px; margin: 0 auto; text-align: center; }
  .vbi__crumbs { font-size: 12.5px; color: var(--mut); margin: 0 0 18px; }
  .vbi__crumbs a { color: var(--bd); font-weight: 700; text-decoration: none; }
  .vbi__icon { width: 74px; height: 74px; border-radius: 22px; background: #fff; display: grid; place-items: center; font-size: 36px; margin: 0 auto 14px; box-shadow: 0 14px 30px -20px rgba(0,0,0,.35); }
  .vbi__cat { display: inline-block; font-size: 11.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--bp); background: #fff; border: 1px solid color-mix(in srgb, var(--bp) 25%, #fff); border-radius: 999px; padding: 5px 12px; margin: 0 0 12px; }
  .vbi__title { font-size: clamp(30px, 5vw, 48px); font-weight: 800; letter-spacing: -.02em; line-height: 1.08; color: var(--ink); margin: 0 0 12px; }
  .vbi__one { font-size: 17px; line-height: 1.55; color: var(--mut); max-width: 700px; margin: 0 auto 18px; }
  .vbi__meta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .vbi__pill { font-size: 12.5px; font-weight: 700; color: var(--bd); background: #fff; border-radius: 999px; padding: 7px 12px; border: 1px solid #e3ece1; }
  .vbi__pill b { color: var(--bp); }
  .vbi__nav { position: sticky; top: 0; z-index: 5; background: rgba(255,255,255,.9); backdrop-filter: blur(8px); border-bottom: 1px solid #e6ede4; }
  .vbi__nav-in { max-width: 980px; margin: 0 auto; display: flex; gap: 4px; overflow-x: auto; padding: 8px 12px; scrollbar-width: none; }
  .vbi__nav a { white-space: nowrap; font-size: 13px; font-weight: 700; color: var(--mut); text-decoration: none; padding: 8px 12px; border-radius: 999px; }
  .vbi__nav a.is-on, .vbi__nav a:hover { color: var(--bd); background: var(--bt); }
  .vbi__body { max-width: 980px; margin: 0 auto; padding: 28px 20px 60px; display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 36px; align-items: start; }
  .vbi__content .vb-ing__oneliner { display: none; }
  .vbi__content section { padding: 26px 0; border-bottom: 1px solid #e9efe7; scroll-margin-top: 70px; }
  .vbi__content section:last-of-type { border-bottom: 0; }
  .vbi__content h2 { font-size: 20px; font-weight: 800; color: var(--ink); margin: 0 0 12px; letter-spacing: -.01em; display: flex; align-items: center; gap: 10px; }
  .vbi__content h2:before { content: ''; width: 8px; height: 22px; border-radius: 4px; background: var(--bp); }
  .vbi__content p, .vbi__content li { font-size: 15.5px; line-height: 1.7; color: #33422f; }
  .vbi__content ul { padding-left: 0; list-style: none; display: grid; gap: 8px; }
  .vbi__content ul li { position: relative; padding-left: 28px; }
  .vbi__content ul li:before { content: '✓'; position: absolute; left: 0; top: 2px; width: 20px; height: 20px; border-radius: 50%; background: var(--bt); color: var(--bd); font-weight: 800; font-size: 12px; display: grid; place-items: center; }
  .vbi__content section[data-k="synergy"] { background: linear-gradient(135deg, var(--bt), #fff); border: 1px solid color-mix(in srgb, var(--bp) 20%, #fff); border-radius: 20px; padding: 24px; margin: 14px 0; }
  .vbi__content section[data-k="synergy"] h2:before { background: linear-gradient(180deg, var(--bp), #9bd58f); }
  .vbi__content ol.refs { padding-left: 18px; }
  .vbi__content ol.refs li { font-size: 13.5px; color: var(--mut); line-height: 1.55; margin: 0 0 6px; }
  .vbi__content ol.refs a { color: var(--bd); word-break: break-word; }
  .vbi__content .vb-ing__evidence { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; background: var(--bt); color: var(--bd); margin: 0 0 10px; }
  .vbi__side { position: sticky; top: 64px; display: grid; gap: 16px; }
  .vbi__card { background: #fff; border: 1px solid #e6ede4; border-radius: 20px; padding: 18px; }
  .vbi__card h3 { margin: 0 0 12px; font-size: 14px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--mut); }
  .vbi__prod { display: flex; gap: 12px; align-items: center; text-decoration: none; padding: 8px; border-radius: 14px; }
  .vbi__prod:hover { background: var(--bt); }
  .vbi__prod img { width: 54px; height: 54px; object-fit: contain; border-radius: 12px; background: #f6faf5; }
  .vbi__prod b { display: block; font-size: 13.5px; color: var(--ink); line-height: 1.3; }
  .vbi__prod span { font-size: 12.5px; color: var(--mut); }
  .vbi__cta { display: block; text-align: center; background: var(--bp); color: #fff; font-weight: 800; border-radius: 999px; padding: 12px; text-decoration: none; margin-top: 6px; }
  .vbi__cta:hover { background: var(--bd); }
  .vbi__disc { font-size: 12px; color: #7b877b; line-height: 1.5; }
  @media (max-width: 860px) { .vbi__body { grid-template-columns: 1fr; gap: 20px; padding: 18px 16px 48px; } .vbi__side { position: static; } .vbi__hero { padding: 36px 16px 24px; } }
</style>

<div class="vbi" data-vbi>
  <div class="vbi__hero">
    <div class="vbi__hero-in">
      <p class="vbi__crumbs"><a href="/pages/ingredients">Ingredient Repository</a> · <span data-vbi-cat-crumb>Ingredient</span></p>
      <div class="vbi__icon" data-vbi-icon>🌿</div>
      <span class="vbi__cat" data-vbi-cat>Ingredient</span>
      <h1 class="vbi__title">{{ page.title }}</h1>
      <p class="vbi__one" data-vbi-one></p>
      <div class="vbi__meta" data-vbi-meta></div>
    </div>
  </div>
  <nav class="vbi__nav" aria-label="On this page"><div class="vbi__nav-in" data-vbi-nav></div></nav>
  <div class="vbi__body">
    <article class="vbi__content" data-vbi-content>{{ page.content }}</article>
    <aside class="vbi__side">
      <div class="vbi__card"><h3>Found in</h3><div data-vbi-products><p class="vbi__disc">Loading products…</p></div></div>
      <div class="vbi__card"><h3>Why Velobiotics</h3><p class="vbi__disc" style="font-size:13.5px;color:#33422f">Every Velobiotics formula pairs its actives with live cultures protected by patented MEP microencapsulation — so more probiotics reach the gut alive, where they help you absorb and use what you take.</p><a class="vbi__cta" href="/pages/quiz">Find my match →</a></div>
      <p class="vbi__disc">Food supplements support a balanced diet and healthy lifestyle; they do not treat, cure or prevent disease. Content reviewed by the Velobiotics scientific team.</p>
    </aside>
  </div>
</div>

<script>
(function(){
  const root = document.querySelector('[data-vbi]'); if (!root) return;
  const ing = root.querySelector('.vb-ing'); if (!ing) return;
  const CAT = { probiotic_strain:'Probiotic strain', prebiotic:'Prebiotic fibre', enzyme:'Digestive enzyme', vitamin:'Vitamin', mineral:'Mineral', botanical:'Botanical extract', amino_protein:'Protein & amino acid', fatty_acid:'Fatty acid', functional_other:'Functional active' };
  const cat = ing.dataset.category || ''; const label = CAT[cat] || 'Ingredient';
  root.querySelector('[data-vbi-cat]').textContent = label; root.querySelector('[data-vbi-cat-crumb]').textContent = label;
  if (ing.dataset.icon) root.querySelector('[data-vbi-icon]').textContent = ing.dataset.icon;
  const one = ing.querySelector('.vb-ing__oneliner'); if (one) root.querySelector('[data-vbi-one]').textContent = one.textContent;
  const meta = root.querySelector('[data-vbi-meta]');
  const dose = ing.querySelector('[data-dose]'); if (dose) meta.insertAdjacentHTML('beforeend', `<span class="vbi__pill">Typical dose <b>${dose.dataset.dose}</b></span>`);
  if (ing.dataset.evidence) meta.insertAdjacentHTML('beforeend', `<span class="vbi__pill">Evidence <b>${ing.dataset.evidence}</b></span>`);
  // in-page nav
  const nav = root.querySelector('[data-vbi-nav]'); const secs = [...ing.querySelectorAll('section[data-k]')];
  secs.forEach(s => { s.id = 'ing-' + s.dataset.k; const a = document.createElement('a'); a.href = '#' + s.id; a.textContent = s.querySelector('h2')?.textContent || s.dataset.k; nav.appendChild(a); });
  const links = [...nav.querySelectorAll('a')];
  const spy = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) links.forEach(l => l.classList.toggle('is-on', l.getAttribute('href') === '#' + e.target.id)); }), { rootMargin: '-40% 0px -55% 0px' });
  secs.forEach(s => spy.observe(s));
  // found-in products
  let data = {}; try { data = JSON.parse(ing.querySelector('[data-vb-ing]')?.textContent || '{}'); } catch(e) {}
  const box = root.querySelector('[data-vbi-products]'); const handles = (data.found_in || []).slice(0, 8);
  if (!handles.length) { box.innerHTML = '<p class="vbi__disc">Part of the Velobiotics formulation library.</p>'; return; }
  box.innerHTML = '';
  Promise.all(handles.map(h => fetch(`/products/${h}.js`).then(r => r.ok ? r.json() : null).catch(() => null))).then(ps => {
    ps.filter(Boolean).forEach(p => {
      const price = (p.price / 100).toLocaleString(undefined, { style: 'currency', currency: {{ cart.currency.iso_code | json }} });
      box.insertAdjacentHTML('beforeend', `<a class="vbi__prod" href="/products/${p.handle}"><img src="${p.featured_image || ''}" alt="" loading="lazy"><div><b>${p.title}</b><span>${price}</span></div></a>`);
    });
    if (!box.children.length) box.innerHTML = '<p class="vbi__disc">Part of the Velobiotics formulation library.</p>';
  });
})();
</script>

{% schema %}
{ "name": "VB · Ingredient page", "tag": "section", "settings": [], "presets": [{ "name": "VB · Ingredient page" }] }
{% endschema %}
