{%- comment -%}
  VB · Science Behind the Difference — 4-step process cards
{%- endcomment -%}

<style>
  .vb-sci { padding: 72px 24px; background: #1f2c2a; color: #fff; }
  .vb-sci__inner { max-width: 1280px; margin: 0 auto; }
  .vb-sci__head { text-align: center; max-width: 760px; margin: 0 auto 48px; }
  .vb-sci__eyebrow { display: inline-block; color: #8fc086; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-sci__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #fff; line-height: 1.12; margin: 0 0 14px; letter-spacing: -0.01em; }
  .vb-sci__title em { color: #8fc086; font-style: normal; display: block; }
  .vb-sci__sub { font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.72); margin: 0; }
  .vb-sci__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .vb-sci__card { position: relative; padding: 30px 24px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.10); border-radius: 20px; transition: transform 0.22s ease, background-color 0.22s ease, border-color 0.22s ease; }
  .vb-sci__card:hover { transform: translateY(-5px); background: rgba(77,140,68,0.10); border-color: rgba(77,140,68,0.4); }
  .vb-sci__step { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: #4d8c44; color: #fff; font-weight: 900; font-size: 14px; margin: 0 0 16px; box-shadow: 0 8px 18px rgba(77,140,68,0.34); }
  .vb-sci__icon { width: 56px; height: 56px; border-radius: 16px; background: rgba(143,192,134,0.14); color: #8fc086; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 0 14px; }
  .vb-sci__name { font-size: 17px; font-weight: 800; color: #fff; margin: 0 0 8px; line-height: 1.3; }
  .vb-sci__desc { font-size: 13.5px; line-height: 1.55; color: rgba(255,255,255,0.78); margin: 0; }
  @media (max-width: 749px) {
    .vb-sci { padding: 48px 14px; }
    .vb-sci__head { margin-bottom: 32px; }
    .vb-sci__grid { grid-template-columns: 1fr; gap: 12px; }
    .vb-sci__card { padding: 22px 18px; border-radius: 16px; }
    .vb-sci__step { width: 30px; height: 30px; font-size: 12px; }
    .vb-sci__icon { width: 48px; height: 48px; font-size: 24px; }
    .vb-sci__name { font-size: 15.5px; }
    .vb-sci__desc { font-size: 12.5px; }
  }
</style>

<section class="vb-sci">
  <div class="vb-sci__inner">
    <div class="vb-sci__head">
      {%- if section.settings.eyebrow != blank -%}<p class="vb-sci__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vb-sci__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
      {%- if section.settings.sub != blank -%}<p class="vb-sci__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <div class="vb-sci__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <article class="vb-sci__card" {{ block.shopify_attributes }}>
            <span class="vb-sci__step">{{ forloop.index }}</span>
            <div class="vb-sci__icon">{{ block.settings.icon }}</div>
            <h3 class="vb-sci__name">{{ block.settings.name }}</h3>
            <p class="vb-sci__desc">{{ block.settings.desc }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Science Behind",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Science Behind the Difference" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "We Built Armour Around Every Probiotic" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "So It Survives Where Others Don't." },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Most probiotics die before they ever help. Velobiotics uses patented Microencapsulation with Supercritical CO₂ — a four-stage shielding process that lets billions of live cultures pass through stomach acid intact and active." }
  ],
  "blocks": [
    { "type": "step", "name": "Process step", "settings": [
      { "type": "text", "id": "icon", "label": "Icon / emoji", "default": "🧬" },
      { "type": "text", "id": "name", "label": "Name", "default": "Live Strain Selection" },
      { "type": "textarea", "id": "desc", "label": "Description", "default": "Clinically studied probiotic strains hand-picked for results." }
    ]}
  ],
  "presets": [
    { "name": "VB · Science Behind", "blocks": [
      { "type": "step", "settings": { "icon": "🧬", "name": "Live Strain Selection", "desc": "Clinically studied probiotic strains, hand-picked by microbiologists for measurable results." } },
      { "type": "step", "settings": { "icon": "🛡️", "name": "MEP Encapsulation", "desc": "Each culture is shielded using Supercritical CO₂ microencapsulation — our patented armour." } },
      { "type": "step", "settings": { "icon": "🌡️", "name": "Acid-Resistant Coating", "desc": "The coating survives stomach acid and bile, so probiotics arrive in your gut alive." } },
      { "type": "step", "settings": { "icon": "🎯", "name": "Targeted Delivery", "desc": "Cultures release exactly where they're needed — colon, vagina, or intimate microbiome." } }
    ]}
  ]
}
{% endschema %}
