{%- comment -%} VB · Product benefits — feature/icon grid with optional centred image {%- endcomment -%}

{%- liquid
  assign brand_primary = section.settings.brand_primary | default: '#4d8c44'
  assign brand_tint = section.settings.brand_tint | default: '#f3f7f1'
-%}

<style>
  .vb-pbn { padding: 72px 24px; --bp: {{ brand_primary }}; --bt: {{ brand_tint }}; background: #fff; }
  .vb-pbn__inner { max-width: 1280px; margin: 0 auto; }
  .vb-pbn__head { text-align: center; max-width: 720px; margin: 0 auto 40px; }
  .vb-pbn__eyebrow { display: inline-block; color: var(--bp); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-pbn__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; }
  .vb-pbn__title em { color: var(--bp); font-style: normal; }
  .vb-pbn__sub { font-size: 16px; line-height: 1.6; color: #5c6664; margin: 0; }
  .vb-pbn__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
  .vb-pbn__card { padding: 28px 22px 26px; background: linear-gradient(180deg, #fff 0%, var(--bt) 100%); border-radius: 18px; border: 1px solid color-mix(in srgb, var(--bp) 12%, transparent); transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease; position: relative; overflow: hidden; }
  .vb-pbn__card:hover { transform: translateY(-5px); box-shadow: 0 22px 44px color-mix(in srgb, var(--bp) 18%, transparent); border-color: color-mix(in srgb, var(--bp) 35%, transparent); }
  .vb-pbn__card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--bp); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease; }
  .vb-pbn__card:hover::after { transform: scaleX(1); }
  .vb-pbn__icon { width: 56px; height: 56px; border-radius: 16px; background: color-mix(in srgb, var(--bp) 14%, #fff); color: var(--bp); display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 0 14px; }
  .vb-pbn__name { font-size: 16.5px; font-weight: 800; color: #1a1a1a; margin: 0 0 8px; line-height: 1.3; }
  .vb-pbn__desc { font-size: 13.5px; line-height: 1.55; color: #5c6664; margin: 0; }
  @media (max-width: 749px) {
    .vb-pbn { padding: 48px 16px; }
    .vb-pbn__head { margin-bottom: 28px; }
    .vb-pbn__grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .vb-pbn__card { padding: 18px 14px; border-radius: 14px; }
    .vb-pbn__icon { width: 44px; height: 44px; font-size: 22px; margin-bottom: 10px; border-radius: 12px; }
    .vb-pbn__name { font-size: 14px; }
    .vb-pbn__desc { font-size: 12.5px; }
  }
</style>

<section class="vb-pbn">
  <div class="vb-pbn__inner">
    <div class="vb-pbn__head">
      {%- if section.settings.eyebrow != blank -%}<p class="vb-pbn__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vb-pbn__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
      {%- if section.settings.sub != blank -%}<p class="vb-pbn__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <div class="vb-pbn__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feat' -%}
          <article class="vb-pbn__card" {{ block.shopify_attributes }}>
            <div class="vb-pbn__icon">{{ block.settings.icon }}</div>
            <h3 class="vb-pbn__name">{{ block.settings.name }}</h3>
            <p class="vb-pbn__desc">{{ block.settings.desc }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Product benefits",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "color", "id": "brand_primary", "label": "Brand primary", "default": "#4d8c44" },
    { "type": "color", "id": "brand_tint", "label": "Brand tint", "default": "#f3f7f1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Key Benefits" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "Why" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Femina™" },
    { "type": "textarea", "id": "sub", "label": "Sub-text" }
  ],
  "blocks": [
    { "type": "feat", "name": "Benefit", "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🌸" },
      { "type": "text", "id": "name", "label": "Name", "default": "Benefit name" },
      { "type": "textarea", "id": "desc", "label": "Description", "default": "Benefit description." }
    ]}
  ],
  "presets": [{ "name": "VB · Product benefits" }]
}
{% endschema %}
