<style>.vbqsp{background:#fdf9f1;padding:80px 20px;text-align:center}.vbqsp__inner{max-width:1100px;margin:0 auto}.vbqsp__eb{display:inline-block;background:#eef7ec;color:#2e5d28;padding:6px 14px;border-radius:999px;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px}.vbqsp__h{font-family:'Playfair Display',Georgia,serif;font-size:clamp(30px,4.5vw,44px);font-weight:700;margin:0 0 14px;color:#1a2e1a;letter-spacing:-.01em}.vbqsp__hl{color:#4d8c44;font-style:italic}.vbqsp__sub{color:#5a6b5a;font-size:17px;max-width:640px;margin:0 auto 44px;line-height:1.55}.vbqsp__stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}@media(max-width:768px){.vbqsp__stats{grid-template-columns:repeat(2,1fr)}}.vbqsp__stat{background:#fff;border:1px solid #e8efe6;border-radius:20px;padding:32px 18px;transition:.3s}.vbqsp__stat:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(77,140,68,.12)}.vbqsp__val{font-family:'Playfair Display',Georgia,serif;font-size:44px;font-weight:700;color:#4d8c44;line-height:1;margin-bottom:10px;letter-spacing:-.02em}.vbqsp__lbl{font-size:14px;color:#5a6b5a;font-weight:600}.vbqsp__regions{display:flex;gap:18px;justify-content:center;margin-top:36px;flex-wrap:wrap}.vbqsp__region{display:flex;align-items:center;gap:8px;font-size:14px;color:#5a6b5a;font-weight:600;background:#fff;padding:8px 16px;border-radius:99px;border:1px solid #e8efe6}</style>
<section class="vbqsp"><div class="vbqsp__inner">
  <div class="vbqsp__eb">{{ section.settings.eyebrow }}</div>
  <h2 class="vbqsp__h">{{ section.settings.title_pre }} <span class="vbqsp__hl">{{ section.settings.title_highlight }}</span></h2>
  <p class="vbqsp__sub">{{ section.settings.sub }}</p>
  <div class="vbqsp__stats">
    {% for b in section.blocks %}<div class="vbqsp__stat"><div class="vbqsp__val">{{ b.settings.value }}</div><div class="vbqsp__lbl">{{ b.settings.label }}</div></div>{% endfor %}
  </div>
  {% if section.settings.show_regions %}
  <div class="vbqsp__regions">
    <span class="vbqsp__region">🇺🇸 United States</span>
    <span class="vbqsp__region">🇪🇺 European Union</span>
    <span class="vbqsp__region">🇿🇦 South Africa</span>
    <span class="vbqsp__region">🇬🇧 United Kingdom</span>
    <span class="vbqsp__region">🇦🇺 Australia</span>
  </div>
  {% endif %}
</div></section>
{% schema %}
{"name":"VB Quiz · Social proof","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Trusted globally"},{"type":"text","id":"title_pre","label":"Title (pre)","default":"Doctor-built."},{"type":"text","id":"title_highlight","label":"Title (highlight)","default":"Lab-proven."},{"type":"textarea","id":"sub","label":"Sub","default":"The new daily standard for gut, intimate, and family wellness."},{"type":"checkbox","id":"show_regions","label":"Show shipping regions","default":true}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"value","label":"Value","default":"50,000+"},{"type":"text","id":"label","label":"Label","default":"Customers served"}]}],"max_blocks":6,"presets":[{"name":"VB Quiz · Social Proof"}]}
{% endschema %}
