        "q2": {
          "type": "q",
          "settings": {
            "question": "When should I test?",
            "answer": "<p>Test when you have symptoms (unusual discharge, odour, itching, discomfort). Avoid testing within 24 hours of intercourse or menstruation as these can affect pH temporarily.</p>"
          }
        },
        "q3": {
          "type": "q",
          "settings": {
            "question": "What if my result is unclear?",
            "answer": "<p>If symptoms persist or your pH reading is borderline, see your healthcare practitioner. This kit is a first-line diagnostic — not a replacement for clinical care for persistent issues.</p>"
          }
        },
        "q4": {
          "type": "q",
          "settings": {
            "question": "Is it safe to use myself?",
