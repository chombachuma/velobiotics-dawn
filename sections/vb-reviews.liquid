{{ 'vb-reviews.css' | asset_url | stylesheet_tag }}

{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0668/5848/3883/files' -%}

<section class="vb-reviews">
  <div class="vb-reviews__inner page-width">

    <div class="vb-reviews__header">
      <span class="vb-label-tag">Real People. Real Results.</span>
      <h2 class="vb-h2">Trusted by Thousands.<br>Backed by Science.</h2>
    </div>

    {%- comment -%} Aggregate + Doctor quote row {%- endcomment -%}
    <div class="vb-reviews__top-row">

      <div class="vb-reviews__aggregate">
        <div class="vb-reviews__agg-score">
          <span class="vb-reviews__agg-num">4.8</span>
          <div>
            <div class="vb-reviews__agg-stars">★★★★★</div>
            <span class="vb-reviews__agg-count">3,500+ Verified Reviews</span>
          </div>
        </div>
        <div class="vb-reviews__agg-bars">
          <div class="vb-reviews__bar-row"><span>5★</span><div class="vb-bar"><div class="vb-bar__fill" style="width:82%"></div></div><span>82%</span></div>
          <div class="vb-reviews__bar-row"><span>4★</span><div class="vb-bar"><div class="vb-bar__fill" style="width:12%"></div></div><span>12%</span></div>
          <div class="vb-reviews__bar-row"><span>3★</span><div class="vb-bar"><div class="vb-bar__fill" style="width:4%"></div></div><span>4%</span></div>
          <div class="vb-reviews__bar-row"><span>2★</span><div class="vb-bar"><div class="vb-bar__fill" style="width:1%"></div></div><span>1%</span></div>
          <div class="vb-reviews__bar-row"><span>1★</span><div class="vb-bar"><div class="vb-bar__fill" style="width:1%"></div></div><span>1%</span></div>
        </div>
        <div class="vb-reviews__agg-badges">
          <span class="vb-reviews__agg-badge">⭐ 4.8/5 Rating</span>
          <span class="vb-reviews__agg-badge">🧪 Clinically Studied</span>
          <span class="vb-reviews__agg-badge">🏭 SAHPRA Certified</span>
        </div>
      </div>

      <div class="vb-reviews__doctor-quote">
        <img
          src="{{ cdn }}/Dr._Carmen_James_-_Cookie_Fresh.png"
          alt="Dr. Carmen James — Medical Doctor"
          loading="lazy"
          class="vb-reviews__dr-img"
          width="300" height="300"
        >
        <div class="vb-reviews__dq-content">
          <div class="vb-reviews__dq-stars">★★★★★</div>
          <blockquote class="vb-reviews__dq-text">
            "That's why I love this product! It combines the power of Probiotics and Boric Acid for ultimate female intimate health."
          </blockquote>
          <div class="vb-reviews__dq-author">
            <strong>Dr. Carmen James</strong>
            <span>Medical Doctor &nbsp;•&nbsp; 🩺 Verified Doctor</span>
          </div>
        </div>
      </div>

    </div>

    {%- comment -%} Review cards {%- endcomment -%}
    <div class="vb-reviews__grid">

      <div class="vb-reviews__card vb-reviews__card--featured">
        <div class="vb-reviews__card-top">
          <div class="vb-reviews__card-stars">★★★★★</div>
          <span class="vb-reviews__card-badge">✅ Verified</span>
        </div>
        <p class="vb-reviews__card-headline">"Helped me feel a lot more comfortable during the day"</p>
        <p class="vb-reviews__card-body">A lot less bloating and feeling fresh every single day. I've tried so many other brands and nothing compares to Velobiotics. The difference was noticeable within a week.</p>
        <div class="vb-reviews__card-footer">
          <div class="vb-reviews__card-avatar">A</div>
          <div>
            <strong>Ashley Barnes</strong>
            <span>on Femina Probiotic</span>
          </div>
        </div>
      </div>

      <div class="vb-reviews__card">
        <div class="vb-reviews__card-top">
          <div class="vb-reviews__card-stars">★★★★★</div>
          <span class="vb-reviews__card-badge">✅ Verified</span>
        </div>
        <p class="vb-reviews__card-headline">"Lost 42kgs — the last kg wouldn't budge"</p>
        <p class="vb-reviews__card-body">Velo16 helped me lose the last kg. My stomach feels so much lighter and I'm not bloated anymore. It's the only probiotic I'll ever use again.</p>
        <div class="vb-reviews__card-footer">
          <div class="vb-reviews__card-avatar">N</div>
          <div>
            <strong>Nicky vd Westhuizen</strong>
            <span>on Velo16 Probiotic</span>
          </div>
        </div>
      </div>

      <div class="vb-reviews__card">
        <div class="vb-reviews__card-top">
          <div class="vb-reviews__card-stars">★★★★★</div>
          <span class="vb-reviews__card-badge">✅ Verified</span>
        </div>
        <p class="vb-reviews__card-headline">"Cookie Fresh is a total game changer"</p>
        <p class="vb-reviews__card-body">Refreshing confidence that Cookie Fresh gives me — feeling fresh and confident about my feminine hygiene all day long. No more odor or discomfort.</p>
        <div class="vb-reviews__card-footer">
          <div class="vb-reviews__card-avatar">T</div>
          <div>
            <strong>Thandi K.</strong>
            <span>on Cookie Fresh</span>
          </div>
        </div>
      </div>

      <div class="vb-reviews__card">
        <div class="vb-reviews__card-top">
          <div class="vb-reviews__card-stars">★★★★★</div>
          <span class="vb-reviews__card-badge">✅ Verified</span>
        </div>
        <p class="vb-reviews__card-headline">"No more itching, no more odor — feeling fresh!"</p>
        <p class="vb-reviews__card-body">You'll never have itching anymore. No more bloating. Feeling fresh every single day. This product has changed my life completely.</p>
        <div class="vb-reviews__card-footer">
          <div class="vb-reviews__card-avatar">N</div>
          <div>
            <strong>Nomsa P.</strong>
            <span>on Femina Combo</span>
          </div>
        </div>
      </div>

      <div class="vb-reviews__card">
        <div class="vb-reviews__card-top">
          <div class="vb-reviews__card-stars">★★★★★</div>
          <span class="vb-reviews__card-badge">✅ Verified</span>
        </div>
        <p class="vb-reviews__card-headline">"BioKid transformed my children's immunity"</p>
        <p class="vb-reviews__card-body">My two children take BioKid daily. Their immunity is so much better since they started — far fewer sick days and better energy at school.</p>
        <div class="vb-reviews__card-footer">
          <div class="vb-reviews__card-avatar">L</div>
          <div>
            <strong>Linda T.</strong>
            <span>on BioKid Chewables</span>
          </div>
        </div>
      </div>

      <div class="vb-reviews__card">
        <div class="vb-reviews__card-top">
          <div class="vb-reviews__card-stars">★★★★★</div>
          <span class="vb-reviews__card-badge">✅ Verified</span>
        </div>
        <p class="vb-reviews__card-headline">"GutSlim actually works — 4kg in 6 weeks"</p>
        <p class="vb-reviews__card-body">I've been taking GutSlim for 6 weeks and lost 4kg. My gut feels incredible and the bloating is completely gone. I feel lighter and more energetic every day.</p>
        <div class="vb-reviews__card-footer">
          <div class="vb-reviews__card-avatar">M</div>
          <div>
            <strong>Michelle R.</strong>
            <span>on GutSlim</span>
          </div>
        </div>
      </div>

    </div>

    {%- comment -%} Doctor images strip {%- endcomment -%}
    <div class="vb-reviews__doctors">
      <p class="vb-reviews__doctors-label">Trusted by Doctors. Proven by Science.</p>
      <div class="vb-reviews__doctors-grid">
        <div class="vb-reviews__doctor-card">
          <img src="{{ cdn }}/Trusted-By-Doctor-Image-001.jpg" alt="Trusted doctor 1" loading="lazy" class="vb-reviews__doctor-img" width="300" height="300">
          <div class="vb-reviews__doctor-overlay"><span>🩺 Doctor Endorsed</span></div>
        </div>
        <div class="vb-reviews__doctor-card">
          <img src="{{ cdn }}/Trusted-By-Doctor-Image-002.jpg" alt="Trusted doctor 2" loading="lazy" class="vb-reviews__doctor-img" width="300" height="300">
          <div class="vb-reviews__doctor-overlay"><span>🩺 Doctor Endorsed</span></div>
        </div>
        <div class="vb-reviews__doctor-card">
          <img src="{{ cdn }}/Trusted-By-Doctor-Image-003.jpg" alt="Trusted doctor 3" loading="lazy" class="vb-reviews__doctor-img" width="300" height="300">
          <div class="vb-reviews__doctor-overlay"><span>🩺 Doctor Endorsed</span></div>
        </div>
        <div class="vb-reviews__doctor-card">
          <img src="{{ cdn }}/Trusted-By-Doctor-Image-004.jpg" alt="Trusted doctor 4" loading="lazy" class="vb-reviews__doctor-img" width="300" height="300">
          <div class="vb-reviews__doctor-overlay"><span>🩺 Doctor Endorsed</span></div>
        </div>
      </div>
    </div>

    <div class="vb-reviews__footer">
      <a href="/pages/reviews" class="vb-btn vb-btn--ghost vb-btn--lg">Read All 3,500+ Reviews →</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "VB Reviews",
  "tag": "div",
  "class": "vb-section-wrap",
  "settings": [],
  "presets": [{ "name": "VB Reviews" }]
}
{% endschema %}
