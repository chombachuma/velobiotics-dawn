{%- comment -%} VB · Elegant ingredients grid — replaces big supplement-facts image {%- endcomment -%}

{%- liquid
  assign brand_primary = section.settings.brand_primary | default: '#4d8c44'
  assign brand_tint = section.settings.brand_tint | default: '#f3f7f1'
-%}

<style>
  .vb-ping { padding: 72px 24px; --bp: {{ brand_primary }}; --bt: {{ brand_tint }}; background: #fff; }
  .vb-ping__inner { max-width: 1080px; margin: 0 auto; }
  .vb-ping__head { text-align: center; max-width: 720px; margin: 0 auto 40px; }
  .vb-ping__eyebrow { display: inline-block; color: var(--bp); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-ping__title { font-size: clamp(28px, 4vw, 40px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 12px; }
  .vb-ping__title em { color: var(--bp); font-style: normal; }
  .vb-ping__sub { font-size: 15.5px; line-height: 1.6; color: #5c6664; margin: 0; }
  .vb-ping__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
  .vb-ping__card { position: relative; padding: 22px 20px 20px; background: linear-gradient(180deg, #fff 0%, var(--bt) 100%); border-radius: 18px; border: 1px solid color-mix(in srgb, var(--bp) 14%, transparent); transition: transform 0.22s ease, box-shadow 0.22s ease; }
  .vb-ping__card:hover { transform: translateY(-4px); box-shadow: 0 18px 36px color-mix(in srgb, var(--bp) 18%, transparent); }
  .vb-ping__icon { width: 52px; height: 52px; border-radius: 14px; background: color-mix(in srgb, var(--bp) 14%, #fff); color: var(--bp); display: inline-flex; align-items: center; justify-content: center; font-size: 24px; margin: 0 0 12px; }
  .vb-ping__name { font-size: 15.5px; font-weight: 800; color: #1a1a1a; margin: 0 0 4px; line-height: 1.3; }
  .vb-ping__amount { font-size: 12.5px; color: var(--bp); font-weight: 700; letter-spacing: 0.04em; margin: 0 0 8px; text-transform: uppercase; }
  .vb-ping__desc { font-size: 12.5px; line-height: 1.55; color: #5c6664; margin: 0; }
  .vb-ping__bottom { margin-top: 24px; text-align: center; }
  .vb-ping__link { display: inline-flex; align-items: center; gap: 6px; color: var(--bp); font-weight: 700; font-size: 13.5px; text-decoration: none; padding: 8px 16px; border-radius: 999px; background: var(--bt); transition: background-color 0.18s ease; }
  .vb-ping__link:hover { background: color-mix(in srgb, var(--bp) 14%, #fff); }
  @media (max-width: 749px) {
    .vb-ping { padding: 48px 14px; }
    .vb-ping__head { margin-bottom: 24px; }
    .vb-ping__grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .vb-ping__card { padding: 16px 14px 14px; border-radius: 14px; }
    .vb-ping__icon { width: 42px; height: 42px; font-size: 20px; margin-bottom: 10px; border-radius: 11px; }
    .vb-ping__name { font-size: 13.5px; }
    .vb-ping__amount { font-size: 11px; }
    .vb-ping__desc { font-size: 11.5px; }
  }
</style>

<section class="vb-ping">
  <div class="vb-ping__inner">
    <div class="vb-ping__head">
      {%- if section.settings.eyebrow != blank -%}<p class="vb-ping__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vb-ping__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
      {%- if section.settings.sub != blank -%}<p class="vb-ping__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <div class="vb-ping__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'ing' -%}
          <article class="vb-ping__card" {{ block.shopify_attributes }}>
            <div class="vb-ping__icon">{{ block.settings.icon }}</div>
            <h3 class="vb-ping__name">{{ block.settings.name }}</h3>
            <p class="vb-ping__amount">{{ block.settings.amount }}</p>
            <p class="vb-ping__desc">{{ block.settings.desc }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.link_text != blank -%}
      <div class="vb-ping__bottom">
        <a href="{{ section.settings.link_url | default: '#' }}" class="vb-ping__link">{{ section.settings.link_text }} →</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VB · Ingredients",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "color", "id": "brand_primary", "label": "Brand primary", "default": "#4d8c44" },
    { "type": "color", "id": "brand_tint", "label": "Brand tint", "default": "#f3f7f1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's Inside" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "Every Ingredient" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Earns Its Place." },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "No proprietary blends. No hidden fillers. Full transparency on every active." },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View full supplement facts" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    { "type": "ing", "name": "Ingredient", "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "🦠" },
      { "type": "text", "id": "name", "label": "Name", "default": "L. acidophilus" },
      { "type": "text", "id": "amount", "label": "Amount", "default": "5 billion CFU" },
      { "type": "textarea", "id": "desc", "label": "Description", "default": "Restores vaginal flora and produces lactic acid for natural pH." }
    ]}
  ],
  "presets": [{ "name": "VB · Ingredients" }]
}
{% endschema %}
