{%- comment -%}
  VB · Product Outperform v2 — Feature/Description table (matches live theme style) + Add to Cart CTA
{%- endcomment -%}

{%- liquid
  assign bp = section.settings.brand_primary | default: '#4d8c44'
  assign bt = section.settings.brand_tint | default: '#f3f7f1'
  assign bd = section.settings.brand_dark | default: '#36632f'
  assign current_variant = product.selected_or_first_available_variant
-%}

<style>
  .vb-pof { padding: 50px 20px; max-width: 1180px; margin: 0 auto; --bp: {{ bp }}; --bt: {{ bt }}; --bd: {{ bd }}; }
  .vb-pof__head { text-align: center; margin: 0 0 32px; }
  .vb-pof__eyebrow { display: inline-flex; align-items: center; gap: 6px; background: color-mix(in srgb, var(--bp) 12%, #fff); color: var(--bp); padding: 6px 13px; border-radius: 999px; font-size: 11.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-pof__title { font-size: clamp(24px, 3.2vw, 34px); font-weight: 800; color: #1a1a1a; margin: 0 0 8px; letter-spacing: -0.02em; }
  .vb-pof__sub { font-size: 15px; color: #5c6664; margin: 0; max-width: 640px; margin-left: auto; margin-right: auto; }

  .vb-pof__table { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; border-radius: 22px; overflow: hidden; box-shadow: 0 14px 36px rgba(0,0,0,0.06); border: 1px solid #e3ece1; }
  .vb-pof__th { background: linear-gradient(180deg, var(--bt) 0%, #fff 100%); font-size: 13px; font-weight: 800; color: #1a1a1a; padding: 18px 22px; text-align: left; letter-spacing: 0.04em; text-transform: uppercase; }
  .vb-pof__th--brand { color: var(--bp); }
  .vb-pof__row { transition: background 0.15s ease; }
  .vb-pof__row:nth-child(odd) td { background: color-mix(in srgb, var(--bp) 3%, #fff); }
  .vb-pof__row:hover td { background: color-mix(in srgb, var(--bp) 7%, #fff); }
  .vb-pof__feature { padding: 18px 22px; font-size: 14.5px; font-weight: 800; color: var(--bp); width: 38%; vertical-align: top; border-top: 1px solid #f0eaf0; }
  .vb-pof__desc { padding: 18px 22px; font-size: 14.5px; color: #2b3a2a; line-height: 1.55; vertical-align: top; border-top: 1px solid #f0eaf0; }

  .vb-pof__cta-wrap { text-align: center; margin: 32px 0 0; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .vb-pof__cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 16px 36px; background: var(--bp); color: #fff !important; border: none; border-radius: 999px; font-weight: 800; font-size: 15px; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 12px 26px color-mix(in srgb, var(--bp) 30%, transparent); text-decoration: none; }
  .vb-pof__cta:hover { background: var(--bd); transform: translateY(-2px); }
  .vb-pof__cta.is-loading { opacity: 0.7; cursor: wait; }
  .vb-pof__cta.is-added { background: #2d8f3a; }
  .vb-pof__cta-note { font-size: 12px; color: #5c6664; font-weight: 600; }

  @media (max-width: 749px) {
    .vb-pof { padding: 36px 12px; }
    .vb-pof__th { padding: 14px 14px; font-size: 11.5px; }
    .vb-pof__feature { padding: 14px 14px; font-size: 13.5px; width: 38%; }
    .vb-pof__desc { padding: 14px 14px; font-size: 13px; }
    .vb-pof__cta { padding: 13px 26px; font-size: 13.5px; }
  }
</style>

<section class="vb-pof">
  <div class="vb-pof__head">
    <span class="vb-pof__eyebrow">{{ section.settings.eyebrow | default: 'Key benefits' }}</span>
    <h2 class="vb-pof__title">{{ section.settings.title | default: 'Why we outperform' }}</h2>
    {%- if section.settings.sub != blank -%}<p class="vb-pof__sub">{{ section.settings.sub }}</p>{%- endif -%}
  </div>
  <table class="vb-pof__table">
    <thead>
      <tr>
        <th class="vb-pof__th vb-pof__th--brand">{{ section.settings.col_feature | default: 'Feature' }}</th>
        <th class="vb-pof__th">{{ section.settings.col_desc | default: 'Description' }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <tr class="vb-pof__row" {{ block.shopify_attributes }}>
            <td class="vb-pof__feature">{{ block.settings.feature }}</td>
            <td class="vb-pof__desc">{{ block.settings.description }}</td>
          </tr>
        {%- endif -%}
      {%- endfor -%}
    </tbody>
  </table>
  <div class="vb-pof__cta-wrap">
    <button type="button" class="vb-pof__cta" data-vbpof-atc data-variant-id="{{ current_variant.id }}" {% unless current_variant.available %}disabled{% endunless %}>
      🛒 {{ section.settings.cta_text | default: 'Add to Cart' }} →
    </button>
    {%- if section.settings.cta_note != blank -%}<span class="vb-pof__cta-note">{{ section.settings.cta_note }}</span>{%- endif -%}
  </div>
</section>

<script>
  (function(){
    const btn = document.querySelector('.vb-pof [data-vbpof-atc]');
    if (!btn) return;
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const id = btn.dataset.variantId;
      const heroSelected = document.querySelector('.vb-ph input[name="id"]:checked, .vb-ph input[name="id"][type="hidden"]');
      const finalId = heroSelected ? heroSelected.value : id;
      if (!finalId) return;
      const originalText = btn.innerHTML;
      btn.classList.add('is-loading');
      btn.innerHTML = '⏳ Adding...';
      try {
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(finalId), quantity: 1 }] })
        });
        if (!res.ok) throw new Error('Add failed');
        btn.classList.remove('is-loading');
        btn.classList.add('is-added');
        btn.innerHTML = '✓ Added to Cart';
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        const cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer && typeof cartDrawer.open === 'function') cartDrawer.open();
        else if (cartDrawer && cartDrawer.classList) cartDrawer.classList.add('active', 'animate');
        setTimeout(() => { btn.classList.remove('is-added'); btn.innerHTML = originalText; }, 3000);
      } catch (err) {
        btn.classList.remove('is-loading');
        btn.innerHTML = '⚠ Try again';
        setTimeout(() => { btn.innerHTML = originalText; }, 2400);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "VB · Outperform",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "brand_primary", "label": "Brand primary", "default": "#4d8c44" },
    { "type": "color", "id": "brand_dark", "label": "Brand dark", "default": "#36632f" },
    { "type": "color", "id": "brand_tint", "label": "Brand tint", "default": "#f3f7f1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Key benefits" },
    { "type": "text", "id": "title", "label": "Title", "default": "Why we outperform" },
    { "type": "textarea", "id": "sub", "label": "Sub-text" },
    { "type": "text", "id": "col_feature", "label": "Column A label", "default": "Feature" },
    { "type": "text", "id": "col_desc", "label": "Column B label", "default": "Description" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Add to Cart" },
    { "type": "text", "id": "cta_note", "label": "CTA note", "default": "30-day money-back · Free shipping over the free-shipping threshold" }
  ],
  "blocks": [
    { "type": "row", "name": "Feature row", "limit": 12, "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "10 Probiotic Strains" },
      { "type": "textarea", "id": "description", "label": "Description", "default": "Rebalances vaginal flora and reduces harmful bacteria that cause odor." }
    ]}
  ],
  "presets": [{ "name": "VB · Outperform" }]
}
{% endschema %}
