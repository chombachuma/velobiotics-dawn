{% comment %} Velobiotics Lucky Discount Spinner (Wheel v2) - replaces the Omnisend wheel popup. Backend + assets on the Mautic hooks gateway. v2.1: one spin per person ever, known contacts (logged-in customer, Mautic cookie, existing email) never see it, 30-day snooze on close.
   LIVE since 27 Sep 2026 20:25 SAST (preview gate removed). Config mirrors mautic-migration/wheel/theme_snippet.liquid. {% endcomment %}
{% unless customer or request.page_type == 'captcha' or request.path contains '/checkout' or request.path contains '/cart' or request.path contains '/account' %}
<script>(function(){try{
  var za=/\.co\.za$/.test(location.hostname)||'{{ shop.domain }}'.indexOf('.co.za')>-1;
  window.VelobioticsWheelConfig={apiUrl:'https://mautic.velobiotics.com/hooks/wheel/spin',delayMs:15000,dismissDays:30,market:za?'ZA':'US',shopDomain:'{{ shop.permanent_domain }}'};
  var l=document.createElement('link');l.rel='stylesheet';l.href='https://mautic.velobiotics.com/hooks/wheel/wheel.css';document.head.appendChild(l);
  var s=document.createElement('script');s.src='https://mautic.velobiotics.com/hooks/wheel/wheel.js';s.defer=true;document.body.appendChild(s);
}catch(e){}})();</script>
{% endunless %}
