{{ 'vb-reviews.css' | asset_url | stylesheet_tag }}

<section class="vb-reviews">
  <div class="vb-reviews__inner page-width">

    {%- comment -%} Header + aggregate score {%- endcomment -%}
    <div class="vb-reviews__header">
      <p class="vb-section-eyebrow">Real People. Real Results.</p>
      <h2 class="vb-section-h2">Trusted by Thousands. Backed by Science.</h2>

      <div class="vb-reviews__aggregate">
        <div class="vb-reviews__agg-score">
          <span class="vb-reviews__agg-num">4.8</span>
          <div>
            <div class="vb-reviews__agg-stars" aria-label="4.8 out of 5 stars">★★★★★</div>
            <span class="vb-reviews__agg-label">Over 3,500 Verified Reviews</span>
          </div>
        </div>
        <div class="vb-reviews__agg-bars">
          <div class="vb-reviews__bar-row"><span>5★</span><div class="vb-reviews__bar"><div class="vb-reviews__bar-fill" style="width:82%"></div></div><span>82%</span></div>
          <div class="vb-reviews__bar-row"><span>4★</span><div class="vb-reviews__bar"><div class="vb-reviews__bar-fill" style="width:12%"></div></div><span>12%</span></div>
          <div class="vb-reviews__bar-row"><span>3★</span><div class="vb-reviews__bar"><div class="vb-reviews__bar-fill" style="width:4%"></div></div><span>4%</span></div>
          <div class="vb-reviews__bar-row"><span>2★</span><div class="vb-reviews__bar"><div class="vb-reviews__bar-fill" style="width:1%"></div></div><span>1%</span></div>
          <div class="vb-reviews__bar-row"><span>1★</span><div class="vb-reviews__bar"><div class="vb-reviews__bar-fill" style="width:1%"></div></div><span>1%</span></div>
        </div>
      </div>
    </div>

    {%- comment -%} Doctor quote (featured) {%- endcomment -%}
    <div class="vb-reviews__doctor-quote">
      <div class="vb-reviews__dq-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M10 11V7a4 4 0 118 0v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/></svg>
      </div>
      <blockquote class="vb-reviews__dq-text">
        "That's why I love this product! It combines the power of Probiotics and Boric Acid for ultimate female intimate health."
      </blockquote>
      <div class="vb-reviews__dq-author">
        <div class="vb-reviews__dq-avatar" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/><path d="M4 20c0-4 3.58-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
        <div>
          <strong>Dr. Carmen James</strong>
          <span>Medical Doctor</span>
        </div>
        <span class="vb-reviews__dq-verified">🩺 Verified Doctor</span>
      </div>
    </div>

    {%- comment -%} Review card grid {%- endcomment -%}
    <div class="vb-reviews__grid">
      {%- for block in section.blocks -%}
        <div class="vb-reviews__card" {{ block.shopify_attributes }}>
          <div class="vb-reviews__card-top">
            <div class="vb-reviews__card-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- assign r = block.settings.rating | round -%}
              {%- for i in (1..5) -%}
                {%- if i <= r -%}<span class="vb-star--filled">★</span>{%- else -%}<span class="vb-star--empty">★</span>{%- endif -%}
              {%- endfor -%}
            </div>
            {%- if block.settings.verified -%}
              <span class="vb-reviews__card-badge">✅ Verified</span>
            {%- endif -%}
          </div>
          {%- if block.settings.headline != blank -%}
            <p class="vb-reviews__card-headline">"{{ block.settings.headline }}"</p>
          {%- endif -%}
          <p class="vb-reviews__card-body">{{ block.settings.body }}</p>
          <div class="vb-reviews__card-author">
            <div class="vb-reviews__card-avatar" aria-hidden="true">{{ block.settings.author | slice: 0, 1 | upcase }}</div>
            <div>
              <strong>{{ block.settings.author }}</strong>
              {%- if block.settings.product != blank -%}
                <span>on {{ block.settings.product }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="vb-reviews__footer">
      <div class="vb-reviews__trust-line">
        <span>⭐ 4.8 / 5 Store Rating</span>
        <span>•</span>
        <span>🧪 Clinically Studied Strains</span>
        <span>•</span>
        <span>🏭 SAHPRA Certified Manufacturing</span>
        <span>•</span>
        <span>350,000+ Happy Customers</span>
      </div>
      <a href="{{ section.settings.all_reviews_link }}" class="vb-btn vb-btn--ghost vb-btn--md">
        Read More Reviews
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "VB Reviews",
  "tag": "div",
  "class": "vb-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range",    "id": "rating",    "label": "Rating",         "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified",  "label": "Verified buyer", "default": true },
        { "type": "text",     "id": "headline",  "label": "Headline quote", "default": "Life-changing product!" },
        { "type": "textarea", "id": "body",      "label": "Review body",    "default": "I have been using this for 3 months and the difference is remarkable." },
        { "type": "text",     "id": "author",    "label": "Reviewer name",  "default": "Sarah M." },
        { "type": "text",     "id": "product",   "label": "Product name",   "default": "Femina Probiotic" }
      ]
    }
  ],
  "settings": [
    { "type": "url", "id": "all_reviews_link", "label": "All reviews link" }
  ],
  "presets": [
    {
      "name": "VB Reviews",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "headline": "Helped me feel a lot more comfortable", "body": "A lot less bloating and feeling fresh every single day. I've tried other brands and nothing compares to Velobiotics.", "author": "Ashley Barnes", "product": "Femina Probiotic" } },
        { "type": "review", "settings": { "rating": 5, "headline": "Lost 42kgs — the last kg wouldn't budge", "body": "Velo16 helped me lose the last kg. My stomach feels so much lighter and I'm not bloated anymore.", "author": "Nicky vd Westhuizen", "product": "Velo16 Probiotic" } },
        { "type": "review", "settings": { "rating": 5, "headline": "Cookie Fresh is a game changer", "body": "Refreshing confidence that Cookie Fresh gives me helps me feel fresh and stay confident about my feminine hygiene all day long.", "author": "Thandi K.", "product": "Cookie Fresh" } },
        { "type": "review", "settings": { "rating": 5, "headline": "No more itching, no more odor", "body": "You'll never have itching anymore, you'll never have odor anymore. No more bloating — feeling fresh every day!", "author": "Nomsa P.", "product": "Femina Combo" } },
        { "type": "review", "settings": { "rating": 5, "headline": "BioKid is amazing for my kids", "body": "My two children take BioKid daily. Their immunity is so much better since they started — fewer sick days!", "author": "Linda T.", "product": "BioKid Chewables" } },
        { "type": "review", "settings": { "rating": 5, "headline": "GutSlim actually works", "body": "I've been taking GutSlim for 6 weeks. I've lost 4kg and my gut feels incredible. The bloating is completely gone.", "author": "Michelle R.", "product": "GutSlim" } }
      ]
    }
  ]
}
{% endschema %}
