    if(sym==='immunity_low') bump('velo16-probiotics-fulvic-acid',8,'Velo16™ Fulvic Acid — 70+ trace minerals + 16 strains to rebuild your immune defence.');
    if(sym==='skin') bump('probiotics-protein-collagen-peptides-skin-hair-nails',9,'Almasi™ Collagen — Type I & III collagen for skin elasticity, hair growth, nail strength.');
    if(sym==='focus') bump('velo16-probiotics-ashwagandha',7,'Velo16™ Ashwagandha + Lion\'s Mane — clinical adaptogens for brain fog and focus.');
    if(sym==='general'){
      if(sex==='female') bump('her-biotics-original-capsules-60s',8,'Her-Biotics™ Original — your everyday women\'s multivitamin with 16-strain probiotic.');
      if(sex==='male') bump('his-biotics-probiotics-original-multivitamins-capsules-60s',8,'His-Biotics™ Original — your everyday men\'s multivitamin with 16-strain probiotic.');
    }
    if(age==='over60') bump('velo16-probiotics-calcium-magnesium',4,'Velo16™ Calcium & Magnesium — supports bone health, joint comfort, restorative sleep after 60.');
    if(age==='45_60' && sex==='female') bump('velo16-probiotics-ashwagandha',4,'Velo16™ Ashwagandha — eases perimenopausal symptoms and sleep disruption.');
    if(who==='family') bump('family-health-bundle',10,'Family Gut-Health Bundle — Velo16 + Femina + BioKid chewables for the whole household.');
    if(who==='child') bump('family-health-bundle',7,'Family Bundle includes BioKid Chewables — safe daily probiotics for children.');
    const ranked = Object.keys(scores).map(h=>({handle:h,score:scores[h],reason:reasons[h]})).sort((a,b)=>b.score-a.score);
    if(!ranked.length){
      const fb = (sex==='male')?'his-biotics-probiotics-original-multivitamins-capsules-60s':(sex==='female'?'her-biotics-original-capsules-60s':'velo16-probiotic-digestive-capsules');
      ranked.push({handle:fb, score:5, reason:'Our most popular daily probiotic — a safe, effective starting point.'});
    }
    return ranked.slice(0,3);
  }

  function applyGenderFilter(){
    const sex = STATE.answers.sex;
    if(!sex) return;
    $$('.vbq__opt[data-female-only="true"]').forEach(o=>{ o.style.display = (sex==='female') ? '' : 'none'; });
    $$('.vbq__opt[data-male-only="true"]').forEach(o=>{ o.style.display = (sex==='male') ? '' : 'none'; });
  }

  function fillInterstitials(){
    const sex = STATE.answers.sex;
    const goals = Array.isArray(STATE.answers.goal) ? STATE.answers.goal : [];
    if(sex==='female'){
      const e=$('#vbq-i1-emoji'); if(e) e.textContent='🌸';
      const h=$('#vbq-i1-h'); if(h) h.textContent='Welcome.';
      const s=$('#vbq-i1-sub'); if(s) s.textContent='Our women\'s formulations — Femina, Her-Biotics, PregBiotics — are some of the most researched probiotic blends in the world. You\'re in good hands.';
    } else if(sex==='male'){
      const e=$('#vbq-i1-emoji'); if(e) e.textContent='💪';
      const h=$('#vbq-i1-h'); if(h) h.textContent='Welcome.';
      const s=$('#vbq-i1-sub'); if(s) s.textContent='Our His-Biotics + Velo16 men\'s range is built around energy, recovery, and natural testosterone support. Let\'s get you matched.';
    }
    const goalLabels={gut:'gut health',weight:'weight management',intimate:'intimate health',pregnancy:'pregnancy & fertility',energy:'energy & performance',immune:'daily immunity',calm:'calm & sleep',hormone:'hormone vitality',beauty:'skin & beauty',kids:'kids\' wellness'};
    if(goals.length){
      const label=goalLabels[goals[0]]||'wellness';
      const h2=$('#vbq-i2-h'); if(h2) h2.innerHTML='Focused on <span class="vbq__hl">'+label+'</span>?';
      const stats={intimate:'250,000+ women',pregnancy:'12,000+ moms-to-be',weight:'30,000+ on the journey',calm:'80,000+ sleeping better',beauty:'40,000+ glowing'};
      const stat=stats[goals[0]]||'50,000+ globally';
      const st=$('#vbq-i2-stat'); if(st) st.innerHTML='<strong>'+stat+'</strong><small>have walked this path with Velobiotics</small>';
    }
  }

  function render(){
    const steps = $$('.vbq__step');
    steps.forEach(s=> s.classList.remove('is-active'));
    const target = steps[STATE.idx];
    if(target){
      target.classList.add('is-active');
    } else {
      console.warn('[VBQ] step not found at idx', STATE.idx);
    }
    /* Progress bar */
    const showBar = STATE.idx > 0 && STATE.idx < STEPS.length-1;
    const bar = $('#vbq-progress');
    if(bar) bar.classList.toggle('is-on', showBar);
    if(showBar){
      const qCount=['q-who','q-sex','q-age','q-goal','q-symptom','q-diet','q-experience'];
      const cur=STEPS[STATE.idx];
      let qIdx=qCount.indexOf(cur);
      if(qIdx<0){
        for(let i=STATE.idx+1;i<STEPS.length;i++){const nq=qCount.indexOf(STEPS[i]);if(nq>=0){qIdx=nq;break;}}
      }
      if(qIdx<0) qIdx=6;
      const fill=$('#vbq-fill'); if(fill) fill.style.width=((qIdx+1)/7*100)+'%';
      const stp=$('#vbq-step'); if(stp) stp.textContent=Math.min(qIdx+1,7);
    }
    /* Scroll */
    if(root.classList.contains('is-fs')){ root.scrollTop=0; }
    else { try{ window.scrollTo({top:0,behavior:'smooth'}); }catch(e){ window.scrollTo(0,0); } }
  }

  function start(){
    console.log('[VBQ] start');
    track('quiz_started',{});
    document.body.classList.add('vbq-fs');
    root.classList.add('is-fs');
    STATE.idx = 1;
    render();
  }
  function exit(){
    if(!window.confirm('Exit the quiz? Your progress will be lost.')) return;
    document.body.classList.remove('vbq-fs');
    root.classList.remove('is-fs');
    STATE.idx = 0;
    STATE.answers = {};
    $$('.vbq__opt').forEach(o=>o.classList.remove('is-on'));
    $$('.vbq__btn--prime').forEach(b=>{ if(b.id!=='vbq-lead-btn') b.disabled = true; });
    render();
  }
  function next(){
    if(STEPS[STATE.idx]==='q-sex') applyGenderFilter();
    if(STATE.idx+1 < STEPS.length && STEPS[STATE.idx+1].indexOf('inter')===0) fillInterstitials();
    STATE.idx = Math.min(STATE.idx+1, STEPS.length-1);
    render();
    track('quiz_step',{step:STEPS[STATE.idx]});
  }
  function prev(){
    if(STATE.idx>0){ STATE.idx--; render(); }
  }
  function restart(){
    STATE.idx=0; STATE.answers={}; STATE.recs=[];
    $$('.vbq__opt').forEach(o=>o.classList.remove('is-on'));
    $$('.vbq__btn--prime').forEach(b=>{ if(b.id!=='vbq-lead-btn') b.disabled=true; });
    document.body.classList.remove('vbq-fs');
    root.classList.remove('is-fs');
    render();
  }

  /* ---- Option clicks (delegated, scoped to #vbq) ---- */
  root.addEventListener('click', function(e){
    const opt = e.target.closest('.vbq__opt');
    if(opt){
      const step = opt.closest('.vbq__step');
      if(!step) return;
      const key = step.dataset.key;
      const multi = step.dataset.multi==='true';
      const max = parseInt(step.dataset.max||'1',10);
      const val = opt.dataset.val;
      if(multi){
        const existing = Array.isArray(STATE.answers[key]) ? STATE.answers[key] : [];
        if(existing.indexOf(val)>=0){
          STATE.answers[key] = existing.filter(function(v){return v!==val;});
          opt.classList.remove('is-on');
        } else if(existing.length<max){
          STATE.answers[key] = existing.concat([val]);
          opt.classList.add('is-on');
        }
      } else {
        $$('.vbq__opt', step).forEach(function(o){ o.classList.remove('is-on'); });
        opt.classList.add('is-on');
        STATE.answers[key]=val;
      }
      const btn = $('.vbq__btn--prime', step);
      const v = STATE.answers[key];
      const ok = multi ? (Array.isArray(v) && v.length>0) : !!v;
      if(btn) btn.disabled = !ok;
      return;
    }
    /* Action buttons */
    const act = e.target.closest('[data-vbq-action]');
    if(act){
      const a = act.dataset.vbqAction;
      if(a==='next') next();
      else if(a==='prev') prev();
      else if(a==='restart') restart();
      else if(a==='whatsapp') shareWhatsApp();
      else if(a==='copy') copyLink();
    }
  });

  /* ---- Start button (explicit listener — bulletproof) ---- */
  const startBtn = document.getElementById('vbq-start-btn');
  if(startBtn){
    startBtn.addEventListener('click', start);
  } else {
    console.warn('[VBQ] start button not found');
  }
  const exitBtn = document.getElementById('vbq-exit-btn');
  if(exitBtn) exitBtn.addEventListener('click', exit);

  /* ---- Lead form ---- */
  const leadForm = document.getElementById('vbq-lead');
  if(leadForm){
    leadForm.addEventListener('submit', function(e){ e.preventDefault(); submitLead(); });
  }

  async function submitLead(){
    const name = $('#vbq-name').value.trim();
    const email = $('#vbq-email').value.trim();
    if(!name||!email) return;
    STATE.answers.name=name;
    STATE.answers.email=email;
    const btn = $('#vbq-lead-btn'); if(btn){ btn.disabled=true; btn.textContent='Building your stack…'; }
    STATE.recs = recommend(STATE.answers);
    const topProduct = (STATE.recs[0]&&STATE.recs[0].handle)||'';
    const topBrand = topProduct ? ((CATALOG[topProduct]||{}).brand||'') : '';
    track('quiz_lead',{email});
    const apiKey = root.dataset.omnisendKey;
    if(apiKey){
      try {
        await fetch('https://api.omnisend.com/v3/contacts',{
          method:'POST',
          headers:{'Content-Type':'application/json','X-API-KEY':apiKey},
          body: JSON.stringify({
            email, firstName:name, status:'subscribed', statusDate:new Date().toISOString(),
            tags:['quiz_taken','biomatch', topBrand.replace(/[^a-z0-9]/gi,'').toLowerCase(), 'goal_'+(Array.isArray(STATE.answers.goal)?STATE.answers.goal[0]:STATE.answers.goal||'general'), 'sex_'+STATE.answers.sex].filter(Boolean),
            customProperties:{
              quiz_top_product: topProduct, quiz_top_brand: topBrand,
              quiz_goal: (Array.isArray(STATE.answers.goal)?STATE.answers.goal.join(','):STATE.answers.goal)||'',
              quiz_symptom: STATE.answers.symptom||'', quiz_sex: STATE.answers.sex||'',
              quiz_age: STATE.answers.age||'', quiz_who: STATE.answers.who||'',
              quiz_experience: STATE.answers.experience||'',
              quiz_recs: STATE.recs.map(function(r){return r.handle;}).join(',')
            }
          })
        });
      } catch(err){ console.warn('[VBQ] Omnisend submit failed', err); }
    } else {
      try {
        const fd = new FormData();
        fd.append('form_type','customer'); fd.append('utf8','✓');
        fd.append('contact[tags]','quiz_taken,biomatch,'+topBrand.toLowerCase().replace(/[^a-z0-9]/gi,''));
        fd.append('contact[email]',email); fd.append('contact[first_name]',name);
        await fetch('/contact',{method:'POST',body:fd});
      } catch(err){}
    }
    STATE.idx = STEPS.indexOf('loading'); render(); animateLoader();
  }

  function animateLoader(){
    const msgs = ['Analysing your answers…','Matching with our 50+ formulas…','Cross-checking with our doctors…','Finalising your stack…'];
    let i=0;
    const id=setInterval(function(){
      i++;
      if(i>=msgs.length){
        clearInterval(id);
        setTimeout(function(){
          STATE.idx=STEPS.indexOf('results'); render(); renderResults();
          track('quiz_completed',{recs:STATE.recs.map(function(r){return r.handle;}),duration:Math.round((Date.now()-STATE.startTime)/1000)});
        }, 600);
        return;
      }
      const m=$('#vbq-loader-msg'); if(m) m.textContent=msgs[i];
    },700);
  }

  function renderResults(){
    const name = STATE.answers.name||'there';
    const g=$('#vbq-greet'); if(g) g.textContent = name+', here\'s your';
    const goals = Array.isArray(STATE.answers.goal)?STATE.answers.goal.join(' + '):STATE.answers.goal||'';
    const bits=[];
    if(STATE.answers.sex) bits.push(STATE.answers.sex);
    if(STATE.answers.age) bits.push(STATE.answers.age.replace('_','–'));
    if(goals) bits.push('focused on '+goals);
    if(STATE.answers.symptom) bits.push('addressing '+STATE.answers.symptom.replace(/_/g,' '));
    const pr=$('#vbq-profile'); if(pr) pr.innerHTML='<strong>Your profile:</strong> '+bits.join(' · ')+'. Based on your answers and Velobiotics\'s research database, here are the top matches.';
    const rc=$('#vbq-recs'); if(!rc) return;
    rc.innerHTML = STATE.recs.map(function(rec,i){
      const p = CATALOG[rec.handle] || {brand:'Velobiotics', title:rec.handle, price:'', img:''};
      const utm = '?utm_source=quiz&utm_medium=recommendation&utm_campaign=biomatch&utm_content='+rec.handle+'&utm_term=rank-'+(i+1);
      const productUrl = '/products/'+rec.handle+utm;
      return '<div class="vbq__rec '+(i===0?'is-top':'')+'">'+(i===0?'<div class="vbq__rec-rank">★ Best Match</div>':'')+
        '<div class="vbq__rec-img"><img src="'+p.img+'" alt="'+p.title+'" loading="lazy"></div>'+
        '<div class="vbq__rec-body">'+
          '<div class="vbq__rec-brand">'+p.brand+'</div>'+
          '<h3 class="vbq__rec-title">'+p.title+'</h3>'+
          '<p class="vbq__rec-why">'+rec.reason+'</p>'+
          '<a class="vbq__rec-cta" href="'+productUrl+'" onclick="window.VBQ.clickRec(\''+rec.handle+'\','+(i+1)+')">Shop '+p.price+' →</a>'+
          '<a class="vbq__rec-cta-secondary" href="'+productUrl+'">Learn more</a>'+
        '</div></div>';
    }).join('');
  }

  function clickRec(handle, rank){ track('quiz_rec_clicked',{handle:handle, rank:rank}); }
  function shareWhatsApp(){ const msg = encodeURIComponent('I just took the Velobiotics BioMatch and got my personalised wellness plan: '+window.location.href); window.open('https://wa.me/?text='+msg,'_blank'); }
  function copyLink(){ try{ navigator.clipboard.writeText(window.location.href); alert('Link copied!'); }catch(e){ prompt('Copy this link:', window.location.href); } }

  function track(name, props){
    try {
      const payload = Object.assign({event:name, quiz:STATE.quizId, session:STATE.sessionId, ts:Date.now()}, props||{});
      if(window.analytics && window.analytics.publish) window.analytics.publish('vb_quiz_'+name, payload);
      if(window.dataLayer) window.dataLayer.push(Object.assign({event:'vb_quiz_'+name}, payload));
      const log = JSON.parse(localStorage.getItem('vbq_log')||'[]');
      log.push(payload); localStorage.setItem('vbq_log', JSON.stringify(log.slice(-300)));
    } catch(e){}
  }

  /* Expose API */
  window.VBQ = { start:start, next:next, prev:prev, exit:exit, submitLead:submitLead, restart:restart, clickRec:clickRec, shareWhatsApp:shareWhatsApp, copyLink:copyLink, _state: STATE };
  console.log('[VBQ] initialised — '+ STEPS.length +' steps, '+$$('.vbq__step').length+' DOM steps');
})();
</script>

