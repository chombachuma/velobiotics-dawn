{{ 'vb-why-choose.css' | asset_url | stylesheet_tag }}

{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0668/5848/3883/files' -%}

<section class="vb-why">
  <div class="vb-why__inner page-width">

    <div class="vb-why__header">
      <span class="vb-label-tag">Why Choose Velobiotics</span>
      <h2 class="vb-h2">99% of Probiotics Never Make It to Your Gut.</h2>
      <p class="vb-lead">Traditional probiotics break down in stomach acid before they can do any good. Velobiotics uses advanced micro-shield technology to keep probiotics alive — all the way to your gut.</p>
    </div>

    {%- comment -%} Image + reasons split {%- endcomment -%}
    <div class="vb-why__split">
      <div class="vb-why__image-col">
        <img
          src="{{ cdn }}/Patented-PRobiotics-Technology.jpg"
          alt="Patented probiotics technology"
          loading="lazy"
          class="vb-why__img"
          width="970" height="600"
        >
        <div class="vb-why__img-badge">
          <span class="vb-why__img-badge-num">1000×</span>
          <span class="vb-why__img-badge-text">More Probiotics Delivered Alive</span>
        </div>
      </div>

      <div class="vb-why__reasons">
        <div class="vb-why__reason">
          <div class="vb-why__reason-icon">🛡️</div>
          <div>
            <h3>Patented Delivery System</h3>
            <p>Our micro-shield protects probiotics from heat and stomach acid — so billions more reach your gut alive where they can make a real difference.</p>
          </div>
        </div>
        <div class="vb-why__reason">
          <div class="vb-why__reason-icon">🔬</div>
          <div>
            <h3>Clinically Chosen Strains</h3>
            <p>Every probiotic strain we use is backed by research to support gut balance, women's health, and immunity. Not guesswork — science.</p>
          </div>
        </div>
        <div class="vb-why__reason">
          <div class="vb-why__reason-icon">🩺</div>
          <div>
            <h3>Doctor Formulated & Recommended</h3>
            <p>Created and endorsed by medical professionals for safe, daily use by the whole family — from toddlers to adults.</p>
          </div>
        </div>
        <div class="vb-why__reason">
          <div class="vb-why__reason-icon">🌿</div>
          <div>
            <h3>No Fridge. No Fuss. Real Results.</h3>
            <p>Shelf-stable and trusted by 300,000+ South Africans worldwide. Just take it daily and feel the difference within 3–7 days.</p>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} 4 stat counters {%- endcomment -%}
    <div class="vb-why__stats">
      <div class="vb-why__stat">
        <span class="vb-why__stat-num">300K+</span>
        <span class="vb-why__stat-label">Happy Customers</span>
      </div>
      <div class="vb-why__stat">
        <span class="vb-why__stat-num">3,500+</span>
        <span class="vb-why__stat-label">Verified Reviews</span>
      </div>
      <div class="vb-why__stat">
        <span class="vb-why__stat-num">1000×</span>
        <span class="vb-why__stat-label">More Probiotics Delivered</span>
      </div>
      <div class="vb-why__stat">
        <span class="vb-why__stat-num">8</span>
        <span class="vb-why__stat-label">Targeted Probiotic Brands</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "VB Why Choose",
  "tag": "div",
  "class": "vb-section-wrap",
  "settings": [],
  "presets": [{ "name": "VB Why Choose" }]
}
{% endschema %}
