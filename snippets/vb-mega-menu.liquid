  body.vb-mmd-open{overflow:hidden !important}

  /* ============ MOBILE DRAWER COLOR & TYPE BULLETPROOFING ============ */
  /* Boost specificity to beat Dawn header color-scheme inheritance */
  body .vb-mmd,
  body .vb-mmd *,
  body .vb-mmd .vb-mmd__panel,
  body .vb-mmd .vb-mmd__panel * {
    text-transform: none !important;
    letter-spacing: 0.02em !important;
  }
  body .vb-mmd .vb-mmd__item-toggle,
  body .vb-mmd .vb-mmd__item-link,
  body .vb-mmd .vb-mmd__item-toggle > span,
  body .vb-mmd .vb-mmd__item-toggle span {
    color: #1a4015 !important;
    background: transparent !important;
    font-weight: 600 !important;
    font-size: 15px !important;
