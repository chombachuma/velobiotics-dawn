{%- comment -%} VB BreadcrumbList JSON-LD Snippet {%- endcomment -%}
{%- assign vb_bc_about = "new-about-us,custom-about-us" | split: "," -%}
{%- assign vb_bc_page = false -%}{%- if template.name == 'page' and page and vb_bc_about contains page.handle -%}{%- assign vb_bc_page = true -%}{%- endif -%}
{%- if template.name == 'product' or template.name == 'collection' or vb_bc_page -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    }
    {%- if template.name == 'product' and product -%}
      {%- if product.collections.first -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.collections.first.title | json }},
        "item": {{ shop.url | append: product.collections.first.url | json }}
      }
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- else -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- endif -%}
    {%- elsif vb_bc_page -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "The Science",
        "item": {{ shop.url | append: "/pages/microencapsulation-research" | json }}
      }
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ page.title | json }},
        "item": {{ shop.url | append: page.url | json }}
      }
    {%- elsif template.name == 'collection' and collection -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
