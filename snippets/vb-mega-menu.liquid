    .vb-mm__cols{gap:5px 16px !important}
    .vb-mm__col-link{font-size:12px !important;padding:5px 8px !important}
    .vb-mm__feat-title{font-size:15px !important}
  }
</style>

<script>
(function(){
  var nav=document.querySelector('[data-vb-mm]');
  if(nav){
    var triggers=nav.querySelectorAll('[data-vb-mm-trigger]');
    var panels=nav.querySelectorAll('[data-vb-mm-panel]');
    var openIdx=null,hoverTimeout=null,closeTimeout=null;
    var backdrop=document.querySelector('.vb-mm-backdrop');
    if(!backdrop){backdrop=document.createElement('div');backdrop.className='vb-mm-backdrop';document.body.appendChild(backdrop);}
    function open(idx){
      clearTimeout(closeTimeout);
      if(openIdx===idx)return;
      close(false);
      var t=nav.querySelector('[data-vb-mm-trigger="'+idx+'"]');
      var p=nav.querySelector('[data-vb-mm-panel="'+idx+'"]');
      if(!t||!p)return;
      t.setAttribute('aria-expanded','true');p.setAttribute('data-vb-mm-open','true');p.setAttribute('aria-hidden','false');
      backdrop.setAttribute('data-vb-mm-backdrop-open','true');openIdx=idx;
    }
    function close(rb){
      if(rb===undefined)rb=true;
      triggers.forEach(function(t){t.setAttribute('aria-expanded','false');});
      panels.forEach(function(p){p.removeAttribute('data-vb-mm-open');p.setAttribute('aria-hidden','true');});
      if(rb)backdrop.removeAttribute('data-vb-mm-backdrop-open');
      openIdx=null;
    }
    triggers.forEach(function(t){
      t.addEventListener('click',function(e){e.preventDefault();var i=t.dataset.vbMmTrigger;if(openIdx===i)close();else open(i);});
      t.addEventListener('mouseenter',function(){clearTimeout(hoverTimeout);clearTimeout(closeTimeout);var i=t.dataset.vbMmTrigger;hoverTimeout=setTimeout(function(){open(i);},110);});
      t.addEventListener('mouseleave',function(){clearTimeout(hoverTimeout);});
    });
    panels.forEach(function(p){
      p.addEventListener('mouseenter',function(){clearTimeout(closeTimeout);});
      p.addEventListener('mouseleave',function(){closeTimeout=setTimeout(close,180);});
    });
    nav.addEventListener('mouseleave',function(){closeTimeout=setTimeout(close,220);});
    document.addEventListener('click',function(e){if(!nav.contains(e.target)&&openIdx!==null)close();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&openIdx!==null){close();var t=nav.querySelector('[data-vb-mm-trigger="'+openIdx+'"]');if(t)t.focus();}});
    backdrop.addEventListener('click',close);
  }

  var burger=document.querySelector('[data-vb-mm-burger]');
  var drawer=document.querySelector('[data-vb-mm-drawer]');
  if(burger&&drawer){
    var closers=drawer.querySelectorAll('[data-vb-mmd-close]');
    var toggles=drawer.querySelectorAll('[data-vb-mmd-toggle]');
    function dopen(){drawer.setAttribute('data-vb-mmd-open','true');drawer.setAttribute('aria-hidden','false');burger.setAttribute('aria-expanded','true');document.body.classList.add('vb-mmd-open');}
    function dclose(){drawer.removeAttribute('data-vb-mmd-open');drawer.setAttribute('aria-hidden','true');burger.setAttribute('aria-expanded','false');document.body.classList.remove('vb-mmd-open');toggles.forEach(function(t){t.setAttribute('aria-expanded','false');});}
    burger.addEventListener('click',function(){if(drawer.dataset.vbMmdOpen==='true')dclose();else dopen();});
    closers.forEach(function(c){c.addEventListener('click',dclose);});
    drawer.querySelectorAll('a').forEach(function(a){a.addEventListener('click',dclose);});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&drawer.dataset.vbMmdOpen==='true')dclose();});
    toggles.forEach(function(toggle){
      toggle.addEventListener('click',function(){
        var open=toggle.getAttribute('aria-expanded')==='true';
        toggles.forEach(function(t){if(t!==toggle)t.setAttribute('aria-expanded','false');});
        toggle.setAttribute('aria-expanded',open?'false':'true');
      });
    });
  }
})();
</script>
