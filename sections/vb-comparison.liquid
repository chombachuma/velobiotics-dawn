<style>
.vb-cmp { background: #fff; padding: 5rem 1.5rem; }
.vb-cmp__inner { max-width: 1380px; margin: 0 auto; }
.vb-cmp__header { text-align: center; max-width: 680px; margin: 0 auto 3rem; }
.vb-cmp__footer { text-align: center; margin-top: 2.5rem; }

.vb-cmp__table-wrap { overflow-x: auto; border-radius: 1.25rem; border: 1.5px solid var(--vb-green-100); box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
.vb-cmp__table { width: 100%; border-collapse: collapse; }

.vb-cmp__table thead tr { background: var(--vb-green-600); }
.vb-cmp__th-feature {
  text-align: left; padding: 1.25rem 1.5rem;
  font-size: 1rem; font-weight: 700; color: #fff;
  width: 36%;
}
.vb-cmp__th {
  text-align: center; padding: 1.25rem 1rem;
  font-size: 0.95rem; font-weight: 700; color: rgba(255,255,255,0.7);
  width: 21%;
}
.vb-cmp__th--us {
  color: #fff; background: rgba(0,0,0,0.15);
  display: table-cell; /* inline flex doesn't work in table */
}
.vb-cmp__th--us { display: table-cell; vertical-align: middle; }
.vb-cmp__logo {
  display: block; margin: 0 auto 0.4rem;
  width: 44px; height: 44px; object-fit: contain;
  background: #fff; border-radius: 8px; padding: 2px;
}
.vb-cmp__th span { display: block; }

.vb-cmp__feature {
  padding: 1rem 1.5rem;
  font-size: 1rem; color: var(--vb-neutral-800);
  border-bottom: 1px solid #eaeaea;
}
.vb-cmp__cell {
  text-align: center;
  padding: 1rem; vertical-align: middle;
  border-bottom: 1px solid #eaeaea;
  font-size: 1.3rem;
}
.vb-cmp__cell--us { background: rgba(77,140,68,0.04); }
.vb-cmp__row-alt td { background: #fafafa; }
.vb-cmp__row-alt .vb-cmp__cell--us { background: rgba(77,140,68,0.07); }
.vb-cmp__check { color: var(--vb-green-600); font-size: 1.5rem; font-weight: 800; }
.vb-cmp__cross { color: #dc2626; font-size: 1.5rem; font-weight: 800; }
</style>

{% schema %}
{
  "name": "VB Comparison Table",
  "tag": "div",
  "class": "vb-section-wrap",
  "settings": [],
  "presets": [{ "name": "VB Comparison Table" }]
}
{% endschema %}
