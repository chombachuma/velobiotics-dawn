{%- comment -%} VB · Confidence stats — animated percentage progress bars with strong fill contrast {%- endcomment -%}

{%- liquid
  assign brand_primary = section.settings.brand_primary | default: '#4d8c44'
  assign brand_tint = section.settings.brand_tint | default: '#f3f7f1'
  assign brand_dark = section.settings.brand_dark | default: '#36632f'
-%}

<style>
  .vb-pcf { padding: 72px 24px; --bp: {{ brand_primary }}; --bt: {{ brand_tint }}; --bd: {{ brand_dark }}; background: var(--bt); }
  .vb-pcf__inner { max-width: 1080px; margin: 0 auto; }
  .vb-pcf__head { text-align: center; max-width: 760px; margin: 0 auto 40px; }
  .vb-pcf__eyebrow { display: inline-block; color: var(--bp); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-pcf__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 12px; }
  .vb-pcf__title em { color: var(--bp); font-style: normal; }
  .vb-pcf__sub { font-size: 15.5px; line-height: 1.6; color: #5c6664; margin: 0; }
  .vb-pcf__list { display: grid; gap: 18px; }
  .vb-pcf__row { display: grid; grid-template-columns: 1.4fr 2fr auto; gap: 22px; align-items: center; padding: 18px 22px; background: #fff; border: 1px solid color-mix(in srgb, var(--bp) 18%, transparent); border-radius: 16px; transition: transform 0.22s ease, box-shadow 0.22s ease; }
  .vb-pcf__row:hover { transform: translateY(-2px); box-shadow: 0 14px 28px color-mix(in srgb, var(--bp) 18%, transparent); }
  .vb-pcf__label { font-size: 15px; font-weight: 700; color: #1a1a1a; line-height: 1.3; }
  .vb-pcf__bar { position: relative; height: 20px; background: color-mix(in srgb, var(--bp) 8%, #fff); border-radius: 999px; overflow: hidden; box-shadow: inset 0 2px 4px rgba(0,0,0,0.08); border: 1px solid color-mix(in srgb, var(--bp) 14%, transparent); }
  .vb-pcf__fill { display: block; height: 100%; background: linear-gradient(90deg, var(--bd) 0%, var(--bp) 60%, var(--bp) 100%); border-radius: 999px; width: 0; transition: width 1.8s cubic-bezier(0.22, 0.61, 0.36, 1); box-shadow: 0 1px 6px color-mix(in srgb, var(--bp) 40%, transparent); }
  .vb-pcf__pct { font-size: 24px; font-weight: 900; color: var(--bp); letter-spacing: -0.02em; min-width: 64px; text-align: right; }
  .vb-pcf__caveat { margin-top: 18px; text-align: center; font-size: 11.5px; color: #6c7a6b; }

  @media (max-width: 749px) {
    .vb-pcf { padding: 48px 14px; }
    .vb-pcf__head { margin-bottom: 24px; }
    .vb-pcf__list { gap: 12px; }
    .vb-pcf__row { grid-template-columns: 1fr auto; grid-template-rows: auto auto; padding: 14px 16px; border-radius: 14px; gap: 8px 16px; }
    .vb-pcf__label { font-size: 13.5px; grid-column: 1; grid-row: 1; }
    .vb-pcf__pct { font-size: 19px; min-width: 48px; grid-column: 2; grid-row: 1; }
    .vb-pcf__bar { grid-column: 1 / -1; grid-row: 2; height: 14px; }
  }
</style>

<section class="vb-pcf" data-vb-confidence>
  <div class="vb-pcf__inner">
    <div class="vb-pcf__head">
      {%- if section.settings.eyebrow != blank -%}<p class="vb-pcf__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vb-pcf__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
      {%- if section.settings.sub != blank -%}<p class="vb-pcf__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <div class="vb-pcf__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="vb-pcf__row" {{ block.shopify_attributes }}>
            <div class="vb-pcf__label">{{ block.settings.label }}</div>
            <div class="vb-pcf__bar"><div class="vb-pcf__fill" data-target="{{ block.settings.percent | default: 80 }}"></div></div>
            <div class="vb-pcf__pct">{{ block.settings.percent | default: 80 }}%</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.caveat != blank -%}<p class="vb-pcf__caveat">{{ section.settings.caveat }}</p>{%- endif -%}
  </div>
</section>

<script>
  (function(){
    const root = document.querySelector('[data-vb-confidence]');
    if (!root) return;
    const fills = root.querySelectorAll('.vb-pcf__fill');
    const animate = () => fills.forEach(f => { f.style.width = (f.dataset.target || 80) + '%'; });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((ents) => {
        ents.forEach(e => { if (e.isIntersecting) { animate(); io.disconnect(); } });
      }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
      io.observe(root);
    } else animate();
    setTimeout(animate, 1500);
  })();
</script>

{% schema %}
{
  "name": "VB · Confidence stats",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "color", "id": "brand_primary", "label": "Brand primary", "default": "#4d8c44" },
    { "type": "color", "id": "brand_dark", "label": "Brand dark", "default": "#36632f" },
    { "type": "color", "id": "brand_tint", "label": "Brand tint", "default": "#f3f7f1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real results" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "Trusted for" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Everyday Confidence" },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "What women report after 4 weeks of daily Femina use." },
    { "type": "text", "id": "caveat", "label": "Caveat", "default": "Based on a survey of 1,300+ verified customers. Individual results may vary." }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat row", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Reported daily freshness" },
      { "type": "range", "id": "percent", "label": "Percent", "min": 10, "max": 100, "step": 1, "default": 90 }
    ]}
  ],
  "presets": [{ "name": "VB · Confidence stats" }]
}
{% endschema %}
