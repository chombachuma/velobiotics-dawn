<style>
  :root{--g:#4d8c44;--g2:#2e5d28;--g3:#6fae65;--tint:#eef7ec;--tint2:#e3f0df;--cream:#fdf9f1;--ink:#1a2e1a;--mute:#5a6b5a;--line:#e3eadf;--warm:#f6b26b;--r:18px}
  .vbq{font-family:Poppins,'Helvetica Neue',Arial,sans-serif;color:var(--ink);background:var(--cream);min-height:100vh}
  .vbq *{box-sizing:border-box}
  .vbq__serif{font-family:'Playfair Display',Georgia,serif}
  .vbq__hl{color:var(--g);font-style:italic;font-family:'Playfair Display',Georgia,serif}
  /* ---------- top bar ---------- */
  .vbq__bar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:14px;padding:10px 18px;background:rgba(253,249,241,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .vbq__bar img{height:30px;width:auto;display:block}
  .vbq__bar-spacer{flex:1}
  .vbq__bar-back{font-size:13px;color:var(--mute);text-decoration:none}
  .vbq__bar-back:hover{color:var(--g)}
  .vbq__exit{display:none;border:0;background:transparent;font-size:20px;color:var(--mute);cursor:pointer;padding:4px 8px}
  .vbq.is-quiz .vbq__exit{display:block}
  .vbq.is-quiz .vbq__bar-back{display:none}
  /* ---------- steps ---------- */
  .vbq__steps{display:none;max-width:760px;margin:22px auto 0;padding:0 18px}
  .vbq.is-quiz .vbq__steps{display:block}
  .vbq__dots{display:flex;align-items:center;justify-content:space-between;position:relative}
  .vbq__dots:before{content:"";position:absolute;left:18px;right:18px;top:15px;height:3px;background:var(--line);z-index:0}
  .vbq__dots-fill{position:absolute;left:18px;top:15px;height:3px;background:var(--g);z-index:1;transition:width .4s ease}
  .vbq__dot{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:6px;flex:1}
  .vbq__dot i{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#fff;border:3px solid var(--line);font-size:13px;font-weight:700;color:var(--mute);transition:all .3s}
  .vbq__dot span{font-size:11px;color:var(--mute);letter-spacing:.02em;white-space:nowrap}
  .vbq__dot.is-done i{background:var(--g);border-color:var(--g);color:#fff}
  .vbq__dot.is-on i{border-color:var(--g);color:var(--g);box-shadow:0 0 0 5px var(--tint)}
  .vbq__dot.is-on span{color:var(--g2);font-weight:700}
  .vbq__qcount{margin:12px 0 0;text-align:center;font-size:12px;color:var(--mute)}
  .vbq__qcount b{color:var(--g2)}
  @media (max-width:560px){.vbq__dot span{display:none}.vbq__dot.is-on span{display:block;position:absolute;top:36px}}
  /* ---------- hero (landing) ---------- */
  .vbq__hero{position:relative;overflow:hidden;min-height:calc(100vh - 52px);display:grid;grid-template-columns:1.1fr .9fr;align-items:center;max-width:1180px;margin:0 auto;padding:40px 24px;gap:32px}
  .vbq__hero-copy{position:relative;z-index:2}
  .vbq__eyebrow{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--g2)}
  .vbq__eyebrow:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--g)}
  .vbq__title{font-size:clamp(38px,5.4vw,66px);line-height:1.02;margin:18px 0 14px;font-weight:800;letter-spacing:-.02em}
  .vbq__sub{font-size:17px;line-height:1.6;color:var(--mute);max-width:520px;margin:0 0 22px}
  .vbq__cta{display:inline-flex;align-items:center;gap:10px;background:var(--g);color:#fff;border:0;border-radius:999px;padding:18px 34px;font-size:17px;font-weight:700;cursor:pointer;box-shadow:0 12px 30px rgba(77,140,68,.28);transition:transform .15s,box-shadow .15s}
  .vbq__cta:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(77,140,68,.34)}
  .vbq__facts{display:flex;flex-wrap:wrap;gap:10px 20px;margin:20px 0 0;font-size:13.5px;color:var(--ink)}
  .vbq__facts span{display:inline-flex;align-items:center;gap:7px}
  .vbq__how{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:30px 0 0;max-width:560px}
  .vbq__how div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px 12px 12px;font-size:12.5px;line-height:1.4;color:var(--mute)}
  .vbq__how b{display:block;color:var(--ink);font-size:13px;margin:6px 0 2px}
  .vbq__how em{font-style:normal;font-size:22px;display:block}
  .vbq__hero-art{position:relative;z-index:1}
  .vbq__hero-art img{width:100%;height:auto;border-radius:28px;display:block;box-shadow:0 30px 60px rgba(26,46,26,.18)}
  .vbq__hero-badge{position:absolute;left:-14px;bottom:26px;background:#fff;border-radius:16px;padding:12px 16px;box-shadow:0 12px 30px rgba(26,46,26,.14);font-size:13px;display:flex;gap:10px;align-items:center}
  .vbq__hero-badge b{display:block;font-size:15px;color:var(--g2)}
  .vbq__trust{max-width:1180px;margin:0 auto;padding:0 24px 40px;display:flex;flex-wrap:wrap;gap:12px 28px;justify-content:center;font-size:13px;color:var(--mute)}
  @media (max-width:860px){.vbq__hero{grid-template-columns:1fr;min-height:0;padding:28px 18px 10px}.vbq__hero-art{order:-1}.vbq__hero-art img{max-height:260px;object-fit:cover}.vbq__hero-badge{left:10px;bottom:-14px}.vbq__how{grid-template-columns:1fr 1fr 1fr;gap:8px}.vbq__how div{padding:10px}}
  /* ---------- question stage ---------- */
  .vbq__stage{max-width:760px;margin:0 auto;padding:26px 18px 60px}
  .vbq__card{animation:vbqIn .35s ease both}
  @keyframes vbqIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .vbq__qlabel{display:inline-block;background:var(--tint);color:var(--g2);font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;padding:6px 12px;border-radius:999px}
  .vbq__h{font-size:clamp(28px,4vw,42px);line-height:1.1;margin:14px 0 8px;font-weight:800;letter-spacing:-.01em}
  .vbq__help{font-size:15px;color:var(--mute);margin:0 0 22px;line-height:1.55}
  .vbq__opts{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .vbq__opts.is-3{grid-template-columns:repeat(3,1fr)}
  @media (max-width:560px){.vbq__opts,.vbq__opts.is-3{grid-template-columns:1fr}}
  .vbq__opt{display:flex;align-items:center;gap:14px;text-align:left;background:#fff;border:2px solid var(--line);border-radius:16px;padding:14px 16px;cursor:pointer;transition:all .15s;font:inherit;color:var(--ink);position:relative}
  .vbq__opt:hover{border-color:var(--g3);transform:translateY(-1px);box-shadow:0 8px 20px rgba(26,46,26,.06)}
  .vbq__opt.is-on{border-color:var(--g);background:var(--tint)}
  .vbq__opt-ico{width:46px;height:46px;border-radius:14px;background:var(--tint);display:grid;place-items:center;font-size:24px;flex:none}
  .vbq__opt.is-on .vbq__opt-ico{background:#fff}
  .vbq__opt-t{font-weight:700;font-size:15.5px;line-height:1.25}
  .vbq__opt-s{font-size:12.5px;color:var(--mute);margin-top:2px;line-height:1.35}
  .vbq__opt-chk{margin-left:auto;width:22px;height:22px;border-radius:50%;border:2px solid var(--line);flex:none;display:grid;place-items:center;font-size:12px;color:#fff}
  .vbq__opt.is-on .vbq__opt-chk{background:var(--g);border-color:var(--g)}
  .vbq__opt.is-on .vbq__opt-chk:after{content:"✓"}
  .vbq__nav{display:flex;align-items:center;gap:14px;margin-top:22px}
  .vbq__back{border:0;background:transparent;color:var(--mute);font:inherit;font-size:14px;cursor:pointer;padding:10px 6px}
  .vbq__next{flex:1;border:0;border-radius:999px;background:var(--g);color:#fff;font:inherit;font-weight:700;font-size:16px;padding:16px 22px;cursor:pointer;transition:opacity .15s}
  .vbq__next:disabled{opacity:.4;cursor:not-allowed}
  .vbq__hint{font-size:12.5px;color:var(--mute);margin-top:10px;text-align:center}
  .vbq__react{margin-top:16px;background:#fff;border-left:4px solid var(--g);border-radius:12px;padding:10px 14px;font-size:14px;color:var(--ink);animation:vbqIn .3s ease both}
  /* ---------- lead ---------- */
  .vbq__lead{max-width:560px;margin:0 auto}
  .vbq__field{margin:0 0 12px}
  .vbq__field label{display:block;font-size:12.5px;font-weight:700;color:var(--mute);margin:0 0 6px}
  .vbq__input{width:100%;border:2px solid var(--line);border-radius:14px;padding:15px 16px;font:inherit;font-size:16px;background:#fff}
  .vbq__input:focus{outline:0;border-color:var(--g)}
  .vbq__legal{font-size:12px;color:var(--mute);text-align:center;margin:10px 0 0;line-height:1.5}
  .vbq__legal a{color:var(--g)}
  .vbq__gift{display:flex;gap:12px;align-items:center;background:var(--tint);border-radius:14px;padding:12px 14px;margin:0 0 18px;font-size:13.5px}
  .vbq__gift em{font-style:normal;font-size:26px}
  .vbq__prev{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0 0 18px}
  .vbq__prev div{background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px;text-align:center;font-size:12px;color:var(--mute)}
  .vbq__prev b{display:block;font-size:20px}
  /* ---------- loader ---------- */
  .vbq__loader{max-width:460px;margin:40px auto;text-align:center}
  .vbq__ring{width:92px;height:92px;border-radius:50%;border:8px solid var(--tint2);border-top-color:var(--g);margin:0 auto 20px;animation:vbqSpin 1s linear infinite}
  @keyframes vbqSpin{to{transform:rotate(360deg)}}
  .vbq__check{list-style:none;padding:0;margin:0;text-align:left;display:inline-block}
  .vbq__check li{padding:6px 0;color:var(--mute);font-size:14.5px;opacity:.45;transition:opacity .3s}
  .vbq__check li.is-on{opacity:1;color:var(--ink)}
  .vbq__check li.is-on:before{content:"✓ ";color:var(--g);font-weight:700}
  /* ---------- results ---------- */
  .vbq__res{max-width:900px;margin:0 auto;padding:26px 18px 70px}
  .vbq__chips{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 22px}
  .vbq__chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 12px;font-size:12.5px;color:var(--ink)}
  .vbq__chip b{color:var(--g2)}
  .vbq__report{display:grid;grid-template-columns:96px 1fr;gap:16px;align-items:center;background:linear-gradient(135deg,var(--g2),var(--g));color:#fff;border-radius:var(--r);padding:18px 20px;margin:0 0 22px}
  .vbq__report-ico{width:96px;height:120px;background:#fff;border-radius:8px;box-shadow:0 10px 24px rgba(0,0,0,.2);position:relative;overflow:hidden}
  .vbq__report-ico:before{content:"";position:absolute;left:0;right:0;top:0;height:28px;background:var(--g)}
  .vbq__report-ico:after{content:"";position:absolute;left:10px;right:10px;top:40px;height:6px;border-radius:3px;background:var(--line);box-shadow:0 14px 0 var(--line),0 28px 0 var(--line),0 42px 0 var(--tint2),0 56px 0 var(--tint2)}
  .vbq__report h3{margin:0 0 6px;font-size:20px;line-height:1.2}
  .vbq__report p{margin:0 0 12px;font-size:13.5px;opacity:.95;line-height:1.5}
  .vbq__report-btns{display:flex;flex-wrap:wrap;gap:8px}
  .vbq__rbtn{display:inline-block;background:#fff;color:var(--g2);text-decoration:none;font-weight:700;font-size:13.5px;padding:10px 16px;border-radius:999px}
  .vbq__rbtn--ghost{background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.5)}
  @media (max-width:560px){.vbq__report{grid-template-columns:1fr}.vbq__report-ico{display:none}}
  .vbq__code{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;background:var(--tint);border:1px dashed var(--g);border-radius:14px;padding:14px 18px;margin:0 0 22px}
  .vbq__code-l{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--g2);font-weight:700}
  .vbq__code-v{font-size:22px;letter-spacing:.06em;color:var(--g2);font-weight:800}
  .vbq__code-r{font-size:13px;color:var(--mute);flex-basis:100%}
  .vbq__recs{display:grid;grid-template-columns:1fr;gap:14px}
  .vbq__rec{display:grid;grid-template-columns:160px 1fr;gap:18px;background:#fff;border:2px solid var(--line);border-radius:var(--r);padding:18px;position:relative}
  .vbq__rec.is-top{border-color:var(--g);box-shadow:0 18px 40px rgba(77,140,68,.14)}
  .vbq__rank{position:absolute;top:-12px;left:18px;background:var(--g);color:#fff;font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;padding:5px 12px;border-radius:999px}
  .vbq__rec.is-top .vbq__rank{background:var(--warm);color:var(--ink)}
  .vbq__rec-img{background:var(--cream);border-radius:14px;display:grid;place-items:center;padding:10px;min-height:160px}
  .vbq__rec-img img{max-width:100%;max-height:170px;object-fit:contain;mix-blend-mode:multiply}
  .vbq__rec-brand{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--g2);font-weight:700}
  .vbq__rec-title{margin:4px 0 6px;font-size:20px;line-height:1.2}
  .vbq__rec-why{font-size:14px;color:var(--ink);line-height:1.55;margin:0 0 8px}
  .vbq__rec-ing{font-size:12.5px;color:var(--mute);margin:0 0 12px;line-height:1.5}
  .vbq__rec-ing b{color:var(--ink)}
  .vbq__rec-fit{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--mute);margin:0 0 12px}
  .vbq__fitbar{flex:1;height:8px;background:var(--tint2);border-radius:4px;overflow:hidden;max-width:180px}
  .vbq__fitbar i{display:block;height:100%;background:var(--g);border-radius:4px}
  .vbq__rec-cta{display:inline-block;background:var(--g);color:#fff;text-decoration:none;font-weight:700;font-size:14.5px;padding:12px 20px;border-radius:999px;margin-right:8px}
  .vbq__rec-cta2{display:inline-block;color:var(--g2);text-decoration:none;font-weight:700;font-size:13.5px;padding:12px 10px}
  @media (max-width:560px){.vbq__rec{grid-template-columns:1fr}.vbq__rec-img{min-height:0}.vbq__rec-img img{max-height:130px}}
  .vbq__share{margin:26px 0 0;text-align:center;font-size:13px;color:var(--mute)}
  .vbq__share a{display:inline-block;margin:8px 6px 0;padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--ink);text-decoration:none;font-size:13px;cursor:pointer}
  .vbq__foot{text-align:center;font-size:11.5px;color:var(--mute);padding:0 18px 30px;line-height:1.6}
  /* distractions */
  #omnisend-forms-wrapper,.omnisend-form-wrapper,[id^="omnisend-form"],#zipchat-root,[id*="zipchat"],[class*="zipchat"],#judgeme_floating_tab,.jdgm-floating-tab{display:none !important}
</style>

<div class="vbq" id="vbq" data-version="2.0">
