{%- comment -%} VB · Vertical Timeline — alternating left/right milestones with year markers {%- endcomment -%}

<style>
  .vb-tl { padding: 56px 20px; max-width: 1080px; margin: 0 auto; background: linear-gradient(180deg, #f3f7f1 0%, #fff 100%); }
  .vb-tl__head { text-align: center; max-width: 760px; margin: 0 auto 48px; }
  .vb-tl__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; padding: 6px 13px; background: rgba(77, 140, 68, 0.1); border-radius: 999px; }
  .vb-tl__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; letter-spacing: -0.02em; }
  .vb-tl__title em { color: #4d8c44; font-style: normal; }
  .vb-tl__sub { font-size: 16px; line-height: 1.6; color: #5c6664; margin: 0; }

  .vb-tl__line { position: relative; padding: 20px 0; }
  .vb-tl__line::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 3px; background: linear-gradient(180deg, #4d8c44 0%, #6ec56e 50%, #4d8c44 100%); transform: translateX(-50%); border-radius: 3px; }

  .vb-tl__node { position: relative; margin: 0 0 36px; min-height: 80px; }
  .vb-tl__node:last-child { margin-bottom: 0; }
  .vb-tl__dot { position: absolute; left: 50%; top: 28px; transform: translate(-50%, 0); width: 22px; height: 22px; background: #fff; border: 4px solid #4d8c44; border-radius: 50%; z-index: 2; box-shadow: 0 4px 14px rgba(77, 140, 68, 0.3); }
  .vb-tl__year { position: absolute; left: 50%; top: -10px; transform: translateX(-50%); background: #4d8c44; color: #fff; padding: 4px 14px; border-radius: 999px; font-size: 13px; font-weight: 900; letter-spacing: 0.04em; box-shadow: 0 4px 14px rgba(77, 140, 68, 0.3); z-index: 3; }

  .vb-tl__card { width: calc(50% - 40px); background: #fff; border-radius: 16px; padding: 18px 22px 20px; box-shadow: 0 6px 18px rgba(0,0,0,0.06); border: 1px solid #e3ece1; position: relative; }
  .vb-tl__card::before { content: ''; position: absolute; top: 24px; width: 14px; height: 14px; background: #fff; border: 2px solid #e3ece1; transform: rotate(45deg); }
  .vb-tl__node--left .vb-tl__card { float: left; }
  .vb-tl__node--left .vb-tl__card::before { right: -9px; border-left: none; border-bottom: none; }
  .vb-tl__node--right .vb-tl__card { float: right; }
  .vb-tl__node--right .vb-tl__card::before { left: -9px; border-right: none; border-top: none; }
  .vb-tl__node::after { content: ''; display: table; clear: both; }

  .vb-tl__heading { font-size: 17px; font-weight: 800; color: #1a1a1a; margin: 0 0 6px; line-height: 1.3; }
  .vb-tl__heading em { color: #4d8c44; font-style: normal; }
  .vb-tl__text { font-size: 13.5px; line-height: 1.55; color: #5c6664; margin: 0; }

  @media (max-width: 749px) {
    .vb-tl { padding: 36px 14px; }
    .vb-tl__head { margin-bottom: 32px; }
    .vb-tl__line::before { left: 24px; }
    .vb-tl__node { margin-bottom: 24px; min-height: auto; padding-left: 60px; }
    .vb-tl__dot { left: 24px; }
    .vb-tl__year { left: 24px; transform: translateX(-50%); top: -8px; font-size: 11px; padding: 3px 10px; }
    .vb-tl__card { width: 100%; padding: 14px 16px 16px; }
    .vb-tl__card::before { display: none; }
    .vb-tl__node--left .vb-tl__card, .vb-tl__node--right .vb-tl__card { float: none; }
    .vb-tl__heading { font-size: 15.5px; }
    .vb-tl__text { font-size: 13px; }
  }
</style>

<section class="vb-tl">
  <div class="vb-tl__head">
    {%- if section.settings.eyebrow != blank -%}<span class="vb-tl__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="vb-tl__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
    {%- if section.settings.sub != blank -%}<p class="vb-tl__sub">{{ section.settings.sub }}</p>{%- endif -%}
  </div>
  <div class="vb-tl__line">
    {%- for block in section.blocks -%}
      {%- if block.type == 'milestone' -%}
        {%- assign pos = 'right' -%}
        {%- assign idx = forloop.index | modulo: 2 -%}
        {%- if idx == 1 -%}{%- assign pos = 'left' -%}{%- endif -%}
        <div class="vb-tl__node vb-tl__node--{{ pos }}" {{ block.shopify_attributes }}>
          <span class="vb-tl__dot"></span>
          {%- if block.settings.year != blank -%}<span class="vb-tl__year">{{ block.settings.year }}</span>{%- endif -%}
          <div class="vb-tl__card">
            <h3 class="vb-tl__heading">{{ block.settings.heading }}</h3>
            <p class="vb-tl__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "VB · Timeline",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Journey" },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "From an idea" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "to 1000× delivery." },
    { "type": "textarea", "id": "sub", "label": "Subtitle", "default": "The story of Velobiotics, one milestone at a time." }
  ],
  "blocks": [
    { "type": "milestone", "name": "Milestone", "settings": [
      { "type": "text", "id": "year", "label": "Year", "default": "2018" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Milestone" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Description of this milestone." }
    ]}
  ],
  "presets": [{ "name": "VB · Timeline" }]
}
{% endschema %}
