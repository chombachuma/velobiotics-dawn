{%- comment -%} VB Quiz — Velobiotics Personalised Wellness Check {%- endcomment -%}
<style>
  .vbq{--g:#4d8c44;--g2:#2e5d28;--cream:#fdf9f1;--ink:#1a2e1a;--mute:#5a6b5a;--border:#e8efe6;--tint:#eef7ec;font-family:'Open Sans','Inter',system-ui,sans-serif;background:linear-gradient(180deg,#fdf9f1 0%,#fff 100%);min-height:100vh;color:var(--ink)}
  .vbq__shell{max-width:680px;margin:0 auto;padding:48px 20px 80px}
  .vbq__bar{height:6px;background:#eee;border-radius:6px;overflow:hidden;margin-bottom:32px}
  .vbq__bar-fill{height:100%;background:linear-gradient(90deg,var(--g),var(--g2));transition:width .5s cubic-bezier(.4,0,.2,1)}
  .vbq__step{display:none;animation:vbqfade .4s ease}
  .vbq__step.is-active{display:block}
  @keyframes vbqfade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .vbq__eyebrow{display:inline-block;background:var(--tint);color:var(--g2);padding:6px 14px;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:20px}
  .vbq__h{font-family:'Playfair Display',Georgia,serif;font-size:clamp(28px,5vw,44px);line-height:1.15;margin:0 0 12px;font-weight:700}
  .vbq__h .vbq__hl{color:var(--g);font-style:italic}
  .vbq__sub{font-size:18px;line-height:1.55;color:var(--mute);margin:0 0 32px;max-width:540px}
  .vbq__opts{display:grid;gap:12px;margin-bottom:24px}
  .vbq__opts.cols-2{grid-template-columns:repeat(2,1fr)}
  .vbq__opts.cols-3{grid-template-columns:repeat(3,1fr)}
  @media (max-width:640px){.vbq__opts.cols-2,.vbq__opts.cols-3{grid-template-columns:1fr}}
  .vbq__opt{display:flex;align-items:center;gap:14px;padding:18px 20px;background:#fff;border:2px solid var(--border);border-radius:14px;cursor:pointer;font-weight:600;font-size:16px;color:var(--ink);text-align:left;transition:all .2s;user-select:none}
  .vbq__opt:hover{border-color:var(--g);background:var(--tint);transform:translateY(-2px);box-shadow:0 8px 24px rgba(77,140,68,.18)}
  .vbq__opt.is-on{border-color:var(--g);background:var(--tint);box-shadow:0 4px 16px rgba(77,140,68,.2)}
  .vbq__opt-icon{font-size:24px;flex-shrink:0}
  .vbq__opt-text{flex:1}
  .vbq__opt-text small{display:block;font-weight:400;color:var(--mute);font-size:13px;margin-top:2px}
  .vbq__check{width:22px;height:22px;border:2px solid #ccc;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.2s}
  .vbq__opt.is-on .vbq__check{background:var(--g);border-color:var(--g)}
  .vbq__opt.is-on .vbq__check::after{content:'';width:8px;height:14px;border:solid #fff;border-width:0 3px 3px 0;transform:rotate(45deg);margin-top:-3px}
  .vbq__nav{display:flex;gap:12px;align-items:center;margin-top:28px}
  .vbq__btn{appearance:none;border:none;cursor:pointer;font-weight:700;font-size:16px;padding:16px 32px;border-radius:12px;transition:.2s;font-family:inherit;display:inline-flex;align-items:center;gap:8px}
  .vbq__btn--prime{background:var(--g);color:#fff;flex:1;justify-content:center}
  .vbq__btn--prime:hover:not(:disabled){background:var(--g2);transform:translateY(-2px);box-shadow:0 8px 20px rgba(77,140,68,.3)}
  .vbq__btn--prime:disabled{opacity:.4;cursor:not-allowed}
  .vbq__btn--ghost{background:transparent;color:var(--mute);padding:16px 20px}
  .vbq__btn--ghost:hover{color:var(--g)}
  .vbq__input{width:100%;padding:16px 20px;border:2px solid var(--border);border-radius:12px;font-size:16px;font-family:inherit;background:#fff;transition:.2s;color:var(--ink)}
  .vbq__input:focus{outline:none;border-color:var(--g);box-shadow:0 0 0 4px rgba(77,140,68,.12)}
  .vbq__field{margin-bottom:16px}
  .vbq__field label{display:block;font-weight:600;font-size:14px;margin-bottom:6px;color:var(--ink)}
  .vbq__legal{font-size:13px;color:var(--mute);line-height:1.5;margin-top:12px}
  .vbq__legal a{color:var(--g);text-decoration:underline}
  /* Hero / start screen */
  .vbq__hero{text-align:center;padding-top:24px}
  .vbq__badges{display:flex;justify-content:center;gap:24px;margin-top:36px;flex-wrap:wrap}
  .vbq__badge{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--mute);font-weight:600}
  .vbq__badge-icon{width:32px;height:32px;background:var(--tint);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px}
  /* Loading screen */
  .vbq__loader{text-align:center;padding:48px 0}
  .vbq__spinner{width:64px;height:64px;border:5px solid var(--tint);border-top-color:var(--g);border-radius:50%;margin:0 auto 24px;animation:vbqspin 1s linear infinite}
  @keyframes vbqspin{to{transform:rotate(360deg)}}
  .vbq__loader-msg{font-size:18px;font-weight:600;color:var(--g2);margin:0}
  /* Results */
  .vbq__results-header{text-align:center;margin-bottom:36px}
  .vbq__profile{background:var(--tint);border:1px solid #d8e8d4;border-radius:16px;padding:20px;margin-bottom:32px;font-size:15px;color:var(--ink);line-height:1.6}
  .vbq__profile strong{color:var(--g2)}
  .vbq__rec{background:#fff;border:2px solid var(--border);border-radius:18px;padding:24px;margin-bottom:20px;display:flex;gap:20px;align-items:flex-start;position:relative;overflow:hidden}
  .vbq__rec.is-top{border-color:var(--g);box-shadow:0 12px 36px rgba(77,140,68,.16)}
  .vbq__rec-rank{position:absolute;top:0;right:0;background:var(--g);color:#fff;padding:6px 14px;border-bottom-left-radius:12px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .vbq__rec-img{width:120px;height:120px;flex-shrink:0;background:#f6f6f4;border-radius:12px;overflow:hidden;display:flex;align-items:center;justify-content:center}
  .vbq__rec-img img{width:100%;height:100%;object-fit:contain}
  .vbq__rec-body{flex:1;min-width:0}
  .vbq__rec-brand{font-size:12px;font-weight:700;color:var(--g);text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px}
  .vbq__rec-title{font-size:18px;font-weight:700;color:var(--ink);margin:0 0 8px;line-height:1.3}
  .vbq__rec-why{font-size:14px;color:var(--mute);line-height:1.5;margin:0 0 12px}
  .vbq__rec-why strong{color:var(--ink)}
  .vbq__rec-cta{display:inline-flex;align-items:center;gap:6px;background:var(--g);color:#fff;padding:10px 18px;border-radius:8px;font-weight:700;font-size:14px;text-decoration:none;transition:.2s}
  .vbq__rec-cta:hover{background:var(--g2);transform:translateY(-1px);color:#fff}
  .vbq__rec-cta-secondary{display:inline-block;margin-left:12px;font-size:13px;color:var(--mute);text-decoration:underline}
  @media (max-width:640px){.vbq__rec{flex-direction:column;align-items:stretch}.vbq__rec-img{width:100%;height:200px}}
  .vbq__share{text-align:center;margin-top:32px;padding-top:24px;border-top:1px solid var(--border)}
  .vbq__share p{margin:0 0 12px;color:var(--mute);font-size:14px}
  .vbq__share-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .vbq__share-btn{padding:10px 18px;background:var(--tint);border:1px solid #d8e8d4;border-radius:8px;color:var(--g2);text-decoration:none;font-size:13px;font-weight:600;cursor:pointer}
  .vbq__share-btn:hover{background:var(--g);color:#fff}
  /* Multi-select hint */
  .vbq__hint{font-size:13px;color:var(--mute);margin:-12px 0 16px;font-style:italic}
</style>

<div class="vbq" id="vbq" data-omnisend-key="{{ section.settings.omnisend_api_key }}" data-collection-handle="{{ section.settings.fallback_collection | default: 'all' }}">
  <div class="vbq__shell">
    <div class="vbq__bar" id="vbq-bar" style="display:none"><div class="vbq__bar-fill" id="vbq-fill" style="width:0%"></div></div>

    {%- comment -%} ============ STEP 0: HERO START ============ {%- endcomment -%}
    <section class="vbq__step is-active vbq__hero" data-step="start">
      <div class="vbq__eyebrow">{{ section.settings.eyebrow | default: 'The Velobiotics V-Check' }}</div>
      <h1 class="vbq__h">{{ section.settings.hero_title_pre | default: 'Find your' }} <span class="vbq__hl">{{ section.settings.hero_title_highlight | default: 'perfect probiotic' }}</span>.</h1>
      <p class="vbq__sub">{{ section.settings.hero_sub | default: '7 quick questions. 60 seconds. A personalised recommendation from our gut-health doctors — backed by the Velobiotics™ MEP science.' }}</p>
      <button class="vbq__btn vbq__btn--prime" onclick="VBQ.next()" style="max-width:320px;width:100%">{{ section.settings.cta_start | default: 'Start the V-Check →' }}</button>
      <div class="vbq__badges">
        <div class="vbq__badge"><div class="vbq__badge-icon">⏱</div> 60 seconds</div>
        <div class="vbq__badge"><div class="vbq__badge-icon">🩺</div> Doctor-built</div>
        <div class="vbq__badge"><div class="vbq__badge-icon">💚</div> 100% free</div>
      </div>
    </section>

    {%- comment -%} ============ STEP 1: WHO ============ {%- endcomment -%}
    <section class="vbq__step" data-step="q" data-key="who">
      <div class="vbq__eyebrow">Question 1 of 7</div>
      <h2 class="vbq__h">Who is this <span class="vbq__hl">for?</span></h2>
      <p class="vbq__sub">We'll tailor every recommendation to the right person.</p>
      <div class="vbq__opts cols-2">
        <button class="vbq__opt" data-val="myself"><span class="vbq__opt-icon">👤</span><span class="vbq__opt-text">Myself</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="partner"><span class="vbq__opt-icon">💑</span><span class="vbq__opt-text">My Partner</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="child"><span class="vbq__opt-icon">👶</span><span class="vbq__opt-text">My Child</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="family"><span class="vbq__opt-icon">👨‍👩‍👧</span><span class="vbq__opt-text">Whole Family</span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button class="vbq__btn vbq__btn--ghost" onclick="VBQ.prev()">← Back</button><button class="vbq__btn vbq__btn--prime" onclick="VBQ.next()" disabled>Continue</button></div>
    </section>

    {%- comment -%} ============ STEP 2: SEX ============ {%- endcomment -%}
    <section class="vbq__step" data-step="q" data-key="sex">
      <div class="vbq__eyebrow">Question 2 of 7</div>
      <h2 class="vbq__h">Tell us about <span class="vbq__hl">biological sex.</span></h2>
      <p class="vbq__sub">Some of our formulations are body-specific — this helps us match the right one.</p>
      <div class="vbq__opts cols-3">
        <button class="vbq__opt" data-val="female"><span class="vbq__opt-icon">♀</span><span class="vbq__opt-text">Female</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="male"><span class="vbq__opt-icon">♂</span><span class="vbq__opt-text">Male</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="any"><span class="vbq__opt-icon">⚧</span><span class="vbq__opt-text">Prefer not to say</span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button class="vbq__btn vbq__btn--ghost" onclick="VBQ.prev()">← Back</button><button class="vbq__btn vbq__btn--prime" onclick="VBQ.next()" disabled>Continue</button></div>
    </section>

    {%- comment -%} ============ STEP 3: AGE ============ {%- endcomment -%}
    <section class="vbq__step" data-step="q" data-key="age">
      <div class="vbq__eyebrow">Question 3 of 7</div>
      <h2 class="vbq__h">What is your <span class="vbq__hl">age range?</span></h2>
      <p class="vbq__sub">Nutritional needs shift with every life stage.</p>
      <div class="vbq__opts cols-2">
        <button class="vbq__opt" data-val="under18"><span class="vbq__opt-icon">🧒</span><span class="vbq__opt-text">Under 18 <small>BioKid range</small></span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="18_30"><span class="vbq__opt-icon">🌱</span><span class="vbq__opt-text">18 – 30 <small>Early adult</small></span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="30_45"><span class="vbq__opt-icon">⚡</span><span class="vbq__opt-text">30 – 45 <small>Peak years</small></span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="45_60"><span class="vbq__opt-icon">🌿</span><span class="vbq__opt-text">45 – 60 <small>Hormone shift</small></span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="over60"><span class="vbq__opt-icon">🌟</span><span class="vbq__opt-text">60+ <small>Ageless wellness</small></span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button class="vbq__btn vbq__btn--ghost" onclick="VBQ.prev()">← Back</button><button class="vbq__btn vbq__btn--prime" onclick="VBQ.next()" disabled>Continue</button></div>
    </section>

    {%- comment -%} ============ STEP 4: PRIMARY GOAL ============ {%- endcomment -%}
    <section class="vbq__step" data-step="q" data-key="goal" data-multi="true" data-max="2">
      <div class="vbq__eyebrow">Question 4 of 7</div>
      <h2 class="vbq__h">What's your <span class="vbq__hl">top wellness goal?</span></h2>
      <p class="vbq__sub">Pick up to 2 — we'll prioritise these.</p>
      <p class="vbq__hint">You can select 2 goals.</p>
      <div class="vbq__opts cols-2">
        <button class="vbq__opt" data-val="gut"><span class="vbq__opt-icon">🦠</span><span class="vbq__opt-text">Gut & digestion</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="weight"><span class="vbq__opt-icon">⚖️</span><span class="vbq__opt-text">Weight management</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="intimate"><span class="vbq__opt-icon">🌸</span><span class="vbq__opt-text">Intimate health</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="pregnancy"><span class="vbq__opt-icon">🤰</span><span class="vbq__opt-text">Pregnancy & fertility</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="energy"><span class="vbq__opt-icon">⚡</span><span class="vbq__opt-text">Energy & performance</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="immune"><span class="vbq__opt-icon">🛡️</span><span class="vbq__opt-text">Immunity & daily wellness</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="calm"><span class="vbq__opt-icon">🧘</span><span class="vbq__opt-text">Calm, sleep & focus</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="hormone"><span class="vbq__opt-icon">🌡️</span><span class="vbq__opt-text">Hormone & vitality</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="beauty"><span class="vbq__opt-icon">✨</span><span class="vbq__opt-text">Skin, hair & nails</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="kids"><span class="vbq__opt-icon">👶</span><span class="vbq__opt-text">Kids' wellness</span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button class="vbq__btn vbq__btn--ghost" onclick="VBQ.prev()">← Back</button><button class="vbq__btn vbq__btn--prime" onclick="VBQ.next()" disabled>Continue</button></div>
    </section>

    {%- comment -%} ============ STEP 5: SYMPTOM ============ {%- endcomment -%}
    <section class="vbq__step" data-step="q" data-key="symptom">
      <div class="vbq__eyebrow">Question 5 of 7</div>
      <h2 class="vbq__h">What's bothering you <span class="vbq__hl">the most?</span></h2>
      <p class="vbq__sub">Pick the one symptom that feels most urgent right now.</p>
      <div class="vbq__opts cols-2">
        <button class="vbq__opt" data-val="bloat"><span class="vbq__opt-icon">💨</span><span class="vbq__opt-text">Bloating / digestion</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="fatigue"><span class="vbq__opt-icon">😴</span><span class="vbq__opt-text">Low energy / fatigue</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="stress"><span class="vbq__opt-icon">😰</span><span class="vbq__opt-text">Stress / poor sleep</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="bv_yeast"><span class="vbq__opt-icon">🌸</span><span class="vbq__opt-text">Recurring BV / yeast</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="pms"><span class="vbq__opt-icon">💢</span><span class="vbq__opt-text">PMS / menopause</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="weight_stuck"><span class="vbq__opt-icon">📉</span><span class="vbq__opt-text">Weight won't shift</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="immunity_low"><span class="vbq__opt-icon">🤒</span><span class="vbq__opt-text">Getting sick often</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="skin"><span class="vbq__opt-icon">✨</span><span class="vbq__opt-text">Skin / hair issues</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="focus"><span class="vbq__opt-icon">🧠</span><span class="vbq__opt-text">Brain fog</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="general"><span class="vbq__opt-icon">💚</span><span class="vbq__opt-text">Just want a daily multi</span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button class="vbq__btn vbq__btn--ghost" onclick="VBQ.prev()">← Back</button><button class="vbq__btn vbq__btn--prime" onclick="VBQ.next()" disabled>Continue</button></div>
    </section>

    {%- comment -%} ============ STEP 6: DIET ============ {%- endcomment -%}
    <section class="vbq__step" data-step="q" data-key="diet" data-multi="true" data-max="4">
      <div class="vbq__eyebrow">Question 6 of 7</div>
      <h2 class="vbq__h">Any dietary <span class="vbq__hl">preferences?</span></h2>
      <p class="vbq__sub">All Velobiotics products are SAHPRA-compliant. This just helps us flag formulations.</p>
      <p class="vbq__hint">Select all that apply.</p>
      <div class="vbq__opts cols-2">
        <button class="vbq__opt" data-val="none"><span class="vbq__opt-icon">🍽️</span><span class="vbq__opt-text">No restrictions</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="vegan"><span class="vbq__opt-icon">🌱</span><span class="vbq__opt-text">Vegan / Vegetarian</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="halaal"><span class="vbq__opt-icon">☪️</span><span class="vbq__opt-text">Halaal</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="gluten_free"><span class="vbq__opt-icon">🌾</span><span class="vbq__opt-text">Gluten-free</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="dairy_free"><span class="vbq__opt-icon">🥛</span><span class="vbq__opt-text">Dairy / lactose-free</span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="pregnant"><span class="vbq__opt-icon">🤰</span><span class="vbq__opt-text">Pregnant / breastfeeding</span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button class="vbq__btn vbq__btn--ghost" onclick="VBQ.prev()">← Back</button><button class="vbq__btn vbq__btn--prime" onclick="VBQ.next()" disabled>Continue</button></div>
    </section>

    {%- comment -%} ============ STEP 7: EXPERIENCE ============ {%- endcomment -%}
    <section class="vbq__step" data-step="q" data-key="experience">
      <div class="vbq__eyebrow">Question 7 of 7</div>
      <h2 class="vbq__h">Have you tried <span class="vbq__hl">probiotics before?</span></h2>
      <p class="vbq__sub">We'll tune the explanation to where you're starting from.</p>
      <div class="vbq__opts cols-3">
        <button class="vbq__opt" data-val="new"><span class="vbq__opt-icon">🌱</span><span class="vbq__opt-text">Never <small>I'm new to this</small></span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="tried"><span class="vbq__opt-icon">🤔</span><span class="vbq__opt-text">Tried some <small>Didn't work</small></span><span class="vbq__check"></span></button>
        <button class="vbq__opt" data-val="experienced"><span class="vbq__opt-icon">💪</span><span class="vbq__opt-text">Daily user <small>Looking to upgrade</small></span><span class="vbq__check"></span></button>
      </div>
      <div class="vbq__nav"><button class="vbq__btn vbq__btn--ghost" onclick="VBQ.prev()">← Back</button><button class="vbq__btn vbq__btn--prime" onclick="VBQ.next()" disabled>See my results →</button></div>
    </section>

    {%- comment -%} ============ STEP 8: LEAD CAPTURE ============ {%- endcomment -%}
    <section class="vbq__step" data-step="lead">
      <div class="vbq__eyebrow">Almost there</div>
      <h2 class="vbq__h">Where should we send your <span class="vbq__hl">personalised plan?</span></h2>
      <p class="vbq__sub">{{ section.settings.lead_sub | default: 'Get your recommendation plus a free 7-day gut reset email series, science guides, and exclusive subscriber pricing.' }}</p>
      <form id="vbq-lead" onsubmit="event.preventDefault();VBQ.submitLead()">
        <div class="vbq__field"><label for="vbq-name">Your first name</label><input class="vbq__input" type="text" id="vbq-name" required placeholder="e.g. Lerato"></div>
        <div class="vbq__field"><label for="vbq-email">Email address</label><input class="vbq__input" type="email" id="vbq-email" required placeholder="you@example.com"></div>
        <button type="submit" class="vbq__btn vbq__btn--prime" style="width:100%" id="vbq-lead-btn">Show my recommendation →</button>
        <p class="vbq__legal">By continuing you agree to receive emails from Velobiotics. Unsubscribe anytime. We respect your privacy — see our <a href="/policies/privacy-policy">privacy policy</a>.</p>
      </form>
    </section>

    {%- comment -%} ============ STEP 9: LOADING ============ {%- endcomment -%}
    <section class="vbq__step" data-step="loading">
      <div class="vbq__loader">
        <div class="vbq__spinner"></div>
        <p class="vbq__loader-msg" id="vbq-loader-msg">Analysing your answers…</p>
      </div>
    </section>

    {%- comment -%} ============ STEP 10: RESULTS ============ {%- endcomment -%}
    <section class="vbq__step" data-step="results">
      <div class="vbq__results-header">
        <div class="vbq__eyebrow">Your V-Check Results</div>
        <h2 class="vbq__h"><span id="vbq-greet">Here's your</span> <span class="vbq__hl">personalised stack</span>.</h2>
      </div>
      <div class="vbq__profile" id="vbq-profile"></div>
      <div id="vbq-recs"></div>
      <div class="vbq__share">
        <p>Share your V-Check or save for later</p>
        <div class="vbq__share-btns">
          <a class="vbq__share-btn" href="javascript:VBQ.shareWhatsApp()">📱 WhatsApp</a>
          <a class="vbq__share-btn" href="javascript:VBQ.copyLink()">🔗 Copy link</a>
          <a class="vbq__share-btn" href="javascript:VBQ.restart()">↻ Retake quiz</a>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
(function(){
  /* ============================================================
   * VB Quiz Engine — recommendation scoring + UTM + Omnisend
   * ============================================================ */
  const STEPS = ['start','who','sex','age','goal','symptom','diet','experience','lead','loading','results'];
  const STATE = { idx:0, answers:{}, recs:[], startTime:Date.now(), quizId:'v-check-2026', sessionId:null };
  const $ = (s,c=document)=>c.querySelector(s);
  const $$ = (s,c=document)=>Array.from(c.querySelectorAll(s));

  /* ---- Product catalogue (handle → metadata) ---- */
  const CATALOG = {
    'femina-probiotic-capsules-with-cranberry-for-women': {brand:'Femina™', title:'Femina™ Probiotic Capsules + Cranberry', price:'R 299.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/FEMINA-60s.jpg?v=1775328667'},
    'femina-probiotics-cookie-fresh-with-boric-acid-suppositories': {brand:'Femina™', title:'Femina™ Cookie Fresh Boric+Probiotic Suppositories', price:'R 399.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Front-Femina-COOKIE-FRESH-Transparent.png?v=1775328725'},
    'femina-intimate-starter-pack': {brand:'Femina™', title:'Femina Intimate Reset Kit (Starter)', price:'R 619.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/FeminaIntimateHealthStarterPack.png?v=1775328667'},
    'femina-ph-self-test-kit-for-vaginal-infections': {brand:'Femina™', title:'Femina Self-Test pH Kit', price:'R 199.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Femina-Kit-1000x1336.jpg?v=1772290471'},
    'femina-mini-combo': {brand:'Femina™', title:'Femina Mini Combo', price:'R 359.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/WhatsApp-Image-2024-10-07-at-11.50.30_8a2e6af9-da3e-4803-8e73-eda725942526.jpg?v=1775328725'},
    'her-biotics-original-capsules-60s': {brand:'Her-Biotics™', title:'Her-Biotics™ Original Multivitamin', price:'R 299.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/4_transparent_Realistic_3D_product_mockup_2.png?v=1775328607'},
    'his-biotics-probiotics-original-multivitamins-capsules-60s': {brand:'His-Biotics™', title:'His-Biotics™ Original Multivitamin', price:'R 349.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/1_transparent_Realistic_3D_product_mockup_5.png?v=1775328665'},
    'velo16-probiotic-digestive-capsules': {brand:'Velo16™', title:'Velo16™ Probiotic Digestive Capsules', price:'R 299.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/VELO16-60s.jpg?v=1775328668'},
    'velo16-probiotics-ashwagandha': {brand:'Velo16™', title:'Velo16™ Ashwagandha KSM-66', price:'R 299.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/AshwagandhaRealistic3DFrontView.png?v=1775328608'},
    'velo16-probiotics-calcium-magnesium': {brand:'Velo16™', title:'Velo16™ Calcium & Magnesium', price:'R 299.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Calcium_MagnesiumRealistic3DFrontView.png?v=1775328607'},
    'velo16-probiotics-fulvic-acid': {brand:'Velo16™', title:'Velo16™ Fulvic Acid', price:'R 349.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/FulvicAcidRealistic3DFrontView.png?v=1775328666'},
    'gutslim-probiotics-tummy-toner': {brand:'GutSlim™', title:'GutSlim™ Tummy Toner', price:'R 349.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Tummy_Toner.jpg?v=1775328667'},
    '14-day-gut-reboot-starter-pack': {brand:'GutSlim™', title:'14-Day GutSlim Reboot Starter Pack', price:'R 799.50', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/14_Day_Gut_Reboot_Right-Facing.png?v=1775328667'},
    '6-week-total-transformation-pack': {brand:'GutSlim™', title:'6-Week GutSlim Transformation Pack', price:'R 1 990.50', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/6-wk_-_Right_Facing.png?v=1775328668'},
    'probiotics-protein-collagen-peptides-skin-hair-nails': {brand:'Almasi™', title:'Almasi™ Collagen Peptides 30s', price:'R 269.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Collagen_30_Capsules-1000x1000-1.png?v=1775328607'},
    'her-glow-combo': {brand:'Her-Biotics™', title:'Her Glow Combo', price:'R 569.90', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Concept49-Editable11.png?v=1775328606'},
    'c-essentials-kit': {brand:'PregBiotics™', title:'TC-Essentials Pregnancy Kit', price:'R 509.90', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Concept3-Editable11_6.png?v=1775328607'},
    'calm-nights-bundle-magnesium-glycinate-ashwagandha-gut-calm-support': {brand:'Velo16™', title:'Calm Nights Bundle (Magnesium + Ashwagandha)', price:'R 509.92', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Velo16_probioticsupplementbundle_36686f53-aae5-46dd-8fd9-a2fc1524dfd7.png?v=1775328607'},
    'family-health-bundle': {brand:'Family', title:'Family Gut-Health Bundle', price:'R 764.87', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Family_Health_Bundle_2.png?v=1775328666'},
    'femina-combo-care': {brand:'Femina™', title:'Femina Combo Care', price:'R 499.95', img:'https://cdn.shopify.com/s/files/1/0668/5848/3883/files/Femina_Combo_Care_1.png?v=1775328668'}
  };

  /* ---- Recommendation engine ---- */
  function recommend(a){
    /* Scoring map: each (signal, value) → list of {handle, score, reason} */
    const scores = {};   // handle → total score
    const reasons = {};  // handle → reason chosen
    const sex = a.sex || 'any';
    const goals = Array.isArray(a.goal) ? a.goal : (a.goal ? [a.goal] : []);
    const goal = goals[0];
    const sym = a.symptom;
    const age = a.age;
    const who = a.who;
    const exp = a.experience;

    function bump(handle, n, why){
      scores[handle] = (scores[handle] || 0) + n;
      if(!reasons[handle] || n >= 5) reasons[handle] = why;
    }

    /* --- Goal-based scoring --- */
    goals.forEach(g=>{
      if(g==='gut') { bump('velo16-probiotic-digestive-capsules', 8, 'Velo16™ Probiotic Digestive Capsules — daily 16-strain probiotic for gut comfort, less bloat, better digestion.'); }
      if(g==='weight'){ bump('gutslim-probiotics-tummy-toner', 8, 'GutSlim™ Tummy Toner — GLP-1-style appetite control + probiotic synergy for weight management.'); bump('14-day-gut-reboot-starter-pack', 5, '14-Day GutSlim Reboot — kick-start the metabolism with a structured 2-week reset.'); }
      if(g==='intimate' && sex==='female'){ bump('femina-probiotic-capsules-with-cranberry-for-women', 10, 'Femina™ Probiotic Capsules + Cranberry — daily vaginal pH balance, UTI defence, BV/yeast prevention.'); }
      if(g==='pregnancy' && sex==='female'){ bump('c-essentials-kit', 10, 'TC-Essentials Pregnancy Kit — pre-conception through breastfeeding, OB-GYN-approved.'); }
      if(g==='energy'){ bump('his-biotics-probiotics-original-multivitamins-capsules-60s', 6, 'His-Biotics™ Original — daily multivitamin engineered for male energy and recovery.'); if(sex==='female') bump('her-biotics-original-capsules-60s', 8, 'Her-Biotics™ Original — daily multivitamin tuned to female biology with iron and B-complex for energy.'); }
      if(g==='immune'){ bump('velo16-probiotics-fulvic-acid', 7, 'Velo16™ Fulvic Acid — mineral-rich daily immune booster with 16-strain probiotic.'); }
      if(g==='calm'){ bump('velo16-probiotics-ashwagandha', 9, 'Velo16™ Ashwagandha KSM-66 — clinical-grade adaptogen for stress, sleep, and mental calm.'); bump('calm-nights-bundle-magnesium-glycinate-ashwagandha-gut-calm-support', 6, 'Calm Nights Bundle — Magnesium + Ashwagandha stacked for deep restorative sleep.'); }
      if(g==='hormone'){ if(sex==='female') bump('her-biotics-original-capsules-60s', 8, 'Her-Biotics™ Original — hormone-cycle support for women with iron, B6, and probiotics.'); else bump('his-biotics-probiotics-original-multivitamins-capsules-60s', 8, 'His-Biotics™ Original — testosterone-supporting zinc, D3 and 16-strain probiotic blend.'); }
      if(g==='beauty'){ bump('probiotics-protein-collagen-peptides-skin-hair-nails', 10, 'Almasi™ Collagen Peptides — protein collagen for skin glow, hair strength, nail health.'); if(sex==='female') bump('her-glow-combo', 7, 'Her Glow Combo — Her-Biotics + Collagen for the complete beauty-from-within stack.'); }
      if(g==='kids'){ bump('family-health-bundle', 9, 'Family Gut-Health Bundle — Velo16 + Femina + BioKid chewables for the whole house.'); }
    });

    /* --- Symptom overrides --- */
    if(sym==='bloat') bump('velo16-probiotic-digestive-capsules', 6, 'Velo16™ Probiotic Digestive Capsules — targeted relief for bloating, gas, and slow digestion.');
    if(sym==='fatigue' && sex==='female') bump('her-biotics-original-capsules-60s', 7, 'Her-Biotics™ Original — iron + B-complex specifically dosed for women fighting fatigue.');
    if(sym==='fatigue' && sex==='male') bump('his-biotics-probiotics-original-multivitamins-capsules-60s', 7, 'His-Biotics™ Original — zinc, D3, and 16-strain probiotic to restore daily energy.');
    if(sym==='stress'){ bump('velo16-probiotics-ashwagandha', 9, 'Velo16™ Ashwagandha — KSM-66 clinically lowers cortisol and improves sleep within 4 weeks.'); bump('velo16-probiotics-calcium-magnesium', 5, 'Velo16™ Calcium & Magnesium — magnesium glycinate for muscle relaxation and deep sleep.'); }
    if(sym==='bv_yeast'){ bump('femina-probiotics-cookie-fresh-with-boric-acid-suppositories', 10, 'Femina™ Cookie Fresh with Boric — gold-standard acute BV/yeast treatment, OB-GYN-endorsed.'); bump('femina-intimate-starter-pack', 8, 'Femina Intimate Reset Kit — pH test + Cookie Fresh + daily Femina capsules in one starter.'); }
    if(sym==='pms'){ bump('her-biotics-original-capsules-60s', 6, 'Her-Biotics™ Original — daily hormone-cycle support with iron, B6, and magnesium.'); bump('velo16-probiotics-ashwagandha', 5, 'Velo16™ Ashwagandha — eases PMS mood swings and menopausal hot flashes.'); }
    if(sym==='weight_stuck'){ bump('gutslim-probiotics-tummy-toner', 8, 'GutSlim™ Tummy Toner — GLP-1 booster + probiotics restart stalled weight loss.'); bump('14-day-gut-reboot-starter-pack', 6, '14-Day GutSlim Reboot — proven 2-week kick-start for stubborn weight plateaus.'); }
    if(sym==='immunity_low') bump('velo16-probiotics-fulvic-acid', 8, 'Velo16™ Fulvic Acid — 70+ trace minerals + 16 strains to rebuild your immune defence.');
    if(sym==='skin'){ bump('probiotics-protein-collagen-peptides-skin-hair-nails', 9, 'Almasi™ Collagen — Type I & III collagen for skin elasticity, hair growth, nail strength.'); }
    if(sym==='focus') bump('velo16-probiotics-ashwagandha', 7, 'Velo16™ Ashwagandha + Lion\'s Mane — clinical adaptogens for brain fog and focus.');
    if(sym==='general'){ if(sex==='female') bump('her-biotics-original-capsules-60s', 8, 'Her-Biotics™ Original — your everyday women\'s multivitamin with 16-strain probiotic.'); else bump('his-biotics-probiotics-original-multivitamins-capsules-60s', 8, 'His-Biotics™ Original — your everyday men\'s multivitamin with 16-strain probiotic.'); }

    /* --- Age modifiers --- */
    if(age==='over60') bump('velo16-probiotics-calcium-magnesium', 4, 'Velo16™ Calcium & Magnesium — supports bone health, joint comfort, and restorative sleep after 60.');
    if(age==='45_60' && sex==='female') bump('velo16-probiotics-ashwagandha', 4, 'Velo16™ Ashwagandha — eases perimenopausal symptoms and sleep disruption.');

    /* --- Who modifier (Family) --- */
    if(who==='family') bump('family-health-bundle', 10, 'Family Gut-Health Bundle — Velo16 + Femina + BioKid Chewables in one box for the whole household.');
    if(who==='child') bump('family-health-bundle', 7, 'Family Bundle includes BioKid Chewables — safe daily probiotics for children.');

    /* --- Sort and pick top 3 --- */
    const ranked = Object.keys(scores).filter(h=>CATALOG[h]).map(h=>({handle:h,score:scores[h],reason:reasons[h]})).sort((a,b)=>b.score-a.score);
    /* Always at least 1 result */
    if(ranked.length===0){
      ranked.push({handle:'velo16-probiotic-digestive-capsules',score:5,reason:CATALOG['velo16-probiotic-digestive-capsules'] ? 'Velo16™ Digestive Capsules — our most popular daily probiotic, the right starting point for anyone.' : ''});
    }
    return ranked.slice(0,3);
  }

  /* ---- UI navigation ---- */
  function render(){
    $$('.vbq__step').forEach(s=>s.classList.remove('is-active'));
    const cur = STATE.idx;
    const stepEl = $$('.vbq__step')[cur];
    if(stepEl) stepEl.classList.add('is-active');
    /* Progress bar */
    const showBar = cur > 0 && cur < 8;
    $('#vbq-bar').style.display = showBar ? 'block':'none';
    if(showBar) $('#vbq-fill').style.width = ((cur)/7*100)+'%';
    window.scrollTo({top:0,behavior:'smooth'});
  }
  function next(){ if(STATE.idx === 7){ goLead(); return;} STATE.idx++; render(); track('quiz_step', {step:STEPS[STATE.idx]}); }
  function prev(){ if(STATE.idx>0){ STATE.idx--; render(); }}
  function goLead(){ STATE.idx = 8; render(); track('quiz_step',{step:'lead'}); }
  function goLoading(){ STATE.idx = 9; render(); animateLoader(); }
  function goResults(){ STATE.idx = 10; render(); renderResults(); track('quiz_completed',{ recs: STATE.recs.map(r=>r.handle), duration: Math.round((Date.now()-STATE.startTime)/1000) }); }
  function animateLoader(){
    const msgs = ['Analysing your answers…','Matching with 50+ products…','Cross-checking with our doctors…','Finalising your stack…'];
    let i=0;
    const id=setInterval(()=>{
      i++;
      if(i>=msgs.length){clearInterval(id); STATE.recs = recommend(STATE.answers); setTimeout(goResults, 600); return;}
      $('#vbq-loader-msg').textContent = msgs[i];
    },700);
  }

  /* ---- Option click handlers ---- */
  document.addEventListener('click', e=>{
    const opt = e.target.closest('.vbq__opt');
    if(!opt) return;
    const step = opt.closest('.vbq__step');
    if(!step) return;
    const key = step.dataset.key;
    const multi = step.dataset.multi === 'true';
    const max = parseInt(step.dataset.max || '1');
    const val = opt.dataset.val;
    if(multi){
      const existing = Array.isArray(STATE.answers[key]) ? STATE.answers[key] : [];
      if(existing.includes(val)){
        STATE.answers[key] = existing.filter(v=>v!==val);
        opt.classList.remove('is-on');
      } else if(existing.length < max){
        STATE.answers[key] = [...existing, val];
        opt.classList.add('is-on');
      }
    } else {
      step.querySelectorAll('.vbq__opt').forEach(o=>o.classList.remove('is-on'));
      opt.classList.add('is-on');
      STATE.answers[key] = val;
    }
    /* Enable Continue button */
    const btn = step.querySelector('.vbq__btn--prime');
    const v = STATE.answers[key];
    const ok = multi ? (Array.isArray(v) && v.length>0) : !!v;
    if(btn) btn.disabled = !ok;
  });

  /* ---- Lead submit + Omnisend ---- */
  async function submitLead(){
    const name = $('#vbq-name').value.trim();
    const email = $('#vbq-email').value.trim();
    if(!name || !email) return;
    STATE.answers.name = name;
    STATE.answers.email = email;
    const btn = $('#vbq-lead-btn');
    btn.disabled = true;
    btn.textContent = 'Building your stack…';
    track('quiz_lead', {email: email});
    /* Compute recs first so we can tag the contact */
    STATE.recs = recommend(STATE.answers);
    const topBrand = (STATE.recs[0] && CATALOG[STATE.recs[0].handle]) ? CATALOG[STATE.recs[0].handle].brand : '';
    /* Send to Omnisend */
    const apiKey = $('#vbq').dataset.omnisendKey;
    if(apiKey){
      try {
        await fetch('https://api.omnisend.com/v3/contacts', {
          method:'POST',
          headers:{'Content-Type':'application/json', 'X-API-KEY': apiKey},
          body: JSON.stringify({
            email,
            firstName: name,
            status:'subscribed',
            statusDate: new Date().toISOString(),
            tags:['quiz_taken','v-check', topBrand.replace(/[^a-z0-9]/gi,'').toLowerCase(), 'goal_'+(STATE.answers.goal||[''])[0]||'general'].filter(Boolean),
            customProperties:{ quiz_top_product: STATE.recs[0]?.handle, quiz_top_brand: topBrand, quiz_goal: (Array.isArray(STATE.answers.goal)?STATE.answers.goal.join(','):STATE.answers.goal)||'', quiz_symptom: STATE.answers.symptom||'', quiz_sex: STATE.answers.sex||'', quiz_age: STATE.answers.age||'' }
          })
        });
      } catch(err){ console.warn('Omnisend submit failed', err); }
    } else {
      /* No Omnisend key — capture lead via Shopify customer form fallback */
      try {
        const fd = new FormData();
        fd.append('form_type','customer');
        fd.append('utf8','✓');
        fd.append('contact[tags]','quiz_taken,v-check');
        fd.append('contact[email]',email);
        fd.append('contact[first_name]',name);
        await fetch('/contact', {method:'POST', body:fd});
      } catch(err){ console.warn('Shopify fallback failed', err);}
    }
    goLoading();
  }

  /* ---- Results render ---- */
  function renderResults(){
    /* Greeting */
    const name = STATE.answers.name || 'there';
    $('#vbq-greet').textContent = name + ', here\'s your';
    /* Profile sentence */
    const goals = Array.isArray(STATE.answers.goal) ? STATE.answers.goal.join(' + ') : STATE.answers.goal || '';
    const profileBits = [];
    if(STATE.answers.sex && STATE.answers.sex!=='any') profileBits.push(STATE.answers.sex+'');
    if(STATE.answers.age) profileBits.push(STATE.answers.age.replace('_','–'));
    if(goals) profileBits.push('focused on '+goals);
    if(STATE.answers.symptom) profileBits.push('addressing '+STATE.answers.symptom.replace('_',' '));
    $('#vbq-profile').innerHTML = '<strong>Your profile:</strong> ' + profileBits.join(' · ') + '. Based on your answers and Velobiotics\'s research database, here are the top matches.';
    /* Render each rec */
    const recsHtml = STATE.recs.map((rec,i)=>{
      const p = CATALOG[rec.handle] || {brand:'Velobiotics', title:rec.handle, price:'', img:''};
      const utm = `?utm_source=quiz&utm_medium=recommendation&utm_campaign=v-check&utm_content=${rec.handle}&utm_term=rank-${i+1}`;
      const productUrl = `/products/${rec.handle}${utm}`;
      const cartUrl = `/cart/add?id=&quantity=1${utm.replace('?','&')}`;
      return `<div class="vbq__rec ${i===0?'is-top':''}">${i===0?'<div class="vbq__rec-rank">★ Best Match</div>':''}
        <div class="vbq__rec-img"><img src="${p.img}" alt="${p.title}" loading="lazy"></div>
        <div class="vbq__rec-body">
          <div class="vbq__rec-brand">${p.brand}</div>
          <h3 class="vbq__rec-title">${p.title}</h3>
          <p class="vbq__rec-why">${rec.reason}</p>
          <a class="vbq__rec-cta" href="${productUrl}" onclick="VBQ.clickRec('${rec.handle}',${i+1})">Shop ${p.price} →</a>
          <a class="vbq__rec-cta-secondary" href="${productUrl}" onclick="VBQ.clickRec('${rec.handle}',${i+1})">Learn more</a>
        </div></div>`;
    }).join('');
    $('#vbq-recs').innerHTML = recsHtml;
  }

  function clickRec(handle, rank){ track('quiz_rec_clicked',{handle:handle, rank:rank}); }
  function shareWhatsApp(){
    const msg = encodeURIComponent('I just took the Velobiotics V-Check and got my personalised wellness plan: '+ window.location.href);
    window.open('https://wa.me/?text='+msg,'_blank');
  }
  function copyLink(){
    navigator.clipboard.writeText(window.location.href);
    alert('Link copied!');
  }
  function restart(){ STATE.idx=0; STATE.answers={}; STATE.recs=[]; $$('.vbq__opt').forEach(o=>o.classList.remove('is-on')); $$('.vbq__btn--prime').forEach(b=>{if(b.id!=='vbq-lead-btn')b.disabled=true}); render(); }

  /* ---- Analytics event hooks ---- */
  function track(name, props){
    try {
      const payload = {event:name, quiz:STATE.quizId, session:STATE.sessionId, ts:Date.now(), ...props};
      /* Shopify Analytics */
      if(window.analytics && window.analytics.publish) window.analytics.publish('vb_quiz_'+name, payload);
      /* dataLayer (GA4) */
      if(window.dataLayer) window.dataLayer.push({event:'vb_quiz_'+name, ...payload});
      /* localStorage event log for the dashboard */
      const log = JSON.parse(localStorage.getItem('vbq_log')||'[]');
      log.push(payload);
      localStorage.setItem('vbq_log', JSON.stringify(log.slice(-200)));
      /* Beacon to /apps/vb-analytics endpoint if configured (optional, future) */
    } catch(e){}
  }

  /* ---- Init ---- */
  STATE.sessionId = 'vbq_'+Date.now()+'_'+Math.random().toString(36).slice(2,8);
  track('quiz_started',{});
  window.VBQ = { next, prev, submitLead, restart, clickRec, shareWhatsApp, copyLink };
  /* Disable continue buttons by default */
  $$('.vbq__step[data-step="q"] .vbq__btn--prime').forEach(b=>b.disabled = true);
})();
</script>

