{%- comment -%}
  VB · Trusted by Doctors — 4 credibility cards with SVG icons in Velobiotics green
{%- endcomment -%}

<style>
  .vb-docs { padding: 72px 24px; background: linear-gradient(180deg, #fff 0%, #f5f9f3 100%); }
  .vb-docs__inner { max-width: 1280px; margin: 0 auto; }
  .vb-docs__head { text-align: center; max-width: 820px; margin: 0 auto 44px; }
  .vb-docs__eyebrow { display: inline-block; color: #4d8c44; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
  .vb-docs__title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; color: #1a1a1a; line-height: 1.12; margin: 0 0 14px; letter-spacing: -0.01em; }
  .vb-docs__title em { color: #4d8c44; font-style: normal; }
  .vb-docs__sub { font-size: 16.5px; line-height: 1.6; color: #5c6664; margin: 0; }
  .vb-docs__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .vb-docs__card { padding: 30px 24px 26px; background: #fff; border: 1px solid #e3ece1; border-radius: 20px; text-align: center; transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease; }
  .vb-docs__card:hover { transform: translateY(-5px); box-shadow: 0 22px 44px rgba(77, 140, 68, 0.16); border-color: rgba(77, 140, 68, 0.3); }
  .vb-docs__icon { width: 72px; height: 72px; border-radius: 50%; background: rgba(77, 140, 68, 0.1); display: inline-flex; align-items: center; justify-content: center; margin: 0 0 18px; padding: 18px; }
  .vb-docs__icon img { width: 100%; height: 100%; object-fit: contain; }
  .vb-docs__icon-fallback { font-size: 32px; color: #4d8c44; }
  .vb-docs__name { font-size: 16.5px; font-weight: 800; color: #1a1a1a; margin: 0 0 8px; line-height: 1.3; }
  .vb-docs__desc { font-size: 13.5px; line-height: 1.55; color: #5c6664; margin: 0; }
  @media (max-width: 749px) {
    .vb-docs { padding: 48px 14px; }
    .vb-docs__head { margin-bottom: 28px; }
    .vb-docs__grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .vb-docs__card { padding: 22px 16px 20px; border-radius: 16px; }
    .vb-docs__icon { width: 56px; height: 56px; padding: 14px; margin-bottom: 12px; }
    .vb-docs__name { font-size: 14.5px; }
    .vb-docs__desc { font-size: 12.5px; }
  }
</style>

<section class="vb-docs">
  <div class="vb-docs__inner">
    <div class="vb-docs__head">
      {%- if section.settings.eyebrow != blank -%}<p class="vb-docs__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="vb-docs__title">{{ section.settings.title_pre }}{%- if section.settings.title_highlight != blank %} <em>{{ section.settings.title_highlight }}</em>{%- endif -%}</h2>
      {%- if section.settings.sub != blank -%}<p class="vb-docs__sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <div class="vb-docs__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <article class="vb-docs__card" {{ block.shopify_attributes }}>
            <div class="vb-docs__icon">
              {%- if block.settings.icon_url != blank -%}
                <img src="{{ block.settings.icon_url }}" alt="" loading="lazy" />
              {%- else -%}
                <span class="vb-docs__icon-fallback">{{ block.settings.icon_fallback | default: '✓' }}</span>
              {%- endif -%}
            </div>
            <h3 class="vb-docs__name">{{ block.settings.name }}</h3>
            <p class="vb-docs__desc">{{ block.settings.desc }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VB · Trusted by Doctors",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trusted by Doctors. Proven by Science." },
    { "type": "text", "id": "title_pre", "label": "Title (start)", "default": "Loved by" },
    { "type": "text", "id": "title_highlight", "label": "Title (highlight)", "default": "Thousands." },
    { "type": "textarea", "id": "sub", "label": "Sub-text", "default": "Built on peer-reviewed strains, medical formulations, and SAHPRA-aware manufacturing — every Velobiotics product earns its place." }
  ],
  "blocks": [
    { "type": "card", "name": "Doctor card", "settings": [
      { "type": "text", "id": "icon_url", "label": "Icon URL" },
      { "type": "text", "id": "icon_fallback", "label": "Icon fallback emoji", "default": "✓" },
      { "type": "text", "id": "name", "label": "Name", "default": "Clinically Proven Strains" },
      { "type": "textarea", "id": "desc", "label": "Description", "default": "Formulated using strains studied in peer-reviewed clinical trials." }
    ]}
  ],
  "presets": [
    { "name": "VB · Trusted by Doctors", "blocks": [
      { "type": "card", "settings": { "icon_url": "https://www.velobiotics.com/cdn/shop/files/verified_24dp_4D8C44.svg?v=1763281966", "name": "Clinically Proven Strains", "desc": "Formulated using strains studied in peer-reviewed clinical trials." } },
      { "type": "card", "settings": { "icon_url": "https://www.velobiotics.com/cdn/shop/files/medication_24dp_4D8C44.svg?v=1763281966", "name": "Doctor Formulated", "desc": "Developed by medical doctors and microbiologists for real-world outcomes." } },
      { "type": "card", "settings": { "icon_url": "https://www.velobiotics.com/cdn/shop/files/science_24dp_4D8C44.svg?v=1763353073", "name": "Patented MEP Technology", "desc": "Microencapsulation with Supercritical CO₂ — 1000× more probiotics survive." } },
      { "type": "card", "settings": { "icon_url": "https://www.velobiotics.com/cdn/shop/files/takeout_dining_24dp_4D8C44.svg?v=1763353199", "name": "Clean Label", "desc": "No fillers, no allergens, no greenwashing — just clinical-grade probiotics." } }
    ]}
  ]
}
{% endschema %}
